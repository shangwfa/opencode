{
  "name": "@opencode/hn-base-server",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "通用底座服务：用户/认证/组织/授权 + 会话访问网关（Hono + PostgreSQL + better-auth）",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsgo -p tsconfig.json",
    "start": "bun run src/server.ts",
    "test": "BASE_DATABASE_SCHEMA=hn_base_dev bun test --isolate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.8",
    "@hono/node-server": "^2.1.5",
    "@opencode/schema": "workspace:*",
    "better-auth": "1.7.8",
    "drizzle-orm": "^0.45.2",
    "effect": "catalog:",
    "hono": "catalog:",
    "pg": "^8.16.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.15.6",
    "@typescript/native-preview": "catalog:"
  }
}
