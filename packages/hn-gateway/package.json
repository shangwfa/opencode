{
  "name": "@opencode/hn-gateway",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "影刀前端网关(BFF)迁移：Hono + PostgreSQL。应用注册/微前端托管/灰度分流/发布审批/上报/代理，Nacos 由 PG 替代",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsgo -p tsconfig.json",
    "start": "bun run src/server.ts",
    "test": "esbuild src/ws-proxy.ts --bundle --platform=node --format=esm --outfile=dist/ws-proxy.mjs && GATEWAY_DATABASE_SCHEMA=hn_gateway_dev bun test --isolate",
    "build:node": "bun run scripts/build-node.mjs src/server.ts dist/server.js",
    "start:node": "bun run build:node && node dist/server.js"
  },
  "dependencies": {
    "@alicloud/devops20210625": "4.19.2",
    "@alicloud/openapi-client": "^0.4.12",
    "@alicloud/tea-util": "^1.4.9",
    "cheerio": "1.0.0-rc.12",
    "ua-parser-js": "^2.0.0",
    "@hono/node-server": "^2.0.10",
    "drizzle-orm": "^0.44.7",
    "hono": "catalog:",
    "jsencrypt": "^3.5.4",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "esbuild": "^0.25.0",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "^8.15.6",
    "@typescript/native-preview": "catalog:"
  }
}