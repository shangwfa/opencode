{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "esbuild api/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=api/index.js --external:pg-native --external:pdf-parse --banner:js=\"import{createRequire as __vcr}from'node:module';const require=__vcr(import.meta.url);\" --log-level=warning",
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api" },
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/mcp/:path*", "destination": "/api" }
  ]
}
