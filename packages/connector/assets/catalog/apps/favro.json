    {
      "id": "favro.list_cards",
      "service": "favro",
      "name": "list_cards",
      "description": "List Favro cards using a documented board, collection, card, or todo filter.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "todoList": {
            "type": "boolean",
            "description": "Whether to return cards from the user's todo list."
          },
          "cardCommonId": {
            "type": "string",
            "minLength": 1,
            "description": "Common card identifier used to filter results."
          },
          "cardSequentialId": {
            "type": "string",
            "minLength": 1,
            "description": "Sequential card identifier used to filter results."
          },
          "widgetCommonId": {
            "type": "string",
            "minLength": 1,
            "description": "Widget common identifier used to filter cards."
          },
          "columnId": {
            "type": "string",
            "minLength": 1,
            "description": "Column identifier used to filter cards."
          },
          "collectionId": {
            "type": "string",
            "minLength": 1,
            "description": "Collection identifier used to filter cards."
          },
          "unique": {
            "type": "boolean",
            "description": "Whether to return unique cards only."
          },
          "archived": {
            "type": "boolean",
            "description": "Whether to return archived cards."
          },
          "descriptionFormat": {
            "type": "string",
            "enum": [
              "plaintext",
              "markdown"
            ],
            "description": "Card description format."
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "description": "Request identifier returned by the first page."
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "description": "Zero-based page index to retrieve."
          },
          "backendIdentifier": {
            "type": "string",
            "minLength": 1,
            "description": "Favro backend identifier returned by the first page for routing continuation requests."
          }
        },
        "additionalProperties": false,
        "description": "Card filters and continuation data. At least one card filter is required."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "cards": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A Favro API entity."
            },
            "description": "Cards returned for this page."
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "description": "Request identifier used to retrieve subsequent pages."
          },
          "page": {
            "type": "integer",
            "description": "Zero-based page index returned by Favro."
          },
          "pages": {
            "type": "integer",
            "description": "Total number of available pages."
          },
          "limit": {
            "type": "integer",
            "description": "Maximum number of entities in this page."
          },
          "backendIdentifier": {
            "anyOf": [
              {
                "type": "string",
                "description": "Favro backend identifier required when retrieving subsequent pages."
              },
              {
                "type": "null"
              }
            ],
            "description": "Favro backend identifier required when retrieving subsequent pages."
          }
        },
        "additionalProperties": false,
        "description": "A page of Favro cards."
      }
    },
