    {
      "id": "practitest.create_test",
      "service": "practitest",
      "name": "create_test",
      "description": "Create a test in a PractiTest project.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1,
            "description": "The PractiTest project ID."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The test name."
          },
          "authorId": {
            "type": "string",
            "minLength": 1,
            "description": "The author user ID; omit for a personal token unless impersonation is enabled."
          },
          "description": {
            "type": "string",
            "description": "The test description."
          },
          "testType": {
            "type": "string",
            "enum": [
              "ScriptedTest",
              "ApiTest",
              "FireCracker",
              "xBotTest",
              "EggplantTest",
              "BDDTest"
            ],
            "description": "The PractiTest test type."
          },
          "assignedToId": {
            "type": "string",
            "minLength": 1,
            "description": "The assigned user or group ID."
          },
          "assignedToType": {
            "type": "string",
            "enum": [
              "user",
              "group"
            ],
            "description": "The assignee type."
          },
          "plannedExecution": {
            "type": "string",
            "description": "The planned execution date and time.",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "description": "The test workflow status."
          },
          "version": {
            "type": "string",
            "description": "The test version."
          },
          "priority": {
            "type": "string",
            "description": "The test priority."
          },
          "durationEstimate": {
            "type": "string",
            "description": "The test duration estimate."
          },
          "customFields": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "PractiTest custom field keys and values."
          },
          "automatedFields": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "PractiTest automation information fields."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "A test tag."
            },
            "description": "Tags assigned to the test."
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255,
                  "description": "The step name, up to 255 characters."
                },
                "description": {
                  "type": "string",
                  "description": "The step description."
                },
                "expectedResults": {
                  "type": "string",
                  "description": "The expected step results."
                }
              },
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "description": "A step to create with a scripted test."
            },
            "description": "Scripted steps to create with the test.",
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "projectId",
          "name"
        ],
        "description": "The project, attributes, and optional scripted steps for the new test."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "test": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "The PractiTest resource ID."
              },
              "type": {
                "type": "string",
                "minLength": 1,
                "description": "The PractiTest resource type."
              },
              "attributes": {
                "type": "object",
                "properties": {},
                "additionalProperties": true,
                "description": "The attributes returned by PractiTest for this resource."
              }
            },
            "additionalProperties": true,
            "description": "A PractiTest JSON:API resource."
          }
        },
        "additionalProperties": false,
        "description": "The test returned by PractiTest."
      }
