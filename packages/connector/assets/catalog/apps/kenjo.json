    {
      "id": "kenjo.create_office",
      "service": "kenjo",
      "name": "create_office",
      "description": "Create a Kenjo office linked to an existing company and calendar.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The office name."
          },
          "companyId": {
            "type": "string",
            "minLength": 1,
            "description": "The Kenjo company ID."
          },
          "calendarId": {
            "type": "string",
            "minLength": 1,
            "description": "The Kenjo calendar ID."
          },
          "street": {
            "type": "string",
            "description": "The office street address."
          },
          "postalCode": {
            "type": "string",
            "description": "The office postal code."
          },
          "city": {
            "type": "string",
            "description": "The office city."
          },
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "description": "The ISO 3166-1 alpha-2 country code."
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "companyId",
          "calendarId"
        ],
        "description": "The office to create."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "office": {
            "type": "object",
            "properties": {
              "_id": {
                "type": "string",
                "description": "The Kenjo office ID."
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "The office name."
              },
              "companyId": {
                "type": "string",
                "minLength": 1,
                "description": "The Kenjo company ID."
              },
              "calendarId": {
                "type": "string",
                "minLength": 1,
                "description": "The Kenjo calendar ID."
              },
              "street": {
                "type": "string",
                "description": "The office street address."
              },
              "postalCode": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "A postal code."
                  },
                  {
                    "type": "number",
                    "description": "A numeric postal code."
                  }
                ],
                "description": "The office postal code, returned as a string or number."
              },
              "city": {
                "type": "string",
                "description": "The office city."
              },
              "country": {
                "type": "string",
                "minLength": 2,
                "maxLength": 2,
                "description": "The ISO 3166-1 alpha-2 country code."
              },
              "activeForShiftplan": {
                "type": "boolean",
                "description": "Whether the office is enabled as a shift plan location."
              }
            },
            "additionalProperties": true,
            "description": "A Kenjo office, including additional upstream fields."
          }
        },
        "additionalProperties": false,
        "required": [
          "office"
        ],
        "description": "The returned Kenjo office."
      }
