      "extraFields": [
        {
          "key": "environment",
          "label": "Environment",
          "required": false,
          "placeholder": "production",
          "description": "Use production (default) or sandbox to match the environment activated for your API key: https://kenjo.readme.io/reference/post_auth-login.",
          "inputType": "text",
          "secret": false
        }
      ]
    }
