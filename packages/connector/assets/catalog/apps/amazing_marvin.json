{
  "service": "amazing_marvin",
  "displayName": "Amazing Marvin",
  "homepageUrl": "https://amazingmarvin.com/",
  "categories": [
    "Productivity"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Token",
      "description": "Get the API Token from https://app.amazingmarvin.com/pre?api (Features > API settings). Use API_TOKEN, not FULL_ACCESS_TOKEN. Requests send it in X-API-Token."
    }
  ],
  "actions": [
    {
      "id": "amazing_marvin.complete_task",
      "service": "amazing_marvin",
      "name": "complete_task",
      "description": "Mark a Marvin task complete. This experimental API does not reproduce all client recurrence and reward behavior.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string",
            "minLength": 1,
            "description": "ID of the task to complete."
          },
          "timeZoneOffset": {
            "type": "integer",
            "description": "UTC offset in minutes, positive east of UTC; used for local dates."
          }
        },
        "additionalProperties": false,
        "required": [
          "itemId"
        ],
        "description": "Task completion input."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "description": "Upstream JSON or text confirmation, or null for an empty response; an item ID is not guaranteed."
          }
        },
        "additionalProperties": false,
        "required": [
          "result"
        ],
        "description": "Write operation response."
      }
    },
    {
      "id": "amazing_marvin.create_project",
      "service": "amazing_marvin",
      "name": "create_project",
      "description": "Create a Marvin project with scheduling, labels, notes, and priority.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "Item title; Marvin processes supported task input shortcuts."
          },
          "done": {
            "type": "boolean",
            "description": "Whether the new item is already complete."
          },
          "day": {
            "anyOf": [
              {
                "type": "string",
                "description": "Calendar date in YYYY-MM-DD format.",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "description": "Calendar date in YYYY-MM-DD format."
          },
          "parentId": {
            "type": "string",
            "minLength": 1,
            "description": "Parent category or project ID; unassigned is the inbox."
          },
          "labelIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "A label ID."
            },
            "description": "Label IDs to attach."
          },
          "firstScheduled": {
            "type": "string",
            "description": "Calendar date in YYYY-MM-DD format.",
            "format": "date"
          },
          "rank": {
            "type": "number",
            "description": "Sort rank within the parent."
          },
          "dailySection": {
            "type": "string",
            "description": "Daily section name, such as Morning."
          },
          "bonusSection": {
            "type": "string",
            "enum": [
              "Essential",
              "Bonus"
            ],
            "description": "Essential or bonus section."
          },
          "customSection": {
            "type": "string",
            "description": "Custom section ID from the user's settings."
          },
          "timeBlockSection": {
            "type": "string",
            "description": "Time block ID."
          },
          "note": {
            "type": "string",
            "description": "Item notes."
          },
          "dueDate": {
            "type": "string",
            "description": "Calendar date in YYYY-MM-DD format.",
            "format": "date"
          },
          "timeEstimate": {
            "type": "number",
            "description": "Estimated duration in milliseconds."
          },
          "isReward": {
            "type": "boolean",
            "description": "Whether the item is a reward."
          },
          "isFrogged": {
            "type": "integer",
            "description": "Frog difficulty level."
          },
          "plannedWeek": {
            "type": "string",
            "description": "Calendar date in YYYY-MM-DD format.",
            "format": "date"
          },
          "plannedMonth": {
            "type": "string",
            "description": "Planned month in YYYY-MM format."
          },
          "rewardPoints": {
            "type": "number",
            "description": "Reward points for completing the item."
          },
          "backburner": {
            "type": "boolean",
            "description": "Whether to manually place the item on the backburner."
          },
          "reviewDate": {
            "type": "string",
            "description": "Calendar date in YYYY-MM-DD format.",
            "format": "date"
          },
          "timeZoneOffset": {
            "type": "integer",
            "description": "UTC offset in minutes, positive east of UTC; used for local dates."
          },
          "priority": {
            "type": "string",
            "enum": [
              "high",
              "mid",
              "low"
            ],
            "description": "Project priority."
          },
          "rewardId": {
            "type": "string",
            "description": "ID of the attached reward."
          },
          "itemSnoozeTime": {
            "type": "number",
            "description": "Snooze until this Unix timestamp in milliseconds."
          },
          "permaSnoozeTime": {
            "type": "string",
            "description": "Daily snooze time in HH:mm format."
          }
        },
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "description": "Project creation input; set day to null for an unscheduled project."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "description": "Upstream JSON or text confirmation, or null for an empty response; an item ID is not guaranteed."
          }
        },
        "additionalProperties": false,
        "required": [
          "result"
        ],
        "description": "Write operation response."
      }
    },
