    {
      "id": "odoo.unlink",
      "service": "odoo",
      "name": "unlink",
      "description": "Delete one or more Odoo records.",
      "operationType": "destructive",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
