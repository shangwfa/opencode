            "pattern": "\\S"
          },
          "domain": {
            "type": "array",
            "items": {
              "description": "A domain condition array or prefix operator: &, |, !."
            },
            "description": "Odoo domain in JSON form, for example [[\"is_company\", \"=\", true]]. Use [] to match all records."
          },
          "fields": {
