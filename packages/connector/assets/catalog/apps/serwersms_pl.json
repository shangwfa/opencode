{
  "service": "serwersms_pl",
  "displayName": "SerwerSMS.pl",
  "homepageUrl": "https://serwersms.pl/",
  "categories": [
    "Communication"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Token",
      "placeholder": "SERWERSMS_API_TOKEN",
      "description": "Create an API token in the Customer Panel at https://panel.serwersms.pl/ under Ustawienia interfejsów → HTTPS API → Tokeny API. The token is sent using Bearer authentication."
    }
  ],
  "actions": [
    {
      "id": "serwersms_pl.add_sender",
      "service": "serwersms_pl",
      "name": "add_sender",
      "description": "Submit a sender name for authorization. Wait until list_senders reports authorized before using it to send SMS.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 11,
            "description": "The alphanumeric sender name, at most 11 characters."
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "description": "Sender name to submit."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the operation succeeded."
          }
        },
        "additionalProperties": true,
        "description": "The operation result."
      }
    },
    {
      "id": "serwersms_pl.cancel_scheduled_sms",
      "service": "serwersms_pl",
      "name": "cancel_scheduled_sms",
      "description": "Cancel scheduled SMS messages by provider or caller-assigned IDs before dispatch.",
      "operationType": "destructive",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "description": "A single value."
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "One value."
                },
                "description": "Multiple values.",
                "minItems": 1
              }
            ],
            "description": "Provider message IDs."
          },
          "unique_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "description": "A single value."
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "One value."
                },
                "description": "Multiple values.",
                "minItems": 1
              }
            ],
            "description": "Caller-assigned message IDs."
          }
        },
        "additionalProperties": false,
        "description": "Scheduled messages to cancel.",
        "anyOf": [
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "unique_id"
            ]
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the operation was processed."
          },
          "correct": {
            "type": "integer",
            "description": "Number of successfully cancelled messages."
          },
          "failed": {
            "type": "integer",
            "description": "Number of messages that could not be cancelled."
          }
        },
        "additionalProperties": true,
        "description": "Cancellation result."
      }
    },
    {
      "id": "serwersms_pl.get_account_limits",
      "service": "serwersms_pl",
      "name": "get_account_limits",
      "description": "Get available message quotas and optionally the account type.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "show_type": {
            "type": "boolean",
            "description": "Include the account type; defaults to true.",
            "default": true
          }
        },
        "additionalProperties": false,
        "description": "Account quota options."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "account": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "Account information, including prepaid or postpaid type."
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A quota record; value may be a numeric string, no_limit, or not_available."
            },
            "description": "Available quotas by message or lookup type."
          }
        },
        "additionalProperties": true,
        "required": [
          "items"
        ],
        "description": "Account quotas."
      }
    },
    {
      "id": "serwersms_pl.get_delivery_reports",
      "service": "serwersms_pl",
      "name": "get_delivery_reports",
      "description": "Query SMS delivery reports by message IDs or filters. Reports are available for about 14 days and updated for up to 72 hours; prefer batches of 50–200 IDs.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "description": "A single value."
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "One value."
                },
                "description": "Multiple values.",
                "minItems": 1,
                "maxItems": 500
              }
            ],
            "description": "Provider message IDs; at most 500 per request."
          },
          "unique_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "description": "A single value."
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "One value."
                },
                "description": "Multiple values.",
                "minItems": 1,
                "maxItems": 500
              }
            ],
            "description": "Caller-assigned message IDs."
          },
          "phone": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "description": "A single value."
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "One value."
                },
                "description": "Multiple values.",
                "minItems": 1
              }
            ],
            "description": "Recipient phone numbers in international format."
          },
          "date_from": {
            "type": "string",
            "minLength": 1,
            "description": "Start of the queuing-time interval, for example 2026-12-01 00:00:00."
          },
          "date_to": {
            "type": "string",
            "minLength": 1,
            "description": "End of the queuing-time interval, for example 2026-12-01 23:59:59."
          },
          "status": {
            "type": "string",
            "enum": [
              "delivered",
              "undelivered",
              "pending",
              "sent",
              "unsent",
              "in_progress",
              "saved"
            ],
            "description": "Filter by dispatch status."
          },
          "show_contact": {
            "type": "boolean",
            "description": "Include contact details when the recipient exists in the contact database."
          }
        },
        "additionalProperties": false,
        "description": "Delivery report filters."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A message record returned by SerwerSMS.pl."
            },
            "description": "Message records, including per-recipient status and errors."
          }
        },
        "additionalProperties": true,
        "description": "Delivery report result; archived messages may produce an empty list."
      }
    },
    {
      "id": "serwersms_pl.list_senders",
      "service": "serwersms_pl",
      "name": "list_senders",
      "description": "List sender names and their authorization status, optionally including predefined senders.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "predefined": {
            "type": "boolean",
            "description": "Include predefined sender names ready to use."
          },
          "type": {
            "type": "string",
            "enum": [
              "ndi",
              "mms"
            ],
            "description": "Filter by sender type."
          },
          "sort": {
            "type": "string",
            "enum": [
              "name"
            ],
            "description": "Sort by sender name."
          },
          "order": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "description": "Sort direction."
          }
        },
        "additionalProperties": false,
        "description": "Sender list options."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A sender record with name, agreement, status, and optional note or networks."
            },
            "description": "Sender names and approval states."
          }
        },
        "additionalProperties": true,
        "description": "Sender list result."
      }
    },
    {
      "id": "serwersms_pl.send_sms",
      "service": "serwersms_pl",
      "name": "send_sms",
      "description": "Send or schedule SMS messages with the same content. Omit sender for ECO+ or use an approved sender for FULL SMS. A queued result does not mean delivery.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "The message content; for vcard, supply newline-separated vCard text."
          },
          "phone": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "description": "A single value."
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "One value."
                },
                "description": "Multiple values.",
                "minItems": 1,
                "maxItems": 100000
              }
            ],
            "description": "Recipient phone numbers, preferably in international +country format. Use batches of 50–200 numbers."
          },
          "group_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "description": "A single value."
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "One value."
                },
                "description": "Multiple values.",
                "minItems": 1
              }
            ],
            "description": "Recipient group IDs in the Customer Panel."
          },
          "contact_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "description": "A single value."
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "One value."
                },
                "description": "Multiple values.",
                "minItems": 1
              }
            ],
            "description": "Recipient contact IDs in the Customer Panel."
          },
          "sender": {
            "type": "string",
            "description": "An approved sender name or number for FULL SMS; empty or omitted selects ECO+. Use 2waySMS for a reply-capable random number."
          },
          "flash": {
            "type": "boolean",
            "description": "Send as a flash SMS if enabled on the account."
          },
          "test": {
            "type": "boolean",
            "description": "Simulate submission without sending messages."
          },
          "wap_push": {
            "type": "string",
            "description": "The WAP Push URL."
          },
          "utf": {
            "type": "boolean",
            "description": "Enable Unicode for FULL SMS; requires sender and reduces a single part to 70 characters."
          },
          "details": {
            "type": "boolean",
            "description": "Include individual message IDs and statuses; defaults to true.",
            "default": true
          },
          "vcard": {
            "type": "boolean",
            "description": "Interpret the message text as a vCard."
          },
          "speed": {
            "type": "boolean",
            "description": "Use the highest-quality independent channel, which may incur an extra charge."
          },
          "date": {
            "type": "string",
            "minLength": 1,
            "description": "Scheduled dispatch time in provider format, for example 2026-12-01 12:25:55."
          },
          "unique_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 3,
                "maxLength": 50,
                "description": "One caller-assigned ID.",
                "pattern": "^[a-zA-Z0-9]+$"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 50,
                  "description": "One caller-assigned ID.",
                  "pattern": "^[a-zA-Z0-9]+$"
                },
                "description": "Caller-assigned IDs in recipient order.",
                "minItems": 1,
                "uniqueItems": true
              }
            ],
            "description": "Caller-assigned message IDs; provide one per recipient, with unique values."
          },
          "dlr_url": {
            "type": "string",
            "minLength": 1,
            "description": "Delivery callback URL template, passed to SerwerSMS.pl. Supply the unencoded URL; form encoding is handled automatically. Supported placeholders include #SMSID#, #STAN#, #DATA#, and #PRZYCZYNA#."
          }
        },
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "description": "SMS content, recipients, and delivery options.",
        "anyOf": [
          {
            "required": [
              "phone"
            ]
          },
          {
            "required": [
              "group_id"
            ]
          },
          {
            "required": [
              "contact_id"
            ]
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the submission was processed."
          },
          "queued": {
            "type": "integer",
            "description": "Number of queued messages."
          },
          "unsent": {
            "type": "integer",
            "description": "Number of messages not sent."
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A message record returned by SerwerSMS.pl."
            },
            "description": "Message records, including per-recipient status and errors."
          }
        },
        "additionalProperties": true,
        "required": [
          "success",
          "queued",
          "unsent"
        ],
        "description": "SMS submission result, including any partial failures."
      }
    }
  ]
}
