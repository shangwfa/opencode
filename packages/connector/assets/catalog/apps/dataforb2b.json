              "company",
              "people_industry",
              "company_industry",
              "category",
              "location",
              "city",
              "region",
              "school",
              "title",
              "skill",
              "investor"
            ],
            "description": "Category of filter values to autocomplete."
          },
          "q": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Search query for matching filter values."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Maximum number of results to return."
          }
        },
        "additionalProperties": false,
        "required": [
          "type",
          "q"
        ],
