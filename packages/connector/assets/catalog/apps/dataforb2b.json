      "service": "dataforb2b",
      "name": "typeahead",
      "description": "Autocomplete values for DataForB2B people and company search filters.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
