    {
      "id": "kadoa.export_workflow_data",
      "service": "kadoa",
      "name": "export_workflow_data",
      "description": "Materialize all matching Kadoa workflow records and return a temporary signed download URL.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "workflowId": {
            "type": "string",
            "minLength": 1,
            "description": "The unique identifier of the Kadoa workflow."
          },
          "runId": {
            "type": "string",
            "minLength": 1,
            "description": "The optional workflow run identifier."
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The workflow schema field to filter."
                },
                "operator": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The Kadoa comparison operator to apply."
                },
                "value": {
                  "description": "The value to compare with the workflow field."
                }
              },
              "additionalProperties": false,
              "description": "A structured filter that Kadoa applies to workflow data."
            },
            "description": "Structured filters to apply to workflow records.",
            "minItems": 1
          },
          "sortBy": {
            "type": "string",
            "minLength": 1,
            "description": "The workflow field used to sort records."
          },
          "order": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "description": "The sort direction for workflow records.",
            "default": "asc"
          },
          "rowIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "A workflow record identifier."
            },
            "description": "Specific workflow record identifiers to include.",
            "minItems": 1
          },
          "format": {
            "type": "string",
            "enum": [
              "csv",
              "json",
              "parquet"
            ],
            "description": "The file format for the materialized workflow export.",
            "default": "csv"
          }
        },
        "additionalProperties": false,
        "required": [
          "workflowId"
        ],
        "description": "The input payload for exporting Kadoa workflow data."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "workflowId": {
            "type": "string",
            "description": "The Kadoa workflow identifier."
          },
          "runId": {
            "type": "string",
            "description": "The workflow run identifier exported by Kadoa."
          },
          "executedAt": {
            "type": "string",
            "description": "The timestamp when the exported workflow run was executed.",
            "format": "date-time"
          },
          "format": {
            "type": "string",
            "enum": [
              "csv",
              "json",
              "parquet"
            ],
            "description": "The generated export format."
          },
          "rowCount": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of records in the export."
          },
          "url": {
            "type": "string",
            "description": "The signed self-authenticating download URL.",
            "format": "uri"
          },
          "expiresAt": {
            "type": "string",
            "description": "The timestamp when the signed download URL expires.",
            "format": "date-time"
          }
        },
        "additionalProperties": false,
        "required": [
          "workflowId",
          "runId",
          "format",
          "rowCount",
          "url",
          "expiresAt"
        ],
        "description": "Metadata for a materialized Kadoa workflow data export."
      }
    },
