    {
      "id": "kadoa.list_workflows",
      "service": "kadoa",
      "name": "list_workflows",
      "description": "List Kadoa workflows with pagination and optional lifecycle, execution, and scheduling filters.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string",
            "minLength": 1,
            "description": "A search term matched against workflow names or identifiers."
          },
          "skip": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of workflows to skip.",
            "default": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "The maximum number of workflows to return.",
            "default": 25
          },
          "state": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DRAFT",
              "PAUSED",
              "PREVIEW",
              "QUEUED",
              "SETUP",
              "COMPLIANCE_REVIEW",
              "COMPLIANCE_REJECTED",
              "NOT_SUPPORTED",
              "ERROR",
              "DELETED"
            ],
            "description": "The persisted Kadoa workflow state to match."
          },
          "runState": {
            "type": "string",
            "enum": [
              "FAILED",
              "FINISHED",
              "RUNNING"
            ],
            "description": "The latest Kadoa workflow run state to match."
          },
          "displayState": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DRAFT",
              "PAUSED",
              "PREVIEW",
              "FAILED",
              "RUNNING",
              "VALIDATING",
              "PENDING_START",
              "COMPLIANCE_REVIEW",
              "COMPLIANCE_REJECTED"
            ],
            "description": "The computed Kadoa workflow display state to match."
          },
          "monitoring": {
            "type": "boolean",
            "description": "Whether to return only monitored or unmonitored workflows."
          },
          "updateInterval": {
            "type": "string",
            "enum": [
              "HOURLY",
              "DAILY",
              "WEEKLY",
              "MONTHLY",
              "REAL_TIME"
            ],
            "description": "The workflow update interval to match."
          },
          "scheduleType": {
            "type": "string",
            "enum": [
              "RUN_ONCE",
              "RECURRING"
            ],
            "description": "The workflow scheduling mode to match."
          },
          "includeDeleted": {
            "type": "boolean",
            "description": "Whether deleted workflows should be included."
          }
        },
        "additionalProperties": false,
        "description": "The input payload for listing Kadoa workflows."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "workflows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The unique Kadoa workflow identifier."
                },
                "name": {
                  "type": "string",
                  "description": "The workflow name."
                },
                "description": {
                  "type": "string",
                  "description": "The workflow description."
                },
                "state": {
                  "type": "string",
                  "description": "The persisted workflow lifecycle state."
                },
                "displayState": {
                  "type": "string",
                  "description": "The computed workflow state shown to users."
                },
                "runState": {
                  "type": "string",
                  "description": "The latest workflow execution state."
                },
                "createdAt": {
                  "type": "string",
                  "description": "The timestamp when the workflow was created.",
                  "format": "date-time"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Tags associated with the workflow."
                },
                "totalRecords": {
                  "type": "integer",
                  "description": "The total number of records extracted by the latest run."
                }
              },
              "additionalProperties": true,
              "required": [
                "id",
                "name",
                "description",
                "state",
                "displayState",
                "runState",
                "createdAt",
                "tags",
                "totalRecords"
              ],
              "description": "A Kadoa workflow summary."
