    {
      "id": "indiegogo.get_creator",
      "service": "indiegogo",
      "name": "get_creator",
      "description": "Get an Indiegogo creator by the URL name shown on their public creator page.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "urlName": {
            "type": "string",
            "minLength": 1,
            "description": "The URL name from an Indiegogo creator or project page.",
            "pattern": "\\S"
          }
        },
        "additionalProperties": false,
        "description": "Input for an Indiegogo Public API lookup."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "creator": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "description": "The creator's public description."
              },
              "name": {
                "type": "string",
                "description": "The creator's display name."
              },
              "urlName": {
                "type": "string",
                "description": "The creator's unique URL name."
              },
              "thumbImageUrl": {
                "type": "string",
                "description": "The URL of the creator's thumbnail image.",
                "format": "uri"
              },
              "creatorPageUrl": {
                "type": "string",
                "description": "The URL of the creator's public Indiegogo page.",
                "format": "uri"
              }
            },
            "additionalProperties": true,
            "required": [
              "description",
              "name",
              "urlName",
              "thumbImageUrl",
              "creatorPageUrl"
            ],
            "description": "A creator returned by the Indiegogo Public API."
          }
        },
        "additionalProperties": false,
        "description": "The requested Indiegogo creator."
      }
    },
