{
  "service": "hamsa",
  "displayName": "Hamsa",
  "categories": [
    "AI",
    "Communication"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "YOUR_HAMSA_API_KEY",
      "description": "Hamsa API key sent in the Authorization header. Create and copy a key from https://agents.tryhamsa.com/settings/api-keys.",
      "extraFields": []
    }
  ],
  "homepageUrl": "https://tryhamsa.com",
  "actions": [
    {
      "id": "hamsa.get_project",
      "service": "hamsa",
      "name": "get_project",
      "description": "Get the Hamsa project associated with the connected API key.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "description": "The input payload for retrieving the connected Hamsa project."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The project identifier."
              },
              "name": {
                "type": "string",
                "description": "The project name."
              },
              "createdAt": {
                "type": "string",
                "description": "The project creation timestamp.",
                "format": "date-time"
              }
            },
            "additionalProperties": true,
            "description": "A Hamsa project associated with the API key."
          }
        },
        "additionalProperties": false,
        "description": "The connected Hamsa project response."
      }
    },
    {
      "id": "hamsa.get_voice_agent",
      "service": "hamsa",
      "name": "get_voice_agent",
      "description": "Get a Hamsa voice agent by its identifier.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "voiceAgentId": {
            "type": "string",
            "description": "The voice agent identifier.",
            "format": "uuid"
          }
        },
        "additionalProperties": false,
        "description": "The input payload for retrieving a Hamsa voice agent."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "voiceAgent": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The voice agent identifier.",
                "format": "uuid"
              },
              "name": {
                "type": "string",
                "description": "The voice agent name."
              },
              "type": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "The voice agent type."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The voice agent type."
              },
              "createdAt": {
                "type": "string",
                "description": "The voice agent creation timestamp.",
                "format": "date-time"
              },
              "updatedAt": {
                "type": "string",
                "description": "The voice agent update timestamp.",
                "format": "date-time"
              }
            },
            "additionalProperties": true,
            "description": "A Hamsa voice agent."
          }
        },
        "additionalProperties": false,
        "description": "The Hamsa voice agent response."
      }
    },
    {
      "id": "hamsa.list_tts_voices",
      "service": "hamsa",
      "name": "list_tts_voices",
      "description": "List Hamsa text-to-speech voices available to a project.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "description": "The Hamsa project identifier.",
            "format": "uuid"
          },
          "source": {
            "anyOf": [
              {
                "const": "jobs",
                "type": "string",
                "description": "Voices used by media jobs."
              },
              {
                "const": "voice_agents",
                "type": "string",
                "description": "Voices used by voice agents."
              }
            ],
            "description": "The product surface where the voices are used."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "The one-based page number."
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "description": "The number of voices to return per page."
          },
          "search": {
            "type": "string",
            "description": "The search query used to filter voices."
          },
          "recentlyUsed": {
            "type": "boolean",
            "description": "Whether to return only recently used voices."
          },
          "all": {
            "type": "boolean",
            "description": "Whether to return all matching voices."
          },
          "myVoices": {
            "type": "boolean",
            "description": "Whether to return only voices owned by the connected user."
          },
          "favourite": {
            "type": "boolean",
            "description": "Whether to return only favourite voices."
          },
          "genders": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "const": "male",
                  "type": "string",
                  "description": "A male voice."
                },
                {
                  "const": "female",
                  "type": "string",
                  "description": "A female voice."
                }
              ],
              "description": "A voice gender."
            },
            "description": "The voice genders to include."
          },
          "languages": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "const": "ar",
                  "type": "string",
                  "description": "Arabic."
                },
                {
                  "const": "en",
                  "type": "string",
                  "description": "English."
                }
              ],
              "description": "A voice language."
            },
            "description": "The voice languages to include."
          },
          "styles": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "const": "narrator",
                  "type": "string",
                  "description": "Narrator style."
                },
                {
                  "const": "conversational",
                  "type": "string",
                  "description": "Conversational style."
                }
              ],
              "description": "A speaking style."
            },
            "description": "The speaking styles to include."
          },
          "dialectIds": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "A dialect identifier.",
              "format": "uuid"
            },
            "description": "The dialect identifiers to include."
          }
        },
        "additionalProperties": false,
        "required": [
          "projectId",
          "source"
        ],
        "description": "The input payload for listing Hamsa text-to-speech voices."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "voices": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The voice identifier.",
                  "format": "uuid"
                },
                "language": {
                  "type": "string",
                  "description": "The voice language code."
                },
                "name": {
                  "type": "string",
                  "description": "The voice name."
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "A voice tag."
                  },
                  "description": "The gender and speaking-style tags for the voice."
                },
                "voiceRecord": {
                  "type": "string",
                  "description": "The signed URL for the voice audio sample.",
                  "format": "uri"
                },
                "createdAt": {
                  "type": "string",
                  "description": "The voice creation timestamp.",
                  "format": "date-time"
                },
                "isFavourite": {
                  "type": "boolean",
                  "description": "Whether the voice is marked as a favourite."
                },
                "usedInJobs": {
                  "type": "boolean",
                  "description": "Whether the voice has been used in text-to-speech jobs."
                },
                "usedInVoiceAgents": {
                  "type": "boolean",
                  "description": "Whether the voice is assigned to a voice agent."
                }
              },
              "additionalProperties": true,
              "description": "A Hamsa text-to-speech voice."
            },
            "description": "The voices in this page."
          },
          "totalPages": {
            "type": "integer",
            "description": "The total number of pages."
          },
          "page": {
            "type": "integer",
            "description": "The current page number."
          },
          "totalCount": {
            "type": "integer",
            "description": "The total number of matching voices."
          }
        },
        "additionalProperties": false,
        "description": "A paginated Hamsa text-to-speech voice list."
      }
    },
    {
      "id": "hamsa.list_voice_agents",
      "service": "hamsa",
      "name": "list_voice_agents",
      "description": "List Hamsa voice agents with pagination, search, sorting, and filters.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "The one-based page number."
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "description": "The number of voice agents to return per page."
          },
          "search": {
            "type": "string",
            "description": "The search query used to filter voice agents by name."
          },
          "sortOrder": {
            "anyOf": [
              {
                "const": "asc",
                "type": "string",
                "description": "Ascending creation-time order."
              },
              {
                "const": "desc",
                "type": "string",
                "description": "Descending creation-time order."
              }
            ],
            "description": "The creation-time sort order."
          },
          "types": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "A voice agent type."
            },
            "description": "The voice agent types to include."
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "A language code."
            },
            "description": "The language codes to include."
          }
        },
        "additionalProperties": false,
        "description": "The input payload for listing Hamsa voice agents."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "The total number of matching voice agents."
          },
          "filtered": {
            "type": "integer",
            "description": "The number of voice agents returned in this page."
          },
          "voiceAgents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The voice agent identifier.",
                  "format": "uuid"
                },
                "name": {
                  "type": "string",
                  "description": "The voice agent name."
                },
                "type": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "The voice agent type."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The voice agent type."
                },
                "createdAt": {
                  "type": "string",
                  "description": "The voice agent creation timestamp.",
                  "format": "date-time"
                },
                "updatedAt": {
                  "type": "string",
                  "description": "The voice agent update timestamp.",
                  "format": "date-time"
                }
              },
              "additionalProperties": true,
              "description": "A Hamsa voice agent."
            },
            "description": "The voice agents in this page."
          }
        },
        "additionalProperties": false,
        "description": "A paginated Hamsa voice agent list."
      }
    }
  ]
}
