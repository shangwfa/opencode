    {
      "id": "saucelabs.list_build_jobs",
      "service": "saucelabs",
      "name": "list_build_jobs",
      "description": "List jobs associated with one Sauce Labs build.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "build_source": {
            "type": "string",
            "enum": [
              "vdc",
              "rdc"
            ],
            "description": "The Sauce Labs device source for the build."
          },
          "build_id": {
            "type": "string",
            "minLength": 1,
            "description": "The Sauce Labs build identifier."
          },
          "modified_since": {
            "type": "integer",
            "description": "Return jobs modified after this Unix timestamp."
          },
          "completed": {
            "type": "boolean",
            "description": "Filter by whether jobs ran uninterrupted to completion."
          },
          "errored": {
            "type": "boolean",
            "description": "Filter by whether jobs are in the errored state."
          },
          "failed": {
            "type": "boolean",
            "description": "Filter by whether jobs are in the failed state."
          },
          "finished": {
            "type": "boolean",
            "description": "Filter by whether jobs are no longer running."
          },
          "new": {
            "type": "boolean",
            "description": "Filter by whether jobs are in the new state."
          },
          "passed": {
            "type": "boolean",
            "description": "Filter by whether jobs are in the passed state."
          },
          "public": {
            "type": "boolean",
            "description": "Filter by whether jobs ran on public devices."
          },
          "queued": {
            "type": "boolean",
            "description": "Filter by whether jobs are in the queued state."
          },
          "running": {
            "type": "boolean",
            "description": "Filter by whether jobs are in the running state."
          },
          "faulty": {
            "type": "boolean",
            "description": "Filter by whether jobs are errored or failed."
          }
        },
        "additionalProperties": false,
        "required": [
          "build_source",
          "build_id"
        ],
        "description": "The Sauce Labs build and job state filters to query."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "jobs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The Sauce Labs job identifier."
                },
                "state": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true,
                  "description": "Boolean job states reported by the Sauce Labs Builds API."
                }
              },
              "additionalProperties": true,
              "description": "A job summary returned within a Sauce Labs build."
            },
            "description": "The jobs associated with the build."
          }
        },
        "additionalProperties": false,
        "description": "The normalized jobs in a Sauce Labs build."
      }
    },
