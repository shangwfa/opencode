                "start_time": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "description": "The Unix timestamp of the earliest job in the build."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The Unix timestamp of the earliest job in the build."
                },
                "end_time": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "description": "The Unix timestamp of the latest job in the build."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The Unix timestamp of the latest job in the build."
                }
              },
              "additionalProperties": true,
              "description": "A Sauce Labs build summary."
