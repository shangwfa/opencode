      "outputSchema": {
        "type": "object",
        "properties": {
          "meta": {
            "type": "object",
            "properties": {
              "generatedAt": {
                "type": "string",
                "description": "ISO 8601 timestamp when Sherpa generated the summary."
              },
              "locale": {
                "type": "string",
                "description": "Locale used for the summary."
              },
              "LlmModel": {
                "type": "string",
                "description": "Model identifier reported by Sherpa."
              }
            },
            "additionalProperties": true,
            "required": [
              "generatedAt",
              "locale",
              "LlmModel"
            ],
            "description": "Metadata for the generated travel requirement summary."
          },
          "data": {
            "type": "object",
            "properties": {
