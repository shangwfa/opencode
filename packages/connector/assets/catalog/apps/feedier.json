              "name": {
                "type": "string",
                "description": "The report name."
              },
              "type": {
                "type": "string",
                "description": "The report visibility type."
              },
              "status": {
                "type": "string",
                "description": "The report publication status."
              },
              "fql": {
                "anyOf": [
                  {
                    "type": "string",
