      "id": "feedier.create_report",
      "service": "feedier",
      "name": "create_report",
      "description": "Create a Feedier analytical report.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "integer",
            "minimum": 1,
            "description": "The user ID to associate with the report."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The report name."
          },
          "fql": {
            "anyOf": [
              {
                "type": "string",
                "description": "A serialized Feedier FQL expression."
              },
              {
                "type": "array",
