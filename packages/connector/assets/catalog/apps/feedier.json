          "team_id": {
            "type": "integer",
            "minimum": 1,
            "description": "The team ID that should own the report."
          },
          "master_id": {
            "type": "integer",
            "minimum": 1,
            "description": "The master report ID to clone as a template."
          },
          "format": {
            "type": "string",
            "enum": [
              "blank",
              "prefilled"
            ],
            "description": "The initial Feedier report format."
          }
        },
        "additionalProperties": false,
        "description": "Fields for creating a Feedier report."
