    {
      "id": "mailsoftly.add_contacts_to_contact_list",
      "service": "mailsoftly",
      "name": "add_contacts_to_contact_list",
      "description": "Add contacts to a Mailsoftly list by email, creating contacts that do not already exist.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "contact_list_id": {
            "type": "integer",
            "description": "The Mailsoftly contact list ID."
          },
          "contacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "description": "The contact email address.",
                  "format": "email"
                },
                "first_name": {
                  "type": "string",
                  "description": "The contact first name."
                },
                "last_name": {
                  "type": "string",
                  "description": "The contact last name."
                }
              },
              "additionalProperties": false,
              "required": [
                "email"
              ],
              "description": "A contact to add to the list."
            },
            "description": "Contacts to match or create by email.",
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "contact_list_id",
          "contacts"
        ],
        "description": "Contacts to add to a Mailsoftly contact list."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "The operation status."
          },
          "added_count": {
            "type": "integer",
            "description": "The number of contacts added to the list."
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "contact": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true,
                  "description": "The contact payload that failed."
                },
                "error": {
                  "type": "string",
                  "description": "The error reported for the contact."
                }
              },
              "additionalProperties": true,
              "description": "One failed contact-list membership operation."
            },
