    {
      "id": "memento_database.create_entry",
      "service": "memento_database",
      "name": "create_entry",
      "description": "Create a Memento Database entry using existing library field IDs.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "libraryId": {
            "type": "string",
            "minLength": 1,
            "description": "The library ID returned by list_libraries."
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "description": "The field ID defined in the library."
                },
                "value": {
                  "description": "The JSON value accepted by the library field type."
                }
              },
              "additionalProperties": false,
              "required": [
                "id",
                "value"
              ],
              "description": "One library field value."
            },
            "description": "The entry fields. Use field IDs from get_library and values matching their field types."
          }
        },
        "additionalProperties": false,
        "required": [
          "libraryId",
          "fields"
        ],
        "description": "The entry to create."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The entry ID."
          },
          "author": {
            "type": "string",
            "description": "The entry author."
          },
          "createdTime": {
            "type": "string",
            "description": "The entry creation timestamp."
          },
          "modifiedTime": {
            "type": "string",
            "description": "The entry modification timestamp."
          },
          "revision": {
            "type": "integer",
            "description": "The entry revision."
          },
          "status": {
            "type": "string",
            "description": "The entry status."
          },
          "size": {
            "type": "number",
            "description": "The entry size reported by Memento Database."
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "description": "The field ID defined in the library."
                },
                "value": {
                  "description": "The JSON value accepted by the library field type."
                }
              },
              "additionalProperties": false,
              "required": [
                "id",
                "value"
              ],
              "description": "One library field value."
            },
            "description": "The entry fields. Use field IDs from get_library and values matching their field types."
          }
        },
        "additionalProperties": true,
        "required": [
          "id"
        ],
        "description": "The entry returned by Memento Database, including any additional upstream fields."
      }
    },
