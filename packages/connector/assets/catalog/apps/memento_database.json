          "pageToken": {
            "type": "string",
            "minLength": 1,
            "description": "The nextPageToken from the previous response."
          },
          "fields": {
            "type": "string",
            "minLength": 1,
            "description": "Comma-separated field IDs or *all. Defaults to *all to include field values."
          },
          "startRevision": {
            "type": "integer",
            "description": "Return entries updated or created at or after this revision."
