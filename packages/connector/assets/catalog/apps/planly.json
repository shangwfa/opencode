      "id": "planly.create_schedules",
      "service": "planly",
      "name": "create_schedules",
      "description": "Create scheduled or immediate social posts in Planly. This endpoint creates scheduled posts, not drafts; publication status can be read with list_schedules.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "schedules": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "channelId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Connected channel ID returned by list_channels."
                },
                "publishOn": {
                  "type": "string",
                  "description": "Publication date and time; omit to publish immediately.",
                  "format": "date-time"
                },
                "content": {
                  "type": "string",
                  "description": "Text content for the post."
                },
                "media": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Planly media ID returned by import_media or list_media."
                      },
                      "options": {
                        "type": "object",
                        "properties": {},
                        "additionalProperties": true,
                        "description": "Platform-specific media options passed unchanged to Planly."
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "id"
                    ],
                    "description": "Media reference and platform options."
                  },
                  "description": "Previously imported Planly media."
                },
                "options": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true,
                  "description": "Social-network options passed unchanged to Planly. Pinterest publishing requires boardId; TikTok requires privacyLevel. See https://docs.planly.com/#social-network-options for all platform fields."
                }
              },
              "additionalProperties": false,
              "required": [
                "channelId"
              ],
              "description": "A post to publish on a connected social channel."
            },
            "description": "Social posts to schedule.",
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "schedules"
        ],
        "description": "Posts to create."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "upsert": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true,
                  "description": "Planly resource, including additional upstream fields."
                },
                "description": "Created groups with schedules and publication status."
              }
            },
            "additionalProperties": true,
            "description": "Created schedule groups."
          },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {},
                "additionalProperties": true,
                "description": "Upstream error details, or null on success."
              },
              {
                "type": "null"
              }
            ],
            "description": "Upstream error details, or null on success."
          }
        },
        "additionalProperties": true,
        "required": [
          "data"
        ],
        "description": "Planly response envelope."
      }
