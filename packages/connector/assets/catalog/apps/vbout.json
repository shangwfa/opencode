    {
      "id": "vbout.create_contact",
      "service": "vbout",
      "name": "create_contact",
      "description": "Create a contact in a VBOUT email marketing list.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "listId": {
            "type": "integer",
            "minimum": 1,
            "description": "The numeric VBOUT email list identifier."
          },
          "email": {
            "type": "string",
            "description": "The contact email address.",
            "format": "email"
          },
          "status": {
            "type": "string",
            "enum": [
              "Active",
              "Disactive"
            ],
            "description": "The VBOUT contact subscription status."
          },
          "ipAddress": {
            "type": "string",
            "minLength": 1,
            "description": "The contact IP address recorded by VBOUT."
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "description": "The value assigned to this custom contact field."
            },
            "description": "Custom VBOUT list fields keyed by their numeric field identifiers."
          }
        },
        "additionalProperties": false,
        "required": [
          "listId",
          "status"
        ],
        "description": "The new contact input."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "minLength": 1,
            "description": "VBOUT response status, normally ok for successful requests."
          },
          "data": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "Creation result data."
          },
          "rateLimit": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "string",
                "description": "Maximum requests allowed in the current window."
              },
              "requests": {
                "type": "string",
                "description": "Requests already made in the current window."
              },
              "remaining": {
                "type": "string",
                "description": "Requests remaining in the current window."
              },
              "reached": {
                "type": "string",
                "description": "Whether the current request reached the rate limit."
              },
              "reset": {
                "type": "string",
                "description": "Unix timestamp when the current rate-limit window resets."
              },
              "after": {
                "type": "string",
                "description": "Seconds to wait before retrying after reaching the limit."
              }
            },
            "additionalProperties": true,
            "description": "Rate-limit details returned by VBOUT."
          }
        },
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "description": "The VBOUT contact creation response."
      }
    },
