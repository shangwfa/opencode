            "description": "The lowercase ISO 3166-1 alpha-2 country code for the capture exit IP."
          },
          "delay": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30,
            "description": "The seconds to wait after page load before capture."
          },
          "timeout": {
            "type": "integer",
            "minimum": 5,
            "maximum": 60,
            "description": "The navigation timeout in seconds."
          },
          "waitUntil": {
            "type": "string",
            "enum": [
              "load",
              "domcontentloaded",
              "networkidle0",
              "networkidle2"
            ],
            "description": "The browser lifecycle event to wait for before capture."
          },
          "blockCookieBanners": {
            "type": "boolean",
            "description": "Whether to attempt to hide cookie-consent banners."
          },
          "blockAds": {
            "type": "boolean",
            "description": "Whether to attempt to block advertisements."
          },
          "blockChats": {
            "type": "boolean",
            "description": "Whether to attempt to hide chat widgets."
          },
          "hideSelectors": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 255,
              "description": "A CSS selector to hide."
            },
            "description": "The CSS selectors of elements to hide before capture."
          },
          "styles": {
            "type": "string",
            "maxLength": 10000,
            "description": "The custom CSS to inject before capture."
          },
          "attachmentName": {
            "type": "string",
            "maxLength": 255,
            "description": "The output filename without an extension."
          }
        },
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "description": "The input payload for capturing a webpage with screenshotbase."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "The public URL of the generated screenshot.",
            "format": "uri"
          }
        },
        "additionalProperties": false,
        "description": "The hosted screenshot response."
      }
    }
