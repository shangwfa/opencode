{
  "service": "screenshotbase",
  "displayName": "screenshotbase",
  "categories": [
    "Developer Tools",
    "Design & Media"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "SCREENSHOTBASE_API_KEY",
      "description": "screenshotbase API key."
    }
  ],
  "homepageUrl": "https://screenshotbase.com",
  "actions": [
    {
      "id": "screenshotbase.get_quota_status",
      "service": "screenshotbase",
      "name": "get_quota_status",
      "description": "Retrieve the current monthly and grace quota usage for screenshotbase.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "description": "The input payload for retrieving screenshotbase quota status."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "accountId": {
            "anyOf": [
              {
                "type": "integer",
                "description": "The screenshotbase account identifier when returned."
              },
              {
                "type": "null"
              }
            ],
            "description": "The screenshotbase account identifier when returned."
          },
          "month": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "description": "The total requests available in this quota bucket."
              },
              "used": {
                "type": "integer",
                "description": "The requests already used in this quota bucket."
              },
              "remaining": {
                "type": "integer",
                "description": "The requests remaining in this quota bucket."
              }
            },
            "additionalProperties": false,
            "description": "One screenshotbase quota bucket."
          },
          "grace": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "total": {
                    "type": "integer",
                    "description": "The total requests available in this quota bucket."
                  },
                  "used": {
                    "type": "integer",
                    "description": "The requests already used in this quota bucket."
                  },
                  "remaining": {
                    "type": "integer",
                    "description": "The requests remaining in this quota bucket."
                  }
                },
                "additionalProperties": false,
                "description": "The grace quota bucket when available for the account."
              },
              {
                "type": "null"
              }
            ],
            "description": "The grace quota bucket when available for the account."
          }
        },
        "additionalProperties": false,
        "description": "The screenshotbase account quota status."
      }
    },
    {
      "id": "screenshotbase.take_screenshot",
      "service": "screenshotbase",
      "name": "take_screenshot",
      "description": "Capture a webpage with screenshotbase and return a hosted screenshot URL.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "The complete HTTP or HTTPS webpage URL to capture.",
            "format": "uri"
          },
          "format": {
            "type": "string",
            "enum": [
              "jpg",
              "jpeg",
              "png",
              "gif",
              "webp"
            ],
            "description": "The image format for the hosted screenshot."
          },
          "quality": {
            "type": "integer",
            "description": "The image quality to use when the format is jpg."
          },
          "fullPage": {
            "type": "boolean",
            "description": "Whether to capture the full scrollable page."
          },
          "viewportWidth": {
            "type": "integer",
            "description": "The browser viewport width in pixels."
          },
          "viewportHeight": {
            "type": "integer",
            "description": "The browser viewport height in pixels."
          },
          "deviceScaleFactor": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 3,
            "description": "The browser device pixel ratio."
          },
