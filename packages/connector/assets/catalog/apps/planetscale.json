  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "Service Token",
      "placeholder": "PLANETSCALE_SERVICE_TOKEN",
      "description": "PlanetScale service token. Create one under Organization Settings > Service tokens: https://planetscale.com/docs/api/reference/service-tokens",
      "extraFields": [
        {
          "key": "serviceTokenId",
          "label": "Service Token ID",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "PLANETSCALE_SERVICE_TOKEN_ID",
          "description": "ID generated with the PlanetScale service token."
        }
      ]
    }
  ],
  "homepageUrl": "https://planetscale.com",
  "actions": [
    {
      "id": "planetscale.create_branch",
      "service": "planetscale",
      "name": "create_branch",
      "description": "Create a branch in a PlanetScale database.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "organization": {
            "type": "string",
            "minLength": 1,
            "description": "PlanetScale organization name slug."
          },
          "database": {
            "type": "string",
            "minLength": 1,
            "description": "PlanetScale database name slug."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "PlanetScale branch name."
          },
          "parentBranch": {
            "type": "string",
            "minLength": 1,
            "description": "Parent branch name; the database default is used when omitted."
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "description": "Region slug; the database default is used when omitted."
          },
          "deletionProtected": {
            "type": "boolean",
            "description": "Whether deletion protection is enabled for the new branch."
          }
        },
        "additionalProperties": false,
        "required": [
          "organization",
          "database",
          "name"
        ],
        "description": "Input for creating a PlanetScale branch."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Branch ID."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Branch name."
          },
          "ready": {
            "type": "boolean",
            "description": "Whether the branch is ready to serve queries."
          },
          "production": {
            "type": "boolean",
            "description": "Whether this is a production branch."
          }
        },
        "additionalProperties": true,
        "required": [
          "id",
          "name",
          "ready",
          "production"
        ],
        "description": "A PlanetScale database branch."
      }
    },
    {
      "id": "planetscale.create_database",
      "service": "planetscale",
      "name": "create_database",
      "description": "Create a MySQL or PostgreSQL database in a PlanetScale organization.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "organization": {
            "type": "string",
            "minLength": 1,
            "description": "PlanetScale organization name slug."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "PlanetScale database name slug."
          },
          "kind": {
            "type": "string",
            "enum": [
              "mysql",
              "postgresql"
            ],
            "description": "Database engine kind."
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "description": "Region slug; PlanetScale uses the organization default when omitted."
          },
          "clusterSize": {
            "type": "string",
            "minLength": 1,
            "description": "PlanetScale cluster size name, such as PS_10."
          },
          "replicas": {
            "anyOf": [
              {
                "const": 0,
                "type": "number",
                "description": "No replicas for a non-HA database."
              },
              {
                "type": "integer",
                "minimum": 2,
                "description": "Replica count for an HA database."
              }
            ],
            "description": "Number of replicas; use 0 for non-HA or 2 or more for HA."
          },
          "majorVersion": {
            "type": "string",
            "minLength": 1,
            "description": "PostgreSQL major version; ignored for MySQL databases."
          }
        },
        "additionalProperties": false,
        "required": [
          "organization",
          "name",
          "clusterSize"
        ],
        "description": "Input for creating a PlanetScale database."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Database ID."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Database name."
          },
          "ready": {
            "type": "boolean",
            "description": "Whether the database is ready for use."
          },
          "default_branch": {
            "type": "string",
            "minLength": 1,
            "description": "Default branch name."
          }
        },
        "additionalProperties": true,
        "required": [
          "id",
          "name",
          "ready",
          "default_branch"
        ],
        "description": "A PlanetScale database."
      }
    },
    {
