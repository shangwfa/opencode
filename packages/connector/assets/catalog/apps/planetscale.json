            "type": "string",
            "minLength": 1,
            "description": "PlanetScale branch name."
          },
          "deleteDescendants": {
            "type": "boolean",
            "description": "Whether to recursively delete descendant branches."
          }
        },
        "additionalProperties": false,
        "required": [
          "organization",
          "database",
          "branch"
        ],
        "description": "Input for deleting a PlanetScale branch."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean",
