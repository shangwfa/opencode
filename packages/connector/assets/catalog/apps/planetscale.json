          "next_page": {
            "anyOf": [
              {
                "type": "integer",
                "description": "Next page number, or null on the last page."
              },
              {
                "type": "null"
              }
            ],
            "description": "Next page number, or null on the last page."
          },
          "total_count": {
            "type": "integer",
            "description": "Total number of matching resources."
          },
          "total_pages": {
            "type": "integer",
            "description": "Total number of pages."
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Branch ID."
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Branch name."
                },
                "ready": {
                  "type": "boolean",
                  "description": "Whether the branch is ready to serve queries."
