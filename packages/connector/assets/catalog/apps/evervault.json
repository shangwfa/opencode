{
  "service": "evervault",
  "displayName": "Evervault",
  "categories": [
    "Developer Tools",
    "Security"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "api_key_...",
      "description": "Evervault API key from App Settings > API Keys: https://app.evervault.com",
      "extraFields": [
        {
          "key": "appId",
          "label": "App ID",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "app_...",
          "description": "Evervault App ID from the Evervault dashboard."
        }
      ]
    }
  ],
  "homepageUrl": "https://evervault.com",
  "actions": [
    {
      "id": "evervault.decrypt_json",
      "service": "evervault",
      "name": "decrypt_json",
      "description": "Decrypt an Evervault-encrypted JSON-compatible value.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "value": {
            "description": "A JSON-compatible value, including objects, arrays, scalars, or null."
          }
        },
        "additionalProperties": false,
        "description": "The Evervault-encrypted JSON value to decrypt."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "value": {
            "description": "A JSON-compatible value, including objects, arrays, scalars, or null."
          }
        },
        "additionalProperties": false,
        "description": "The decrypted JSON value returned by Evervault."
      }
    },
    {
      "id": "evervault.encrypt_json",
      "service": "evervault",
      "name": "encrypt_json",
      "description": "Encrypt a JSON-compatible value with the configured Evervault app.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "value": {
            "description": "A JSON-compatible value, including objects, arrays, scalars, or null."
          }
        },
        "additionalProperties": false,
        "description": "The JSON value to encrypt."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "value": {
            "description": "A JSON-compatible value, including objects, arrays, scalars, or null."
          }
        },
        "additionalProperties": false,
        "description": "The encrypted JSON value returned by Evervault."
      }
    },
    {
      "id": "evervault.inspect_token",
      "service": "evervault",
      "name": "inspect_token",
      "description": "Inspect metadata for an Evervault-encrypted token without decrypting it.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "description": "The Evervault-encrypted token to inspect."
          }
        },
        "additionalProperties": false,
        "description": "The encrypted token to inspect."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "integer",
              "float",
              "boolean",
              "string"
            ],
            "description": "The JSON data type stored in the encrypted token."
          },
          "category": {
            "type": "string",
            "description": "The category assigned to the encrypted value."
          },
          "encryptedAt": {
            "type": "integer",
            "description": "The encryption time as a Unix timestamp in milliseconds."
          },
          "role": {
            "type": "string",
            "description": "The data role assigned to the encrypted value."
          },
          "fingerprint": {
            "type": "string",
            "description": "The stable fingerprint of the encrypted value."
          },
          "metadata": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "Additional category-specific encrypted-value metadata."
          }
        },
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "description": "Metadata describing the encrypted token."
      }
    }
  ]
}
