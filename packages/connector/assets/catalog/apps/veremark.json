                "additionalProperties": true,
                "description": "The raw request returned by Veremark."
              }
            },
            "additionalProperties": false,
            "description": "A normalized Veremark background-check request."
          }
        },
        "additionalProperties": false,
        "description": "The requested Veremark background-check request."
      }
    },
