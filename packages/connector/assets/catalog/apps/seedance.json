    {
      "id": "seedance.submit_video_generation",
      "service": "seedance",
      "name": "submit_video_generation",
      "description": "Submit an asynchronous Seedance video generation task through Seedance.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "description": "The Seedance Model ID or Endpoint ID used for Seedance video generation.",
            "default": "doubao-seedance-2-0-260128",
            "examples": [
              "doubao-seedance-2-0-260128"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "The video generation prompt."
          },
          "omniReferenceTaskType": {
            "type": "string",
            "enum": [
              "auto",
              "reference",
              "edit",
              "extend"
            ],
            "description": "Guide Seedance 2.5 when classifying an all-modal reference task."
          },
          "outputFormat": {
            "type": "string",
            "enum": [
              "mp4",
              "mov"
            ],
            "description": "The generated video file format."
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A public image URL, data URL, or Volcengine asset identifier."
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "first_frame",
                    "last_frame",
                    "reference_image"
                  ],
                  "description": "How Seedance uses this image."
                }
              },
              "additionalProperties": false,
              "required": [
                "url"
              ],
              "description": "An image input for Seedance."
            },
            "description": "Image inputs for Seedance."
          },
          "videos": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A public video URL or Volcengine asset identifier."
                },
                "role": {
                  "const": "reference_video",
                  "type": "string",
                  "description": "Use the video as a Seedance reference video."
                }
              },
              "additionalProperties": false,
              "required": [
                "url"
              ],
              "description": "A reference video input for Seedance."
            },
            "description": "Reference video inputs for Seedance."
          },
          "audios": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A public audio URL, data URL, or Volcengine asset identifier."
                },
                "role": {
                  "const": "reference_audio",
                  "type": "string",
                  "description": "Use the audio as a Seedance reference audio."
                }
              },
              "additionalProperties": false,
              "required": [
                "url"
              ],
