      "id": "seedance.delete_video_generation",
      "service": "seedance",
      "name": "delete_video_generation",
      "description": "Cancel a queued Seedance task or delete a task according to Seedance task-state semantics.",
      "operationType": "destructive",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1,
            "description": "The opaque Seedance task identifier returned by the selected connection."
          }
        },
        "additionalProperties": false,
        "required": [
          "taskId"
        ],
        "description": "A Seedance task cancellation or deletion."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1,
            "description": "The opaque Seedance task identifier returned by the selected connection."
          },
          "accepted": {
            "type": "boolean",
            "description": "Whether Seedance accepted the cancellation or deletion."
          }
        },
        "additionalProperties": false,
        "required": [
          "taskId",
          "accepted"
        ],
        "description": "The Seedance cancellation or deletion result."
      }
