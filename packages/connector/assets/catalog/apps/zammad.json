  "auth": [
    {
      "type": "api_key",
      "label": "Access Token",
      "placeholder": "Your Zammad access token",
      "description": "Create a token in your Zammad user profile under Token Access: https://user-docs.zammad.org/en/latest/extras/user-menu-profile-settings.html#token-access.",
      "extraFields": [
        {
          "key": "baseUrl",
          "label": "Zammad Base URL",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "https://support.example.com"
        }
      ]
    }
  ],
  "homepageUrl": "https://zammad.com/en",
  "actions": [
    {
      "id": "zammad.create_ticket",
      "service": "zammad",
      "name": "create_ticket",
      "description": "Create a Zammad ticket with its initial text article.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "description": "The ticket title."
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "description": "The target group name."
          },
          "customer": {
            "type": "string",
            "minLength": 1,
            "description": "The customer login or email address."
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "description": "The initial article body."
          },
          "articleType": {
            "type": "string",
            "enum": [
              "note",
              "email",
              "phone"
            ],
            "description": "The initial article type."
          },
          "contentType": {
            "type": "string",
            "enum": [
              "text/plain",
              "text/html"
            ],
            "description": "The initial article content type."
          },
          "internal": {
            "type": "boolean",
            "description": "Whether the initial article is internal."
          },
          "subject": {
            "type": "string",
            "description": "The initial article subject."
          },
          "sender": {
            "type": "string",
            "enum": [
              "Agent",
              "Customer",
              "System"
            ],
            "description": "The initial article sender role."
          },
          "priority": {
            "type": "string",
            "description": "The ticket priority name."
          },
          "state": {
            "type": "string",
            "description": "The ticket state name."
          }
        },
        "additionalProperties": false,
        "required": [
          "title",
          "group",
          "customer",
          "body"
        ],
        "description": "The input for creating a Zammad ticket."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ticket": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "description": "The numeric Zammad resource ID."
              },
              "number": {
                "type": "string",
                "description": "The human-readable ticket number."
              },
              "title": {
                "type": "string",
                "description": "The ticket title."
              },
              "group_id": {
                "type": "integer",
                "description": "The assigned group ID."
              },
              "customer_id": {
                "type": "integer",
                "description": "The customer user ID."
              },
              "state_id": {
                "type": "integer",
                "description": "The ticket state ID."
              },
              "priority_id": {
                "type": "integer",
                "description": "The ticket priority ID."
              }
            },
            "additionalProperties": true,
            "description": "A Zammad ticket object."
          }
        },
        "additionalProperties": false,
        "description": "The created Zammad ticket response."
      }
    },
