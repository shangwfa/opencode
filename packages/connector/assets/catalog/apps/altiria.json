    {
      "id": "altiria.send_sms",
      "service": "altiria",
      "name": "send_sms",
      "description": "Send an SMS message through Altiria's REST SMS endpoint.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "to": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "One recipient mobile phone number."
            },
            "description": "Recipient mobile phone numbers with international prefix.",
            "minItems": 1
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "description": "SMS sender value registered or allowed in Altiria."
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "SMS body text to send."
          },
          "notificationUrl": {
            "anyOf": [
              {
                "type": "string",
                "description": "One delivery notification URL.",
                "format": "uri"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "One delivery URL.",
                  "format": "uri"
                },
                "description": "Delivery notification URLs by recipient.",
                "minItems": 1
              }
            ],
            "description": "Delivery notification URL, either shared by all recipients or one URL per recipient."
          },
          "campaignName": {
            "type": "string",
            "minLength": 1,
            "description": "Optional campaign name used in Altiria statistics."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "One tag."
            },
            "description": "Campaign tags to attach to the send.",
            "minItems": 1
          },
          "certified": {
            "type": "boolean",
            "description": "Whether to send the message as certified SMS."
          },
          "splitParts": {
            "type": "boolean",
            "description": "Whether Altiria should split long SMS messages into SMS parts."
          },
          "flash": {
            "type": "boolean",
            "description": "Whether to send the message as a Flash SMS."
          },
          "sub": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {
                "description": "Variable value."
              },
              "description": "Substitution variables for one recipient."
            },
            "description": "Substitution variable objects, one per recipient.",
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "to",
          "from",
          "message"
        ],
        "description": "The input payload for sending an Altiria SMS message."
