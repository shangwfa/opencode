{
  "service": "altiria",
  "displayName": "Altiria",
  "categories": [
    "Communication",
    "Marketing"
  ],
  "authTypes": [
    "custom_credential"
  ],
  "auth": [
    {
      "type": "custom_credential",
      "fields": [
        {
          "key": "username",
          "label": "Username",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "ALTIRIA_USERNAME",
          "description": "Altiria API username used as the Basic Auth username. Use the username for the Altiria platform account: https://www.altiria.com."
        },
        {
          "key": "apiPassword",
          "label": "API Password",
          "inputType": "password",
          "required": true,
          "secret": true,
          "placeholder": "ALTIRIA_API_PASSWORD",
          "description": "Altiria API password used as the Basic Auth password. It is different from the platform login password; get it from the APIs > Change API password menu in the Altiria platform, as described in https://apidocs.altiria.com/."
        },
        {
          "key": "dashboardHost",
          "label": "Dashboard Host",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "https://www.altiria.net",
          "description": "Altiria dashboard host used before /api/rest in API requests. Copy the HTTPS host from your Altiria platform URL; the REST docs show it as DASHBOARD_HOST: https://apidocs.altiria.com/."
        }
      ],
      "testAction": {
        "actionName": "list_groups",
        "input": {
          "limit": 1
        }
      }
    }
  ],
  "homepageUrl": "https://www.altiria.com",
  "actions": [
    {
      "id": "altiria.create_contact",
      "service": "altiria",
      "name": "create_contact",
      "description": "Create a new Altiria contact.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Contact email address.",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "minLength": 1,
            "description": "Contact mobile phone number with international prefix."
          },
          "landline": {
            "type": "string",
            "minLength": 1,
            "description": "Contact landline phone number."
          },
          "countryIso": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "description": "Two-letter country code required when phone or landline is specified."
          },
          "groupsIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "description": "One Altiria group ID."
            },
            "description": "Contact group IDs to attach this contact to.",
            "minItems": 1
          },
          "groupsNames": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "One Altiria group name."
            },
            "description": "Contact group names to attach this contact to.",
            "minItems": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Contact first name."
          },
          "surname": {
            "type": "string",
            "minLength": 1,
            "description": "Contact surname."
          },
          "customFields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Custom field name."
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "date",
                    "decimal"
                  ],
                  "description": "Custom field type."
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Custom field value."
                }
              },
              "additionalProperties": false,
              "required": [
                "key",
                "value"
              ],
              "description": "One Altiria contact custom field value."
            },
            "description": "Custom fields to set on this contact.",
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "description": "The input payload for creating an Altiria contact."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "contact": {
            "type": "object",
            "properties": {
              "id": {
                "anyOf": [
                  {
                    "type": "integer",
                    "description": "Altiria contact identifier."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Altiria contact identifier."
              },
              "email": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Contact email address."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Contact email address."
              },
              "phone": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Contact mobile phone number."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Contact mobile phone number."
              },
              "landline": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Contact landline phone number."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Contact landline phone number."
              },
              "countryIso": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Two-letter contact country code."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Two-letter contact country code."
              },
              "name": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Contact first name."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Contact first name."
              },
              "surname": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Contact surname."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Contact surname."
              },
              "createdAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Contact creation timestamp returned by Altiria."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Contact creation timestamp returned by Altiria."
              },
              "updatedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Contact update timestamp returned by Altiria."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Contact update timestamp returned by Altiria."
              },
              "raw": {
                "type": "object",
                "properties": {},
                "additionalProperties": true,
                "description": "Raw Altiria contact object."
              }
            },
            "additionalProperties": true,
            "description": "One normalized Altiria contact."
          },
          "raw": {
            "description": "Raw Altiria response payload."
          }
        },
        "additionalProperties": false,
        "required": [
          "contact",
          "raw"
        ],
        "description": "Contact created by Altiria."
      }
