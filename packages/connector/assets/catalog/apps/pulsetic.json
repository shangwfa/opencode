      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "monitorId": {
            "type": "integer",
            "minimum": 1,
            "description": "The unique Pulsetic monitor ID."
          },
          "seconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "The lookback window in seconds used to calculate downtime."
