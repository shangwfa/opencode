{
  "service": "tick",
  "displayName": "Tick",
  "categories": [
    "Productivity"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Token",
      "placeholder": "TICK_API_TOKEN",
      "description": "Tick API token assigned to your subscription role. Retrieve it through the official roles endpoint: https://github.com/tick/tick-api/blob/master/sections/roles.md",
      "extraFields": [
        {
          "key": "subscriptionId",
          "label": "Subscription ID",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "123456",
          "description": "Numeric Tick subscription ID returned with the API token."
        },
        {
          "key": "email",
          "label": "Contact Email",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "you@example.com",
          "description": "Contact email included in the User-Agent header as required by the Tick API."
        }
      ]
    }
  ],
  "homepageUrl": "https://www.tickspot.com",
  "actions": [
    {
      "id": "tick.create_entry",
      "service": "tick",
      "name": "create_entry",
      "description": "Create a Tick time entry.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "The work date in YYYY-MM-DD format.",
            "format": "date"
          },
          "hours": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "The positive number of hours to record."
          },
          "taskId": {
            "type": "integer",
            "minimum": 1,
            "description": "The task receiving the time entry."
          },
          "notes": {
            "type": "string",
            "description": "Notes to record with the time entry."
          },
          "userId": {
            "type": "integer",
            "minimum": 1,
            "description": "The user receiving the entry; ignored for non-administrators."
          }
        },
        "additionalProperties": false,
        "required": [
          "date",
          "hours",
          "taskId"
        ],
        "description": "The new time entry fields."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "entry": {
            "type": "object",
            "properties": {
              "id": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "The entry ID as text."
                  },
                  {
                    "type": "integer",
                    "minimum": 1,
                    "description": "The numeric entry ID."
                  }
                ],
                "description": "The time entry ID."
              },
              "date": {
                "type": "string",
                "description": "The work date in YYYY-MM-DD format."
              },
              "hours": {
                "type": "number",
                "description": "The number of hours recorded."
              },
              "notes": {
                "type": "string",
                "description": "Notes recorded with the time entry."
              },
              "task_id": {
                "type": "integer",
                "minimum": 1,
                "description": "The associated task ID."
              },
              "user_id": {
                "type": "integer",
                "minimum": 1,
                "description": "The associated user ID."
              },
              "billed": {
                "type": "boolean",
                "description": "Whether the time entry has been billed."
              },
              "url": {
                "type": "string",
                "description": "The API URL for the time entry."
              },
              "created_at": {
                "type": "string",
                "description": "When the time entry was created."
              },
              "updated_at": {
                "type": "string",
                "description": "When the time entry was last updated."
              }
            },
            "additionalProperties": true,
            "description": "A Tick time entry."
          }
        },
        "additionalProperties": false,
        "description": "The created Tick time entry response."
      }
    },
    {
