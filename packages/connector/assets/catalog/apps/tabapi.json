    {
      "id": "tabapi.find_adsense_publisher_sites",
      "service": "tabapi",
      "name": "find_adsense_publisher_sites",
      "description": "Find domains associated with an AdSense publisher ID.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "pub_id": {
            "type": "string",
            "description": "The 16-digit AdSense publisher ID, with or without pub-.",
            "pattern": "^(?:pub-)?\\d{16}$"
          }
        },
        "additionalProperties": false,
        "required": [
          "pub_id"
        ],
        "description": "Input for reverse AdSense lookup."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "publisher_id": {
            "type": "string",
            "description": "The normalized AdSense publisher ID."
          },
          "total_sites": {
            "type": "integer",
            "description": "The reported number of matches."
          },
          "sites": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Matching domains."
          }
        },
        "additionalProperties": true,
        "required": [
          "publisher_id",
          "total_sites",
          "sites"
        ],
        "description": "The reverse AdSense result."
      }
    },
    {
      "id": "tabapi.get_dns_records",
      "service": "tabapi",
      "name": "get_dns_records",
      "description": "Get DNS records for a domain.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1,
            "description": "The domain name to inspect, without a URL path."
          },
          "type": {
            "type": "string",
            "enum": [
              "A",
              "AAAA",
              "CNAME",
              "MX",
              "NS",
              "TXT",
              "all"
            ],
            "description": "The DNS record type, or ALL for every supported type."
          }
        },
        "additionalProperties": false,
        "required": [
          "domain"
        ],
        "description": "Input for retrieving DNS records."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "description": "The queried hostname."
          },
          "status": {
            "type": "string",
            "description": "The DNS response code name."
          },
          "resolver": {
            "type": "string",
            "description": "The selected DNS resolver."
          },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "One DNS resource record."
            },
            "description": "Returned DNS records."
          }
        },
        "additionalProperties": true,
        "required": [
          "domain",
          "status",
          "resolver",
          "records"
        ],
        "description": "The DNS response."
      }
    },
