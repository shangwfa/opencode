      "id": "tabapi.google_search",
      "service": "tabapi",
      "name": "google_search",
      "description": "Search Google and return normalized result data.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1,
            "description": "The Google search query."
          },
          "country": {
            "type": "string",
            "description": "The two-letter lowercase country code.",
            "pattern": "^[a-z]{2}$"
          },
          "language": {
            "type": "string",
            "description": "The lowercase language code.",
            "pattern": "^[a-z]{2,3}(-[a-z0-9]{2,8})*$"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "The one-based result page."
          }
        },
        "additionalProperties": false,
        "required": [
          "q"
        ],
        "description": "Input for Google Search."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "search_parameters": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
