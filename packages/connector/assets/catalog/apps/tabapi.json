  "homepageUrl": "https://tabapi.com",
  "actions": [
    {
      "id": "tabapi.capture_url_screenshot",
      "service": "tabapi",
      "name": "capture_url_screenshot",
      "description": "Capture the first viewport of a public URL and return a hosted PNG URL.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "The public HTTP or HTTPS page URL that TabAPI should capture.",
            "format": "uri",
            "pattern": "^https?://"
          },
          "options": {
            "type": "object",
            "properties": {
              "viewport": {
                "type": "object",
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 320,
                    "maximum": 2560,
                    "description": "The viewport width in pixels."
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 240,
                    "maximum": 2160,
                    "description": "The viewport height in pixels."
                  }
                },
                "additionalProperties": false,
                "description": "The first-viewport dimensions."
              }
            },
            "additionalProperties": false,
            "description": "Screenshot rendering settings."
          }
        },
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "description": "Input for capturing a URL screenshot."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "Source URL resolution details."
          },
          "page": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "Extracted page metadata."
          },
          "output": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The screenshot output."
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "One warning."
            },
            "description": "Non-fatal warnings."
          }
        },
        "additionalProperties": true,
        "required": [
          "source",
          "page",
          "output",
          "warnings"
        ],
        "description": "The normalized screenshot result."
      }
    },
