    {
      "id": "chuhaijiang.get_product",
      "service": "chuhaijiang",
      "name": "get_product",
      "description": "Retrieve a TikTok Shop product from Chuhaijiang with product, shop, pricing, sales, and category details.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "minLength": 1,
            "description": "The TikTok product ID returned by Chuhaijiang."
          },
          "country": {
            "type": "string",
            "enum": [
              "br",
              "de",
              "es",
              "fr",
              "gb",
              "id",
              "it",
              "jp",
              "mx",
              "my",
              "ph",
              "sg",
              "th",
              "us",
              "vn"
            ],
            "description": "TikTok Shop market country code."
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "channel",
                "core"
              ],
              "description": "A related product-detail section."
            },
            "description": "Optional related sections to include in the product detail.",
            "maxItems": 2
          }
        },
        "additionalProperties": false,
        "required": [
          "product_id",
          "country"
        ],
        "description": "Input for retrieving one TikTok Shop product from Chuhaijiang."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "product": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The TikTok product record, including documented product, shop, pricing, sales, and category fields."
          },
          "requestId": {
            "type": "string",
            "description": "Chuhaijiang request identifier used for support and tracing."
          },
          "usage": {
            "type": "object",
            "properties": {
              "creditsCost": {
                "type": "integer",
                "description": "Credits consumed by this request."
              },
              "creditsBalance": {
                "type": "integer",
                "description": "Credits remaining after this request."
              }
            },
            "additionalProperties": false,
            "description": "Credits consumed and remaining after the request."
          }
        },
        "additionalProperties": false,
        "required": [
          "product",
          "requestId"
        ],
        "description": "A normalized TikTok product detail returned by Chuhaijiang."
      }
    },
    {
      "id": "chuhaijiang.list_most_promoted_products",
      "service": "chuhaijiang",
      "name": "list_most_promoted_products",
      "description": "List TikTok Shop products most heavily promoted by creators, videos, and live streams in Chuhaijiang.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "enum": [
              "br",
              "de",
              "es",
              "fr",
              "gb",
              "id",
              "it",
              "jp",
              "mx",
              "my",
              "ph",
              "sg",
              "th",
              "us",
              "vn"
            ],
            "description": "TikTok Shop market country code."
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "description": "TikTok product category ID used to filter the ranking."
          },
          "seller_type": {
            "type": "string",
            "enum": [
              "1",
              "2",
              "3",
              "4"
            ],
            "description": "Seller type: 1 for overseas, 2 for local, 3 for brand, or 4 for non-brand."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "One-based page number."
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "Number of ranking results per page, up to 20."
          },
          "date": {
            "type": "string",
            "description": "Statistics date in YYYYMMDD format.",
            "pattern": "^[0-9]{8}$"
          },
          "granularity": {
            "type": "string",
            "enum": [
              "daily",
              "weekly",
              "monthly"
            ],
            "description": "Statistics period used by the ranking."
          },
          "sort_field": {
            "type": "string",
            "enum": [
              "interval_gmv",
              "interval_sold_count",
              "live_count",
              "live_user_count",
              "related_creator_count",
              "video_play_count"
            ],
            "description": "Product field used to sort the promotion ranking."
          },
          "sort_direction": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "description": "Direction used to sort the promotion ranking."
          }
        },
        "additionalProperties": false,
        "required": [
          "country",
          "date",
          "granularity"
        ],
        "description": "Market, period, filters, sorting, and pagination for the Chuhaijiang most-promoted product ranking."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A Chuhaijiang record whose documented fields depend on the selected product resource."
            },
            "description": "Records returned by Chuhaijiang for this page."
          },
          "totalCount": {
            "type": "integer",
            "description": "Total number of matching records reported by Chuhaijiang."
          },
          "requestId": {
            "type": "string",
            "description": "Chuhaijiang request identifier used for support and tracing."
          },
          "usage": {
            "type": "object",
            "properties": {
              "creditsCost": {
                "type": "integer",
                "description": "Credits consumed by this request."
              },
              "creditsBalance": {
                "type": "integer",
                "description": "Credits remaining after this request."
              }
            },
            "additionalProperties": false,
            "description": "Credits consumed and remaining after the request."
          }
        },
        "additionalProperties": false,
        "required": [
          "items",
          "totalCount",
          "requestId"
        ],
        "description": "A normalized page of records returned by Chuhaijiang."
      }
    },
