  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "YOUR_API_KEY",
      "description": "LightSpeed VT API key used as the HTTP Basic username. Obtain it from the Integration Panel: https://lightspeedvt.readme.io/reference/authentication-1",
      "extraFields": [
        {
          "key": "apiSecret",
          "label": "API Secret",
          "inputType": "password",
          "required": true,
          "secret": true,
          "placeholder": "YOUR_API_SECRET",
          "description": "LightSpeed VT API password paired with the API key."
        }
      ]
    }
  ],
  "homepageUrl": "https://lightspeedvt.com/",
  "actions": [
    {
      "id": "lightspeed_vt.get_course",
      "service": "lightspeed_vt",
      "name": "get_course",
      "description": "Retrieve one LightSpeed VT course by course identifier.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "courseId": {
            "type": "integer",
            "minimum": 1,
            "description": "The LightSpeed VT course identifier."
          }
        },
        "additionalProperties": false,
        "description": "The course to retrieve."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "course": {
            "type": "object",
            "properties": {
              "courseId": {
                "type": "integer",
                "minimum": 1,
                "description": "The LightSpeed VT course identifier."
              },
              "courseName": {
                "type": "string",
                "description": "The course name."
              },
              "categoryId": {
                "type": "integer",
                "minimum": 1,
                "description": "The course category identifier."
              },
              "categoryName": {
                "type": "string",
                "description": "The course category name."
              }
            },
            "additionalProperties": true,
            "description": "A LightSpeed VT course summary. Additional course fields may be returned."
          }
        },
        "additionalProperties": false,
        "description": "The requested LightSpeed VT course."
      }
    },
