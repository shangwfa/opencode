      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The collection title."
          },
          "view": {
            "type": "string",
            "enum": [
              "list",
              "simple",
              "grid",
              "masonry"
            ],
            "description": "The collection view style."
          },
          "sort": {
            "type": "integer",
            "description": "The descending sort position among sibling collections."
          },
          "public": {
            "type": "boolean",
            "description": "Whether the collection and its bookmarks are publicly accessible."
          },
          "parentId": {
            "type": "integer",
            "description": "The parent collection ID. Omit it for a root collection."
          },
          "cover": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "A collection cover URL.",
              "format": "uri"
            },
