    {
      "id": "textmagic.send_message",
      "service": "textmagic",
      "name": "send_message",
      "description": "Send a plain-text SMS message to up to 1,000 phone numbers through Textmagic.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "The SMS message text."
          },
          "phones": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "One recipient phone number in E.164 format without separators."
            },
            "description": "Recipient phone numbers in E.164 format without separators.",
            "minItems": 1,
            "maxItems": 1000
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "description": "An allowed Textmagic phone number or alphanumeric sender ID."
          },
          "referenceId": {
            "type": "integer",
            "description": "A custom integer reference ID for delivery callbacks."
          },
          "cutExtra": {
            "type": "boolean",
            "description": "Whether Textmagic should truncate text beyond partsCount."
          },
          "partsCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6,
            "description": "The maximum number of SMS message parts."
          },
          "local": {
            "type": "boolean",
            "description": "Whether recipient numbers should be interpreted as local numbers."
          },
          "localCountry": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "description": "The two-letter country code used when local is true."
          }
        },
        "additionalProperties": false,
        "required": [
          "text",
          "phones"
        ],
        "description": "Input for sending a Textmagic SMS message."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The created message, session, schedule, or bulk ID."
          },
          "href": {
            "type": "string",
            "description": "The relative URI of the created Textmagic resource."
          },
          "type": {
            "type": "string",
            "enum": [
              "message",
              "session",
              "schedule",
              "bulk"
            ],
            "description": "The kind of Textmagic resource created for the submission."
          },
          "sessionId": {
            "anyOf": [
              {
                "type": "integer",
                "description": "The message session ID when one was created."
              },
              {
                "type": "null"
              }
            ],
            "description": "The message session ID when one was created."
          },
          "bulkId": {
            "anyOf": [
              {
                "type": "integer",
                "description": "The bulk session ID when asynchronous processing was required."
              },
              {
                "type": "null"
              }
            ],
            "description": "The bulk session ID when asynchronous processing was required."
          },
          "messageId": {
            "anyOf": [
              {
                "type": "integer",
                "description": "The message ID for a single-recipient submission."
              },
              {
                "type": "null"
              }
            ],
            "description": "The message ID for a single-recipient submission."
          },
          "scheduleId": {
            "anyOf": [
              {
                "type": "integer",
                "description": "The schedule ID when a scheduled message was created."
              },
              {
                "type": "null"
              }
            ],
            "description": "The schedule ID when a scheduled message was created."
          },
          "chatId": {
            "anyOf": [
              {
                "type": "integer",
                "description": "The chat ID when a chat was created."
              },
              {
                "type": "null"
              }
            ],
            "description": "The chat ID when a chat was created."
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "href",
          "type",
          "sessionId",
          "bulkId",
          "messageId",
          "scheduleId",
          "chatId"
        ],
        "description": "The Textmagic message submission result."
      }
