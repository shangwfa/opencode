    {
      "id": "textmagic.create_list",
      "service": "textmagic",
      "name": "create_list",
      "description": "Create a contact list in Textmagic.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The contact-list name."
          },
          "shared": {
            "type": "boolean",
            "description": "Whether subaccounts can access the new list."
          },
          "favorited": {
            "type": "boolean",
            "description": "Whether the new list should be favorited."
          },
          "isDefault": {
            "type": "boolean",
            "description": "Whether new web contacts should use this list by default."
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "description": "Input for creating a Textmagic contact list."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The created Textmagic list ID."
          },
          "href": {
            "type": "string",
            "description": "The relative URI of the created Textmagic list."
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "href"
        ],
        "description": "The created Textmagic contact-list link."
      }
    },
