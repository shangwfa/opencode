                      "type": "null"
                    }
                  ],
                  "description": "The custom field value."
                }
              },
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "description": "A Doppler custom field value."
            },
            "description": "Custom field values to set on the subscriber."
          }
        },
        "additionalProperties": false,
        "required": [
          "listId",
          "email"
        ],
        "description": "The subscriber and list association to create."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "The result message returned by Doppler."
          },
          "data": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The raw object returned by Doppler Email Marketing."
          }
        },
        "additionalProperties": false,
        "required": [
          "message",
          "data"
        ],
        "description": "A Doppler operation result."
      }
