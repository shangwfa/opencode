      "id": "doppler_marketing_automation.add_subscriber_to_list",
      "service": "doppler_marketing_automation",
      "name": "add_subscriber_to_list",
      "description": "Create or update a Doppler subscriber and associate the subscriber with a list.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "listId": {
            "type": "integer",
            "minimum": 1,
            "description": "The Doppler subscriber list ID."
          },
          "email": {
            "type": "string",
            "maxLength": 100,
            "description": "The subscriber email address.",
            "format": "email"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
