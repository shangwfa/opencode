{
  "service": "venafitlsprotectdatacenter",
  "displayName": "Venafi TLS Protect Datacenter",
  "categories": [
    "Security",
    "Developer Tools"
  ],
  "authTypes": [
    "custom_credential"
  ],
  "auth": [
    {
      "type": "custom_credential",
      "fields": [
        {
          "key": "domain",
          "label": "Domain",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "https://tpp.example.com",
          "description": "HTTPS origin of your TLS Protect Datacenter instance."
        },
        {
          "key": "clientId",
          "label": "Client ID",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "websdk",
          "description": "Client ID created under API > Integrations in TLS Protect Datacenter: https://docs.venafi.com/Docs/current/TopNav/Content/SDK/WebSDK/t-SDK-UsingOpenAPI.php"
        },
        {
          "key": "username",
          "label": "Username",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "API username",
          "description": "TLS Protect Datacenter username authorized for the API integration."
        },
        {
          "key": "password",
          "label": "Password",
          "inputType": "password",
          "required": true,
          "secret": true,
          "placeholder": "Password",
          "description": "Password for the TLS Protect Datacenter API username."
        }
      ]
    }
  ],
  "homepageUrl": "https://www.cyberark.com/resources/product-datasheets/cyberark-certificate-manager-self-hosted",
  "actions": [
    {
      "id": "venafitlsprotectdatacenter.check_policy",
      "service": "venafitlsprotectdatacenter",
      "name": "check_policy",
      "description": "Check the effective certificate policy for a policy distinguished name.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "policyDn": {
            "type": "string",
            "minLength": 1,
            "description": "The distinguished name of the policy folder."
          }
        },
        "additionalProperties": false,
        "description": "The policy folder to inspect."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "policy": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The effective certificate policy."
          }
        },
        "additionalProperties": false,
        "description": "The effective policy returned by Venafi."
      }
    },
    {
      "id": "venafitlsprotectdatacenter.get_certificate",
      "service": "venafitlsprotectdatacenter",
      "name": "get_certificate",
      "description": "Retrieve a certificate by GUID from Venafi TLS Protect Datacenter.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "certificateId": {
            "type": "string",
            "minLength": 1,
            "description": "The certificate GUID."
          }
        },
        "additionalProperties": false,
        "description": "The certificate to retrieve."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "certificate": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "A certificate returned by Venafi TLS Protect Datacenter."
          }
        },
        "additionalProperties": false,
        "description": "The matching certificate."
      }
    },
    {
      "id": "venafitlsprotectdatacenter.list_certificates",
      "service": "venafitlsprotectdatacenter",
      "name": "list_certificates",
      "description": "List certificates visible to the Venafi TLS Protect Datacenter integration.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Maximum number of certificates to return."
          },
          "next": {
            "type": "string",
            "minLength": 1,
            "description": "The next-page URL returned by a previous list_certificates call."
          }
        },
        "additionalProperties": false,
        "description": "Pagination fields for listing certificates."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "certificates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A certificate returned by Venafi TLS Protect Datacenter."
            },
            "description": "Certificates returned for this page."
          },
          "next": {
            "anyOf": [
              {
                "type": "string",
                "description": "Relative next-page URL returned by Venafi."
              },
              {
                "type": "null"
              }
            ],
            "description": "Relative next-page URL returned by Venafi."
          }
        },
        "additionalProperties": false,
        "description": "A page of certificates and the next page URL when available."
      }
    }
  ]
}
