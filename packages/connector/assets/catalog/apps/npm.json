              },
              "additionalProperties": false,
              "required": [
                "packageName",
                "downloads"
              ],
              "description": "Download totals for one npm package."
            },
            "description": "Download totals in the requested package order."
          }
        },
        "additionalProperties": false,
        "required": [
          "start",
          "end",
          "packages"
        ],
        "description": "Normalized npm package download totals for an inclusive period."
