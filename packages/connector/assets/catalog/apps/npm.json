    {
      "id": "npm.audit_package_versions",
      "service": "npm",
      "name": "audit_package_versions",
      "description": "Get npm security advisories for requested exact package versions.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "packages": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "description": "An exact published package version."
              },
              "description": "Exact published versions to audit for this package.",
              "minItems": 1
            },
            "description": "Package names mapped to exact published versions to audit."
          }
        },
        "additionalProperties": false,
        "required": [
          "packages"
        ],
        "description": "Input for checking exact package versions against npm security advisories."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "summary": {
            "type": "object",
            "properties": {
              "packageCount": {
                "type": "integer",
                "minimum": 0,
                "description": "The number of packages checked."
              },
              "affectedPackageCount": {
                "type": "integer",
                "minimum": 0,
                "description": "The number of packages with advisories."
              },
              "advisoryCount": {
                "type": "integer",
                "minimum": 0,
                "description": "The total number of returned advisories."
              }
            },
            "additionalProperties": false,
            "required": [
              "packageCount",
              "affectedPackageCount",
              "advisoryCount"
            ],
            "description": "Aggregate advisory counts for the audit request."
          },
          "packages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "packageName": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The npm package name, including its scope when present."
                },
                "requestedVersions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "description": "One requested exact version."
                  },
                  "description": "The exact published versions supplied for this package."
                },
                "advisories": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "The numeric npm advisory identifier."
                      },
                      "url": {
                        "type": "string",
                        "description": "The canonical advisory URL.",
                        "format": "uri"
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The advisory title."
                      },
                      "severity": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The severity reported by npm."
                      },
                      "vulnerableVersions": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The affected version range reported by npm."
                      },
                      "cwe": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "description": "One CWE identifier."
                        },
                        "description": "CWE identifiers associated with the advisory."
                      },
                      "cvss": {
                        "type": "object",
                        "properties": {
                          "score": {
                            "type": "number",
                            "description": "The advisory CVSS score."
                          },
                          "vectorString": {
                            "anyOf": [
                              {
                                "type": "string",
                                "description": "The advisory CVSS vector string, or null when npm has not assigned one."
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "description": "The advisory CVSS vector string, or null when npm has not assigned one."
                          }
                        },
                        "additionalProperties": false,
                        "required": [
                          "score",
                          "vectorString"
                        ],
                        "description": "CVSS data reported by the npm advisory service."
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "url",
                      "title",
                      "severity",
                      "vulnerableVersions",
                      "cwe",
                      "cvss"
                    ],
                    "description": "One npm security advisory affecting a requested package."
                  },
                  "description": "Security advisories returned for this package."
                }
              },
              "additionalProperties": false,
              "required": [
                "packageName",
                "requestedVersions",
                "advisories"
              ],
              "description": "Advisories for one requested package."
            },
            "description": "Audit results in the requested package order."
          }
        },
        "additionalProperties": false,
        "required": [
          "summary",
          "packages"
        ],
        "description": "Normalized npm security advisories grouped by requested package."
      }
    },
