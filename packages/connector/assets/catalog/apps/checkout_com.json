              "name": {
                "type": "string",
                "description": "The customer's name."
              },
              "phone": {
                "type": "object",
                "properties": {},
                "additionalProperties": true,
                "description": "The customer's phone number."
              },
              "metadata": {
                "type": "object",
                "properties": {},
                "additionalProperties": true,
                "description": "The metadata attached to the customer."
              },
              "instruments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true,
                  "description": "A linked payment instrument returned by Checkout.com."
                },
                "description": "The payment instruments linked to the customer."
              }
            },
            "additionalProperties": true,
            "required": [
              "id",
              "email"
            ],
            "description": "Customer details returned by Checkout.com."
          }
        },
        "additionalProperties": false,
        "description": "The retrieved Checkout.com customer."
      }
    },
