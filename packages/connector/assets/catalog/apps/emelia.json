    {
      "id": "emelia.get_campaign",
      "service": "emelia",
      "name": "get_campaign",
      "description": "Get details for one Emelia email campaign.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "campaignId": {
            "type": "string",
            "minLength": 1,
            "description": "The Emelia email campaign ID."
          }
        },
        "additionalProperties": false,
        "required": [
          "campaignId"
        ],
        "description": "The input for getting an Emelia email campaign."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "campaign": {
            "type": "object",
            "properties": {
              "_id": {
                "type": "string",
                "description": "The campaign identifier returned by Emelia."
              },
              "id": {
                "type": "string",
                "description": "The campaign identifier returned by Emelia when present."
              },
              "name": {
                "type": "string",
                "description": "The campaign name."
              },
              "status": {
                "type": "string",
                "description": "The campaign status."
              },
              "createdAt": {
                "type": "string",
                "description": "The timestamp when the campaign was created."
              },
              "updatedAt": {
                "type": "string",
                "description": "The timestamp when the campaign was last updated."
              }
            },
            "additionalProperties": true,
            "required": [
              "_id",
              "id",
              "name",
              "status",
              "createdAt",
              "updatedAt"
            ],
            "description": "An Emelia email campaign record."
          }
        },
        "additionalProperties": false,
        "required": [
          "campaign"
        ],
        "description": "The output from getting an Emelia email campaign."
      }
    },
    {
      "id": "emelia.get_campaign_activities",
      "service": "emelia",
      "name": "get_campaign_activities",
      "description": "List activity events for one Emelia email campaign.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "campaignId": {
            "type": "string",
            "minLength": 1,
            "description": "The Emelia email campaign ID."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "The 1-based page number for pagination."
          },
          "type": {
            "type": "string",
            "enum": [
              "SENT",
              "FIRST_OPEN",
              "OPENED",
              "CLICKED",
              "REPLIED",
              "RE_REPLY",
              "BOUNCED",
              "UNSUBSCRIBED"
            ],
            "description": "Filter activities by event type."
          },
          "query": {
            "type": "string",
            "description": "Free-text search across activities."
          },
          "contactId": {
            "type": "string",
            "description": "Filter activities by contact ID."
          },
          "versionId": {
            "type": "string",
            "description": "Filter activities by campaign version ID."
          }
        },
        "additionalProperties": false,
        "required": [
          "campaignId"
        ],
        "description": "The input for listing Emelia campaign activities."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "activities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "campaign": {
                  "type": "string",
                  "description": "The campaign ID associated with the activity."
                },
                "contact": {
                  "type": "string",
                  "description": "The contact ID associated with the activity."
                },
                "event": {
                  "type": "string",
                  "description": "The activity event name."
                },
                "stepId": {
                  "type": "string",
                  "description": "The campaign step ID."
                },
                "versionId": {
                  "type": "string",
                  "description": "The campaign version ID."
                },
                "providerId": {
                  "type": "string",
                  "description": "The email provider ID."
                },
                "customData": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true,
                  "description": "Additional event data returned by Emelia."
                }
              },
              "additionalProperties": true,
              "required": [
                "campaign",
                "contact",
                "event",
                "stepId",
                "versionId",
                "providerId",
                "customData"
              ],
              "description": "An Emelia campaign activity record."
            },
            "description": "The campaign activities returned by Emelia."
          }
        },
        "additionalProperties": false,
        "required": [
          "activities"
        ],
        "description": "The output from listing Emelia campaign activities."
      }
    },
