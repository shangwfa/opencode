    {
      "id": "neetodesk.create_comment",
      "service": "neetodesk",
      "name": "create_comment",
      "description": "Create a reply or private note on a NeetoDesk ticket.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "ticket_id": {
            "type": "string",
            "minLength": 1,
            "description": "The ticket UUID or sequential ticket number."
          },
          "author_email": {
            "type": "string",
            "description": "The email address attributed as the comment author.",
            "format": "email"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "description": "The comment content."
          },
          "author_type": {
            "type": "string",
            "enum": [
              "agent",
              "customer"
            ],
            "description": "The kind of author represented by author_email."
          },
          "comment_type": {
            "type": "string",
            "enum": [
              "reply",
              "note"
            ],
            "description": "Whether to create a public reply or private note."
          },
          "message_id": {
            "type": "string",
            "description": "A caller-supplied idempotency identifier unique per ticket."
          }
        },
        "additionalProperties": false,
        "required": [
          "ticket_id",
          "author_email",
          "content"
