        "type": "object",
        "properties": {
          "comment": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The comment's unique identifier."
              },
              "created_at": {
                "type": "string",
                "description": "The comment creation timestamp.",
                "format": "date-time"
              },
              "comment_type": {
                "type": "string",
                "description": "The comment type, such as reply or note."
              },
              "content": {
                "type": "string",
                "description": "The comment content."
              },
              "author": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "The person's unique identifier."
                  },
                  "name": {
                    "type": "string",
                    "description": "The person's display name."
                  },
                  "email": {
                    "type": "string",
                    "description": "The person's email address."
