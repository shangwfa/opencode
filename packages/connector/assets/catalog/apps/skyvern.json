                "description": "The timestamp when execution finished."
              },
              "recordingUrl": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "The provider-hosted recording URL for the run.",
                    "format": "uri"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The provider-hosted recording URL for the run."
