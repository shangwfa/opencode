              },
              "output": {
                "anyOf": [
                  {
                    "description": "The provider-defined structured or textual run output."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The provider-defined structured or textual run output."
              },
              "failureReason": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "The reason the run failed or terminated."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The reason the run failed or terminated."
              },
              "createdAt": {
                "type": "string",
                "description": "The timestamp when Skyvern created the run.",
                "format": "date-time"
              },
              "modifiedAt": {
                "type": "string",
                "description": "The timestamp when Skyvern last modified the run.",
                "format": "date-time"
              },
              "startedAt": {
