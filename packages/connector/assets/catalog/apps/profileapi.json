{
  "service": "profileapi",
  "displayName": "profileAPI",
  "categories": [
    "Data",
    "Marketing"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "PROFILEAPI_API_KEY",
      "description": "profileAPI key sent as Authorization: ApiKey <key>. Request a key through the official Start Building form."
    }
  ],
  "homepageUrl": "https://profileapi.com",
  "actions": [
    {
      "id": "profileapi.reverse_lookup_email",
      "service": "profileapi",
      "name": "reverse_lookup_email",
      "description": "Resolve a profileAPI person identifier and basic profile link from one email address.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The email address to reverse lookup.",
            "format": "email"
          }
        },
        "additionalProperties": false,
        "description": "The email reverse lookup request."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "The profileAPI person identifier, formatted as a UUID without hyphens."
              },
              "linkedInUrl": {
                "type": "string",
                "description": "The LinkedIn profile URL returned for the matched person.",
                "format": "uri"
              }
            },
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "description": "The person identifiers returned by profileAPI."
          }
        },
        "additionalProperties": false,
        "description": "The profileAPI reverse lookup response."
      }
    },
    {
      "id": "profileapi.reverse_lookup_phone",
      "service": "profileapi",
      "name": "reverse_lookup_phone",
      "description": "Resolve a profileAPI person identifier and basic profile link from one E.164 phone number.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "minLength": 1,
            "description": "The phone number to reverse lookup in E.164 format, including the leading plus sign.",
            "pattern": "^\\+[1-9][0-9]{1,14}$"
          }
        },
        "additionalProperties": false,
        "description": "The phone reverse lookup request."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "The profileAPI person identifier, formatted as a UUID without hyphens."
              },
              "linkedInUrl": {
                "type": "string",
                "description": "The LinkedIn profile URL returned for the matched person.",
                "format": "uri"
              }
            },
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "description": "The person identifiers returned by profileAPI."
          }
        },
        "additionalProperties": false,
        "description": "The profileAPI reverse lookup response."
      }
    }
  ]
}
