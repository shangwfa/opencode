                },
                "price": {
                  "type": "string",
                  "description": "The estimated shipping price in CNY."
                },
                "productName": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "The product name when the carrier distinguishes products."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The product name when the carrier distinguishes products."
                }
              },
              "additionalProperties": false,
              "required": [
                "expType",
                "price",
                "productName"
              ],
              "description": "One product price estimate."
            },
            "description": "The per-product price estimates."
          },
          "tips": {
            "type": "string",
            "description": "An upstream notice, present when the call consumed the Kuaidi100 free daily quota."
