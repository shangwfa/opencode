    {
      "id": "kuaidi100.auto_number",
      "service": "kuaidi100",
      "name": "auto_number",
      "description": "Detect the likely express carriers for a tracking number from its format.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "trackingNumber": {
            "type": "string",
            "minLength": 1,
            "description": "The express tracking number (快递单号)."
          }
        },
        "additionalProperties": false,
        "required": [
          "trackingNumber"
        ],
        "description": "The tracking number to identify."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "comCode": {
                  "type": "string",
                  "description": "The Kuaidi100 carrier code."
                },
                "name": {
                  "type": "string",
                  "description": "The carrier display name."
                },
                "lengthPre": {
                  "type": "string",
                  "description": "The tracking number length the carrier uses."
                }
              },
              "additionalProperties": false,
              "required": [
                "comCode",
                "name",
                "lengthPre"
              ],
              "description": "One candidate carrier."
            },
            "description": "The candidate carriers for the tracking number."
          },
          "tips": {
            "type": "string",
            "description": "An upstream notice, present when the call consumed the Kuaidi100 free daily quota."
          }
        },
        "additionalProperties": false,
        "required": [
          "data"
        ],
        "description": "The carriers that could own the tracking number."
      },
      "followUpActions": [
        "kuaidi100.query_trace"
      ]
    },
