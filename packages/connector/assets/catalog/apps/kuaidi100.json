            "type": "string",
            "minLength": 1,
            "description": "The recipient address, for example 广东省深圳市南山区."
          },
          "weightKg": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "The parcel weight in kilograms."
          }
        },
        "additionalProperties": false,
        "required": [
          "carrier",
          "senderAddress",
          "recipientAddress",
          "weightKg"
        ],
        "description": "The shipment whose price should be estimated."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "kuaidicom": {
            "type": "string",
