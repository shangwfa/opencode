  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "MAILWIZZ_API_KEY",
      "description": "MailWizz v2 API key sent in the X-Api-Key header.",
      "extraFields": [
        {
          "key": "baseUrl",
          "label": "Instance URL",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "https://mail.example.com/api",
          "description": "The base URL of the MailWizz v2 API."
        }
      ]
    }
