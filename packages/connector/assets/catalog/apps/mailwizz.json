    {
      "id": "mailwizz.create_or_update_subscriber",
      "service": "mailwizz",
      "name": "create_or_update_subscriber",
      "description": "Create a subscriber in a MailWizz list, or update the existing subscriber with the same email address.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "listUid": {
            "type": "string",
            "minLength": 1,
            "description": "The unique ID of the MailWizz mailing list."
          },
          "email": {
            "type": "string",
            "description": "The subscriber email address.",
            "format": "email"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "description": "A string list field value."
                },
                {
                  "type": "number",
                  "description": "A numeric list field value."
                },
                {
                  "type": "boolean",
                  "description": "A boolean list field value."
                }
              ],
              "description": "A string, number, or boolean list field value."
            },
            "description": "Additional MailWizz list field values keyed by field tag, such as FNAME or LNAME."
          }
        },
        "additionalProperties": false,
        "required": [
          "listUid",
          "email"
        ],
        "description": "The input for creating or updating a MailWizz subscriber."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "The MailWizz response status."
          },
          "data": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The data payload returned by the MailWizz instance."
          }
        },
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "description": "The created or updated MailWizz subscriber response."
      }
    },
