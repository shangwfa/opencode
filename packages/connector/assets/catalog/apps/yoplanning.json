    {
      "id": "yoplanning.list_online_products",
      "service": "yoplanning",
      "name": "list_online_products",
      "description": "List products that a YoPlanning team currently offers for online sale.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "teamId": {
            "type": "string",
            "description": "The YoPlanning team ID.",
            "format": "uuid"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "The maximum number of results to return, from 1 to 100."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "The zero-based result offset."
          },
          "language": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "description": "The ISO 639-1 language code used for translated product content."
          },
          "startDate": {
            "type": "string",
            "description": "Return products with availability on or after this ISO 8601 date.",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "description": "Return products with availability on or before this ISO 8601 date.",
            "format": "date"
          },
          "subCategoryId": {
            "type": "integer",
            "description": "The YoPlanning subcategory ID used to filter products."
          }
        },
        "additionalProperties": false,
        "required": [
          "teamId"
        ],
        "description": "Input payload for listing a team's online products."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "description": "The total number of matching resources."
          },
          "next": {
            "anyOf": [
              {
                "type": "string",
                "description": "The URL of the next pagination page, or null when no page is available.",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "description": "The URL of the next pagination page, or null when no page is available."
          },
          "previous": {
            "anyOf": [
              {
                "type": "string",
                "description": "The URL of the previous pagination page, or null when no page is available.",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "description": "The URL of the previous pagination page, or null when no page is available."
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The YoPlanning online product ID.",
                  "format": "uuid"
                },
                "name": {
                  "type": "string",
                  "description": "The internal YoPlanning product name."
                },
                "team": {
                  "type": "string",
                  "description": "The YoPlanning team ID that owns the product.",
                  "format": "uuid"
                }
              },
              "additionalProperties": true,
              "required": [
                "id",
                "name",
                "team"
              ],
              "description": "A YoPlanning online product returned by the API."
            },
            "description": "The online products returned for this page."
          }
        },
        "additionalProperties": false,
        "required": [
          "count",
          "next",
          "previous",
          "results"
        ],
        "description": "A paginated list of online products."
      },
      "followUpActions": [
        "yoplanning.get_online_product",
        "yoplanning.list_product_availabilities"
      ]
    },
    {
