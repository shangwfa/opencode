  "auth": [
    {
      "type": "api_key",
      "label": "API Token",
      "placeholder": "YOUR_YOPLANNING_API_TOKEN",
      "description": "YoPlanning API token sent in the Authorization header. Request it from Settings > Advanced after signing in; see the official authentication guide: https://yoplanning.pro/api/v3.1/docs/#auth.",
