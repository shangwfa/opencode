    {
      "id": "yoplanning.get_availability_details",
      "service": "yoplanning",
      "name": "get_availability_details",
      "description": "Get the currently bookable options and resources for a YoPlanning availability.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "teamId": {
            "type": "string",
            "description": "The YoPlanning team ID.",
            "format": "uuid"
          },
          "availabilityId": {
            "type": "string",
            "description": "The session group ID returned by a product availability.",
            "format": "uuid"
          },
          "language": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "description": "The ISO 639-1 language code used for translated product content."
          }
        },
        "additionalProperties": false,
        "required": [
          "teamId",
          "availabilityId"
        ],
        "description": "Action input."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "availability": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The YoPlanning session group ID.",
                "format": "uuid"
              }
            },
            "additionalProperties": true,
            "required": [
              "id"
            ],
            "description": "The bookable options and resources returned by the API."
          }
        },
        "additionalProperties": false,
        "required": [
          "availability"
        ],
        "description": "Action output."
      }
    },
