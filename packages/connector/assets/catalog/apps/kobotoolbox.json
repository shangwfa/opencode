    {
      "id": "kobotoolbox.clone_project",
      "service": "kobotoolbox",
      "name": "clone_project",
      "description": "Clone an existing KoboToolbox asset into a new survey project.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "sourceAssetUid": {
            "type": "string",
            "minLength": 1,
            "description": "The UID of the asset to clone."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "The name for the cloned project."
          }
        },
        "additionalProperties": false,
        "description": "The KoboToolbox asset clone request."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "asset": {
            "type": "object",
            "properties": {
              "uid": {
                "type": "string",
                "minLength": 1,
                "description": "The asset UID."
              },
              "name": {
                "type": "string",
                "description": "The asset name."
              },
              "asset_type": {
                "type": "string",
                "description": "The KoboToolbox asset type."
              },
              "date_created": {
                "type": "string",
                "description": "When the asset was created.",
                "format": "date-time"
              },
              "date_modified": {
                "type": "string",
                "description": "When the asset was last modified.",
                "format": "date-time"
              },
              "date_deployed": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "When the asset was last deployed.",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "When the asset was last deployed."
              },
              "deployment_status": {
                "type": "string",
                "description": "The current asset deployment status."
              },
              "has_deployment": {
                "type": "boolean",
                "description": "Whether the asset has been deployed."
              }
            },
            "additionalProperties": true,
            "required": [
              "uid",
              "name",
              "asset_type"
            ],
            "description": "A KoboToolbox project or library asset with provider-defined nested content."
          }
        },
        "additionalProperties": false,
        "description": "The cloned KoboToolbox project."
      }
    },
