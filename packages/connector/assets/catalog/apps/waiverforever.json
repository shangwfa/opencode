    {
      "id": "waiverforever.create_template_signing_link",
      "service": "waiverforever",
      "name": "create_template_signing_link",
      "description": "Create a one-off signing link for a WaiverForever template.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "template_id": {
            "type": "string",
            "minLength": 1,
            "description": "The WaiverForever resource ID.",
            "pattern": "\\S"
          },
          "ttl": {
            "type": "integer",
            "minimum": 1,
            "description": "The signing link expiration time in seconds. WaiverForever defaults to 86400."
          },
          "pending_enabled": {
            "type": "boolean",
            "description": "Whether submissions through the generated tracking link should start as pending."
          }
        },
        "additionalProperties": false,
        "required": [
          "template_id"
        ],
        "description": "The input payload for creating a WaiverForever template signing link."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "tracking_id": {
            "anyOf": [
              {
                "type": "string",
                "description": "The generated tracking ID."
              },
              {
                "type": "null"
              }
            ],
            "description": "The generated tracking ID."
          },
          "request_waiver_url": {
            "anyOf": [
              {
                "type": "string",
                "description": "The generated request waiver URL.",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "description": "The generated request waiver URL."
          },
          "ttl": {
            "anyOf": [
              {
                "type": "integer",
                "description": "The signing link expiration time in seconds."
              },
              {
                "type": "null"
              }
            ],
            "description": "The signing link expiration time in seconds."
          },
          "pending_enabled": {
            "anyOf": [
              {
                "type": "boolean",
                "description": "Whether pending status was requested for this signing link."
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether pending status was requested for this signing link."
          },
          "pending_available": {
            "anyOf": [
              {
                "type": "boolean",
                "description": "Whether pending status was available for this signing link."
              },
              {
                "type": "null"
              }
            ],
            "description": "Whether pending status was available for this signing link."
          },
          "raw": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The raw object returned by WaiverForever."
          }
        },
        "additionalProperties": false,
        "required": [
          "tracking_id",
          "request_waiver_url",
          "ttl",
          "pending_enabled",
          "pending_available",
          "raw"
        ],
        "description": "The WaiverForever template signing link response."
      }
    },
