      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "recordingUuid": {
            "type": "string",
            "minLength": 1,
            "description": "The UUID of the Screendesk recording."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "The one-based Screendesk page number to fetch."
          }
        },
        "additionalProperties": false,
        "required": [
          "recordingUuid"
        ],
        "description": "Input parameters for retrieving a Screendesk recording transcript."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "recording_uuid": {
            "type": "string",
            "description": "The recording UUID.",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "processing",
              "unavailable"
            ],
            "description": "The current transcript availability status."
          },
          "language": {
            "anyOf": [
              {
                "type": "string",
                "description": "The detected BCP 47 language code when available."
              },
              {
                "type": "null"
              }
            ],
            "description": "The detected BCP 47 language code when available."
          },
          "speaker_map": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "description": "The known speaker display name."
            },
            "description": "A mapping from diarization speaker indices to known display names."
          },
          "pagination": {
            "type": "object",
            "properties": {
              "count": {
                "type": "integer",
                "description": "The total number of records."
              },
              "page": {
                "type": "integer",
                "description": "The current page number."
              },
              "items": {
                "type": "integer",
                "description": "The number of records per page."
              },
              "pages": {
                "type": "integer",
                "description": "The total number of pages."
              },
              "next_page": {
                "anyOf": [
                  {
                    "type": "integer",
                    "description": "The next page number, or null on the last page."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The next page number, or null on the last page."
              },
              "prev_page": {
                "anyOf": [
                  {
                    "type": "integer",
                    "description": "The previous page number, or null on the first page."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The previous page number, or null on the first page."
              },
              "last_page": {
                "type": "integer",
                "description": "The last page number."
              },
              "from": {
                "type": "integer",
                "description": "The index of the first record on this page."
              },
              "to": {
                "type": "integer",
                "description": "The index of the last record on this page."
              }
            },
            "additionalProperties": true,
            "required": [
              "count",
              "page",
              "items",
              "pages",
              "last_page",
              "from",
              "to"
            ],
            "description": "Screendesk pagination metadata."
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "start_seconds": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "The segment start time in seconds."
                },
                "end_seconds": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "description": "The segment end time in seconds when available."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The segment end time in seconds when available."
                },
                "text": {
                  "type": "string",
                  "description": "The transcript segment text."
                },
                "sentences": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Sentence timing and diarization metadata."
                  },
                  "description": "Sentence timing and diarization metadata when available."
                }
              },
              "additionalProperties": true,
              "required": [
                "start_seconds",
                "text",
                "sentences"
              ],
              "description": "A timestamped Screendesk transcript segment."
            },
            "description": "The timestamped transcript segments on this page."
          }
        },
        "additionalProperties": true,
        "required": [
          "recording_uuid",
          "status",
          "speaker_map",
          "pagination",
          "segments"
        ],
        "description": "The Screendesk recording transcript response."
      }
    },
