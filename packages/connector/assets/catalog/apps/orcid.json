{
  "service": "orcid",
  "displayName": "ORCID",
  "categories": [
    "Data"
  ],
  "authTypes": [
    "oauth2"
  ],
  "auth": [
    {
      "type": "oauth2",
      "authorizationUrl": "https://orcid.org/oauth/authorize",
      "tokenUrl": "https://orcid.org/oauth/token",
      "scopes": [
        "openid"
      ],
      "tokenEndpointAuthMethod": "client_secret_post"
    }
  ],
  "homepageUrl": "https://orcid.org/",
  "actions": [
    {
      "id": "orcid.get_record",
      "service": "orcid",
      "name": "get_record",
      "description": "Get the public ORCID record for a researcher by ORCID iD.",
      "operationType": "read",
      "requiredScopes": [
        "orcid.records.read"
      ],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "orcidId": {
            "type": "string",
            "minLength": 1,
            "description": "The ORCID iD in the canonical 0000-0000-0000-0000 format."
          }
        },
        "additionalProperties": false,
        "description": "Input parameters for reading an ORCID record."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "orcidId": {
            "type": "string",
            "minLength": 1,
            "description": "The ORCID iD in the canonical 0000-0000-0000-0000 format."
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "description": "The researcher's public display name."
              },
              {
                "type": "null"
              }
            ],
            "description": "The researcher's public display name."
          },
          "record": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The raw ORCID API object."
          }
        },
        "additionalProperties": false,
        "description": "The public ORCID record response."
      }
    },
    {
      "id": "orcid.get_works",
      "service": "orcid",
      "name": "get_works",
      "description": "Get the public works summary for a researcher by ORCID iD.",
      "operationType": "read",
      "requiredScopes": [
        "orcid.records.read"
      ],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "orcidId": {
            "type": "string",
            "minLength": 1,
            "description": "The ORCID iD in the canonical 0000-0000-0000-0000 format."
          }
        },
        "additionalProperties": false,
        "description": "Input parameters for reading an ORCID works summary."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "orcidId": {
            "type": "string",
            "minLength": 1,
            "description": "The ORCID iD in the canonical 0000-0000-0000-0000 format."
          },
          "works": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "The raw ORCID API object."
            },
            "description": "The work groups returned by ORCID."
          },
          "raw": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The raw ORCID API object."
          }
        },
        "additionalProperties": false,
        "description": "The public ORCID works summary response."
      }
    },
    {
      "id": "orcid.search_records",
      "service": "orcid",
      "name": "search_records",
      "description": "Search public ORCID records with ORCID's Solr query syntax.",
      "operationType": "read",
      "requiredScopes": [
        "orcid.records.read"
      ],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "A Solr query, such as family-name:Sanchez or affiliation-org-name:Example University."
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999,
            "description": "The zero-based result offset within the first 10,000 results."
          },
          "rows": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "The number of results to return, up to 1000."
          }
        },
        "additionalProperties": false,
        "required": [
          "query"
        ],
        "description": "Input parameters for searching public ORCID records."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "The total number of matching public records."
          },
          "start": {
            "type": "integer",
            "description": "The zero-based result offset used for this page."
          },
          "rows": {
            "type": "integer",
            "description": "The requested page size."
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "The raw ORCID API object."
            },
            "description": "The expanded public ORCID search results."
          }
        },
        "additionalProperties": false,
        "description": "The expanded ORCID search response."
      }
    }
  ]
}
