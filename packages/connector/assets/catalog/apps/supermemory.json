    {
      "id": "supermemory.add_document",
      "service": "supermemory",
      "name": "add_document",
      "description": "Submit raw text, a transcript, or a public URL for asynchronous memory extraction or managed RAG indexing.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "description": "Raw text, a conversation transcript, or a public URL that Supermemory should process."
          },
          "containerTag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "The user, project, or tenant container tag that scopes this operation."
          },
          "taskType": {
            "type": "string",
            "enum": [
              "memory",
              "superrag"
            ],
            "description": "How Supermemory should process the content."
          },
          "customId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "A stable caller-provided identifier used for idempotency and deletion."
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "description": "A string metadata value."
                },
                {
                  "type": "number",
                  "description": "A numeric metadata value."
                },
                {
                  "type": "boolean",
                  "description": "A boolean metadata value."
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "A list of string metadata values."
                }
              ],
              "description": "A supported metadata value."
            },
            "description": "Flat metadata used to organize and filter Supermemory content."
          },
          "entityContext": {
            "type": "string",
            "maxLength": 1500,
            "description": "Context that guides memory extraction for this container."
          },
          "filterByMetadata": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "description": "A string metadata value."
                },
                {
                  "type": "number",
                  "description": "A numeric metadata value."
                },
                {
                  "type": "boolean",
                  "description": "A boolean metadata value."
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "A list of string metadata values."
                }
              ],
              "description": "A supported metadata value."
            },
            "description": "Metadata filters for existing memories used as ingestion context."
          },
          "dreaming": {
            "type": "string",
            "enum": [
              "instant",
              "dynamic"
            ],
            "description": "Whether to process immediately or group related documents dynamically."
          }
        },
        "additionalProperties": false,
        "required": [
          "content",
          "containerTag",
          "taskType"
        ],
        "description": "The source content and processing behavior for a new document."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The document identifier used to poll processing status."
          },
          "status": {
            "type": "string",
            "description": "The initial document processing status."
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "description": "The queued Supermemory document."
      },
      "asyncLifecycle": {
        "startActionId": "supermemory.add_document",
        "statusActionId": "supermemory.get_document"
      }
