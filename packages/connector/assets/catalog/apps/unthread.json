      "id": "unthread.list_accounts",
      "service": "unthread",
      "name": "list_accounts",
      "description": "List and filter external customer accounts in Unthread.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "select": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "A documented account field name."
            },
            "description": "Documented account fields to include in each result.",
            "minItems": 1
          },
          "order": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "A documented account field name."
            },
            "description": "Documented account fields used to order results.",
            "minItems": 1
          },
          "where": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The documented account field to filter by."
                },
                "operator": {
                  "type": "string",
                  "enum": [
                    "==",
                    "!=",
                    ">",
                    "<",
                    "in",
                    "notIn",
                    "contains",
                    "notContains",
                    "like"
                  ],
                  "description": "The comparison operator for the filter."
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "A string filter value."
                    },
                    {
                      "type": "number",
                      "description": "A numeric filter value."
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "description": "A string filter value."
                      },
                      "description": "A list of string filter values."
                    }
                  ],
                  "description": "The string, number, or string list compared by the filter."
                }
              },
              "additionalProperties": false,
              "description": "A filter applied to the account list."
            },
            "description": "Filters applied to the account list.",
            "minItems": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "The maximum number of accounts to return, up to 100."
          },
          "descending": {
            "type": "boolean",
            "description": "Whether to sort the selected order fields in descending order."
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "description": "The opaque cursor for the next or previous result page."
          }
        },
        "additionalProperties": false,
        "description": "The account list selection, filtering, ordering, and pagination options."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "An Unthread account projection containing the fields selected by the caller."
            },
            "description": "The account projections returned for this page."
          },
          "totalCount": {
            "type": "integer",
            "description": "The total number of accounts matching the request."
          },
          "cursors": {
            "type": "object",
            "properties": {
              "hasNext": {
                "type": "boolean",
                "description": "Whether another result page is available."
              },
              "hasPrevious": {
                "type": "boolean",
                "description": "Whether a previous result page is available."
              },
              "next": {
                "type": "string",
                "description": "The cursor for the next result page."
              },
              "previous": {
                "type": "string",
                "description": "The cursor for the previous result page."
              }
            },
            "additionalProperties": false,
            "required": [
              "hasNext",
              "hasPrevious"
            ],
            "description": "Cursor information returned by an Unthread list endpoint."
          }
        },
        "additionalProperties": false,
        "description": "A page of Unthread accounts."
