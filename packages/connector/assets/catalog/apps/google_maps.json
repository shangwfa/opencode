{
  "service": "google_maps",
  "displayName": "Google Maps",
  "categories": [
    "Location",
    "Developer Tools"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "GOOGLE_MAPS_API_KEY",
      "description": "Google Maps Platform API key used with the Places, Geocoding, and Routes APIs. Create and restrict it in the Google Cloud Console: https://developers.google.com/maps/get-started#create-project-account-key",
      "extraFields": []
    }
  ],
  "homepageUrl": "https://mapsplatform.google.com/",
  "actions": [
    {
      "id": "google_maps.autocomplete_places",
      "service": "google_maps",
      "name": "autocomplete_places",
      "description": "Return Google Places autocomplete predictions for text input.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "minLength": 1,
            "description": "The text for which to return place or query predictions."
          },
          "sessionToken": {
            "type": "string",
            "minLength": 1,
            "description": "A URL-safe token that groups one autocomplete session."
          },
          "languageCode": {
            "type": "string",
            "minLength": 1,
            "description": "The BCP 47 language code for localized results."
          },
          "regionCode": {
            "type": "string",
            "minLength": 1,
            "description": "The two-character CLDR region code used to format results."
          }
        },
        "additionalProperties": true,
        "required": [
          "input"
        ],
        "description": "Input for Google Places autocomplete."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "suggestions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {
                "description": "An upstream Google Maps API JSON property value."
              },
              "description": "One place or query suggestion."
            },
            "description": "The autocomplete suggestions."
          }
        },
        "additionalProperties": true,
        "description": "A Google Places autocomplete response."
      }
    },
    {
      "id": "google_maps.compute_route_matrix",
      "service": "google_maps",
      "name": "compute_route_matrix",
      "description": "Compute routes for every origin and destination combination with Google Routes.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "fieldMask": {
            "type": "string",
            "minLength": 1,
            "description": "The comma-separated response field mask; requested fields affect Google billing."
          },
          "origins": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {
                "description": "An upstream Google Maps API JSON property value."
              },
              "description": "One route matrix origin."
            },
            "description": "The route matrix origins.",
            "minItems": 1
          },
          "destinations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {
                "description": "An upstream Google Maps API JSON property value."
              },
              "description": "One route matrix destination."
            },
            "description": "The route matrix destinations.",
            "minItems": 1
          }
        },
        "additionalProperties": true,
        "required": [
          "fieldMask",
          "origins",
          "destinations"
        ],
        "description": "Input for Google Routes computeRouteMatrix."
      },
      "outputSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": {
            "description": "An upstream Google Maps API JSON property value."
          },
          "description": "One route matrix element."
        },
        "description": "The Google Routes route matrix elements."
      }
    },
    {
      "id": "google_maps.compute_routes",
      "service": "google_maps",
      "name": "compute_routes",
      "description": "Compute one or more routes between an origin and destination with Google Routes.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "fieldMask": {
            "type": "string",
            "minLength": 1,
            "description": "The comma-separated response field mask; requested fields affect Google billing."
          },
          "origin": {
            "type": "object",
            "additionalProperties": {
              "description": "An upstream Google Maps API JSON property value."
            },
            "description": "The route origin waypoint."
          },
          "destination": {
            "type": "object",
            "additionalProperties": {
              "description": "An upstream Google Maps API JSON property value."
            },
            "description": "The route destination waypoint."
          }
        },
        "additionalProperties": true,
        "required": [
          "fieldMask",
          "origin",
          "destination"
        ],
        "description": "Input for Google Routes computeRoutes."
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": {
          "description": "An upstream Google Maps API JSON property value."
        },
        "description": "A Google Routes computeRoutes response."
      }
    },
    {
      "id": "google_maps.geocode_address",
      "service": "google_maps",
      "name": "geocode_address",
      "description": "Convert an address into geographic coordinates with Google Geocoding.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "minLength": 1,
            "description": "The human-readable street address to geocode."
          },
          "bounds": {
            "type": "string",
            "minLength": 1,
            "description": "The viewport bounds used to bias results."
          },
          "components": {
            "type": "string",
            "minLength": 1,
            "description": "The pipe-separated component filters."
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "description": "The language code for results."
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "description": "The two-character region code used to bias results."
          }
        },
        "additionalProperties": false,
        "required": [
          "address"
        ],
        "description": "Input for geocoding an address."
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": {
          "description": "An upstream Google Maps API JSON property value."
        },
        "description": "A Google Geocoding response."
      }
    },
    {
      "id": "google_maps.get_place",
      "service": "google_maps",
      "name": "get_place",
      "description": "Get details for a Google Place by place ID.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "placeId": {
            "type": "string",
            "minLength": 1,
            "description": "The Google Place ID to retrieve."
          },
          "fieldMask": {
            "type": "string",
            "minLength": 1,
            "description": "The comma-separated response field mask; requested fields affect Google billing."
          },
          "languageCode": {
            "type": "string",
            "minLength": 1,
            "description": "The BCP 47 language code for localized results."
          },
          "regionCode": {
            "type": "string",
            "minLength": 1,
            "description": "The two-character CLDR region code used to format results."
          }
        },
        "additionalProperties": true,
        "required": [
          "placeId"
        ],
        "description": "Input for retrieving Google Place details."
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": {
          "description": "An upstream Google Maps API JSON property value."
        },
        "description": "A Google Places place resource."
      }
    },
    {
      "id": "google_maps.reverse_geocode",
      "service": "google_maps",
      "name": "reverse_geocode",
      "description": "Convert geographic coordinates into addresses with Google Geocoding.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "The latitude in decimal degrees."
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "The longitude in decimal degrees."
          },
          "resultTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "One result type."
            },
            "description": "The address result types to include."
          },
          "locationTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "One location type."
            },
            "description": "The location precision types to include."
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "description": "The language code for results."
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "description": "The two-character region code used to bias results."
          }
        },
        "additionalProperties": false,
        "required": [
          "latitude",
          "longitude"
        ],
        "description": "Input for reverse geocoding coordinates."
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": {
          "description": "An upstream Google Maps API JSON property value."
        },
        "description": "A Google reverse geocoding response."
      }
    },
    {
      "id": "google_maps.search_nearby_places",
      "service": "google_maps",
      "name": "search_nearby_places",
      "description": "Search Google Places near a geographic point.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "The center latitude in decimal degrees."
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "The center longitude in decimal degrees."
          },
          "radiusMeters": {
            "type": "number",
            "maximum": 50000,
            "exclusiveMinimum": 0,
            "description": "The search radius in meters, greater than 0 and at most 50000."
          },
          "fieldMask": {
            "type": "string",
            "minLength": 1,
            "description": "The comma-separated response field mask; requested fields affect Google billing."
          },
          "includedTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "One supported place type."
            },
            "description": "The place types to include.",
            "maxItems": 50
          },
          "excludedTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "One supported place type."
            },
            "description": "The place types to exclude.",
            "maxItems": 50
          },
          "languageCode": {
            "type": "string",
            "minLength": 1,
            "description": "The BCP 47 language code for localized results."
          },
          "regionCode": {
            "type": "string",
            "minLength": 1,
            "description": "The two-character CLDR region code used to format results."
          }
        },
        "additionalProperties": true,
        "required": [
          "latitude",
          "longitude",
          "radiusMeters"
        ],
        "description": "Input for a Google Places nearby search."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "places": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {
                "description": "An upstream Google Maps API JSON property value."
              },
              "description": "A Google Places place resource."
            },
            "description": "The places returned by Google."
          },
          "routingSummaries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {
                "description": "An upstream Google Maps API JSON property value."
              },
              "description": "One routing summary."
            },
            "description": "Routing summaries returned when routing parameters are requested."
          }
        },
        "additionalProperties": true,
        "description": "A Google Places nearby search response."
      }
    },
    {
      "id": "google_maps.search_places",
      "service": "google_maps",
      "name": "search_places",
      "description": "Search Google Places using a text query.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "textQuery": {
            "type": "string",
            "minLength": 1,
            "description": "The text query describing a place or category to find."
          },
          "fieldMask": {
            "type": "string",
            "minLength": 1,
            "description": "The comma-separated response field mask; requested fields affect Google billing."
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "The number of results to return, from 1 through 20."
          },
          "pageToken": {
            "type": "string",
            "minLength": 1,
            "description": "The token returned by a previous text search."
          },
          "languageCode": {
            "type": "string",
            "minLength": 1,
            "description": "The BCP 47 language code for localized results."
          },
          "regionCode": {
            "type": "string",
            "minLength": 1,
            "description": "The two-character CLDR region code used to format results."
          }
        },
        "additionalProperties": true,
        "required": [
          "textQuery"
        ],
        "description": "Input for a Google Places text search."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "places": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {
                "description": "An upstream Google Maps API JSON property value."
              },
              "description": "A Google Places place resource."
            },
            "description": "The places returned by Google."
          },
          "nextPageToken": {
            "type": "string",
            "description": "The token for retrieving the next page."
          },
          "searchUri": {
            "type": "string",
            "description": "The Google Maps URL for the search."
          }
        },
        "additionalProperties": true,
        "description": "A Google Places search response."
      }
    }
  ]
}
