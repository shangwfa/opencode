{
  "service": "itunes_search",
  "displayName": "iTunes Search API",
  "description": "Search public iTunes Store, App Store, Apple Books, Music, and Podcast records.",
  "categories": [
    "Data",
    "Media"
  ],
  "authTypes": [
    "no_auth"
  ],
  "auth": [
    {
      "type": "no_auth"
    }
  ],
  "homepageUrl": "https://performance-partners.apple.com/search-api",
  "actions": [
    {
      "id": "itunes_search.lookup_store",
      "service": "itunes_search",
      "name": "lookup_store",
      "description": "Look up iTunes Store and Apple Books Store records by one kind of identifier.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "One iTunes identifier.",
              "pattern": "\\S"
            },
            "description": "iTunes identifiers.",
            "minItems": 1
          },
          "bundleId": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "One bundle identifier.",
              "pattern": "\\S"
            },
            "description": "App bundle identifiers.",
            "minItems": 1
          },
          "amgArtistId": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "One artist identifier.",
              "pattern": "\\S"
            },
            "description": "All Music Guide artist identifiers.",
            "minItems": 1
          },
          "amgAlbumId": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "One album identifier.",
              "pattern": "\\S"
            },
            "description": "All Music Guide album identifiers.",
            "minItems": 1
          },
          "amgVideoId": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "One video identifier.",
              "pattern": "\\S"
            },
            "description": "All Music Guide video identifiers.",
            "minItems": 1
          },
          "upc": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "One barcode.",
              "pattern": "\\S"
            },
            "description": "UPC or EAN barcodes.",
            "minItems": 1
          },
          "isbn": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "One ISBN.",
              "pattern": "\\S"
            },
            "description": "Thirteen-digit ISBNs.",
            "minItems": 1
          },
          "entity": {
            "type": "string",
            "enum": [
              "album",
              "allArtist",
              "allTrack",
              "audiobook",
              "audiobookAuthor",
              "desktopSoftware",
              "ebook",
              "iPadSoftware",
              "mix",
              "movie",
              "movieArtist",
              "musicArtist",
              "musicTrack",
              "musicVideo",
              "podcast",
              "podcastAuthor",
              "podcastEpisode",
              "shortFilm",
              "shortFilmArtist",
              "software",
              "song",
              "tvEpisode",
              "tvSeason"
            ],
            "description": "Related content to return."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "description": "The maximum number of related records."
          },
          "sort": {
            "type": "string",
            "enum": [
              "recent"
            ],
            "description": "The related-record order."
          },
          "country": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "description": "The two-letter storefront country code.",
            "pattern": "^[A-Z]{2}$"
          },
          "lang": {
            "type": "string",
            "enum": [
              "en_us",
              "ja_jp"
            ],
            "description": "The response language."
          }
        },
        "additionalProperties": false,
        "description": "Identifiers and optional related-content settings.",
        "anyOf": [
          {
            "required": [
              "id"
            ]
          },
          {
            "required": [
              "bundleId"
            ]
          },
          {
            "required": [
              "amgArtistId"
            ]
          },
          {
            "required": [
              "amgAlbumId"
            ]
          },
          {
            "required": [
              "amgVideoId"
            ]
          },
          {
            "required": [
              "upc"
            ]
          },
          {
            "required": [
              "isbn"
            ]
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "resultCount": {
            "type": "integer",
            "description": "The record count Apple reported."
          },
          "returnedCount": {
            "type": "integer",
            "description": "The number of records returned."
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "wrapperType": {
                  "type": "string",
                  "description": "The wrapped object kind."
                },
                "kind": {
                  "type": "string",
                  "description": "The content kind."
                },
                "artistId": {
                  "type": "integer",
                  "description": "The artist, developer, or author identifier."
                },
                "collectionId": {
                  "type": "integer",
                  "description": "The collection identifier."
                },
                "trackId": {
                  "type": "integer",
                  "description": "The track, app, movie, or episode identifier."
                },
                "artistName": {
                  "type": "string",
                  "description": "The artist, developer, or author name."
                },
                "collectionName": {
                  "type": "string",
                  "description": "The collection name."
                },
                "trackName": {
                  "type": "string",
                  "description": "The track, app, movie, or episode name."
                },
                "artistViewUrl": {
                  "type": "string",
                  "description": "The artist store page.",
                  "format": "uri"
                },
                "collectionViewUrl": {
                  "type": "string",
                  "description": "The collection store page.",
                  "format": "uri"
                },
                "trackViewUrl": {
                  "type": "string",
                  "description": "The record store page.",
                  "format": "uri"
                },
                "previewUrl": {
                  "type": "string",
                  "description": "The preview asset URL.",
                  "format": "uri"
                },
                "artworkUrl30": {
                  "type": "string",
                  "description": "The 30-pixel artwork URL.",
                  "format": "uri"
                },
                "artworkUrl60": {
                  "type": "string",
                  "description": "The 60-pixel artwork URL.",
                  "format": "uri"
                },
                "artworkUrl100": {
                  "type": "string",
                  "description": "The 100-pixel artwork URL.",
                  "format": "uri"
                },
                "collectionPrice": {
                  "type": "number",
                  "description": "The collection price."
                },
                "trackPrice": {
                  "type": "number",
                  "description": "The record price."
                },
                "currency": {
                  "type": "string",
                  "description": "The ISO 4217 storefront currency."
                },
                "trackTimeMillis": {
                  "type": "integer",
                  "description": "The playback duration in milliseconds."
                },
                "releaseDate": {
                  "type": "string",
                  "description": "The release timestamp."
                },
                "country": {
                  "type": "string",
                  "description": "The storefront country code."
                },
                "primaryGenreName": {
                  "type": "string",
                  "description": "The primary genre."
                },
                "bundleId": {
                  "type": "string",
                  "description": "The application bundle identifier."
                }
              },
              "additionalProperties": true,
              "description": "One iTunes Store record, with additional media-specific fields passed through."
            },
            "description": "The store records, including media-specific upstream fields."
          }
        },
        "additionalProperties": false,
        "description": "Normalized iTunes Search API results."
      }
    },
    {
