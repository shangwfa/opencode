  "actions": [
    {
      "id": "dynalist.add_to_inbox",
      "service": "dynalist",
      "name": "add_to_inbox",
      "description": "Add a node to the configured Dynalist inbox. Configure an inbox before calling this action.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": -1,
            "description": "The zero-based position; -1 appends at the end."
          },
          "content": {
            "type": "string",
            "description": "The node title."
          },
          "note": {
            "type": "string",
            "description": "The node note."
          },
          "checked": {
            "type": "boolean",
            "description": "Whether the node is checked."
          },
          "checkbox": {
            "type": "boolean",
            "description": "Whether the node has a checkbox."
          },
          "heading": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "The heading level; 0 disables headings."
          },
          "color": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6,
            "description": "The color label; 0 removes the label."
          }
        },
        "additionalProperties": false,
        "description": "The request parameters."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "_code": {
            "type": "string",
            "description": "The Dynalist result code; OK indicates success."
          },
          "_msg": {
            "type": "string",
            "description": "The Dynalist result message."
          },
          "file_id": {
            "type": "string",
            "minLength": 1,
            "description": "The Dynalist ID."
          },
          "node_id": {
            "type": "string",
            "minLength": 1,
            "description": "The Dynalist ID."
          },
          "index": {
            "type": "integer",
            "minimum": -1,
            "description": "The zero-based position; -1 appends at the end."
          }
        },
        "additionalProperties": true,
        "description": "The Dynalist response."
      }
    },
