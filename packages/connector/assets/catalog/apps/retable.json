      "id": "retable.search_rows",
      "service": "retable",
      "name": "search_rows",
      "description": "Search a Retable table for a term in one column with optional pagination.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "retableId": {
            "type": "string",
            "minLength": 1,
            "description": "The Retable table ID from its URL or a discovery action.",
            "pattern": "\\S"
          },
          "columnId": {
            "type": "string",
            "minLength": 1,
            "description": "The Retable column ID.",
            "pattern": "\\S"
          },
          "term": {
            "type": "string",
            "minLength": 1,
            "description": "The search term.",
            "pattern": "\\S"
          },
          "columnIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "The Retable column ID.",
              "pattern": "\\S"
            },
            "description": "Additional Retable column IDs included in the search result.",
            "minItems": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "The maximum number of search results to return."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "The zero-based search result offset."
          }
        },
        "additionalProperties": false,
        "required": [
          "retableId",
          "columnId",
          "term"
        ],
        "description": "Input payload for searching Retable rows."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "row_id": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "The numeric Retable row ID."
                }
              },
              "additionalProperties": true,
              "required": [
                "row_id"
              ],
              "description": "A row returned by Retable."
            },
            "description": "Matching rows returned by Retable."
          },
          "count": {
            "anyOf": [
              {
                "type": "integer",
                "description": "The returned row count."
              },
              {
                "type": "null",
                "description": "Retable omitted the row count."
              }
            ],
            "description": "The total count returned by Retable, or null when omitted."
          }
        },
        "additionalProperties": false,
        "description": "Rows matching a Retable search."
      }
