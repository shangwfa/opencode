      "id": "retable.delete_rows",
      "service": "retable",
      "name": "delete_rows",
      "description": "Delete one or more rows from a Retable table.",
      "operationType": "destructive",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "retableId": {
            "type": "string",
            "minLength": 1,
            "description": "The Retable table ID from its URL or a discovery action.",
            "pattern": "\\S"
          },
          "rowIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "description": "The numeric Retable row ID."
            },
            "description": "Numeric row IDs to delete.",
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "description": "Input payload for deleting Retable rows."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "deletedRowCount": {
            "type": "integer",
            "description": "The number of rows deleted by Retable."
          }
        },
        "additionalProperties": false,
        "description": "Retable row deletion result."
      }
    },
