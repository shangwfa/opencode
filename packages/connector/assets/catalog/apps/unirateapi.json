          }
        },
        "additionalProperties": true,
        "description": "Historical availability by currency."
      }
    },
    {
      "id": "unirateapi.get_historical_rates",
      "service": "unirateapi",
      "name": "get_historical_rates",
      "description": "Get exchange rates and converted amounts for a historical date.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "Date in YYYY-MM-DD format.",
            "format": "date"
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "description": "Base currency code. Defaults to USD.",
            "default": "USD"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "description": "Currency code, such as USD, EUR, or BTC."
          },
          "amount": {
            "type": "number",
            "description": "Amount to convert. Defaults to 1.",
            "default": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "date"
        ],
        "description": "Historical exchange rate input."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "Date in YYYY-MM-DD format.",
            "format": "date"
          },
          "amount": {
            "type": "number",
            "description": "The amount requested."
          },
          "base": {
            "type": "string",
            "description": "The base currency code."
          },
          "to": {
            "type": "string",
            "description": "The target currency when requested."
          },
          "rate": {
            "type": "number",
            "description": "The exchange rate for a single target currency."
          },
          "result": {
            "type": "number",
            "description": "The converted amount for a single target currency."
          },
          "rates": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "description": "The currency value."
            },
            "description": "Values indexed by currency code."
          },
          "results": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "description": "The currency value."
            },
            "description": "Values indexed by currency code."
          }
        },
        "additionalProperties": true,
        "required": [
          "date",
          "amount",
          "base"
        ],
        "description": "Historical rates; to selects rate/result, otherwise rates/results are returned."
      }
    },
