              "type": "object",
              "properties": {
                "earliest_date": {
                  "type": "string",
                  "description": "The earliest available date."
                },
                "latest_date": {
                  "type": "string",
                  "description": "The latest available date."
                },
                "total_days": {
                  "type": "integer",
                  "description": "Available day count."
                },
                "description": {
                  "type": "string",
