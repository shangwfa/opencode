                }
              },
              "additionalProperties": true,
              "description": "A currency's historical availability."
            },
            "description": "Availability indexed by currency code."
          },
          "total_currencies": {
            "type": "integer",
            "description": "Number of currencies with historical data."
          },
          "data_source": {
            "type": "string",
