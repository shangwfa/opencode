{
  "service": "unirateapi",
  "displayName": "UniRateAPI",
  "homepageUrl": "https://unirateapi.com/",
  "categories": [
    "Finance",
    "Data & Analytics"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "description": "Register at https://unirateapi.com/register and get your API key from your account dashboard. Requests send it in the api_key query parameter."
    }
  ],
  "actions": [
    {
      "id": "unirateapi.convert",
      "service": "unirateapi",
      "name": "convert",
      "description": "Convert an amount into a target currency using current exchange rates.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "description": "Base currency code. Defaults to USD.",
            "default": "USD"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "description": "Currency code, such as USD, EUR, or BTC."
          },
          "amount": {
            "type": "number",
            "description": "Amount to convert. Defaults to 1.",
            "default": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "to"
        ],
        "description": "Currency conversion input."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "description": "The original amount."
          },
          "from": {
            "type": "string",
            "description": "The source currency."
          },
          "to": {
            "type": "string",
            "description": "The target currency."
          },
          "result": {
            "type": "number",
            "description": "The converted amount."
          }
        },
        "additionalProperties": true,
        "description": "The converted amount."
      }
    },
    {
      "id": "unirateapi.get_historical_limits",
      "service": "unirateapi",
