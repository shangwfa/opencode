    {
      "id": "unirateapi.get_timeseries",
      "service": "unirateapi",
      "name": "get_timeseries",
      "description": "Get daily historical currency values over a date range of at most five years. Values include the requested amount multiplier.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "start_date": {
            "type": "string",
            "description": "Date in YYYY-MM-DD format.",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "description": "Date in YYYY-MM-DD format.",
            "format": "date"
          },
          "base": {
            "type": "string",
            "minLength": 1,
            "description": "Base currency code. Defaults to USD.",
            "default": "USD"
          },
          "amount": {
            "type": "number",
            "description": "Amount to convert. Defaults to 1.",
            "default": 1
          },
          "currencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Currency code, such as USD, EUR, or BTC."
            },
            "description": "Currency codes to retrieve; omit for all currencies.",
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "start_date",
          "end_date"
        ],
        "description": "Historical time series input."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "start_date": {
            "type": "string",
            "description": "Date in YYYY-MM-DD format.",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "description": "Date in YYYY-MM-DD format.",
            "format": "date"
          },
          "base": {
            "type": "string",
            "description": "The base currency."
          },
          "amount": {
            "type": "number",
            "description": "The amount multiplier."
          },
          "currencies": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "A currency code."
            },
            "description": "Returned currencies."
          },
          "data": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "number",
                "description": "The currency value."
              },
              "description": "Values indexed by currency code."
            },
            "description": "Daily values indexed by date."
          },
          "total_days": {
            "type": "integer",
            "description": "The number of returned days."
          }
        },
        "additionalProperties": true,
        "description": "Daily currency values for the requested interval."
      }
    },
