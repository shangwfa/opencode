      "id": "papertrail.search_events",
      "service": "papertrail",
      "name": "search_events",
      "description": "Search Papertrail log events with optional resource and time boundaries.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "The Papertrail event search query. Omit it to return recent events."
          },
          "systemId": {
            "type": "string",
            "description": "The Papertrail system ID or unique system name used to limit results."
          },
          "groupId": {
            "type": "integer",
            "minimum": 1,
            "description": "The Papertrail group ID used to limit results."
          },
          "minId": {
            "type": "string",
            "description": "The oldest Papertrail event ID to examine."
          },
          "minTime": {
            "type": "integer",
            "description": "The oldest UTC Unix timestamp to examine."
          },
          "maxId": {
            "type": "string",
            "description": "The newest Papertrail event ID to examine."
          },
          "maxTime": {
            "type": "integer",
            "description": "The newest UTC Unix timestamp to examine."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "description": "The maximum number of events to return."
          },
          "tail": {
            "type": "boolean",
            "description": "Whether Papertrail should prioritize recent events for live-tail usage."
          }
        },
        "additionalProperties": false,
        "description": "The input payload for searching Papertrail log events."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "One Papertrail log event, including its string event ID and message."
            },
            "description": "The matching Papertrail log events."
          },
          "minId": {
            "anyOf": [
              {
                "type": "string",
                "description": "The lowest Papertrail event ID examined."
              },
              {
                "type": "null"
              }
            ],
            "description": "The lowest Papertrail event ID examined."
          },
          "maxId": {
            "anyOf": [
              {
                "type": "string",
                "description": "The highest Papertrail event ID examined."
              },
              {
                "type": "null"
              }
            ],
            "description": "The highest Papertrail event ID examined."
          },
          "minTimeAt": {
            "anyOf": [
              {
                "type": "string",
                "description": "The oldest human-readable timestamp examined."
              },
              {
                "type": "null"
              }
            ],
            "description": "The oldest human-readable timestamp examined."
          },
          "maxTimeAt": {
            "anyOf": [
              {
                "type": "string",
                "description": "The newest human-readable timestamp examined."
              },
              {
                "type": "null"
              }
            ],
            "description": "The newest human-readable timestamp examined."
          }
        },
        "additionalProperties": false,
        "description": "The Papertrail event search response."
