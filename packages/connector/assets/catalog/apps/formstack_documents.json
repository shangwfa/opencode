{
  "service": "formstack_documents",
  "displayName": "Formstack Documents",
  "categories": [
    "Productivity",
    "Developer Tools"
  ],
  "authTypes": [
    "custom_credential"
  ],
  "auth": [
    {
      "type": "custom_credential",
      "fields": [
        {
          "key": "apiKey",
          "label": "API Key",
          "inputType": "password",
          "required": true,
          "secret": true,
          "placeholder": "FORMSTACK_DOCUMENTS_API_KEY",
          "description": "API Key used as the HTTP Basic username. Open profile menu > API Access: https://www.webmerge.me/developers/authentication"
        },
        {
          "key": "apiSecret",
          "label": "API Secret",
          "inputType": "password",
          "required": true,
          "secret": true,
          "placeholder": "FORMSTACK_DOCUMENTS_API_SECRET",
          "description": "API Secret used as the HTTP Basic password. Open profile menu > API Access: https://www.webmerge.me/developers/authentication"
        }
      ]
    }
  ],
  "homepageUrl": "https://forms.formstack.com/products/documents",
  "actions": [
    {
      "id": "formstack_documents.copy_document",
      "service": "formstack_documents",
      "name": "copy_document",
      "description": "Create a named copy of a Formstack Documents template.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique source document identifier."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Name for the copied document."
          }
        },
        "additionalProperties": false,
        "description": "Parameters for copying a Formstack Documents template."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "document": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Unique document identifier."
              },
              "key": {
                "type": "string",
                "description": "Secret merge key associated with the document."
              },
              "type": {
                "type": "string",
                "description": "Document template source type."
              },
              "name": {
                "type": "string",
                "description": "Document name."
              },
              "output": {
                "type": "string",
                "description": "Output format produced by merges."
              },
              "output_name": {
                "type": "string",
                "description": "Custom output filename template."
              },
              "folder": {
                "type": "string",
                "description": "Folder containing the document."
              },
              "size": {
                "type": "string",
                "description": "Provider-defined document size value."
              },
              "size_width": {
                "type": "string",
                "description": "Document width in inches as returned by Formstack Documents."
              },
              "size_height": {
                "type": "string",
                "description": "Document height in inches as returned by Formstack Documents."
              },
              "active": {
                "type": "string",
                "description": "Whether the document is active, represented by the upstream string flag."
              },
              "url": {
                "type": "string",
                "description": "Merge URL for the document.",
                "format": "uri"
              },
              "html": {
                "type": "string",
                "description": "HTML source when this is an HTML document."
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true,
                  "description": "A document merge field."
                },
                "description": "Merge fields found in the document."
              }
            },
            "additionalProperties": true,
            "description": "A Formstack Documents template."
          }
        },
        "additionalProperties": false,
        "description": "The copied Formstack Documents template."
      }
    },
    {
      "id": "formstack_documents.create_document",
      "service": "formstack_documents",
      "name": "create_document",
      "description": "Create a Formstack Documents template from HTML or a public file URL.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Document name."
          },
          "type": {
            "type": "string",
            "enum": [
              "html",
              "pdf",
              "docx",
              "xlsx",
              "pptx"
            ],
            "description": "Document template source type."
          },
          "output": {
            "type": "string",
            "enum": [
              "pdf",
              "docx",
              "xlsx",
              "pptx",
              "email"
            ],
            "description": "Output format produced when the document is merged."
          },
          "output_name": {
            "type": "string",
            "minLength": 1,
            "description": "Custom filename template used for merged output."
          },
          "folder": {
            "type": "string",
            "minLength": 1,
            "description": "Folder name. Formstack Documents creates it when necessary."
          },
          "html": {
            "type": "string",
            "minLength": 1,
            "description": "HTML template source. Required when type is html."
          },
          "file_url": {
            "type": "string",
            "description": "Public URL of the template file. Required for non-HTML document types.",
            "format": "uri"
          },
          "size_width": {
            "type": "number",
            "description": "Document width in inches for an HTML template."
          },
          "size_height": {
            "type": "number",
            "description": "Document height in inches for an HTML template."
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "output"
