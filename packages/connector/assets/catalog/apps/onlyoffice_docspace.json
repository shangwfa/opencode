              "additionalProperties": true,
              "description": "A resource returned by ONLYOFFICE DocSpace."
            },
            "description": "Subfolder metadata returned for the folder."
          },
          "current": {
            "anyOf": [
              {
                "type": "object",
                "properties": {},
                "additionalProperties": true,
                "description": "A resource returned by ONLYOFFICE DocSpace."
              },
              {
                "type": "null"
              }
            ],
            "description": "A resource returned by ONLYOFFICE DocSpace."
          },
          "pagination": {
            "type": "object",
            "properties": {
              "count": {
                "anyOf": [
                  {
                    "type": "integer",
                    "description": "Number of resources in this response."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Number of resources in this response."
              },
              "total": {
                "anyOf": [
                  {
                    "type": "integer",
                    "description": "Total number of matching resources when reported."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Total number of matching resources when reported."
              },
              "startIndex": {
                "anyOf": [
                  {
                    "type": "integer",
                    "description": "Start index used for this response when reported."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Start index used for this response when reported."
              }
            },
            "additionalProperties": false,
            "description": "Pagination metadata returned by ONLYOFFICE DocSpace."
          }
        },
        "additionalProperties": false,
        "description": "The ONLYOFFICE DocSpace folder contents."
      }
    },
