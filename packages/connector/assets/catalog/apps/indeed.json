{
  "service": "indeed",
  "displayName": "Indeed",
  "categories": [
    "Human Resources"
  ],
  "authTypes": [
    "oauth2"
  ],
  "auth": [
    {
      "type": "oauth2",
      "authorizationUrl": "https://secure.indeed.com/oauth/v2/authorize",
      "tokenUrl": "https://apis.indeed.com/oauth/v2/tokens",
      "scopes": [
        "email",
        "offline_access",
        "employer_access",
        "employer.hosted_job"
      ],
      "tokenEndpointAuthMethod": "client_secret_post",
      "pkce": {
        "method": "S256"
      },
      "authorizationParams": {
        "prompt": "select_employer"
      },
      "tokenRequestCallbackParameters": [
        "employer"
      ],
      "clientSetup": {
        "docsUrl": "https://docs.indeed.com/authentication/auth-3-legged-oauth",
        "steps": [
          "Become an Indeed partner and register an application in Partner Console.",
          "Add the callback URL shown here to the application's registered redirect URLs.",
          "Request approval for the employer and hosted-job scopes used by these actions."
        ]
      }
    }
  ],
  "homepageUrl": "https://www.indeed.com",
  "actions": [
    {
      "id": "indeed.clear_sourced_job_posting_updates",
      "service": "indeed",
      "name": "clear_sourced_job_posting_updates",
      "description": "Clear updates previously applied to one sourced Indeed job posting.",
      "operationType": "destructive",
      "requiredScopes": [
        "employer_access",
        "employer.hosted_job"
      ],
      "providerPermissions": [
        "employer_access",
        "employer.hosted_job"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "sourcedPostingId": {
            "type": "string",
            "minLength": 1,
            "description": "Sourced posting UUID or EmployerJob IRI."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "anyOf": [
              {
                "type": "object",
                "properties": {},
                "additionalProperties": true
              },
              {
                "type": "null"
              }
            ]
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Indeed GraphQL error message."
                },
                "path": {
                  "type": "array",
                  "items": {
                    "description": "GraphQL response path segment."
                  }
                },
                "extensions": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true
                }
              },
              "additionalProperties": true,
              "required": [
                "message"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "indeed.find_employer_jobs",
      "service": "indeed",
      "name": "find_employer_jobs",
      "description": "List jobs for the employer represented by the OAuth token, with filters and cursor pagination.",
      "operationType": "read",
      "requiredScopes": [
        "employer_access",
        "employer.hosted_job"
      ],
      "providerPermissions": [
        "employer_access",
        "employer.hosted_job"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "legacySourceId": {
            "type": "string",
            "minLength": 1,
            "description": "Sponsored Jobs API source ID filter."
          },
          "jobFeedTypes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Indeed JobFeedType enum value."
            },
            "maxItems": 2
          },
          "includeMultiLocationJobs": {
            "type": "boolean",
            "description": "Whether to include multi-location jobs."
          },
          "jobRequisitionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "ATS requisition ID filter."
            }
          },
          "first": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "Maximum jobs to return.",
            "default": 10
          },
          "before": {
            "type": "string",
            "minLength": 1,
            "description": "Cursor for backward pagination."
          },
          "after": {
            "type": "string",
            "minLength": 1,
            "description": "Cursor for forward pagination."
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "employerJobs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Indeed EmployerJob IRI."
                },
                "jobData": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": true
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "roleData": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": true
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "managementUrls": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": true
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": true,
              "required": [
                "id"
              ]
            }
          },
          "estimatedTotalResultsCount": {
            "type": "integer",
            "minimum": 0,
            "description": "Estimated total number of matching jobs."
          },
          "pageInfo": {
            "type": "object",
            "properties": {
              "endCursor": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Cursor for the next page."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Cursor for the next page."
              },
              "hasNextPage": {
                "type": "boolean",
                "description": "Whether a next page exists."
              },
              "hasPreviousPage": {
                "type": "boolean",
                "description": "Whether a previous page exists."
              },
              "startCursor": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Cursor for the previous page."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Cursor for the previous page."
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "indeed.get_current_user",
      "service": "indeed",
      "name": "get_current_user",
      "description": "Get the Indeed user and associated employers represented by the OAuth access token.",
      "operationType": "read",
      "requiredScopes": [
        "email",
        "employer_access"
      ],
      "providerPermissions": [
        "email",
        "employer_access"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "sub": {
            "type": "string",
            "minLength": 1,
            "description": "Indeed user account ID."
          },
          "email": {
            "type": "string",
            "description": "Email address when the email scope was granted.",
            "format": "email"
          },
          "email_verified": {
            "type": "boolean",
            "description": "Whether Indeed verified the email address."
          },
          "employers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Indeed employer ID."
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Indeed employer name."
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true,
        "required": [
          "sub"
        ]
      }
    },
