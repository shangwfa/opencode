    {
      "id": "workast.search_spaces",
      "service": "workast",
      "name": "search_spaces",
      "description": "Search Workast spaces available to the connected user with filters and pagination.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "onlyUserLists": {
            "type": "boolean",
            "description": "Whether to return only spaces available to the current user."
          },
          "statusIs": {
            "type": "string",
            "enum": [
              "active",
              "archived"
            ],
            "description": "The Workast space status to include."
          },
          "includeTemplates": {
            "type": "boolean",
            "description": "Whether to include Workast team templates."
          },
          "type": {
            "type": "string",
            "enum": [
              "direct",
              "group"
            ],
            "description": "The Workast space type to include."
          },
          "name": {
            "type": "string",
            "description": "Filter spaces by name."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "description": "The maximum number of Workast spaces to return."
          },
          "skip": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of Workast spaces to skip."
          },
          "sort": {
            "type": "string",
            "enum": [
              "name",
              "-name",
              "createdAt",
              "-createdAt"
            ],
            "description": "The order used for Workast space results."
          }
        },
        "additionalProperties": false,
        "description": "Filters and offset pagination for searching Workast spaces."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "spaces": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "One Workast space."
            },
            "description": "The matching Workast spaces."
          }
        },
        "additionalProperties": false,
        "description": "The Workast space search response."
      }
