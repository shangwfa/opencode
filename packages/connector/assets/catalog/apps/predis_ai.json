              "description": "A normalized Predis.ai generated post."
            },
            "description": "Generated Predis.ai posts."
          },
          "totalPages": {
            "anyOf": [
              {
                "type": "integer",
                "description": "The total number of pages returned by Predis.ai."
              },
              {
                "type": "null"
              }
            ],
            "description": "The total number of pages returned by Predis.ai."
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A Predis.ai error object returned by the API."
            },
            "description": "Predis.ai errors returned with the response."
          },
          "raw": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The raw Predis.ai object for forward-compatible fields."
          }
        },
        "additionalProperties": false,
        "required": [
          "posts",
          "totalPages",
          "errors",
          "raw"
        ],
        "description": "The Predis.ai posts response."
      }
    },
