{
  "service": "predis_ai",
  "displayName": "Predis.ai",
  "description": "List Predis.ai templates and posts, and submit AI content generation requests.",
  "categories": [
    "AI",
    "Marketing",
    "Design & Media"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "YOUR_PREDIS_AI_API_KEY",
      "description": "Predis.ai API key sent with the Authorization header. Generate it in the Predis.ai app under Pricing & Account > Rest API: https://app.predis.ai."
    }
  ],
  "homepageUrl": "https://predis.ai",
  "actions": [
    {
      "id": "predis_ai.create_content",
      "service": "predis_ai",
      "name": "create_content",
      "description": "Submit a Predis.ai content generation request and return the created post IDs and immediate generation status.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "brandId": {
            "type": "string",
            "minLength": 1,
            "description": "The Predis.ai brand ID to use for the request."
          },
          "text": {
            "type": "string",
            "minLength": 20,
            "description": "The topic for the post. Predis.ai recommends at least 20 characters and at least 3 words."
          },
          "postType": {
            "type": "string",
            "enum": [
              "generic",
              "meme",
              "quotes"
            ],
            "description": "The Predis.ai post type to filter or generate."
          },
          "modelVersion": {
            "type": "string",
            "enum": [
              "2",
              "4"
            ],
            "description": "The Predis.ai model version to use."
          },
          "postsCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "description": "The number of posts to generate in a single request."
          },
          "inputLanguage": {
            "type": "string",
            "enum": [
              "malay",
              "chinese (traditional)",
              "croatian",
              "english",
              "dutch",
              "indonesian",
              "vietnamese",
              "portuguese_br",
              "finnish",
              "french",
              "german",
              "italian",
              "norwegian",
              "polish",
              "romanian",
              "czech",
              "spanish",
              "swedish",
              "turkish",
              "danish",
              "hungarian"
            ],
            "description": "The language of the input text."
          },
          "outputLanguage": {
            "type": "string",
            "enum": [
              "malay",
              "chinese (traditional)",
              "croatian",
              "english",
              "dutch",
              "indonesian",
              "vietnamese",
              "portuguese_br",
              "finnish",
              "french",
              "german",
              "italian",
              "norwegian",
              "polish",
              "romanian",
              "czech",
              "spanish",
              "swedish",
              "turkish",
              "danish",
              "hungarian"
            ],
            "description": "The language to generate the post in."
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "single_image",
              "carousel",
              "video"
            ],
            "description": "The Predis.ai media type to filter or generate."
          },
          "videoDuration": {
            "type": "string",
            "enum": [
              "short",
              "long"
            ],
            "description": "The video duration when generating video content."
          },
          "templateIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "A template ID."
            },
            "description": "Specific Predis.ai template IDs to use."
          },
          "author": {
            "type": "string",
            "minLength": 1,
            "description": "The quote author when generating quote posts."
          },
          "mediaUrls": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "A publicly reachable media URL.",
              "format": "uri"
            },
            "description": "Image or video URLs that Predis.ai should use in the generated post."
          },
          "colorPaletteType": {
            "type": "string",
            "enum": [
              "brand",
              "ai_suggested"
            ],
            "description": "The color palette source Predis.ai should use."
          },
          "brandDetails": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "Brand details to guide Predis.ai generation."
          },
          "headlines": {
            "type": "array",
            "items": {
              "description": "A Predis.ai headline override item."
            },
            "description": "Headlines or text overrides for generated creatives."
          }
        },
        "additionalProperties": false,
        "required": [
          "brandId",
          "text"
        ],
        "description": "Input for creating Predis.ai content.",
        "anyOf": [
          {
            "required": [
              "mediaType"
            ]
          },
          {
            "required": [
              "templateIds"
            ]
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "postIds": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "A Predis.ai post ID."
            },
            "description": "Predis.ai post IDs submitted for generation."
          },
          "postStatus": {
            "anyOf": [
              {
                "type": "string",
                "description": "The immediate Predis.ai generation status."
              },
              {
                "type": "null"
              }
            ],
            "description": "The immediate Predis.ai generation status."
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A Predis.ai error object returned by the API."
            },
            "description": "Predis.ai errors returned with the response."
          },
          "raw": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The raw Predis.ai object for forward-compatible fields."
          }
        },
        "additionalProperties": false,
        "required": [
          "postIds",
          "postStatus",
          "errors",
          "raw"
        ],
        "description": "The Predis.ai create content response."
      }
    },
    {
