            "items": {
              "type": "object",
              "properties": {
                "_id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The Mixmax sequence identifier."
                },
                "userId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The Mixmax user ID that owns the sequence."
                },
                "createdAt": {
                  "type": "string",
                  "minLength": 1,
                  "description": "When the sequence was created."
                },
                "updatedAt": {
                  "type": "string",
                  "minLength": 1,
                  "description": "When the sequence was last updated."
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The user-configured sequence name."
                },
                "stages": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "description": "A Mixmax sequence stage identifier."
                      },
                      {
                        "type": "object",
                        "properties": {},
                        "additionalProperties": true,
                        "description": "An expanded Mixmax sequence stage."
                      }
                    ],
                    "description": "A sequence stage ID or an expanded stage object."
                  },
                  "description": "The sequence stage IDs or expanded stage objects."
                },
                "variables": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "description": "A sequence variable name."
                  },
                  "description": "The variable names used by the sequence."
                }
              },
              "additionalProperties": true,
              "required": [
                "_id",
                "name"
              ],
              "description": "A Mixmax sequence returned by the API."
            },
            "description": "The Mixmax sequences available to the current user."
          },
          "next": {
            "anyOf": [
              {
                "type": "string",
                "description": "The cursor for the next page."
              },
              {
                "type": "null"
              }
            ],
            "description": "The cursor for the next page."
          },
          "hasNext": {
            "type": "boolean",
            "description": "Whether another sequence page is available."
          },
          "previous": {
            "anyOf": [
              {
                "type": "string",
                "description": "The cursor for the previous page."
              },
              {
                "type": "null"
              }
            ],
            "description": "The cursor for the previous page."
          },
          "hasPrevious": {
            "type": "boolean",
            "description": "Whether a previous sequence page is available."
          }
        },
        "additionalProperties": true,
        "required": [
          "results"
        ],
        "description": "The response returned when listing Mixmax sequences."
      }
    },
    {
