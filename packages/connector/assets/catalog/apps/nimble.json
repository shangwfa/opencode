{
  "service": "nimble",
  "displayName": "Nimble",
  "description": "List, search, create, and update contacts in Nimble CRM.",
  "categories": [
    "Marketing",
    "Productivity"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "nimble_api_key",
      "description": "Nimble API key sent as a Bearer token. Account administrators can generate it in Nimble under Settings > API Token: https://support.nimble.com/en/articles/822159-generate-an-api-key-to-access-the-nimble-api"
    }
  ],
  "homepageUrl": "https://www.nimble.com/",
  "actions": [
    {
      "id": "nimble.create_contact",
      "service": "nimble",
      "name": "create_contact",
      "description": "Create a person or company contact in Nimble using native contact fields.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "description": "The contact field value accepted by Nimble."
                  },
                  "modifier": {
                    "type": "string",
                    "description": "The Nimble modifier for the field value, such as work, home, or mobile."
                  }
                },
                "additionalProperties": true,
                "required": [
                  "value"
                ],
                "description": "One value for a Nimble contact field."
              },
              "description": "The values assigned to one Nimble contact field.",
              "minItems": 1
            },
            "description": "Contact fields keyed by their Nimble field names, such as first name, last name, email, or company name.",
            "minProperties": 1
          },
          "ownerId": {
            "anyOf": [
              {
                "type": "string",
                "description": "The Nimble user ID that should own the contact, or null to leave it unassigned."
              },
              {
                "type": "null"
              }
            ],
            "description": "The Nimble user ID that should own the contact, or null to leave it unassigned."
          },
          "avatarUrl": {
            "type": "string",
            "description": "The avatar URL stored on the contact.",
            "format": "uri"
          }
        },
        "additionalProperties": false,
        "required": [
          "fields"
        ],
        "description": "The Nimble contact to create."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "contact": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The unique Nimble contact ID."
              },
              "fields": {
                "type": "object",
                "additionalProperties": true,
                "description": "The contact fields keyed by their Nimble field names."
              }
            },
            "additionalProperties": true,
            "description": "A contact resource returned by Nimble."
          }
        },
        "additionalProperties": false,
        "description": "The contact created by Nimble."
      }
    },
    {
      "id": "nimble.get_contact",
      "service": "nimble",
