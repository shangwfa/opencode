          "projectCode": {
            "type": "string",
            "minLength": 1,
            "description": "A unique project code."
          },
          "metadata": {
            "type": "string",
            "maxLength": 255,
            "description": "Custom project metadata with at most 255 characters."
          },
          "backgroundColor": {
            "type": "string",
            "minLength": 1,
            "description": "The project display color."
          },
          "useStatusColor": {
            "type": "boolean",
            "description": "Whether to use the default status color."
          },
          "useProjectDuration": {
            "type": "boolean",
            "description": "Whether project display dates are enabled."
          },
          "start": {
            "type": "string",
            "description": "The project display start date in YYYY-MM-DD format.",
