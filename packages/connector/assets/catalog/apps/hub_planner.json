          "end": {
            "type": "string",
            "description": "The project display end date in YYYY-MM-DD format.",
            "format": "date"
          },
          "budgetHours": {
            "type": "number",
            "minimum": 0,
            "description": "The number of budgeted project hours."
          },
          "budgetCashAmount": {
            "type": "number",
            "minimum": 0,
            "description": "The cash budget amount."
