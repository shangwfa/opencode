      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The project name."
          },
          "note": {
            "type": "string",
            "description": "Free-form project notes."
          },
          "status": {
            "type": "string",
            "enum": [
              "STATUS_ACTIVE",
              "STATUS_ARCHIVED",
              "STATUS_PENDING",
              "STATUS_PLANNED",
              "STATUS_FLOATING"
