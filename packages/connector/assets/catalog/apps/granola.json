                    ],
                    "description": "The name of the user."
                  },
                  "email": {
                    "type": "string",
                    "description": "The email address of the user.",
                    "format": "email"
                  }
                },
                "additionalProperties": true,
                "description": "A Granola user object."
              },
              "created_at": {
                "type": "string",
                "description": "The creation time of the note."
              },
              "updated_at": {
