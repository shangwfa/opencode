                "description": "Transcript items returned by Granola."
              },
              "date": {
                "type": "string",
                "description": "MCP only: meeting date when available, not a creation or update timestamp."
              },
              "participants": {
                "type": "string",
                "description": "MCP only: participant names and email addresses as Granola lists them."
