{
  "service": "granola",
  "displayName": "Granola",
  "categories": [
    "AI",
    "Productivity"
  ],
  "authTypes": [
    "oauth2",
    "api_key"
  ],
  "auth": [
    {
      "type": "oauth2",
      "authorizationUrl": "https://mcp-auth.granola.ai/oauth2/authorize",
      "tokenUrl": "https://mcp-auth.granola.ai/oauth2/token",
      "scopes": [
        "openid",
        "profile",
        "email",
        "offline_access"
      ],
      "tokenEndpointAuthMethod": "none",
      "pkce": {
        "method": "S256"
      },
      "authorizationParams": {
        "resource": "https://mcp.granola.ai/mcp"
      },
      "clientSetup": {
        "docsUrl": "https://docs.granola.ai/help-center/sharing/integrations/mcp",
        "steps": [
          "Copy the Callback URL shown below.",
          "POST {\"client_name\":\"Open Connector\",\"redirect_uris\":[\"<Callback URL>\"],\"grant_types\":[\"authorization_code\",\"refresh_token\"],\"response_types\":[\"code\"],\"token_endpoint_auth_method\":\"none\",\"scope\":\"openid profile email offline_access\"} as JSON to https://mcp-auth.granola.ai/oauth2/register.",
          "Copy the returned client_id into the Client ID field below and leave Client Secret empty.",
          "Connect with OAuth for MCP access. The free plan covers personal notes from the last 30 days; some tools require a paid plan."
        ]
      }
    },
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "granola_api_key",
      "description": "For Granola REST API actions on Business or Enterprise plans. Create a key in Granola Settings > Connectors > API keys. Use OAuth for MCP access, including the free plan: https://docs.granola.ai/help-center/sharing/integrations/granola-api."
    }
  ],
  "homepageUrl": "https://www.granola.ai",
  "actions": [
    {
      "id": "granola.get_meeting_transcript",
      "service": "granola",
      "name": "get_meeting_transcript",
      "description": "Read a Granola meeting transcript with OAuth or an API key. Requires an eligible paid Granola plan.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "meeting_id": {
            "type": "string",
            "minLength": 1,
            "description": "Meeting ID returned for this connection."
          }
        },
        "additionalProperties": false,
        "required": [
          "meeting_id"
        ],
        "description": "Meeting whose transcript to retrieve."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "meeting_id": {
            "type": "string",
            "minLength": 1,
            "description": "Native Granola meeting ID."
          },
          "transcript": {
            "type": "string",
            "minLength": 1,
            "description": "Transcript text with speaker labels and timestamps when available."
          }
        },
        "additionalProperties": false,
        "required": [
          "meeting_id",
          "transcript"
        ],
        "description": "Transcript text for the requested meeting."
      }
    },
    {
      "id": "granola.get_meetings",
      "service": "granola",
      "name": "get_meetings",
      "description": "Read Granola meeting details and summaries by ID with OAuth or an API key. Use IDs returned for the same connection. Free-plan OAuth access covers personal notes from the last 30 days.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "meeting_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Meeting ID returned by list_meetings."
            },
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true
          }
        },
        "additionalProperties": false,
        "required": [
          "meeting_ids"
        ],
        "description": "Meetings to retrieve."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "meetings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Meeting ID for this connection. OAuth and API-key IDs are not interchangeable."
                },
                "title": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "Meeting title, when available."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Meeting title, when available."
                },
                "date": {
                  "type": "string",
                  "description": "Meeting date when available, not a creation or update timestamp."
                },
                "attendees": {
                  "type": "string",
                  "description": "Participant names and email addresses when available."
                },
                "summary": {
                  "type": "string",
                  "description": "Meeting summary, preserving its original Markdown when present."
                }
              },
              "additionalProperties": false,
              "required": [
                "id",
                "title"
              ],
              "description": "A Granola meeting."
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "meetings"
        ],
        "description": "Requested meetings in input order."
      }
    },
    {
      "id": "granola.get_note",
