            "additionalProperties": true,
            "required": [
              "id",
              "object",
              "title",
              "owner",
              "created_at",
              "updated_at",
              "web_url",
              "calendar_event",
              "attendees",
              "folder_membership",
              "summary_text",
              "summary_markdown",
