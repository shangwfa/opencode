                    }
                  },
                  "additionalProperties": true,
                  "description": "A Granola user object."
                },
                "description": "Meeting attendees returned by Granola."
              },
              "folder_membership": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
