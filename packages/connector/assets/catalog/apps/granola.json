              "attendees": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "anyOf": [
                        {
                          "type": "string",
                          "description": "The name of the user."
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "The name of the user."
                    },
                    "email": {
                      "type": "string",
