{
  "service": "ringba",
  "displayName": "Ringba",
  "categories": [
    "Marketing",
    "Communication"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Token",
      "placeholder": "RINGBA_API_TOKEN",
      "description": "Ringba API token sent with the Authorization: Token header. Create one from the API Tokens page in the Ringba portal; see https://developers.ringba.com/.",
      "extraFields": [
        {
          "key": "accountId",
          "label": "Default Account ID",
          "inputType": "text",
          "required": false,
          "secret": false,
          "placeholder": "RA-account-id",
          "description": "Optional default Ringba account ID for account-scoped actions. Use get_account to list the accounts accessible to this token."
        }
      ]
    }
  ],
  "homepageUrl": "https://www.ringba.com",
  "actions": [
    {
      "id": "ringba.get_account",
      "service": "ringba",
      "name": "get_account",
      "description": "Get the Ringba account information available to the connected API token.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "description": "The input payload for this Ringba action."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "transactionId": {
            "type": "string",
            "description": "The Ringba transaction ID for the request."
          },
          "account": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The Ringba account ID."
                },
                "name": {
                  "type": "string",
                  "description": "The Ringba account name."
                },
                "accountId": {
                  "type": "string",
                  "description": "The Ringba account ID used by account-scoped endpoints."
                },
                "enabled": {
                  "type": "boolean",
                  "description": "Whether the Ringba account is enabled."
                }
              },
              "additionalProperties": true,
              "description": "A Ringba account object."
            },
            "description": "The Ringba accounts available to the token."
          }
        },
        "additionalProperties": true,
        "required": [
          "transactionId",
          "account"
        ],
        "description": "The Ringba account response."
      }
    },
    {
      "id": "ringba.get_campaign",
