          "campaign": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The Ringba campaign ID."
              },
              "name": {
                "type": "string",
                "description": "The Ringba campaign name."
              },
              "accountId": {
                "type": "string",
                "description": "The Ringba account ID that owns the campaign."
              },
              "enabled": {
                "type": "boolean",
                "description": "Whether the campaign is enabled."
              }
            },
            "additionalProperties": true,
            "description": "A Ringba campaign object."
          }
        },
        "additionalProperties": true,
        "required": [
          "transactionId",
          "campaign"
        ],
        "description": "The Ringba campaign response."
      }
    },
