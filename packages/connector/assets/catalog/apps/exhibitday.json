        },
        "additionalProperties": false,
        "required": [
          "eventId"
        ],
        "description": "The event ID and replacement fields."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "description": "The parsed JSON value returned by ExhibitDay."
