          },
          "venueName": {
            "type": "string",
            "description": "The replacement venue name."
          },
          "venueAddress": {
            "type": "string",
            "description": "The replacement venue address."
          },
          "eventNotes": {
            "type": "string",
            "description": "Replacement event notes."
