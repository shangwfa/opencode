    {
      "id": "exhibitday.list_events",
      "service": "exhibitday",
      "name": "list_events",
      "description": "List ExhibitDay events using workspace, date, format, or tag filters.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "nameContains": {
            "type": "string",
            "description": "Return events whose names contain this case-insensitive text."
          },
          "startDateFrom": {
            "type": "string",
            "description": "Return events starting on or after this date.",
            "format": "date"
          },
          "startDateTo": {
            "type": "string",
            "description": "Return events starting on or before this date.",
            "format": "date"
          },
          "endDateFrom": {
            "type": "string",
            "description": "Return events ending on or after this date.",
            "format": "date"
          },
          "endDateTo": {
            "type": "string",
            "description": "Return events ending on or before this date.",
            "format": "date"
          },
          "participationTypeId": {
            "type": "integer",
            "minimum": 1,
            "description": "Return events with this participation type ID."
          },
          "formatId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "description": "Return events with this format ID from 1 through 3."
          },
          "starRating": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "Return events with this star rating from 0 through 3."
          },
          "tag": {
            "type": "string",
            "description": "Return events with this tag."
          },
          "integrationMetadata1": {
            "type": "string",
            "description": "Match the first integration metadata field exactly."
          },
          "includeTasks": {
            "type": "boolean",
            "description": "Whether to include each event's task collection."
          },
          "includeTaskSections": {
            "type": "boolean",
            "description": "Whether to include each event's task sections."
          },
          "includeCustomFields": {
            "type": "boolean",
            "description": "Whether to include custom event field values."
          }
        },
        "additionalProperties": false,
        "description": "The event list filters."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "description": "The parsed JSON value returned by ExhibitDay."
          }
        },
        "additionalProperties": false,
        "description": "The ExhibitDay API response."
      }
    },
    {
      "id": "exhibitday.list_tasks",
      "service": "exhibitday",
      "name": "list_tasks",
      "description": "List ExhibitDay tasks using event, completion, due-date, or assignee filters.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "integer",
            "minimum": 1,
            "description": "Return tasks associated with this event ID."
          },
          "generalOnly": {
            "type": "boolean",
            "description": "Whether to return only general tasks not associated with an event."
          },
          "incompleteOnly": {
            "type": "boolean",
            "description": "Whether to return only incomplete tasks."
          },
          "completedOnly": {
            "type": "boolean",
            "description": "Whether to return only completed tasks."
          },
          "noDueDate": {
            "type": "boolean",
            "description": "Whether to return only tasks without a due date."
          },
          "dueDateFrom": {
            "type": "string",
            "description": "Return tasks due on or after this date.",
            "format": "date"
          },
          "dueDateTo": {
            "type": "string",
            "description": "Return tasks due on or before this date.",
            "format": "date"
          },
          "hasAssignee": {
            "type": "boolean",
            "description": "Filter tasks by whether they have an assignee."
          },
          "assigneeUserId": {
            "type": "integer",
            "minimum": 1,
            "description": "Return tasks assigned to this user or resource ID."
          },
          "nameContains": {
            "type": "string",
            "description": "Return tasks whose names contain this case-insensitive text."
          },
          "integrationMetadata1": {
            "type": "string",
            "description": "Match the first integration metadata field exactly."
          },
          "includeComments": {
            "type": "boolean",
            "description": "Whether to include each task's comments."
          }
        },
        "additionalProperties": false,
        "description": "The task list filters."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "description": "The parsed JSON value returned by ExhibitDay."
          }
        },
        "additionalProperties": false,
        "description": "The ExhibitDay API response."
      }
    },
