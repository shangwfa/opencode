  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "YOUR_API_KEY",
      "description": "ExhibitDay workspace API key. Copy it from Workspace Settings > API & Integrations > API Access: https://api.exhibitday.com/"
    }
  ],
  "homepageUrl": "https://www.exhibitday.com",
  "actions": [
    {
      "id": "exhibitday.create_event",
      "service": "exhibitday",
      "name": "create_event",
      "description": "Create an event in ExhibitDay.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 500,
            "description": "The event name."
          },
          "startDate": {
            "type": "string",
            "description": "The event start date in YYYY-MM-DD format.",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "description": "The event end date in YYYY-MM-DD format.",
            "format": "date"
          },
          "formatId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "description": "The event format: 1 for in-person, 2 for virtual, or 3 for hybrid."
          },
          "participationTypeId": {
            "type": "integer",
            "minimum": 1,
            "description": "The workspace event participation type ID."
          },
          "integrationMetadata1": {
            "type": "string",
            "description": "Integration-specific metadata stored on the event."
          },
          "integrationMetadata2": {
            "type": "string",
            "description": "A second integration-specific metadata value."
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "startDate",
          "endDate"
        ],
        "description": "The new event fields."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "description": "The parsed JSON value returned by ExhibitDay."
          }
        },
        "additionalProperties": false,
        "description": "The ExhibitDay API response."
      }
    },
