{
  "service": "venafitlsprotectcloud",
  "displayName": "Venafi TLS Protect Cloud",
  "categories": [
    "Security",
    "Developer Tools"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "Paste your Venafi API key",
      "description": "The API key sent as tppl-api-key. Copy it from Avatar > Preferences > API Keys: https://docs.venafi.cloud/api/obtaining-api-key/",
      "extraFields": [
        {
          "key": "region",
          "label": "Region",
          "inputType": "text",
          "placeholder": "us",
          "description": "Venafi Cloud region: us or eu.",
          "required": true,
          "secret": false
        }
      ]
    }
  ],
  "homepageUrl": "https://www.paloaltonetworks.com/network-security/next-gen-trust-security/certificate-manager",
  "actions": [
    {
      "id": "venafitlsprotectcloud.get_certificate",
      "service": "venafitlsprotectcloud",
      "name": "get_certificate",
      "description": "Retrieve a certificate by its Venafi TLS Protect Cloud identifier.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "certificateId": {
            "type": "string",
            "minLength": 1,
            "description": "The unique certificate identifier."
          }
        },
        "additionalProperties": false,
        "description": "The certificate to retrieve."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "certificate": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "A certificate returned by Venafi TLS Protect Cloud."
          }
        },
        "additionalProperties": false,
        "description": "The matching certificate."
      }
    },
    {
      "id": "venafitlsprotectcloud.get_certificate_request",
      "service": "venafitlsprotectcloud",
      "name": "get_certificate_request",
      "description": "Retrieve a certificate request by its Venafi TLS Protect Cloud identifier.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "certificateRequestId": {
            "type": "string",
            "minLength": 1,
            "description": "The unique certificate request identifier."
          }
        },
        "additionalProperties": false,
        "description": "The certificate request to retrieve."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "certificateRequest": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "A certificate request returned by Venafi TLS Protect Cloud."
          }
        },
        "additionalProperties": false,
        "description": "The matching certificate request."
      }
    },
    {
      "id": "venafitlsprotectcloud.list_certificates",
      "service": "venafitlsprotectcloud",
      "name": "list_certificates",
      "description": "List certificates visible to the Venafi TLS Protect Cloud account.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "Maximum number of certificates to return."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Zero-based result offset."
          },
          "subject": {
            "type": "string",
            "description": "Certificate subject text to filter by."
          }
        },
        "additionalProperties": false,
        "description": "Pagination and subject filters for listing certificates."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "certificates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A certificate returned by Venafi TLS Protect Cloud."
            },
            "description": "Certificates returned for this page."
          },
          "total": {
            "anyOf": [
              {
                "type": "integer",
                "description": "Total matching certificates when reported by Venafi."
              },
              {
                "type": "null"
              }
            ],
            "description": "Total matching certificates when reported by Venafi."
          }
        },
        "additionalProperties": false,
        "description": "A page of certificates."
      }
    }
  ]
}
