{
  "service": "coolify",
  "displayName": "Coolify",
  "description": "Inspect applications and manage deployments on a Coolify instance.",
  "categories": [
    "Developer Tools",
    "Infrastructure"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Token",
      "placeholder": "Enter your Coolify API token",
      "description": "A token created in Coolify under Keys & Tokens > API tokens. The token is sent as a Bearer token.",
      "extraFields": [
        {
          "key": "baseUrl",
          "label": "Instance URL",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "https://app.coolify.io",
          "description": "The HTTP or HTTPS URL of your Coolify instance. Public addresses work by default; private-network instances require OOMOL_CONNECT_ALLOW_PRIVATE_NETWORK in the self-hosted runtime."
        }
      ]
    }
  ],
  "homepageUrl": "https://coolify.io",
  "actions": [
    {
      "id": "coolify.deploy_resource",
      "service": "coolify",
      "name": "deploy_resource",
      "description": "Queue a deployment for one Coolify resource UUID.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "minLength": 1,
            "description": "The Coolify resource UUID.",
            "pattern": "\\S"
          },
          "force": {
            "type": "boolean",
            "description": "Whether to rebuild the resource without cache.",
            "default": false
          }
        },
        "additionalProperties": false,
        "required": [
          "uuid"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "deployments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "description": "The result message."
                },
                "deployment_uuid": {
                  "type": "string",
                  "description": "The queued deployment UUID, when one was created."
                }
              },
              "additionalProperties": true,
              "description": "The queued operation result."
            },
            "description": "The deployments queued by Coolify."
          }
        },
        "additionalProperties": true,
        "description": "The Coolify deployment request result."
      }
    },
    {
      "id": "coolify.get_application",
      "service": "coolify",
      "name": "get_application",
      "description": "Get one Coolify application by UUID.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "minLength": 1,
            "description": "The Coolify resource UUID.",
            "pattern": "\\S"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "application": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "description": "The application database ID."
              },
              "uuid": {
                "type": "string",
                "minLength": 1,
                "description": "The Coolify resource UUID.",
                "pattern": "\\S"
              },
              "name": {
                "type": "string",
                "description": "The application name."
              },
              "description": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "The application description."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The application description."
              },
              "status": {
                "type": "string",
                "description": "The current application status."
              },
              "fqdn": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "The application domains."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The application domains."
              },
              "git_repository": {
                "type": "string",
                "description": "The source Git repository."
              },
              "git_branch": {
                "type": "string",
                "description": "The deployed Git branch."
              },
              "created_at": {
                "type": "string",
                "description": "When the application was created.",
                "format": "date-time"
              },
              "updated_at": {
                "type": "string",
                "description": "When the application was last updated.",
                "format": "date-time"
              }
            },
            "additionalProperties": true,
            "description": "A Coolify application."
          }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "coolify.get_application_logs",
      "service": "coolify",
      "name": "get_application_logs",
      "description": "Get recent logs for a Coolify application.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "uuid": {
            "type": "string",
            "minLength": 1,
            "description": "The Coolify resource UUID.",
            "pattern": "\\S"
          },
          "lines": {
            "type": "integer",
            "minimum": 1,
            "description": "The number of lines to return.",
            "default": 100
          },
          "showTimestamps": {
            "type": "boolean",
            "description": "Whether each log line should include its timestamp.",
            "default": false
          }
        },
        "additionalProperties": false,
        "required": [
          "uuid"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "logs": {
            "type": "string",
            "description": "The application log output."
          }
        },
        "additionalProperties": false
      }
    },
