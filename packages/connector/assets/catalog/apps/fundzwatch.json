    {
      "id": "fundzwatch.add_to_watchlist",
      "service": "fundzwatch",
      "name": "add_to_watchlist",
      "description": "Add company domains to the connected account's watchlist.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "domains": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "One company domain.",
              "pattern": "\\S"
            },
            "description": "Company domains to track.",
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "domains"
        ],
        "description": "Domains to add."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "added": {
            "type": "integer",
            "description": "Companies added."
          },
          "alreadyTracked": {
            "type": "integer",
            "description": "Companies already tracked."
          },
          "notFound": {
            "type": "integer",
            "description": "Companies not resolved."
          },
          "totalTracked": {
            "type": "integer",
            "description": "Total tracked after the request."
          },
          "attribution": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "Fundz attribution and licensing metadata."
          }
        },
        "additionalProperties": false,
        "required": [
          "added",
          "alreadyTracked",
          "notFound",
          "totalTracked"
        ],
        "description": "Watchlist addition results."
      }
    },
