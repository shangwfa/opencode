      "inputSchema": {
        "type": "object",
        "properties": {
          "mediaId": {
            "type": "string",
            "minLength": 1,
            "description": "Instagram media ID whose insights should be read."
          },
          "metrics": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "comments",
                "follows",
                "ig_reels_avg_watch_time",
                "ig_reels_video_view_total_time",
                "impressions",
                "likes",
                "link_clicks",
                "navigation",
                "profile_activity",
                "profile_visits",
                "reach",
                "reels_skip_rate",
                "replies",
                "reposts",
                "saved",
                "shares",
                "total_interactions",
                "views"
              ],
              "description": "Instagram Login insight metric."
            },
            "description": "Unique insight metrics to request.",
            "minItems": 1,
            "uniqueItems": true
          },
          "period": {
            "type": "string",
            "enum": [
              "day",
              "week",
              "days_28",
              "month",
              "lifetime",
              "total_over_range"
            ],
            "description": "Optional insight aggregation period."
          },
          "breakdown": {
            "type": "string",
            "enum": [
              "action_type",
              "story_navigation_action_type"
            ],
            "description": "Optional insight breakdown."
          }
        },
        "additionalProperties": false,
        "required": [
          "mediaId",
          "metrics"
        ],
        "description": "Instagram media insights input."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "insights": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Insight result ID when returned."
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Insight metric name."
                },
                "period": {
                  "type": "string",
                  "description": "Aggregation period returned by Meta."
                },
                "title": {
                  "type": "string",
                  "description": "Metric title returned by Meta."
                },
                "description": {
                  "type": "string",
                  "description": "Metric description returned by Meta."
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Metric value and breakdown payload."
                  }
                },
                "totalValue": {
                  "type": "object",
                  "additionalProperties": true,
                  "description": "Metric total and breakdown payload."
                }
              },
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "description": "Structured Instagram insight result."
            },
            "description": "Requested media insights."
          },
          "paging": {
            "type": "object",
            "properties": {
              "before": {
                "type": "string",
                "minLength": 1,
                "description": "Cursor for the preceding page."
              },
              "after": {
                "type": "string",
                "minLength": 1,
                "description": "Cursor for the following page."
              },
              "hasPreviousPage": {
                "type": "boolean",
                "description": "Whether Meta returned a previous-page link."
              },
              "hasNextPage": {
                "type": "boolean",
                "description": "Whether Meta returned a next-page link."
              }
            },
            "additionalProperties": false,
            "required": [
              "hasPreviousPage",
              "hasNextPage"
