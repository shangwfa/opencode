    {
      "id": "instagram.create_comment",
      "service": "instagram",
      "name": "create_comment",
      "description": "Create a top-level comment on owned Instagram media. Live-video comments are unsupported and provider errors are returned as failures.",
      "operationType": "write",
      "requiredScopes": [
        "instagram_business_basic",
        "instagram_business_manage_comments"
      ],
      "providerPermissions": [
        "instagram_business_basic",
        "instagram_business_manage_comments"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "mediaId": {
            "type": "string",
            "minLength": 1,
            "description": "Instagram media ID to comment on."
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "Comment text.",
            "pattern": "\\S"
          }
        },
        "additionalProperties": false,
        "required": [
          "mediaId",
          "message"
        ],
        "description": "Top-level Instagram comment input."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "commentId": {
            "type": "string",
            "minLength": 1,
            "description": "New Instagram comment ID."
          },
          "mediaId": {
            "type": "string",
            "minLength": 1,
            "description": "Commented media ID."
          }
        },
        "additionalProperties": false,
        "required": [
          "commentId",
          "mediaId"
        ],
        "description": "Created top-level comment result."
      }
    },
