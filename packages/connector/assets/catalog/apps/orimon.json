{
  "service": "orimon",
  "displayName": "Orimon",
  "homepageUrl": "https://orimon.ai",
  "categories": [
    "AI",
    "Communication"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "Developer API Key",
      "placeholder": "ORIMON_API_KEY",
      "description": "Orimon Developer API key sent with the authorization header. Generate or manage it from Profile in the Orimon dashboard: https://orimon.gitbook.io/docs/developer-api/getting-started-with-apis#how-to-generate-your-developer-api-key"
    }
  ],
  "actions": [
    {
      "id": "orimon.send_message",
      "service": "orimon",
      "name": "send_message",
      "description": "Send a text message to an Orimon chatbot and return its response.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "minLength": 1,
            "description": "The unique ID of the target Orimon chatbot.",
            "pattern": "\\S"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "The text message to send to the chatbot.",
            "pattern": "\\S"
          },
          "psid": {
            "type": "string",
            "minLength": 1,
            "description": "A stable platform session ID used to continue a conversation. A UUID-based value is generated when omitted.",
            "pattern": "\\S"
          },
          "messageId": {
            "type": "string",
            "minLength": 1,
            "description": "A unique ID for this user message. A UUID is generated when omitted.",
            "pattern": "\\S"
          }
        },
        "additionalProperties": false,
        "required": [
          "tenantId",
          "message"
        ],
        "description": "A text message and conversation identifiers for an Orimon chatbot."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "The request status reported by Orimon."
          },
          "message": {
            "type": "string",
            "description": "The request result message reported by Orimon."
          },
          "data": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "description": "The returned event type."
              },
              "timestamp": {
                "type": "string",
                "description": "The timestamp of the response."
              },
              "psid": {
                "type": "string",
                "description": "The platform session identifier used for the conversation."
              },
              "sessionId": {
                "type": "string",
                "description": "The Orimon session identifier for the conversation."
              },
              "messages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "chatLogId": {
                      "type": "string",
                      "description": "The Orimon chat log identifier for this exchange."
                    },
                    "sessionId": {
                      "type": "string",
                      "description": "The Orimon session identifier for the conversation."
                    },
                    "psid": {
                      "type": "string",
                      "description": "The caller-provided platform session identifier."
                    },
                    "tenantId": {
                      "type": "string",
                      "description": "The unique identifier of the Orimon chatbot."
                    },
                    "id": {
                      "type": "string",
                      "description": "The unique identifier of the returned message."
                    },
                    "type": {
                      "type": "string",
                      "description": "The returned message type."
                    },
                    "payload": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string",
                          "description": "The chatbot response text."
                        },
                        "buttons": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {},
                            "additionalProperties": true,
                            "description": "A provider-defined chatbot button."
                          },
                          "description": "Button options configured for the chatbot response."
                        }
                      },
                      "additionalProperties": true,
                      "description": "The chatbot response payload."
                    },
                    "timestamp": {
                      "type": "string",
                      "description": "The timestamp of the returned message."
                    },
                    "customMessage": {
                      "type": "boolean",
                      "description": "Whether the returned message is a custom chatbot message."
                    }
                  },
                  "additionalProperties": true,
                  "description": "A message returned by the Orimon chatbot."
                },
                "description": "Messages returned by the chatbot."
              },
              "statuses": {
                "type": "array",
                "items": {
                  "description": "A provider-defined conversation status."
                },
                "description": "Provider-defined conversation statuses returned by Orimon."
              }
            },
            "additionalProperties": true,
            "description": "Conversation data returned by Orimon."
          }
        },
        "additionalProperties": true,
        "description": "The response returned by the Orimon Message API."
      }
    }
  ]
}
