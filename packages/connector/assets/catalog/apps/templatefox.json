                      "type": "null"
                    }
                  ],
                  "description": "Nested field spec for array fields."
                }
              },
              "additionalProperties": true,
              "required": [
                "key",
                "label",
                "type",
                "required",
                "helpText",
                "spec"
              ],
              "description": "TemplateFox template field definition."
            },
            "description": "Template fields."
          }
        },
        "additionalProperties": false,
        "required": [
          "fields"
        ],
        "description": "Template field definitions returned by TemplateFox."
      }
