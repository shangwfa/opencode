    {
      "id": "templatefox.merge_pdfs",
      "service": "templatefox",
      "name": "merge_pdfs",
      "description": "Merge multiple PDF URLs with TemplateFox and return a signed download URL for the result.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "pdfUrls": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Public HTTPS URL for TemplateFox to download the PDF.",
              "format": "uri"
            },
            "description": "Ordered PDF URLs to merge.",
            "minItems": 2
          },
          "expiration": {
            "type": "integer",
            "minimum": 60,
            "maximum": 604800,
            "description": "Signed URL expiration in seconds."
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Custom output filename without the file extension."
          }
        },
        "additionalProperties": false,
        "required": [
          "pdfUrls"
        ],
        "description": "Input for merging PDF URLs."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Signed URL to download the generated PDF.",
            "format": "uri"
          },
          "filename": {
            "type": "string",
            "description": "Filename of the generated PDF."
          },
          "creditsRemaining": {
            "type": "integer",
            "description": "Remaining TemplateFox credits after the request."
          },
          "expiresIn": {
            "type": "integer",
            "description": "Seconds until the signed URL expires."
          }
        },
        "additionalProperties": false,
        "required": [
          "url",
          "filename",
          "creditsRemaining",
          "expiresIn"
        ],
        "description": "Generated PDF URL result returned by TemplateFox."
      }
    },
    {
      "id": "templatefox.rotate_pdf",
      "service": "templatefox",
      "name": "rotate_pdf",
      "description": "Rotate all pages or selected pages in a PDF URL with TemplateFox and return a signed download URL.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "pdfUrl": {
            "type": "string",
            "description": "Public HTTPS URL for TemplateFox to download the PDF.",
            "format": "uri"
          },
          "rotation": {
            "type": "integer",
            "enum": [
              0,
              90,
              180,
              270
            ],
            "description": "Rotation in degrees applied to every page."
          },
          "pageRotations": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[1-9][0-9]*$"
            },
            "additionalProperties": {
              "type": "integer",
              "enum": [
                0,
                90,
                180,
                270
              ],
              "description": "Rotation in degrees for this page."
            },
            "description": "Per-page rotations keyed by 1-indexed page number."
          },
          "expiration": {
            "type": "integer",
            "minimum": 60,
            "maximum": 604800,
            "description": "Signed URL expiration in seconds."
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Custom output filename without the file extension."
          }
        },
        "additionalProperties": false,
        "required": [
          "pdfUrl"
        ],
        "description": "Input for rotating pages in a PDF.",
        "oneOf": [
          {
            "required": [
              "rotation"
            ],
            "not": {
              "required": [
                "pageRotations"
              ]
            }
          },
          {
            "required": [
              "pageRotations"
            ],
            "not": {
              "required": [
                "rotation"
              ]
            }
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Signed URL to download the generated PDF.",
            "format": "uri"
          },
          "filename": {
            "type": "string",
            "description": "Filename of the generated PDF."
          },
          "creditsRemaining": {
            "type": "integer",
            "description": "Remaining TemplateFox credits after the request."
          },
          "expiresIn": {
            "type": "integer",
            "description": "Seconds until the signed URL expires."
          }
        },
        "additionalProperties": false,
        "required": [
          "url",
          "filename",
          "creditsRemaining",
          "expiresIn"
        ],
        "description": "Generated PDF URL result returned by TemplateFox."
      }
    }
  ]
}
