              },
              "email": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Account email address returned by TemplateFox."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Account email address returned by TemplateFox."
              }
            },
            "additionalProperties": false,
            "required": [
              "credits",
              "email"
            ],
            "description": "TemplateFox account information."
          }
        },
        "additionalProperties": false,
        "required": [
          "account"
        ],
        "description": "TemplateFox account output."
      }
    },
    {
      "id": "templatefox.get_template_fields",
      "service": "templatefox",
      "name": "get_template_fields",
      "description": "Get dynamic field definitions for a TemplateFox template.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "templateId": {
            "type": "string",
            "minLength": 12,
            "maxLength": 12,
            "description": "The 12-character TemplateFox template ID."
          }
        },
        "additionalProperties": false,
        "required": [
          "templateId"
        ],
        "description": "Input for reading TemplateFox template fields."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "description": "Template field key."
                },
                "label": {
                  "type": "string",
                  "description": "Template field label."
                },
                "type": {
                  "type": "string",
                  "description": "Template field type."
                },
                "required": {
                  "type": "boolean",
                  "description": "Whether the field is required."
                },
                "helpText": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "Help text returned by TemplateFox."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Help text returned by TemplateFox."
                },
                "spec": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "description": "Nested field name."
                          },
                          "label": {
                            "type": "string",
                            "description": "Nested field label."
                          },
                          "type": {
                            "type": "string",
                            "description": "Nested field type."
                          }
                        },
                        "additionalProperties": true,
                        "required": [
                          "name",
