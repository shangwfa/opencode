{
  "service": "templatefox",
  "displayName": "TemplateFox",
  "categories": [
    "Design & Media",
    "Developer Tools"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "TEMPLATEFOX_API_KEY",
      "description": "TemplateFox API key sent with the x-api-key header. Create or copy it from the API key section of the TemplateFox dashboard at https://app.templatefox.com/dashboard; see https://templatefox.com/docs/api-reference."
    }
  ],
  "homepageUrl": "https://templatefox.com",
  "actions": [
    {
      "id": "templatefox.create_image",
      "service": "templatefox",
      "name": "create_image",
      "description": "Generate an image from a TemplateFox image template and return a signed download URL.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "templateId": {
            "type": "string",
            "minLength": 12,
            "maxLength": 12,
            "description": "The 12-character TemplateFox template ID."
          },
          "modifications": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "description": "Layer name to modify."
                },
                "text": {
                  "type": "string",
                  "maxLength": 10000,
                  "description": "Replacement text for the layer."
                },
                "imageUrl": {
                  "type": "string",
                  "maxLength": 2000,
                  "description": "Replacement image URL for the layer.",
                  "format": "uri"
                },
                "color": {
                  "type": "string",
                  "maxLength": 100,
                  "description": "CSS text color applied to the layer."
                },
                "background": {
                  "type": "string",
                  "maxLength": 100,
                  "description": "CSS background color applied to the layer."
                },
                "hidden": {
                  "type": "boolean",
                  "description": "Whether the layer should be hidden."
                }
              },
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "description": "A single image template layer modification."
            },
            "description": "Layer modifications to apply before rendering.",
            "maxItems": 100
          },
          "data": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "Template data keyed by TemplateFox variable names."
          },
          "format": {
            "type": "string",
            "enum": [
              "png",
              "jpeg",
              "webp"
            ],
            "description": "Generated image format."
          },
          "width": {
            "type": "integer",
            "minimum": 100,
            "maximum": 4000,
            "description": "Output width in pixels."
          },
          "quality": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "JPEG or WebP compression quality from 1 to 100."
          },
          "expiration": {
            "type": "integer",
            "minimum": 60,
            "maximum": 604800,
            "description": "Signed URL expiration in seconds."
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Custom output filename without the file extension."
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "Template version tag or version number. When omitted, TemplateFox uses the current draft."
          }
        },
        "additionalProperties": false,
        "required": [
          "templateId"
        ],
        "description": "Input for generating an image from a TemplateFox template."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Signed URL to download the generated image.",
            "format": "uri"
          },
          "filename": {
            "type": "string",
            "description": "Filename of the generated image."
          },
          "creditsRemaining": {
            "type": "integer",
            "description": "Remaining TemplateFox credits after the request."
          },
          "expiresIn": {
            "type": "integer",
            "description": "Seconds until the signed URL expires."
          },
          "warnings": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A warning message."
                },
                "description": "Non-fatal warnings returned by TemplateFox."
              },
              {
                "type": "null"
              }
            ],
            "description": "Non-fatal warnings returned by TemplateFox."
          }
        },
        "additionalProperties": false,
        "required": [
          "url",
          "filename",
          "creditsRemaining",
          "expiresIn",
          "warnings"
        ],
        "description": "Generated image URL result returned by TemplateFox."
      }
    },
    {
