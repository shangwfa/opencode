      "service": "navigatr",
      "name": "verify_badge_assertion",
      "description": "Verify a badge assertion and retrieve the result and reasons. This updates or clears the persisted time_verified field and the public verification indicator.",
      "operationType": "destructive",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
