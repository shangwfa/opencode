                "badge_id": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "description": "Navigatr badge ID."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Navigatr badge ID."
                },
                "recipient_id": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "description": "Recipient user ID."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Recipient user ID."
                },
                "url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "Public assertion URL."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Public assertion URL."
                }
              },
              "additionalProperties": true,
              "description": "Badge assertion details; recipient fields depend on caller permissions."
            },
            "description": "Results in this response."
          },
          "total": {
            "type": "integer",
            "description": "Total matching results."
          },
          "page": {
            "type": "integer",
            "description": "Current page number."
          },
          "size": {
            "type": "integer",
            "description": "Requested page size."
          },
          "pages": {
            "type": "integer",
            "description": "Total pages."
          }
        },
        "additionalProperties": true,
        "description": "Results with pagination metadata when requested."
      }
    },
    {
      "id": "navigatr.list_badges",
      "service": "navigatr",
      "name": "list_badges",
      "description": "List badges for a provider, community, QA community, or issuer. Public API access is limited to the connected user's own provider or community.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "provider_id": {
            "type": "integer",
            "description": "Issuing provider ID; must be one of the badge's providers."
          },
          "community_id": {
            "type": "integer",
            "description": "Community ID."
          },
          "qa_community_id": {
            "type": "integer",
            "description": "Quality assurance community ID."
          },
          "issuer_id": {
            "type": "integer",
            "description": "Badge issuer ID."
          },
          "featured": {
            "type": "boolean",
            "description": "Filter by featured status."
          },
          "qa_required": {
            "type": "boolean",
            "description": "Filter by whether quality assurance is required."
          },
          "type": {
            "type": "string",
            "enum": [
              "Experience",
              "Learning",
              "Validation",
              "Certification",
              "Attendance",
              "Work_Experience",
              "Volunteering",
              "Job",
              "Apprenticeship",
              "Course",
              "Internship",
              "Workshop",
              "Campaigning",
              "Activism",
              "Other",
              "Informal_Learning",
              "Training",
              "Certified",
              "Qualification",
              "Membership"
            ],
            "description": "Badge type."
          },
          "recipient_type": {
            "type": "string",
            "enum": [
              "User",
              "Organisation"
            ],
            "description": "Recipient type."
          },
          "source": {
            "type": "string",
            "description": "Badge source, such as Internal or Credly."
          },
          "order_by": {
            "type": "string",
            "enum": [
              "Time_Created_Asc",
              "Time_Created_Desc",
              "Time_Updated_Asc",
              "Time_Updated_Desc",
              "Name_Asc",
              "Name_Desc"
            ],
            "description": "Sort order."
          },
          "keyword": {
            "type": "string",
            "description": "Search badge names."
          },
          "status": {
            "type": "string",
            "description": "Comma-separated badge statuses."
          },
          "paginated": {
            "type": "boolean",
            "description": "Return a paginated response; defaults to true upstream."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "Page number, starting at 1."
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Results per page, from 1 to 100."
          }
        },
        "additionalProperties": false,
        "description": "Badge filters; supply at least one provider, community, QA community, or issuer ID.",
        "anyOf": [
          {
            "required": [
              "provider_id"
            ]
          },
          {
            "required": [
              "community_id"
            ]
          },
          {
            "required": [
              "qa_community_id"
            ]
          },
          {
            "required": [
              "issuer_id"
            ]
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "description": "Navigatr badge ID."
                },
                "name": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "Badge name."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Badge name."
                },
                "status": {
                  "type": "string",
                  "description": "Badge publication status."
                },
                "url": {
                  "type": "string",
                  "description": "Public badge URL."
                },
                "providers": {
                  "anyOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {},
                        "additionalProperties": true,
                        "description": "Issuing provider details."
                      },
                      "description": "Providers that can issue this badge."
                    },
                    {
                      "type": "null"
