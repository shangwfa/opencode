    {
      "id": "onfleet.list_tasks",
      "service": "onfleet",
      "name": "list_tasks",
      "description": "List Onfleet tasks in a time range with cursor pagination and task filters.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "integer",
            "description": "The inclusive start time in Unix milliseconds."
          },
          "to": {
            "type": "integer",
            "description": "The exclusive end time in Unix milliseconds."
          },
          "lastId": {
            "type": "string",
            "minLength": 1,
            "description": "The pagination cursor returned by the previous page.",
            "pattern": "\\S"
          },
          "state": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3,
              "description": "An Onfleet task state."
            },
            "description": "Task states to include: 0 unassigned, 1 assigned, 2 active, or 3 completed."
          },
          "worker": {
            "type": "string",
            "minLength": 1,
            "description": "The worker ID used to filter tasks.",
            "pattern": "\\S"
          },
          "completeBeforeBefore": {
            "type": "integer",
            "description": "Only include tasks whose completeBefore is before this Unix millisecond timestamp."
          },
          "completeAfterAfter": {
            "type": "integer",
            "description": "Only include tasks whose completeAfter is after this Unix millisecond timestamp."
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Dependency task IDs used to filter tasks."
          },
          "containers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Worker, team, or organization container IDs used to filter tasks."
          }
        },
        "additionalProperties": false,
        "required": [
          "from"
        ],
        "description": "The input payload for listing Onfleet tasks."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "The task object returned by Onfleet."
            },
            "description": "The tasks returned for this page."
          },
          "lastId": {
            "type": "string",
            "minLength": 1,
            "description": "The cursor for the next page, when another page exists.",
            "pattern": "\\S"
          }
        },
        "additionalProperties": false,
        "required": [
          "tasks"
        ],
        "description": "A page of Onfleet tasks."
      }
    },
