{
  "service": "tuskr",
  "displayName": "Tuskr",
  "description": "Manage projects, test cases, test runs, and results in Tuskr.",
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "Permanent Access Token",
      "placeholder": "tuskr_access_token",
      "description": "Tuskr permanent access token sent with the Authorization: Bearer <token> header. Create it from Top Menu > profile icon > API in Tuskr: https://tuskr.app/kb/latest/api",
      "extraFields": [
        {
          "key": "tenantId",
          "label": "Tenant ID",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "5f465f45-37d2-4209-8764-3b0f8aee1754",
          "description": "Tuskr tenant ID used in every API path. Find it from Top Menu > profile icon > API in Tuskr: https://tuskr.app/kb/latest/api"
        }
      ]
    }
  ],
  "homepageUrl": "https://tuskr.app",
  "actions": [
    {
      "id": "tuskr.add_test_run_results",
      "service": "tuskr",
      "name": "add_test_run_results",
      "description": "Add the same Tuskr result to multiple test cases in a test run.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "minLength": 1,
            "description": "Tuskr result status key, such as PASSED or FAILED."
          },
          "testRun": {
            "type": "string",
            "minLength": 1,
            "description": "Tuskr ID, key, name, or email accepted by the API."
          },
          "testCases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Tuskr ID, key, name, or email accepted by the API."
            },
            "description": "Test case IDs, keys, or names to update.",
            "minItems": 1
          },
          "assignedTo": {
            "type": "string",
            "minLength": 1,
            "description": "Tuskr ID, key, name, or email accepted by the API."
          },
          "comments": {
            "type": "string",
            "minLength": 1,
            "description": "Result comments."
          },
          "timeSpentInMinutes": {
            "type": "integer",
            "minimum": 0,
            "description": "Time spent in minutes."
          },
          "customFields": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "Custom fields keyed by Tuskr custom field key."
          }
        },
        "additionalProperties": false,
        "required": [
          "status",
          "testRun",
          "testCases"
        ],
        "description": "The input payload for adding Tuskr results to test cases in a test run."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "raw": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "Provider-specific object returned by Tuskr."
          }
        },
        "additionalProperties": false,
        "required": [
          "raw"
        ],
        "description": "Tuskr object response."
      }
    },
