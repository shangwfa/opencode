    {
      "id": "tuskr.create_test_run",
      "service": "tuskr",
      "name": "create_test_run",
      "description": "Create a Tuskr test run.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Name of the Tuskr test run to create."
          },
          "project": {
            "type": "string",
            "minLength": 1,
            "description": "Tuskr ID, key, name, or email accepted by the API."
          },
          "testCaseInclusionType": {
            "type": "string",
            "enum": [
              "ALL",
              "SPECIFIC"
            ],
            "description": "Which test cases to include in the run."
          },
          "testCases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Tuskr ID, key, name, or email accepted by the API."
            },
            "description": "Test case IDs, keys, or names to include.",
            "minItems": 1
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Test run description."
          },
          "deadline": {
            "type": "string",
            "description": "Test run deadline in YYYY-MM-DD format.",
            "format": "date"
          },
          "assignedTo": {
            "type": "string",
            "minLength": 1,
            "description": "Tuskr ID, key, name, or email accepted by the API."
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "project",
          "testCaseInclusionType"
        ],
        "description": "The input payload for creating a Tuskr test run.",
        "if": {
          "properties": {
            "testCaseInclusionType": {
              "const": "SPECIFIC"
            }
          },
          "required": [
            "testCaseInclusionType"
          ]
        },
        "then": {
          "required": [
            "testCases"
          ]
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "raw": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "Provider-specific object returned by Tuskr."
          }
        },
        "additionalProperties": false,
        "required": [
          "raw"
        ],
        "description": "Tuskr object response."
      }
    },
