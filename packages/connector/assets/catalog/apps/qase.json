    {
      "id": "qase.complete_run",
      "service": "qase",
      "name": "complete_run",
      "description": "Complete an active test run in a Qase project.",
      "operationType": "destructive",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectCode": {
            "type": "string",
            "minLength": 2,
            "maxLength": 10,
            "description": "The Qase project code."
          },
          "runId": {
            "type": "integer",
            "minimum": 1,
            "description": "The Qase entity ID."
          }
        },
        "additionalProperties": false,
        "description": "Identifies the Qase test run to complete."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "completed": {
            "type": "boolean",
            "description": "Whether the test run was completed."
          }
        },
        "additionalProperties": false,
        "description": "Confirms that the Qase test run was completed."
      }
    },
    {
      "id": "qase.create_case",
      "service": "qase",
      "name": "create_case",
      "description": "Create a test case in a Qase project.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectCode": {
            "type": "string",
            "minLength": 2,
            "maxLength": 10,
            "description": "The Qase project code."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "The test case title."
          },
          "description": {
            "type": "string",
            "description": "The test case description."
          },
          "preconditions": {
            "type": "string",
            "description": "Conditions that must be met before the test begins."
          },
          "postconditions": {
            "type": "string",
            "description": "Conditions expected after the test finishes."
          },
          "suiteId": {
            "type": "integer",
            "minimum": 1,
            "description": "The Qase entity ID."
          },
          "isManual": {
            "type": "boolean",
            "description": "Whether the test case is manual."
          },
          "isToBeAutomated": {
            "type": "boolean",
            "description": "Whether a manual test case is planned for automation."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "A tag name."
            },
            "description": "Tags to assign to the test case."
          }
        },
        "additionalProperties": false,
        "required": [
          "projectCode",
          "title"
        ],
        "description": "Defines the Qase test case to create."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "integer",
            "minimum": 1,
            "description": "The Qase entity ID."
          }
        },
        "additionalProperties": false,
        "description": "Identifies the created Qase test case."
      }
    },
