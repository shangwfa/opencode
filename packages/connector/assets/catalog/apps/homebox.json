          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The maintenance entry name, for example Air filter replacement."
          },
          "completedDate": {
            "type": "string",
            "description": "A date in YYYY-MM-DD format.",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "scheduledDate": {
            "type": "string",
            "description": "A date in YYYY-MM-DD format.",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "description": {
            "type": "string",
            "description": "An optional description of the maintenance work."
          },
          "cost": {
            "type": "string",
            "description": "The maintenance cost as a number string, for example 1500."
          }
        },
        "additionalProperties": false,
        "required": [
          "entityId",
          "name"
        ],
        "description": "Input parameters for adding one maintenance entry."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "entry": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The created maintenance entry."
          }
        },
        "additionalProperties": false,
        "required": [
          "entry"
        ],
        "description": "The created HomeBox maintenance entry."
      }
    },
