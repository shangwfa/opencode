      "id": "homebox.update_entity",
      "service": "homebox",
      "name": "update_entity",
      "description": "Update one HomeBox entity. Only the provided fields change; all other entity data (serial number, warranty, custom fields, ...) is preserved. Custom fields are replaced as a whole when fields is provided.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "entityId": {
            "type": "string",
            "minLength": 1,
            "description": "The entity UUID to update."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The entity name."
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "description": "The entity description; pass null to clear it."
              },
              {
                "type": "null"
              }
            ],
            "description": "The entity description; pass null to clear it."
          },
          "quantity": {
            "type": "integer",
            "description": "The quantity."
          },
          "insured": {
            "type": "boolean",
            "description": "Whether the entity is insured."
          },
          "archived": {
            "type": "boolean",
            "description": "Whether the entity is archived."
          },
          "entityTypeId": {
            "type": "string",
            "description": "The entity type UUID; when omitted the current type is kept."
          },
          "tagIds": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "One tag UUID."
            },
            "description": "The tag UUIDs."
          },
          "parentId": {
            "anyOf": [
              {
                "type": "string",
                "description": "The parent entity UUID, or null to unset it."
              },
              {
                "type": "null"
              }
            ],
            "description": "The parent entity UUID, or null to unset it."
          },
          "serialNumber": {
            "type": "string",
            "description": "The serial number."
          },
          "modelNumber": {
            "type": "string",
            "description": "The model number."
          },
          "manufacturer": {
            "type": "string",
            "description": "The manufacturer."
          },
          "lifetimeWarranty": {
            "type": "boolean",
            "description": "Whether the entity has a lifetime warranty."
          },
          "warrantyExpires": {
            "type": "string",
            "description": "A date in YYYY-MM-DD format.",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "warrantyDetails": {
            "type": "string",
            "description": "Warranty details."
          },
          "purchaseDate": {
            "type": "string",
