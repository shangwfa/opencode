          }
        },
        "additionalProperties": false,
        "required": [
          "personId"
        ],
        "description": "The Humaans person to retrieve."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "person": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "The unique Humaans person identifier."
              }
            },
            "additionalProperties": true,
            "required": [
              "id"
            ],
