      "description": "Create or manage an API access token using the official instructions: https://docs.humaans.io/api/#authentication"
    }
  ],
  "homepageUrl": "https://humaans.io",
  "actions": [
    {
      "id": "humaans.get_current_person",
      "service": "humaans",
      "name": "get_current_person",
      "description": "Retrieve the Humaans person record that owns the current API access token using public:read or private:read access.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "description": "No input is required to retrieve the current Humaans person."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "person": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "description": "The unique Humaans person identifier."
              }
            },
            "additionalProperties": true,
            "required": [
              "id"
            ],
            "description": "A Humaans person record."
          }
        },
        "additionalProperties": false,
        "required": [
          "person"
        ],
        "description": "A Humaans person response."
      }
    },
    {
      "id": "humaans.get_person",
      "service": "humaans",
      "name": "get_person",
