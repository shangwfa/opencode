    },
    {
      "id": "humaans.list_people",
      "service": "humaans",
      "name": "list_people",
      "description": "List Humaans people with common exact-match filters and offset pagination using public:read or private:read access.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1,
            "description": "Filter people by exact first name."
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "description": "Filter people by exact last name."
          },
          "preferredName": {
            "type": "string",
            "minLength": 1,
            "description": "Filter people by exact preferred name."
          },
          "email": {
            "type": "string",
            "description": "Filter people by exact work email address.",
            "format": "email"
          },
          "personalEmail": {
            "type": "string",
            "description": "Filter people by exact personal email address.",
            "format": "email"
          },
          "spaceId": {
            "type": "string",
            "minLength": 1,
            "description": "Filter people by Humaans Space identifier."
          },
          "teamId": {
            "type": "string",
            "minLength": 1,
            "description": "Filter people by Humaans team identifier."
          },
          "status": {
            "type": "string",
            "enum": [
              "all",
              "newHire",
              "active",
              "offboarded"
            ],
            "description": "Filter people by Humaans employment status."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 250,
            "description": "The maximum number of people to return, from 1 to 250."
          },
          "skip": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of matching people to skip before returning results."
          }
        },
        "additionalProperties": false,
        "description": "Filters and pagination for listing Humaans people."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0,
            "description": "The total number of people matching the request."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 250,
            "description": "The page size reported by Humaans."
          },
          "skip": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of matching people skipped by Humaans."
          },
          "people": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The unique Humaans person identifier."
                }
              },
              "additionalProperties": true,
              "required": [
                "id"
              ],
              "description": "A Humaans person record."
            },
            "description": "People returned for this page."
          }
        },
        "additionalProperties": false,
        "required": [
          "total",
          "limit",
          "skip",
          "people"
        ],
        "description": "A paginated Humaans people response."
      }
    }
  ]
}
