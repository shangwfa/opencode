    {
      "id": "humaans.get_token_info",
      "service": "humaans",
      "name": "get_token_info",
      "description": "Retrieve the scopes granted to the current Humaans API access token.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "description": "No input is required to retrieve Humaans token information."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "scopes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "One scope granted to the current Humaans access token."
            },
            "description": "Scopes granted to the current Humaans access token."
          }
        },
        "additionalProperties": false,
        "required": [
          "scopes"
        ],
        "description": "The current Humaans access token scopes."
