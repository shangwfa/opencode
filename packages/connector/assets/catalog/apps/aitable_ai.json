    {
      "id": "aitable_ai.delete_records",
      "service": "aitable_ai",
      "name": "delete_records",
      "description": "Delete up to 10 records from an AITable datasheet.",
      "operationType": "destructive",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "datasheetId": {
            "type": "string",
            "minLength": 1,
            "description": "The AITable datasheet ID."
          },
          "recordIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "An AITable record ID.",
              "pattern": "^[^,]+$"
            },
            "description": "The record IDs to delete, with a maximum of 10 per request.",
            "minItems": 1,
            "maxItems": 10
          }
        },
        "additionalProperties": false,
        "required": [
          "datasheetId",
          "recordIds"
        ],
        "description": "Input for deleting AITable records."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean",
            "description": "Whether AITable confirmed the deletion."
          }
        },
        "additionalProperties": false,
        "required": [
          "deleted"
        ],
        "description": "AITable record deletion result."
      }
    },
