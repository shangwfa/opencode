      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "datasheetId": {
            "type": "string",
            "minLength": 1,
            "description": "The AITable datasheet ID."
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "The number of records per page, from 1 to 1000."
          },
          "pageNum": {
            "type": "integer",
            "minimum": 1,
            "description": "The one-based page number to return."
          },
          "maxRecords": {
            "type": "integer",
            "minimum": 1,
            "description": "The maximum total number of records to return."
          },
          "viewId": {
            "type": "string",
            "minLength": 1,
            "description": "The view whose records and visible fields should be returned."
          },
          "filterByFormula": {
            "type": "string",
            "minLength": 1,
            "description": "An AITable formula used to filter records."
          },
          "fieldKey": {
            "type": "string",
            "enum": [
              "name",
              "id"
            ],
            "description": "Whether field names or field IDs identify record fields."
          },
