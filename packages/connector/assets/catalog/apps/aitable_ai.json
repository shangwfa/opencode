            "type": "string",
            "enum": [
              "json",
              "string"
            ],
            "description": "The representation used for cell values."
          }
        },
        "additionalProperties": false,
        "required": [
          "datasheetId"
        ],
        "description": "Input for listing a page of AITable records."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "pageNum": {
            "type": "integer",
            "description": "The returned page number."
          },
          "pageSize": {
            "type": "integer",
            "description": "The returned page size."
          },
          "total": {
            "type": "integer",
            "description": "The total number of matching records."
          },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "recordId": {
                  "type": "string",
                  "description": "The stable AITable record ID."
                },
                "fields": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true,
                  "description": "Field values keyed by field name or field ID."
                }
              },
              "additionalProperties": true,
              "required": [
                "recordId",
                "fields"
              ],
              "description": "An AITable record with provider-defined field values."
            },
            "description": "Records in the returned page."
          }
        },
        "additionalProperties": false,
        "required": [
          "pageNum",
          "pageSize",
          "total",
          "records"
        ],
        "description": "A page of AITable records."
      }
