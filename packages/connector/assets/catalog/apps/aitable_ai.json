      "id": "aitable_ai.create_records",
      "service": "aitable_ai",
      "name": "create_records",
      "description": "Create up to 10 records in an AITable datasheet.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "datasheetId": {
            "type": "string",
            "minLength": 1,
            "description": "The AITable datasheet ID."
          },
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fields": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true,
                  "description": "Field values keyed by field name or field ID."
                }
              },
              "additionalProperties": false,
              "required": [
                "fields"
              ],
              "description": "An AITable record to create."
            },
            "description": "The records to create, with a maximum of 10 per request.",
            "minItems": 1,
            "maxItems": 10
          },
          "fieldKey": {
            "type": "string",
            "enum": [
              "name",
              "id"
            ],
            "description": "Whether field names or field IDs identify record fields."
          }
        },
        "additionalProperties": false,
        "required": [
          "datasheetId",
          "records"
        ],
        "description": "Input for creating AITable records."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "recordId": {
                  "type": "string",
                  "description": "The stable AITable record ID."
                },
                "fields": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true,
                  "description": "Field values keyed by field name or field ID."
                }
              },
              "additionalProperties": true,
              "required": [
                "recordId",
                "fields"
              ],
              "description": "An AITable record with provider-defined field values."
            },
            "description": "The records returned by AITable."
          }
        },
        "additionalProperties": false,
        "required": [
          "records"
        ],
        "description": "Records returned by AITable."
      }
