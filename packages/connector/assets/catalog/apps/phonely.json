    {
      "id": "phonely.list_calls",
      "service": "phonely",
      "name": "list_calls",
      "description": "List calls for a Phonely agent with pagination and optional filters.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string",
            "minLength": 1,
            "description": "The unique Phonely agent ID."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "The maximum number of calls to return."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of matching calls to skip."
          },
          "customerPhoneNumber": {
            "type": "string",
            "description": "The customer phone number to match."
          },
          "campaignId": {
            "type": "string",
            "description": "The campaign ID to match."
          },
          "status": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "COMPLETED",
                "FAILED",
                "ENDED",
                "IN_PROGRESS"
              ],
              "description": "One documented Phonely call status."
            },
            "description": "The call statuses to include.",
            "minItems": 1
          },
          "sentiment": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "Positive",
                "Negative",
                "Neutral"
              ],
              "description": "One documented Phonely sentiment."
            },
            "description": "The customer sentiments to include.",
            "minItems": 1
          },
          "callType": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "inboundPhoneCall",
                "outboundPhoneCall",
                "webCall",
                "dailyCall"
              ],
              "description": "One documented Phonely call type."
            },
            "description": "The call types to include.",
            "minItems": 1
          },
          "outcome": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "One call outcome."
            },
            "description": "The call outcomes to include.",
            "minItems": 1
          },
          "endedReason": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "One call ended reason."
            },
            "description": "The call ended reasons to include.",
            "minItems": 1
          },
          "mode": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "One call mode."
            },
            "description": "The call modes to include.",
            "minItems": 1
          },
          "startDate": {
            "type": "string",
            "description": "Return calls starting at or after this ISO 8601 time.",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "description": "Return calls starting at or before this ISO 8601 time.",
            "format": "date-time"
          },
          "minDuration": {
            "type": "number",
            "minimum": 0,
            "description": "The minimum call duration in seconds."
          },
          "maxDuration": {
            "type": "number",
            "minimum": 0,
            "description": "The maximum call duration in seconds."
          }
        },
        "additionalProperties": false,
        "required": [
          "agentId"
        ],
        "description": "The input for listing calls for a Phonely agent."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A Phonely call record returned by the API."
            },
            "description": "The calls in this page."
          },
          "total": {
            "type": "integer",
            "description": "The total number of calls matching the filters."
          },
          "limit": {
            "type": "integer",
            "description": "The page limit used by Phonely."
          },
          "offset": {
            "type": "integer",
            "description": "The page offset used by Phonely."
          }
        },
        "additionalProperties": false,
        "description": "A page of Phonely calls."
      }
    }
  ]
}
