{
  "service": "phonely",
  "displayName": "Phonely",
  "categories": [
    "Communication",
    "AI"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "PHONELY_API_KEY",
      "description": "Phonely API key sent with the X-Authorization header. Copy it from profile settings: https://app.phonely.ai/settings?tab=profile.",
      "extraFields": [
        {
          "key": "userId",
          "label": "User ID",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "PHONELY_USER_ID",
          "description": "Phonely user ID required by the agent and call APIs."
        }
      ]
    }
  ],
  "homepageUrl": "https://www.phonely.ai/",
  "actions": [
    {
      "id": "phonely.get_agent",
      "service": "phonely",
      "name": "get_agent",
      "description": "Get one Phonely agent by its agent ID.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "agentId": {
            "type": "string",
            "minLength": 1,
            "description": "The unique Phonely agent ID."
          }
        },
        "additionalProperties": false,
        "description": "The input for getting one Phonely agent."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "object",
            "properties": {
              "uid": {
                "type": "string",
                "description": "The Phonely user ID that owns the agent."
              },
              "agentId": {
                "type": "string",
                "description": "The unique Phonely agent ID."
              },
              "name": {
                "type": "string",
                "description": "The agent name."
              },
              "country": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "The agent country code when configured."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The agent country code when configured."
              },
              "businessPhoneNumber": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "The business phone number assigned to the agent when configured."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The business phone number assigned to the agent when configured."
              }
            },
            "additionalProperties": true,
            "required": [
              "uid",
              "agentId",
              "name"
            ],
            "description": "A Phonely agent record."
          }
        },
        "additionalProperties": false,
        "description": "The requested Phonely agent."
      }
    },
    {
