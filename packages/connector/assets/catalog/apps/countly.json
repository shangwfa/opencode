    {
      "id": "countly.list_event_analytics",
      "service": "countly",
      "name": "list_event_analytics",
      "description": "Retrieve event analytics for one or more Countly event keys.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "appId": {
            "type": "string",
            "minLength": 1,
            "description": "The Countly application ID."
          },
          "event": {
            "type": "string",
            "minLength": 1,
            "description": "A single Countly event key to query."
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "A Countly event key."
            },
            "description": "Multiple Countly event keys to query."
          },
          "segmentation": {
            "type": "string",
            "minLength": 1,
            "description": "The event segmentation key to break results down by."
          },
          "period": {
            "type": "string",
            "description": "The Countly period, such as month, 30days, 7days, yesterday, hour, or a JSON array of start and end timestamps."
          }
        },
        "additionalProperties": false,
        "required": [
          "appId"
        ],
        "description": "The input payload for retrieving Countly event analytics."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "_id": {
                  "type": "string",
                  "description": "The date, time, or segmentation bucket identifier."
                },
                "c": {
                  "type": "number",
                  "description": "The total event count in the bucket."
                },
                "s": {
                  "type": "number",
                  "description": "The total event sum in the bucket."
                },
                "dur": {
                  "type": "number",
                  "description": "The total event duration in the bucket."
                }
              },
              "additionalProperties": true,
              "description": "A Countly event analytics data point."
            },
            "description": "Event analytics data points returned by Countly."
          }
        },
        "additionalProperties": false,
        "description": "The Countly event analytics response."
      }
    },
    {
      "id": "countly.list_session_analytics",
      "service": "countly",
      "name": "list_session_analytics",
      "description": "Retrieve session analytics data points for a Countly application and period.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "appId": {
            "type": "string",
            "minLength": 1,
            "description": "The Countly application ID."
          },
          "period": {
            "type": "string",
            "description": "The Countly period, such as month, 30days, 7days, yesterday, hour, or a JSON array of start and end timestamps."
          }
        },
        "additionalProperties": false,
        "required": [
          "appId"
        ],
        "description": "The input payload for retrieving Countly session analytics."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "_id": {
                  "type": "string",
                  "description": "The date or time bucket identifier."
                },
                "u": {
                  "type": "number",
                  "description": "The total unique users in the bucket."
                },
                "t": {
                  "type": "number",
                  "description": "The total sessions in the bucket."
                },
                "n": {
                  "type": "number",
                  "description": "The new users in the bucket."
                },
                "d": {
                  "type": "number",
                  "description": "The total session duration in seconds."
                },
                "e": {
                  "type": "number",
                  "description": "The total write API requests in the bucket."
                }
              },
              "additionalProperties": true,
              "description": "A Countly session analytics data point."
            },
            "description": "Session analytics data points returned by Countly."
          }
        },
        "additionalProperties": false,
        "description": "The Countly session analytics response."
      }
    }
  ]
