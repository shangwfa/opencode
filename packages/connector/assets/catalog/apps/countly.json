        {
          "key": "baseUrl",
          "label": "Countly Base URL",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "https://analytics.example.com",
          "description": "The root URL of your Countly Flex, private cloud, or self-hosted instance without a path."
        }
      ]
    }
  ],
  "homepageUrl": "https://countly.com/",
