{
  "service": "sumup",
  "displayName": "SumUp",
  "categories": [
    "Finance"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "Secret API Key",
      "placeholder": "sk_live_...",
      "description": "SumUp secret or restricted API key. Create and manage API keys at https://me.sumup.com/developers."
    }
  ],
  "homepageUrl": "https://www.sumup.com",
  "actions": [
    {
      "id": "sumup.create_checkout",
      "service": "sumup",
      "name": "create_checkout",
      "description": "Create a SumUp checkout, optionally enabling the SumUp-hosted payment page.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "checkout_reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90,
            "description": "The merchant-defined checkout reference."
          },
          "amount": {
            "type": "number",
            "description": "The amount to charge in major currency units."
          },
          "currency": {
            "type": "string",
            "enum": [
              "BGN",
              "BRL",
              "CHF",
              "CLP",
              "COP",
              "CZK",
              "DKK",
              "EUR",
              "GBP",
              "HRK",
              "HUF",
              "NOK",
              "PLN",
              "RON",
              "SEK",
              "USD"
            ],
            "description": "The three-letter ISO 4217 currency code."
          },
          "merchant_code": {
            "type": "string",
            "minLength": 1,
            "description": "The SumUp merchant code receiving the payment."
          },
          "description": {
            "type": "string",
            "description": "A short description of the checkout."
          },
          "return_url": {
            "type": "string",
            "description": "The backend callback URL for checkout processing updates.",
            "format": "uri"
          },
          "redirect_url": {
            "type": "string",
            "description": "The payer redirect URL for SCA or alternative payment methods.",
            "format": "uri"
          },
          "purpose": {
            "type": "string",
            "enum": [
              "CHECKOUT",
              "SETUP_RECURRING_PAYMENT"
            ],
            "description": "The business purpose of the checkout."
          },
          "valid_until": {
            "anyOf": [
              {
                "type": "string",
                "description": "The optional checkout expiration timestamp.",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "description": "The optional checkout expiration timestamp."
          },
          "customer_id": {
            "type": "string",
            "description": "The saved SumUp customer identifier associated with the checkout."
          },
          "hosted_checkout": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean",
                "description": "Whether SumUp should create a hosted checkout URL."
              }
            },
            "additionalProperties": false,
            "description": "Configuration for the SumUp-hosted checkout page."
          }
        },
        "additionalProperties": false,
        "required": [
          "checkout_reference",
          "amount",
          "currency",
          "merchant_code"
        ],
        "description": "The input payload for creating a SumUp checkout."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "checkout": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The checkout resource returned by SumUp."
          }
        },
        "additionalProperties": false,
        "description": "A SumUp checkout response."
      }
    },
    {
      "id": "sumup.create_customer",
      "service": "sumup",
      "name": "create_customer",
      "description": "Create a saved customer in SumUp for future payment workflows.",
