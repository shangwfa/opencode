      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "minLength": 1,
            "description": "The merchant-defined unique customer identifier."
          },
          "personal_details": {
            "type": "object",
            "properties": {
              "first_name": {
                "type": "string",
                "description": "The customer's first name."
