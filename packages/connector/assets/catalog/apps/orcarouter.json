{
  "service": "orcarouter",
  "displayName": "OrcaRouter",
  "categories": [
    "AI",
    "Developer Tools"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "sk-orca-...",
      "description": "OrcaRouter API key used with the Authorization Bearer header. Get it from https://www.orcarouter.ai/console.",
      "extraFields": []
    }
  ],
  "homepageUrl": "https://www.orcarouter.ai",
  "actions": [
    {
      "id": "orcarouter.create_chat_completion",
      "service": "orcarouter",
      "name": "create_chat_completion",
      "description": "Create an OrcaRouter chat completion through the OpenAI-compatible `/chat/completions` endpoint.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "description": "The namespaced model ID to use, such as `orcarouter/auto` or `openai/gpt-4o-mini`. OrcaRouter routes the request to the matching upstream."
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A JSON object returned by OrcaRouter."
            },
            "description": "An ordered list of conversation messages.",
            "minItems": 1
          },
          "n": {
            "type": "integer",
            "minimum": 1,
            "description": "The number of choices to generate."
          },
          "stop": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "description": "A single stop sequence."
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A stop sequence."
                },
                "description": "Multiple stop sequences.",
                "minItems": 1
              }
            ],
            "description": "Stop sequences for generation."
          },
          "user": {
            "type": "string",
            "description": "The end user's unique identifier."
          },
          "top_p": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Nucleus sampling parameter."
          },
          "stream": {
            "type": "boolean",
            "description": "Whether to request a streaming response. Connector actions only support false or omitted."
          },
          "functions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A JSON object returned by OrcaRouter."
            },
            "description": "A list of JSON objects returned by OrcaRouter."
          },
          "function_call": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "none",
                  "auto"
                ]
              },
              {
                "type": "object",
                "properties": {},
                "additionalProperties": true,
                "description": "A JSON object returned by OrcaRouter."
              }
            ],
            "description": "Legacy function calling strategy converted to tool_choice at execution time."
          },
          "logit_bias": {
            "type": "object",
            "additionalProperties": {
              "type": "number",
              "description": "The bias value for this token."
            },
            "description": "Token bias map."
          },
          "max_tokens": {
            "type": "integer",
            "minimum": 1,
            "description": "The maximum number of output tokens."
          },
          "max_completion_tokens": {
            "type": "integer",
            "minimum": 1,
            "description": "New max output token field, taking precedence over max_tokens."
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "description": "Sampling temperature."
          },
          "presence_penalty": {
            "type": "number",
            "minimum": -2,
            "maximum": 2,
            "description": "Presence penalty."
          },
          "frequency_penalty": {
            "type": "number",
            "minimum": -2,
            "maximum": 2,
            "description": "Frequency penalty."
          },
          "logprobs": {
            "type": "boolean",
            "description": "Whether to return token-level probabilities."
          },
          "top_logprobs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20,
            "description": "The number of top logprobs to return."
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A JSON object returned by OrcaRouter."
            },
            "description": "A list of JSON objects returned by OrcaRouter."
          },
          "tool_choice": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "none",
                  "auto",
                  "required"
                ]
              },
              {
                "type": "object",
                "properties": {},
                "additionalProperties": true,
                "description": "A JSON object returned by OrcaRouter."
              }
            ],
            "description": "Tool selection strategy."
          },
          "response_format": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "A JSON object returned by OrcaRouter."
          },
          "metadata": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "A JSON object returned by OrcaRouter."
          },
          "parallel_tool_calls": {
            "type": "boolean",
            "description": "Whether to allow parallel tool calls."
          }
        },
        "additionalProperties": true,
        "required": [
          "model",
          "messages"
        ],
        "description": "Input parameters when creating an OrcaRouter chat completion."
      },
      "outputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": true,
        "description": "A JSON object returned by OrcaRouter."
      }
    },
    {
      "id": "orcarouter.create_embeddings",
      "service": "orcarouter",
      "name": "create_embeddings",
      "description": "Create embeddings through the OpenAI-compatible `/embeddings` endpoint.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "minLength": 1,
            "description": "The namespaced embedding model ID to use, such as `openai/text-embedding-3-small`."
          },
          "input": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "description": "A single text string to embed."
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A text string to embed."
                },
                "description": "A list of text strings to embed.",
                "minItems": 1
              }
            ],
            "description": "Text to embed."
          },
          "encoding_format": {
            "type": "string",
            "enum": [
              "float",
              "base64"
            ],
            "description": "The format to return the embeddings in."
          }
        },
        "additionalProperties": false,
        "required": [
          "model",
          "input"
        ],
        "description": "Input parameters when creating an OrcaRouter embedding."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A JSON object returned by OrcaRouter."
            },
            "description": "A list of JSON objects returned by OrcaRouter."
          }
        },
        "additionalProperties": false,
        "description": "Standard OrcaRouter response that returns a list of embeddings."
      }
    },
    {
      "id": "orcarouter.create_message",
