                ]
              },
              {
                "type": "object",
                "properties": {},
                "additionalProperties": true,
                "description": "A JSON object returned by OrcaRouter."
              }
            ],
            "description": "Tool selection strategy."
          }
        },
        "additionalProperties": true,
        "required": [
          "model",
          "max_tokens",
          "messages"
        ],
        "description": "Input parameters when creating an OrcaRouter Anthropic-format message."
      },
      "outputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": true,
        "description": "A JSON object returned by OrcaRouter."
      }
    },
