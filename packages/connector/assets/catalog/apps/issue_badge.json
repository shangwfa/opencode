    {
      "id": "issue_badge.issue_badge",
      "service": "issue_badge",
      "name": "issue_badge",
      "description": "Issue an existing IssueBadge template to a recipient and create a public verification URL. Providing an email address triggers a notification email. Reuse an idempotency key to retrieve the existing issuance without issuing it again.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "badge_id": {
            "type": "string",
            "minLength": 1,
            "description": "Encrypted badge ID from list_badges."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Recipient's full name."
          },
          "email": {
            "type": "string",
            "description": "Recipient's email address for notification.",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "description": "Recipient's phone number."
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Unique key to prevent duplicate issuance. Generated by IssueBadge when omitted."
          },
          "metadata": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "Custom field values and additional metadata."
          }
        },
        "additionalProperties": false,
        "required": [
          "badge_id",
          "name"
        ],
        "description": "Input for issuing a badge."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the request succeeded."
          },
          "IssueId": {
            "type": "string",
            "description": "Encrypted issue ID for tracking."
          },
          "publicUrl": {
            "type": "string",
            "description": "Public verification URL."
          }
        },
        "additionalProperties": true,
        "description": "Badge issuance response, including an existing issue on an idempotency replay."
      }
    },
