    {
      "id": "ozon.list_fbs_postings",
      "service": "ozon",
      "name": "list_fbs_postings",
      "description": "List Ozon FBS and rFBS postings for a date range.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "object",
            "properties": {
              "since": {
                "type": "string",
                "description": "The inclusive beginning of the posting period in ISO 8601 format.",
                "format": "date-time"
              },
              "to": {
                "type": "string",
                "description": "The inclusive end of the posting period in ISO 8601 format.",
                "format": "date-time"
              },
              "delivery_method_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "One Ozon identifier."
                },
                "description": "Delivery method identifiers to include.",
                "minItems": 1,
                "maxItems": 1000
              },
              "integration_type_flow": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "One integration processing flow."
                },
                "description": "Integration processing flows to include."
              },
              "is_blr_traceable": {
                "type": "boolean",
                "description": "Whether to include only traceable Belarus products."
              },
              "order_id": {
                "type": "integer",
                "minimum": 1,
                "description": "The Ozon order identifier."
              },
              "order_numbers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "One Ozon order number."
                },
                "description": "Order numbers to include.",
                "minItems": 1,
                "maxItems": 100
              },
              "provider_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "One Ozon identifier."
                },
                "description": "Delivery provider identifiers to include.",
                "minItems": 1,
                "maxItems": 1000
              },
              "statuses": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "One Ozon posting status."
                },
                "description": "Posting statuses to include.",
                "minItems": 1
              },
              "warehouse_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "One Ozon identifier."
                },
                "description": "Warehouse identifiers to include.",
                "minItems": 1,
                "maxItems": 1000
              }
            },
            "additionalProperties": false,
            "required": [
              "since",
              "to"
            ],
            "description": "Filters Ozon FBS and rFBS postings."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "The maximum number of postings to return."
          },
          "cursor": {
            "type": "string",
            "description": "The cursor returned by the previous page."
          },
          "sort_dir": {
            "type": "string",
            "enum": [
              "ASC",
              "DESC"
            ],
            "description": "The posting sort direction."
          },
          "translit": {
            "type": "boolean",
            "description": "Whether Ozon should transliterate returned addresses."
          },
          "with": {
            "type": "object",
            "properties": {
              "analytics_data": {
                "type": "boolean",
                "description": "Whether to include analytics data."
              },
              "barcodes": {
                "type": "boolean",
                "description": "Whether to include posting barcodes."
              },
              "financial_data": {
                "type": "boolean",
                "description": "Whether to include financial data."
              },
              "legal_info": {
                "type": "boolean",
                "description": "Whether to include legal information."
              }
            },
            "additionalProperties": false,
            "description": "Additional posting data to include."
          }
        },
        "additionalProperties": false,
        "required": [
          "filter",
          "limit"
        ],
        "description": "The input payload for listing Ozon FBS and rFBS postings."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "description": "The cursor for the next page."
          },
          "has_next": {
            "type": "boolean",
            "description": "Whether more postings are available."
          },
          "postings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "One Ozon posting."
            },
            "description": "The returned Ozon postings."
          }
        },
        "additionalProperties": true,
        "description": "An Ozon FBS posting list response."
      }
    },
