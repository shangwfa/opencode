            "minItems": 1,
            "maxItems": 1000
          },
          "sku": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "One Ozon identifier."
            },
            "description": "Ozon SKUs to retrieve.",
            "minItems": 1,
            "maxItems": 1000
          }
        },
        "additionalProperties": false,
        "description": "Identifiers for retrieving detailed Ozon product information.",
        "anyOf": [
          {
            "required": [
              "offer_id"
            ]
          },
          {
            "required": [
              "product_id"
            ]
          },
          {
            "required": [
              "sku"
            ]
          }
        ]
      },
      "outputSchema": {
        "type": "object",
