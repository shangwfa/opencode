{
  "service": "neetocal",
  "displayName": "NeetoCal",
  "categories": [
    "Productivity"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "NEETOCAL_API_KEY",
      "description": "NeetoCal workspace API key sent with the X-Api-Key header. Create it in Admin panel > API Keys: https://help.neetocal.com/articles/api-keys.",
      "extraFields": [
        {
          "key": "subdomain",
          "label": "Workspace subdomain",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "your-workspace",
          "description": "The workspace name from https://{your-workspace}.neetocal.com. Enter only the subdomain."
        }
      ]
    }
  ],
  "homepageUrl": "https://www.neeto.com/neetocal",
  "actions": [
    {
      "id": "neetocal.get_booking",
      "service": "neetocal",
      "name": "get_booking",
      "description": "Get one NeetoCal booking by SID.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "bookingSid": {
            "type": "string",
            "minLength": 1,
            "description": "The NeetoCal record identifier or SID.",
            "pattern": "\\S"
          }
        },
        "additionalProperties": false,
        "description": "The input for getting a NeetoCal booking."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique booking identifier."
          },
          "sid": {
            "type": "string",
            "description": "The short booking identifier used by API paths."
          },
          "name": {
            "type": "string",
            "description": "The booking client name."
          },
          "email": {
            "type": "string",
            "description": "The booking client email address."
          },
          "starts_at": {
            "type": "string",
            "description": "The booking start timestamp."
          },
          "ends_at": {
            "type": "string",
            "description": "The booking end timestamp."
          },
          "status": {
            "type": "string",
            "description": "The current booking lifecycle status."
          },
          "meeting_id": {
            "type": "string",
            "description": "The related scheduling-link identifier."
          }
        },
        "additionalProperties": true,
        "description": "A NeetoCal booking."
      }
    },
    {
