    {
      "id": "neetocal.list_available_slots",
      "service": "neetocal",
      "name": "list_available_slots",
      "description": "List available NeetoCal slots for a scheduling link and calendar month.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "schedulingLinkSid": {
            "type": "string",
            "minLength": 1,
            "description": "The NeetoCal record identifier or SID.",
            "pattern": "\\S"
          },
          "timeZone": {
            "type": "string",
            "minLength": 1,
            "description": "The IANA time zone used to calculate available slots.",
            "pattern": "\\S"
          },
          "year": {
            "type": "integer",
            "description": "The calendar year to query."
          },
          "month": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "description": "The calendar month to query."
          },
          "day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31,
            "description": "The optional day of month used to narrow slot results."
          }
        },
        "additionalProperties": false,
        "required": [
          "schedulingLinkSid",
          "timeZone",
          "year",
          "month"
        ],
        "description": "The input for listing available NeetoCal slots."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "description": "The calendar date for the slot group."
                },
                "day": {
                  "type": "integer",
                  "description": "The day of month for the slot group."
                },
                "slots": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true,
                  "description": "The raw object returned by NeetoCal."
                }
              },
              "additionalProperties": true,
              "description": "Available NeetoCal slots for one date."
            },
            "description": "Available slot groups returned by NeetoCal."
          }
        },
        "additionalProperties": false,
        "description": "The NeetoCal available-slot response."
      }
    },
    {
      "id": "neetocal.list_bookings",
      "service": "neetocal",
      "name": "list_bookings",
      "description": "List NeetoCal bookings with optional type, email, parent, sorting, and pagination filters.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "upcoming",
              "past",
              "cancelled",
              "incomplete"
            ],
            "description": "The booking time or lifecycle group to return."
          },
          "pageNumber": {
            "type": "integer",
            "minimum": 1,
            "description": "The 1-based result page to fetch."
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "description": "The maximum number of records to return."
          },
          "hostEmail": {
            "type": "string",
            "minLength": 1,
            "description": "The email address used to filter results.",
            "format": "email"
          },
          "clientEmail": {
            "type": "string",
            "minLength": 1,
            "description": "The email address used to filter results.",
            "format": "email"
          },
          "parentBookingId": {
            "type": "string",
            "minLength": 1,
            "description": "The NeetoCal record identifier or SID.",
            "pattern": "\\S"
          },
          "sortingOrder": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "description": "The booking creation-time sorting direction."
          }
        },
        "additionalProperties": false,
        "description": "The input for listing NeetoCal bookings."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "bookings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The unique booking identifier."
                },
                "sid": {
                  "type": "string",
                  "description": "The short booking identifier used by API paths."
                },
                "name": {
                  "type": "string",
                  "description": "The booking client name."
                },
                "email": {
                  "type": "string",
                  "description": "The booking client email address."
                },
                "starts_at": {
                  "type": "string",
                  "description": "The booking start timestamp."
                },
                "ends_at": {
                  "type": "string",
                  "description": "The booking end timestamp."
                },
                "status": {
                  "type": "string",
                  "description": "The current booking lifecycle status."
                },
                "meeting_id": {
                  "type": "string",
                  "description": "The related scheduling-link identifier."
                }
              },
              "additionalProperties": true,
              "description": "A NeetoCal booking."
            },
            "description": "The bookings returned by NeetoCal."
          },
          "pagination": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "total_records": {
                    "type": "integer",
                    "description": "The total number of matching records."
                  },
                  "total_pages": {
                    "type": "integer",
                    "description": "The total number of result pages."
                  },
                  "current_page_number": {
                    "type": "integer",
                    "description": "The current 1-based page number."
                  },
                  "page_size": {
                    "type": "integer",
                    "description": "The configured result page size."
                  }
                },
                "additionalProperties": true,
                "description": "NeetoCal pagination metadata."
              },
              {
                "type": "null"
              }
            ],
            "description": "NeetoCal pagination metadata."
          }
        },
        "additionalProperties": false,
        "description": "The NeetoCal booking list response."
      }
    },
