{
  "service": "seatable",
  "displayName": "SeaTable",
  "description": "Read and manage rows in a SeaTable base.",
  "categories": [
    "Productivity",
    "Data"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "Base API Token",
      "placeholder": "SeaTable base API token",
      "description": "A read-write API token for one SeaTable base. Create it from the base menu under Advanced > API Tokens: https://seatable.com/help/create-api-tokens/",
      "extraFields": [
        {
          "key": "serverUrl",
          "label": "Server URL",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "https://cloud.seatable.io",
          "description": "The HTTPS URL of SeaTable Cloud or your self-hosted SeaTable server. Public addresses work by default; private-network instances require OOMOL_CONNECT_ALLOW_PRIVATE_NETWORK in the self-hosted runtime. Reserved, local, and cloud-metadata targets remain blocked."
        }
      ]
    }
  ],
  "homepageUrl": "https://seatable.com",
  "actions": [
    {
      "id": "seatable.append_rows",
      "service": "seatable",
      "name": "append_rows",
      "description": "Append one or more rows to a SeaTable table using column names as keys.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "tableName": {
            "type": "string",
            "minLength": 1,
            "description": "The SeaTable table name."
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A row keyed by SeaTable column names."
            },
            "description": "Rows to append, keyed by column names.",
            "minItems": 1,
            "maxItems": 1000
          },
          "applyDefault": {
            "type": "boolean",
            "description": "Whether SeaTable should apply column default values to missing fields."
          }
        },
        "additionalProperties": false,
        "required": [
          "tableName",
          "rows"
        ],
        "description": "Input payload for appending SeaTable rows."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "insertedRowCount": {
            "type": "integer",
            "description": "Number of rows inserted by SeaTable."
          },
          "rowIds": {
            "type": "array",
            "items": {
              "description": "A returned row identifier."
            },
            "description": "Identifiers of the inserted rows."
          },
          "firstRow": {
            "type": "object",
            "properties": {
              "_id": {
                "type": "string",
                "description": "The SeaTable row ID."
              },
              "_mtime": {
                "type": "string",
                "description": "The row modification timestamp."
              }
            },
            "additionalProperties": true,
            "description": "A row returned by SeaTable."
          },
          "raw": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The raw SeaTable API response."
          }
        },
        "additionalProperties": false,
        "required": [
          "insertedRowCount",
          "rowIds",
          "raw"
        ],
        "description": "SeaTable append rows response."
      }
    },
