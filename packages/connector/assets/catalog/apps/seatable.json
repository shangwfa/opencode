                },
                "_mtime": {
                  "type": "string",
                  "description": "The row modification timestamp."
                }
              },
              "additionalProperties": true,
              "description": "A row returned by SeaTable."
            },
            "description": "Rows returned by SeaTable."
          }
        },
        "additionalProperties": false,
        "description": "SeaTable row list response."
      }
