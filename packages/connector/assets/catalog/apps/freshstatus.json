{
  "service": "freshstatus",
  "displayName": "Freshstatus",
  "description": "Build and organize a Freshstatus status page through its public API.",
  "categories": [
    "Communication",
    "Productivity"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "freshstatus_api_key",
      "description": "Freshstatus organization API key used as the HTTP Basic username. Copy it from Settings > Account: https://support.freshstatus.io/support/solutions/articles/50000003646-freshstatus-api-documentation",
      "extraFields": [
        {
          "key": "subdomain",
          "label": "Freshstatus Subdomain",
          "inputType": "password",
          "required": true,
          "secret": true,
          "placeholder": "your-status-page",
          "description": "Freshstatus account subdomain used as the HTTP Basic password. For https://example.freshstatus.io, enter example."
        }
      ]
    }
  ],
  "homepageUrl": "https://www.freshworks.com/statuspage",
  "actions": [
    {
      "id": "freshstatus.create_group",
      "service": "freshstatus",
      "name": "create_group",
      "description": "Create a service group on a Freshstatus status page.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Service group name."
          },
          "description": {
            "type": "string",
            "description": "Service group description."
          },
          "order": {
            "type": "integer",
            "description": "Display order of the service group."
          },
          "parentId": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "description": "Parent service group identifier."
              },
              {
                "type": "null"
              }
            ],
            "description": "Parent service group identifier."
          },
          "displayOptions": {
            "type": "object",
            "properties": {
              "expandOnLoad": {
                "type": "string",
                "enum": [
                  "true",
                  "false"
                ],
                "description": "Whether the group is expanded on page load, encoded as required by Freshstatus."
              },
              "uptimeHistoryEnabled": {
                "type": "string",
                "enum": [
                  "true",
                  "false"
                ],
                "description": "Whether uptime history is enabled, encoded as required by Freshstatus."
              }
            },
            "additionalProperties": false,
            "description": "Freshstatus service group display options.",
            "minProperties": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "description": "Input for creating a Freshstatus service group."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "group": {
            "type": "object",
            "additionalProperties": true,
            "description": "A service group object returned by Freshstatus."
          }
        },
        "additionalProperties": false,
        "description": "Created Freshstatus service group response."
      }
    },
