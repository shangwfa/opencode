{
  "service": "coupontools",
  "displayName": "Coupontools",
  "categories": [
    "Marketing"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "Client ID",
      "placeholder": "COUPONTOOLS_CLIENT_ID",
      "description": "Coupontools API client ID. Find it under Integrations > JSON API in the Coupontools dashboard: https://login.coupontools.com/.",
      "extraFields": [
        {
          "key": "clientSecret",
          "label": "Client Secret",
          "inputType": "password",
          "required": true,
          "secret": true,
          "placeholder": "COUPONTOOLS_CLIENT_SECRET",
          "description": "Coupontools API client secret paired with the client ID. Find it under Integrations > JSON API in the Coupontools dashboard: https://login.coupontools.com/."
        }
      ]
    }
  ],
  "homepageUrl": "https://www.coupontools.com",
  "actions": [
    {
      "id": "coupontools.create_single_use_url",
      "service": "coupontools",
      "name": "create_single_use_url",
      "description": "Create a single-use URL for a Coupontools coupon campaign.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "campaign": {
            "type": "string",
            "minLength": 1,
            "description": "The coupon campaign ID, such as cam_123456."
          },
          "firstname": {
            "type": "string",
            "minLength": 1,
            "description": "The recipient's first name."
          },
          "lastname": {
            "type": "string",
            "minLength": 1,
            "description": "The recipient's last name."
          },
          "email": {
            "type": "string",
            "minLength": 1,
            "description": "The recipient's email address.",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "minLength": 1,
            "description": "The recipient's phone number."
          },
          "customid": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "A custom recipient ID of at most 50 characters."
          },
          "customvalcode": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "A custom validation code of at most 100 characters."
          },
          "customfield1": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "Custom recipient field 1, with at most 50 characters."
          },
          "customfield2": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "Custom recipient field 2, with at most 50 characters."
          },
          "customfield3": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "Custom recipient field 3, with at most 50 characters."
          },
          "customfield4": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "Custom recipient field 4, with at most 50 characters."
          },
          "customfield5": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "Custom recipient field 5, with at most 50 characters."
          },
          "customfield6": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "Custom recipient field 6, with at most 50 characters."
          },
          "customfield7": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "Custom recipient field 7, with at most 50 characters."
          },
          "autovalcode": {
            "type": "string",
            "enum": [
              "6digits",
              "8digits",
              "10digits"
            ],
            "description": "The length of an automatically generated validation code."
          },
          "duplicate_check": {
            "type": "string",
            "enum": [
              "email",
              "phone",
              "customid"
            ],
            "description": "The recipient field used to detect an existing single-use URL."
          },
          "expiry_date": {
            "type": "string",
            "minLength": 1,
            "description": "The expiry datetime in yyyy-MM-dd HH:mm:ss format, using the campaign timezone."
          },
          "utm_campaign": {
            "type": "string",
            "minLength": 1,
            "description": "The Google Analytics campaign tag."
          },
          "utm_source": {
            "type": "string",
            "minLength": 1,
            "description": "The Google Analytics source tag."
          },
          "utm_medium": {
            "type": "string",
            "minLength": 1,
            "description": "The Google Analytics medium tag."
          },
          "utm_term": {
            "type": "string",
            "minLength": 1,
            "description": "The Google Analytics term tag."
          },
          "utm_content": {
            "type": "string",
            "minLength": 1,
            "description": "The Google Analytics content tag."
          }
        },
        "additionalProperties": false,
        "required": [
          "campaign"
        ],
        "description": "The recipient data and settings for a single-use coupon URL."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "single_use_url": {
            "type": "string",
            "minLength": 1,
            "description": "The generated single-use coupon URL."
          },
          "single_use_code": {
            "type": "string",
            "minLength": 1,
            "description": "The generated single-use coupon code."
          },
          "raw": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The raw Coupontools API object."
          }
        },
        "additionalProperties": false,
        "required": [
          "single_use_url",
          "single_use_code",
          "raw"
        ],
        "description": "The single-use coupon URL created by Coupontools."
      }
    },
    {
      "id": "coupontools.get_coupon",
      "service": "coupontools",
      "name": "get_coupon",
      "description": "Get a Coupontools coupon campaign by ID.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "campaign": {
            "type": "string",
            "minLength": 1,
            "description": "The coupon campaign ID, such as cam_123456."
          },
          "show_usage_stats": {
            "type": "boolean",
            "description": "Whether to include coupon usage statistics."
          }
        },
        "additionalProperties": false,
        "required": [
          "campaign"
        ],
        "description": "The Coupontools coupon lookup input."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "coupon": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The raw Coupontools API object."
          },
          "raw": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The raw Coupontools API object."
          }
        },
        "additionalProperties": false,
        "required": [
          "coupon",
          "raw"
        ],
        "description": "The Coupontools coupon campaign result."
      }
    },
    {
      "id": "coupontools.list_coupons",
      "service": "coupontools",
      "name": "list_coupons",
      "description": "List coupon campaigns available to the authenticated Coupontools account.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "only_active": {
            "type": "boolean",
            "description": "Whether to return only active coupon campaigns."
          },
          "folder": {
            "type": "string",
            "minLength": 1,
            "description": "The Coupontools folder ID to match."
          },
          "tags": {
            "type": "string",
            "minLength": 1,
            "description": "A comma-separated list of coupon tags to match."
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "description": "The Coupontools category ID to match."
          }
        },
        "additionalProperties": false,
        "description": "Optional filters for listing Coupontools coupon campaigns."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "coupons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "The raw Coupontools API object."
            },
            "description": "The matching coupon campaigns."
          },
          "raw": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The raw Coupontools API object."
          }
        },
        "additionalProperties": false,
        "required": [
          "coupons",
          "raw"
        ],
        "description": "The coupon campaigns returned by Coupontools."
      }
    }
  ]
}
