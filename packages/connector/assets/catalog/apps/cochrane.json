{
  "service": "cochrane",
  "displayName": "Cochrane",
  "categories": [
    "Data",
    "Productivity"
  ],
  "authTypes": [
    "custom_credential"
  ],
  "auth": [
    {
      "type": "custom_credential",
      "fields": [
        {
          "key": "authMethod",
          "label": "Authentication Method",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "basic or bearer"
        },
        {
          "key": "username",
          "label": "Username",
          "inputType": "text",
          "required": false,
          "secret": false
        },
        {
          "key": "password",
          "label": "Password",
          "inputType": "password",
          "required": false,
          "secret": true
        },
        {
          "key": "bearerToken",
          "label": "Bearer Token",
          "inputType": "password",
          "required": false,
          "secret": true
        }
      ]
    }
  ],
  "homepageUrl": "https://www.cochrane.org",
  "actions": [
    {
      "id": "cochrane.get_review_metadata",
      "service": "cochrane",
      "name": "get_review_metadata",
      "description": "Get JSON metadata for a Cochrane review.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "reviewId": {
            "type": "string",
            "minLength": 1,
            "description": "The Cochrane review ID or CD number."
          }
        },
        "additionalProperties": false,
        "description": "A Cochrane review identifier."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "metadata": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "A JSON object returned by the Cochrane Review Document API."
          }
        },
        "additionalProperties": false,
        "description": "The Cochrane review metadata response."
      }
    },
    {
      "id": "cochrane.get_review_roles",
      "service": "cochrane",
      "name": "get_review_roles",
      "description": "Get the document roles associated with a Cochrane review.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "reviewId": {
            "type": "string",
            "minLength": 1,
            "description": "The Cochrane review ID or CD number."
          }
        },
        "additionalProperties": false,
        "description": "A Cochrane review identifier."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "roles": {
            "description": "The JSON document role data returned by Cochrane."
          }
        },
        "additionalProperties": false,
        "description": "The Cochrane review roles response."
      }
    },
    {
      "id": "cochrane.list_review_translations",
      "service": "cochrane",
      "name": "list_review_translations",
      "description": "List published translations for a Cochrane review or one of its versions.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "reviewId": {
            "type": "string",
            "minLength": 1,
            "description": "The Cochrane review ID or CD number."
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "description": "The published review version, such as 7.0."
          }
        },
        "additionalProperties": false,
        "required": [
          "reviewId"
        ],
        "description": "A Cochrane review and optional published version."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "translations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "language": {
                  "type": "string",
                  "description": "The translation language code."
                },
                "title": {
                  "type": "string",
                  "description": "The translated review title."
                },
                "version": {
                  "type": "string",
                  "description": "The published translation version."
                },
                "href": {
                  "type": "string",
                  "description": "The URL of the published translation.",
                  "format": "uri"
                }
              },
              "additionalProperties": true,
              "description": "A published Cochrane review translation."
            },
            "description": "The published translations returned by Cochrane."
          }
        },
        "additionalProperties": false,
        "description": "The published Cochrane review translations response."
      }
    },
    {
      "id": "cochrane.list_review_versions",
      "service": "cochrane",
      "name": "list_review_versions",
      "description": "List JSON metadata for all versions of a Cochrane review.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "reviewId": {
            "type": "string",
            "minLength": 1,
            "description": "The Cochrane review ID or CD number."
          }
        },
        "additionalProperties": false,
        "description": "A Cochrane review identifier."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "versions": {
            "description": "The JSON version metadata returned by Cochrane."
          }
        },
        "additionalProperties": false,
        "description": "The Cochrane review versions response."
      }
    }
  ]
}
