    {
      "id": "zlibrary.search_books",
      "service": "zlibrary",
      "name": "search_books",
      "description": "Search books on Z-Library by keyword with optional year, language, format, and sort filters.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "The search query, e.g. a title or author name."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "The maximum number of results to return."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "The result page number, starting at 1."
          },
          "yearFrom": {
            "type": "integer",
            "description": "Only books published in this year or later."
          },
          "yearTo": {
            "type": "integer",
            "description": "Only books published in this year or earlier."
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "One language code, e.g. english."
            },
            "description": "Only books in these languages."
          },
          "extensions": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "One file extension, e.g. pdf."
            },
            "description": "Only books in these file formats."
          },
          "exact": {
            "type": "boolean",
            "description": "Require exact phrase matching for the query."
          },
          "order": {
            "type": "string",
            "enum": [
              "popular",
              "date_created",
              "date_updated"
            ],
            "description": "Sort order for the results."
          }
        },
        "additionalProperties": false,
        "required": [
          "message"
        ],
        "description": "The input payload for searching books on Z-Library."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "books": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The Z-Library book identifier."
                },
                "title": {
                  "type": "string",
                  "description": "The book title."
                },
                "author": {
                  "type": "string",
                  "description": "The primary author name."
                },
                "year": {
                  "type": "string",
                  "description": "The publication year as reported by Z-Library."
                },
                "language": {
                  "type": "string",
                  "description": "The book language code."
                },
                "extension": {
                  "type": "string",
                  "description": "The file extension, e.g. pdf, epub, mobi."
                },
                "size": {
                  "type": "string",
                  "description": "The file size as reported by Z-Library."
                },
                "rating": {
                  "type": "string",
                  "description": "The user rating value."
                },
                "quality": {
                  "type": "string",
                  "description": "The quality score reported by Z-Library."
                },
                "hash": {
                  "type": "string",
                  "description": "The book hash used to build download and metadata URLs."
                },
                "pages": {
                  "type": "string",
                  "description": "The page count."
                },
                "isbn": {
                  "type": "string",
                  "description": "The ISBN when available."
                },
                "publisher": {
                  "type": "string",
                  "description": "The publisher when available."
                },
                "url": {
                  "type": "string",
                  "description": "The Z-Library book page URL."
                },
                "cover": {
