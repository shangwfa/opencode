      "id": "browserstack.get_session",
      "service": "browserstack",
      "name": "get_session",
      "description": "Retrieve details for a BrowserStack Automate session.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1,
            "description": "The BrowserStack session hashed_id."
          }
        },
        "additionalProperties": false,
        "required": [
          "session_id"
        ],
        "description": "Input for retrieving a BrowserStack Automate session."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "session": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "The session name."
              },
              "duration": {
                "type": "integer",
                "description": "The session execution duration."
              },
              "os": {
                "type": "string",
                "description": "The session operating system."
              },
              "os_version": {
                "type": "string",
                "description": "The session operating system version."
              },
              "browser_version": {
                "type": "string",
                "description": "The browser version used for the session."
              },
              "browser": {
                "type": "string",
                "description": "The browser used for the session."
              },
              "device": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "The device used for the session, when present."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The device used for the session, when present."
              },
              "status": {
                "type": "string",
                "description": "The session status."
              },
              "hashed_id": {
                "type": "string",
                "description": "The BrowserStack session identifier."
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "The test status reason, when present."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The test status reason, when present."
              },
              "build_name": {
                "type": "string",
                "description": "The build name containing the session."
              },
              "project_name": {
                "type": "string",
                "description": "The project name containing the session."
              },
              "logs": {
                "type": "string",
                "description": "The URL for the session logs."
              },
              "browser_url": {
                "type": "string",
                "description": "The BrowserStack dashboard URL for the session."
              },
              "public_url": {
                "type": "string",
                "description": "The public URL for the session."
              },
              "video_url": {
                "type": "string",
                "description": "The session video URL."
              },
              "browser_console_logs_url": {
                "type": "string",
                "description": "The browser console logs URL."
              },
              "har_logs_url": {
                "type": "string",
                "description": "The HAR logs URL."
              },
              "selenium_logs_url": {
                "type": "string",
                "description": "The Selenium logs URL."
              }
            },
            "additionalProperties": true,
            "description": "A BrowserStack Automate session record."
          }
        },
        "additionalProperties": false,
        "required": [
          "session"
        ],
        "description": "The BrowserStack Automate session details."
      }
