        {
          "key": "username",
          "label": "Username",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "BROWSERSTACK_USERNAME",
          "description": "BrowserStack username used as the HTTP Basic Auth username. Copy it with the access key from BrowserStack Account > Settings > Access Keys: https://www.browserstack.com/accounts/settings."
        }
      ]
    }
