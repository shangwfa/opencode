    {
      "id": "browserstack.list_builds",
      "service": "browserstack",
      "name": "list_builds",
      "description": "List recent BrowserStack Automate builds with optional status, project, and pagination filters.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "The number of results to return. BrowserStack accepts 1 to 100."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "The zero-based result offset."
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "done",
              "timeout",
              "failed"
            ],
            "description": "A BrowserStack Automate build status filter."
          },
          "project_id": {
            "type": "integer",
            "minimum": 1,
            "description": "Only return builds for this BrowserStack project ID."
          }
        },
        "additionalProperties": false,
        "description": "Filters for listing BrowserStack Automate builds."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "builds": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The build name."
                },
                "hashed_id": {
                  "type": "string",
                  "description": "The BrowserStack build identifier."
                },
                "duration": {
                  "type": "integer",
                  "description": "The build execution duration."
                },
                "status": {
                  "type": "string",
                  "description": "The build status."
                },
                "build_tag": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "The build tag, when present."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The build tag, when present."
                },
                "public_url": {
                  "type": "string",
                  "description": "The BrowserStack dashboard URL for the build."
                }
              },
              "additionalProperties": true,
              "description": "A BrowserStack Automate build record."
            },
            "description": "BrowserStack Automate builds."
          }
        },
        "additionalProperties": false,
        "required": [
          "builds"
        ],
        "description": "The BrowserStack Automate build list."
      }
