    {
      "type": "api_key",
      "label": "Access Key",
      "placeholder": "BROWSERSTACK_ACCESS_KEY",
      "description": "BrowserStack access key used as the HTTP Basic Auth password. Copy it from BrowserStack Account > Settings > Access Keys: https://www.browserstack.com/accounts/settings.",
