{
  "service": "groqcloud",
  "displayName": "GroqCloud",
  "categories": [
    "AI",
    "Developer Tools"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "gsk_...",
      "description": "GroqCloud API key used with the Authorization Bearer header. Get it from https://console.groq.com/keys."
    }
  ],
  "homepageUrl": "https://groq.com",
  "actions": [
    {
      "id": "groqcloud.create_audio_transcription",
      "service": "groqcloud",
      "name": "create_audio_transcription",
      "description": "Transcribe an audio file into text in its original language using a GroqCloud Whisper model. Supply the audio inline as base64 or as a public URL that GroqCloud downloads.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "whisper-large-v3",
              "whisper-large-v3-turbo"
            ],
            "description": "The GroqCloud speech-to-text model identifier."
          },
          "file": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "The file name reported to GroqCloud, including the audio file extension. Required with content_base64."
              },
              "mimetype": {
                "type": "string",
                "description": "The MIME type of the audio file, such as audio/mpeg."
              },
              "url": {
                "type": "string",
                "minLength": 1,
                "description": "A public URL that GroqCloud downloads the audio from."
              },
              "content_base64": {
                "type": "string",
                "minLength": 1,
                "description": "The base64-encoded audio content to upload."
              }
            },
            "additionalProperties": false,
            "description": "The audio source. Provide url for GroqCloud to fetch the audio, or content_base64 to upload the bytes inline.",
            "anyOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "content_base64",
                  "name"
                ]
              }
            ],
            "not": {
              "required": [
                "url",
                "content_base64"
              ]
            }
          },
          "language": {
            "type": "string",
            "description": "The ISO-639-1 code of the spoken language, such as en, which improves accuracy and latency."
          },
          "prompt": {
            "type": "string",
            "description": "Optional context or style guidance for the transcript, limited to 224 tokens."
          },
          "response_format": {
            "type": "string",
            "enum": [
              "json",
              "verbose_json"
            ],
            "description": "The transcript format to return. This connector returns structured payloads, so the plain text format is not offered."
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "The sampling temperature applied to the transcription."
          },
          "timestamp_granularities": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "word",
                "segment"
              ],
              "description": "A timestamp granularity."
            },
            "description": "The timestamp detail to include. Requires response_format to be verbose_json.",
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "model",
          "file"
        ],
        "description": "The input payload for transcribing audio with GroqCloud."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The full transcript text."
          },
          "language": {
            "type": "string",
            "description": "The detected or requested language of the audio."
          },
          "duration": {
            "type": "number",
            "description": "The audio duration in seconds."
          },
          "segments": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "description": "The segment index."
                },
                "seek": {
                  "type": "integer",
                  "description": "The seek offset of the segment."
                },
                "start": {
                  "type": "number",
                  "description": "The segment start time in seconds."
                },
                "end": {
                  "type": "number",
                  "description": "The segment end time in seconds."
                },
                "text": {
                  "type": "string",
                  "description": "The transcribed text for the segment."
                },
                "tokens": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "description": "A token identifier."
                  },
                  "description": "The token identifiers for the segment."
                },
                "temperature": {
                  "type": "number",
                  "description": "The sampling temperature used for the segment."
                },
                "avg_logprob": {
                  "type": "number",
                  "description": "The average log probability of the segment."
                },
                "compression_ratio": {
                  "type": "number",
                  "description": "The compression ratio of the segment."
                },
                "no_speech_prob": {
                  "type": "number",
                  "description": "The probability that the segment contains no speech."
                }
              },
              "additionalProperties": true,
              "description": "A transcribed segment of the audio."
            },
            "description": "The transcribed segments, returned for the verbose_json format."
          },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "word": {
                  "type": "string",
                  "description": "The transcribed word."
                },
                "start": {
                  "type": "number",
                  "description": "The word start time in seconds."
                },
                "end": {
                  "type": "number",
                  "description": "The word end time in seconds."
                }
              },
              "additionalProperties": true,
              "description": "A transcribed word with timestamps."
            },
            "description": "The transcribed words, returned when word timestamp granularity is requested."
          },
          "x_groq": {
            "type": "object",
            "additionalProperties": {
              "description": "Any JSON value accepted by the upstream API."
            },
            "description": "Any JSON object."
          }
        },
        "additionalProperties": true,
        "description": "The transcript payload returned by GroqCloud."
      }
    },
