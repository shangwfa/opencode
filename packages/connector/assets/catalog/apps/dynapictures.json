    {
      "id": "dynapictures.generate_images",
      "service": "dynapictures",
      "name": "generate_images",
      "description": "Generate one image from a single-page template or multiple images from a multipage template and return hosted URLs.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "templateId": {
            "type": "string",
            "minLength": 1,
            "description": "The DynaPictures template UID."
          },
          "format": {
            "type": "string",
            "enum": [
              "png",
              "jpeg",
              "webp",
              "avif"
            ],
            "description": "The generated image format."
          },
          "metadata": {
            "type": "string",
            "description": "Custom metadata to store with each generated image."
          },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The template layer name to customize."
                },
                "text": {
                  "type": "string",
                  "description": "The replacement text for a text layer."
                },
                "color": {
                  "type": "string",
                  "description": "The text or label color."
                },
                "backgroundColor": {
                  "type": "string",
                  "description": "The layer background color."
                },
                "borderColor": {
                  "type": "string",
                  "description": "The layer border color."
                },
                "borderWidth": {
                  "type": "string",
                  "description": "The layer border width, such as 1px."
                },
                "borderRadius": {
                  "type": "string",
                  "description": "The layer border radius, such as 5px or 50%."
                },
                "imageUrl": {
                  "type": "string",
                  "description": "The publicly reachable image URL for an image layer.",
                  "format": "uri"
                },
                "imagePosition": {
                  "type": "string",
                  "enum": [
                    "cro",
                    "ai_face",
                    "cov",
                    "align"
                  ],
                  "description": "The image fitting or positioning mode."
                },
                "imageAlignH": {
                  "type": "string",
                  "enum": [
                    "left",
                    "center",
                    "right",
                    "full"
                  ],
                  "description": "The horizontal alignment used with align mode."
                },
                "imageAlignV": {
                  "type": "string",
                  "enum": [
                    "top",
                    "center",
                    "bottom",
                    "full"
                  ],
                  "description": "The vertical alignment used with align mode."
                },
                "imageEffect": {
                  "type": "string",
                  "description": "A CSS filter value applied to an image layer."
                },
                "opacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "The layer opacity from 0 for transparent to 1 for opaque."
                },
                "prompt": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The prompt for a per-request AI image layer."
                },
                "sourceImage": {
                  "type": "string",
                  "description": "The publicly reachable source photo for an AI image layer.",
                  "format": "uri"
                },
                "referenceImages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The name referenced in the AI prompt inside square brackets."
                      },
                      "url": {
                        "type": "string",
                        "description": "The publicly reachable reference image URL.",
                        "format": "uri"
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "url"
                    ],
                    "description": "One named AI layer reference image."
                  },
                  "description": "Named reference images used by an AI image layer.",
                  "maxItems": 6
                },
                "chartColor": {
                  "type": "string",
                  "description": "The chart series color."
                },
                "chartLabelColor": {
                  "type": "string",
                  "description": "The chart axis label color."
                },
                "chartDataLabels": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "One chart label."
                  },
                  "description": "The chart labels shown on the horizontal axis."
                },
                "chartDataValues": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "description": "One chart value."
                  },
                  "description": "The numeric data series rendered by a chart layer."
                },
                "value": {
                  "type": "number",
                  "minimum": 0,
                  "description": "The progress value for a gauge or progress bar."
                },
                "maxValue": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "The maximum value for a radial tick gauge."
                },
                "activeColor": {
                  "type": "string",
                  "description": "The filled tick color for a radial tick gauge."
                },
                "inactiveColor": {
                  "type": "string",
                  "description": "The empty tick color for a radial tick gauge."
                },
                "circleColor": {
                  "type": "string",
                  "description": "The background ring color for a simple gauge."
                },
                "progressColor": {
                  "type": "string",
                  "description": "The filled progress color for a gauge or progress bar."
                },
                "textColor": {
                  "type": "string",
                  "description": "The value label color for a simple gauge."
                },
                "remainingColor": {
                  "type": "string",
                  "description": "The unfilled track color for a line progress bar."
                },
                "label": {
                  "type": "string",
                  "description": "The line progress bar label text."
                },
                "labelAlign": {
                  "type": "string",
                  "enum": [
                    "left",
                    "center",
                    "right"
                  ],
                  "description": "The horizontal alignment of a progress bar label."
                }
              },
              "additionalProperties": true,
              "required": [
                "name"
              ],
              "description": "One DynaPictures layer override. Additional provider-defined layer properties are forwarded unchanged."
            },
            "description": "Layer overrides for a single-page template.",
            "minItems": 1
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "The zero-based template page index to customize."
