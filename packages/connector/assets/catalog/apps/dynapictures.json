                        ],
                        "description": "The horizontal alignment used with align mode."
                      },
                      "imageAlignV": {
                        "type": "string",
                        "enum": [
                          "top",
                          "center",
                          "bottom",
                          "full"
                        ],
                        "description": "The vertical alignment used with align mode."
                      },
                      "imageEffect": {
                        "type": "string",
                        "description": "A CSS filter value applied to an image layer."
                      },
                      "opacity": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "description": "The layer opacity from 0 for transparent to 1 for opaque."
                      },
                      "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The prompt for a per-request AI image layer."
                      },
                      "sourceImage": {
                        "type": "string",
