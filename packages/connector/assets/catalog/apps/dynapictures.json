    {
      "id": "dynapictures.get_template",
      "service": "dynapictures",
      "name": "get_template",
      "description": "Retrieve one DynaPictures template and its customizable layers by UID.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "templateId": {
            "type": "string",
            "minLength": 1,
            "description": "The DynaPictures template UID."
          }
        },
        "additionalProperties": false,
        "required": [
          "templateId"
        ],
        "description": "Input for retrieving a DynaPictures template."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "template": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The unique template UID."
              },
              "name": {
                "type": "string",
                "description": "The template name."
              },
              "thumbnail": {
                "type": "string",
                "description": "The template thumbnail URL.",
                "format": "uri"
              },
              "dateCreated": {
                "type": "string",
                "description": "The template creation timestamp.",
                "format": "date-time"
              },
              "dateUpdated": {
                "type": "string",
                "description": "The template update timestamp.",
                "format": "date-time"
              },
              "layers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "description": "The layer type."
                    },
                    "name": {
                      "type": "string",
                      "description": "The layer name used in generation overrides."
                    },
                    "width": {
                      "anyOf": [
                        {
                          "type": "number",
                          "description": "The numeric layer width."
                        },
                        {
                          "type": "string",
                          "description": "The string layer width."
                        }
                      ],
                      "description": "The layer width as returned by DynaPictures."
                    },
                    "height": {
                      "anyOf": [
                        {
                          "type": "number",
                          "description": "The numeric layer height."
                        },
                        {
                          "type": "string",
                          "description": "The string layer height."
                        }
                      ],
                      "description": "The layer height as returned by DynaPictures."
                    },
                    "text": {
                      "anyOf": [
                        {
                          "type": "string",
                          "description": "The current text value for a text layer."
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "The current text value for a text layer."
                    }
                  },
                  "additionalProperties": true,
                  "description": "One template layer returned by DynaPictures."
                },
                "description": "The layers available in the template."
              },
              "raw": {
                "type": "object",
                "properties": {},
                "additionalProperties": true,
                "description": "The raw object returned by DynaPictures."
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "thumbnail",
              "dateCreated",
              "dateUpdated",
              "layers",
              "raw"
            ],
            "description": "A normalized DynaPictures template."
          }
        },
        "additionalProperties": false,
        "required": [
          "template"
        ],
        "description": "The requested DynaPictures template."
      }
    },
