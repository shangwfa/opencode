                      },
                      "referenceImages": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "minLength": 1,
                              "description": "The name referenced in the AI prompt inside square brackets."
                            },
                            "url": {
                              "type": "string",
                              "description": "The publicly reachable reference image URL.",
                              "format": "uri"
                            }
                          },
                          "additionalProperties": false,
                          "required": [
                            "name",
                            "url"
                          ],
                          "description": "One named AI layer reference image."
                        },
                        "description": "Named reference images used by an AI image layer.",
                        "maxItems": 6
                      },
                      "chartColor": {
                        "type": "string",
                        "description": "The chart series color."
                      },
                      "chartLabelColor": {
                        "type": "string",
                        "description": "The chart axis label color."
                      },
                      "chartDataLabels": {
                        "type": "array",
                        "items": {
                          "type": "string",
