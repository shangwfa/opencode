{
  "service": "pushinator",
  "displayName": "Pushinator",
  "homepageUrl": "https://pushinator.com",
  "iconUrl": "https://pushinator.com/logo.svg",
  "categories": [
    "Communication",
    "Developer Tools"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "Pushinator API key",
      "description": "Create an API key at https://console.pushinator.com/tokens. Sent as a Bearer token. Connecting only checks that the key is non-empty; Pushinator verifies it when you run an action."
    }
  ],
  "actions": [
    {
      "id": "pushinator.create_channel",
      "service": "pushinator",
      "name": "create_channel",
      "description": "Create a Pushinator channel for notification subscribers.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of the channel."
          },
          "description": {
            "type": "string",
            "description": "The description of the channel."
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "description": "The channel to create."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The channel properties returned by Pushinator, preserved without renaming."
          }
        },
        "additionalProperties": false,
        "required": [
          "channel"
        ],
        "description": "The created channel result."
      }
    },
    {
      "id": "pushinator.send_notification",
      "service": "pushinator",
      "name": "send_notification",
      "description": "Send a push notification to the subscribers of a Pushinator channel.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel_id": {
            "type": "string",
            "description": "The UUID of the channel to send the notification to.",
            "format": "uuid"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "description": "The message content of the notification."
          },
          "acknowledgment_required": {
            "type": "boolean",
            "description": "Whether subscriber acknowledgment is required. Defaults to false; treated as false on the Free plan. Unacknowledged notifications retry up to five times with exponential backoff."
          }
        },
        "additionalProperties": false,
        "required": [
          "channel_id",
          "content"
        ],
        "description": "The notification to send."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether Pushinator accepted the notification."
          },
          "message": {
            "type": "string",
            "description": "The human-readable response message."
          }
        },
        "additionalProperties": true,
        "required": [
          "success",
          "message"
        ],
        "description": "The notification submission result, not a delivery receipt."
      }
    }
  ]
}
