                "description": "A Qdrant UUID point ID in simple, hyphenated, or URN form."
              }
            ],
            "description": "A Qdrant numeric or UUID point ID."
          }
        },
        "additionalProperties": false,
        "required": [
          "collectionName",
          "id"
        ],
        "description": "Input parameters for retrieving a Qdrant point."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "point": {
            "type": "object",
            "properties": {
              "id": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991,
                    "description": "A numeric point ID within the JavaScript safe-integer range."
                  },
                  {
                    "type": "string",
                    "pattern": "^(?:[0-9A-Fa-f]{32}|[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}|[uU][rR][nN]:[uU][uU][iI][dD]:[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12})$",
                    "description": "A Qdrant UUID point ID in simple, hyphenated, or URN form."
                  }
                ],
                "description": "A Qdrant numeric or UUID point ID."
              },
              "payload": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {},
                    "additionalProperties": true,
                    "description": "A JSON object stored with the point."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "A JSON object stored with the point."
              },
              "vector": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "description": "One vector component."
                    },
                    "description": "A dense unnamed vector.",
                    "minItems": 1
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "A dense unnamed vector."
              },
              "shard_key": {
                "description": "The Qdrant shard key when present."
              },
              "order_value": {
                "description": "The Qdrant order value when present."
              }
            },
            "additionalProperties": true,
            "required": [
              "id"
            ],
            "description": "A Qdrant point record."
          }
        },
        "additionalProperties": false,
        "required": [
          "point"
        ],
        "description": "The Qdrant point record response."
      }
    },
