          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "The numeric Payrexx resource identifier."
          }
        },
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "description": "The transaction to retrieve."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "transaction": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "A Payrexx resource returned by the API."
          }
        },
        "additionalProperties": false,
        "required": [
          "transaction"
        ],
        "description": "The requested Payrexx transaction."
      }
    },
    {
      "id": "payrexx.list_payment_providers",
      "service": "payrexx",
      "name": "list_payment_providers",
      "description": "List payment providers configured for the connected Payrexx instance.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "description": "The input payload for this action."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "paymentProviders": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A Payrexx resource returned by the API."
            },
            "description": "Configured payment providers."
          }
        },
        "additionalProperties": false,
        "description": "The payment providers configured for the Payrexx instance."
      }
    },
    {
      "id": "payrexx.list_transactions",
      "service": "payrexx",
      "name": "list_transactions",
      "description": "List transactions for the connected Payrexx instance.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "filterDatetimeUtcGreaterThan": {
            "type": "string",
            "description": "Return transactions after this UTC timestamp in YYYY-MM-DD HH:MM:SS format."
          },
          "filterDatetimeUtcLessThan": {
            "type": "string",
            "description": "Return transactions before this UTC timestamp in YYYY-MM-DD HH:MM:SS format."
          },
          "filterMyTransactionsOnly": {
            "type": "boolean",
            "description": "Whether to return only transactions associated with the current API key."
          },
          "orderByTime": {
            "type": "string",
            "enum": [
              "ASC",
              "DESC"
            ],
            "description": "Sort direction for the transaction timestamp."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of transaction rows to skip."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "The maximum number of transactions to return."
          }
        },
        "additionalProperties": false,
        "description": "Filters and pagination for Payrexx transactions."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "transactions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A Payrexx resource returned by the API."
            },
            "description": "Matching transactions."
          }
        },
        "additionalProperties": false,
        "required": [
          "transactions"
        ],
        "description": "The matching Payrexx transactions."
      }
    }
  ]
}
