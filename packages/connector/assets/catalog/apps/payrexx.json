{
  "service": "payrexx",
  "displayName": "Payrexx",
  "categories": [
    "Finance"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Secret",
      "placeholder": "PAYREXX_API_SECRET",
      "description": "Payrexx API Secret sent in the X-API-KEY header. View it under API and Plugins: https://docs.payrexx.com/merchant/english/account/api-and-plugins.",
      "extraFields": [
        {
          "key": "instance",
          "label": "Instance",
          "required": true,
          "secret": false,
          "inputType": "text",
          "placeholder": "example",
          "description": "Your Payrexx instance name from https://{instance}.payrexx.com."
        }
      ]
    }
  ],
  "homepageUrl": "https://payrexx.com",
  "actions": [
    {
      "id": "payrexx.create_gateway",
      "service": "payrexx",
      "name": "create_gateway",
      "description": "Create a Payrexx payment gateway and return its hosted checkout link.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "integer",
            "minimum": 1,
            "description": "The payment amount in the smallest currency unit, such as cents."
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "description": "The ISO 4217 currency code."
          },
          "purpose": {
            "type": "string",
            "description": "The purpose shown for the payment."
          },
          "referenceId": {
            "type": "string",
            "description": "An internal reference identifier from your system."
          },
          "sku": {
            "type": "string",
            "description": "The product stock keeping unit."
          },
          "vatRate": {
            "type": "number",
            "description": "The VAT rate percentage."
          },
          "successRedirectUrl": {
            "type": "string",
            "description": "The URL where the shopper is redirected after a successful payment.",
            "format": "uri"
          },
          "failedRedirectUrl": {
            "type": "string",
            "description": "The URL where the shopper is redirected after a failed payment.",
            "format": "uri"
          },
          "cancelRedirectUrl": {
            "type": "string",
            "description": "The URL where the shopper is redirected after cancelling the payment.",
            "format": "uri"
          },
          "preAuthorization": {
            "type": "boolean",
            "description": "Whether the payment should be authorized for later capture."
          },
          "reservation": {
            "type": "boolean",
            "description": "Whether the payment amount should be reserved for later capture."
          }
        },
        "additionalProperties": false,
        "required": [
          "amount",
          "currency"
        ],
        "description": "The payment gateway to create."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "gateway": {
            "type": "object",
            "properties": {
              "link": {
                "type": "string",
                "description": "The hosted Payrexx checkout URL.",
                "format": "uri"
              }
            },
            "additionalProperties": true,
            "required": [
              "link"
            ],
            "description": "The created gateway and its hosted checkout details."
          }
        },
        "additionalProperties": false,
        "required": [
          "gateway"
        ],
        "description": "The created Payrexx gateway."
      }
    },
    {
      "id": "payrexx.get_gateway",
      "service": "payrexx",
      "name": "get_gateway",
      "description": "Retrieve one Payrexx payment gateway by its numeric identifier.",
