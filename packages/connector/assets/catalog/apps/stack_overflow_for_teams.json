        {
          "key": "team",
          "label": "Team Slug",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "my-team",
          "description": "The team slug from your Stack Internal URL, such as my-team in stackoverflowteams.com/c/my-team."
        }
      ]
    }
