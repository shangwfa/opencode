{
  "service": "latchshot",
  "displayName": "Latchshot",
  "description": "Render guarded screenshots and PDFs of public web pages without running a browser locally.",
  "categories": [
    "Developer Tools",
    "Design & Media"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "ls_live_...",
      "description": "Latchshot API key sent as a Bearer token. Get a recurring Free-plan key from https://latchshot.fly.dev/?intent=openconnector#trial."
    }
  ],
  "homepageUrl": "https://latchshot.fly.dev",
  "actions": [
    {
      "id": "latchshot.capture_page",
      "service": "latchshot",
      "name": "capture_page",
      "description": "Render a public web page as a PNG, JPEG, or PDF and store the bounded artifact in local transit storage.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "The public HTTP or HTTPS page URL. Private, loopback, link-local, credential-bearing, and non-web-port targets are rejected.",
            "format": "uri"
          },
          "kind": {
            "type": "string",
            "enum": [
              "screenshot",
              "pdf"
            ],
            "description": "The artifact family to render.",
            "default": "screenshot"
          },
          "format": {
            "type": "string",
            "enum": [
              "png",
              "jpeg"
            ],
            "description": "The image format for screenshots. PDF renders always return PDF.",
            "default": "png"
          },
          "width": {
            "type": "integer",
            "minimum": 320,
            "maximum": 2560,
            "description": "The browser viewport width in CSS pixels.",
            "default": 1440
          },
          "height": {
            "type": "integer",
            "minimum": 240,
            "maximum": 1440,
            "description": "The browser viewport height in CSS pixels.",
            "default": 900
          },
          "scale": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2,
            "description": "The device scale factor for screenshot output.",
            "default": 1
          },
          "fullPage": {
            "type": "boolean",
            "description": "Whether a screenshot should include the bounded full document height.",
            "default": false
          },
          "waitUntil": {
            "type": "string",
            "enum": [
              "load",
              "domcontentloaded",
              "networkidle"
            ],
            "description": "The browser lifecycle event awaited before the optional delay.",
            "default": "domcontentloaded"
          },
          "delay": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3000,
            "description": "Additional wait in milliseconds after the lifecycle event.",
            "default": 0
          },
          "timeout": {
            "type": "integer",
            "minimum": 3000,
            "maximum": 30000,
            "description": "The browser navigation timeout in milliseconds.",
            "default": 15000
          },
          "darkMode": {
            "type": "boolean",
            "description": "Whether to emulate a dark color-scheme preference.",
            "default": false
          },
          "reducedMotion": {
            "type": "boolean",
            "description": "Whether to emulate reduced motion for a more stable capture.",
            "default": true
          },
          "paper": {
            "type": "string",
            "enum": [
              "A4",
              "Letter",
              "Legal"
            ],
            "description": "The paper size for PDF rendering.",
            "default": "A4"
          },
          "landscape": {
            "type": "boolean",
            "description": "Whether PDF output should use landscape orientation.",
            "default": false
          }
        },
        "additionalProperties": false,
        "required": [
          "url"
        ],
        "description": "Input parameters for one bounded public-page screenshot or PDF render."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "file": {
            "type": "object",
            "properties": {
              "fileId": {
                "type": "string",
                "minLength": 1,
                "description": "The local transit file identifier."
              },
              "downloadUrl": {
                "type": "string",
                "description": "The local URL used to download the rendered artifact.",
                "format": "uri"
              },
              "sizeBytes": {
                "type": "integer",
                "minimum": 0,
                "description": "The artifact size in bytes."
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "The artifact filename."
              },
              "mimeType": {
                "type": "string",
                "enum": [
                  "image/png",
                  "image/jpeg",
                  "application/pdf"
                ],
                "description": "The artifact MIME type."
              }
            },
            "additionalProperties": false,
            "required": [
              "fileId",
              "downloadUrl",
              "sizeBytes",
              "name",
              "mimeType"
            ],
            "description": "The rendered artifact stored in local transit storage."
          },
          "diagnostics": {
            "type": "object",
            "properties": {
              "renderMs": {
                "type": "integer",
                "minimum": 0,
                "description": "The server-side render duration in milliseconds."
              },
              "navigation": {
                "type": "string",
                "enum": [
                  "complete",
                  "timed-out"
                ],
                "description": "Whether browser navigation completed before capture."
              },
              "fonts": {
                "type": "string",
                "enum": [
                  "original",
                  "fallback"
                ],
                "description": "Whether the page used its original fonts or a fallback state."
              },
              "scripts": {
                "type": "string",
                "enum": [
                  "active",
                  "paused"
                ],
                "description": "Whether page scripts stayed active or were paused by the fallback path."
              }
            },
            "additionalProperties": false,
            "description": "Bounded render diagnostics returned in Latchshot response headers."
          },
          "quota": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "integer",
                "minimum": 0,
                "description": "The successful-render allowance for the current UTC calendar month."
              },
              "remaining": {
                "type": "integer",
                "minimum": 0,
                "description": "The successful renders remaining in the current month."
              },
              "resetAt": {
                "type": "string",
                "description": "The start of the next UTC calendar month.",
                "format": "date-time"
              }
            },
            "additionalProperties": false,
            "description": "The successful-render quota snapshot returned with the artifact."
          }
        },
        "additionalProperties": false,
        "required": [
          "file"
        ],
        "description": "A rendered artifact in local transit storage with render and quota diagnostics."
      }
    },
    {
      "id": "latchshot.get_usage",
      "service": "latchshot",
      "name": "get_usage",
      "description": "Read the current Latchshot plan, successful-render quota, reset time, upgrade-request status, and owner-managed paid-plan links. This action never initiates payment or an upgrade.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "description": "No input is required to read usage for the configured API key."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "customer": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "The display name attached to the API key."
              },
              "plan": {
                "type": "string",
                "minLength": 1,
                "description": "The current Latchshot plan identifier. Known values are trial, launch, build, and scale; newer tiers are passed through unchanged."
              }
            },
            "additionalProperties": false,
            "required": [
              "name",
              "plan"
            ],
            "description": "The display identity attached to the API key."
          },
          "usage": {
            "type": "object",
            "properties": {
              "period": {
                "type": "string",
                "description": "The current UTC calendar month.",
                "pattern": "^[0-9]{4}-[0-9]{2}$"
              },
              "plan": {
                "type": "string",
                "minLength": 1,
                "description": "The current Latchshot plan identifier. Known values are trial, launch, build, and scale; newer tiers are passed through unchanged."
              },
              "limit": {
                "type": "integer",
                "minimum": 0,
                "description": "The successful-render allowance for the current month."
              },
              "remaining": {
                "type": "integer",
                "minimum": 0,
                "description": "The successful renders remaining in the current month."
              },
              "resetAt": {
                "type": "string",
                "description": "The start of the next UTC calendar month.",
                "format": "date-time"
              },
              "successful": {
                "type": "integer",
                "minimum": 0,
                "description": "The successful renders completed in the current month."
              },
              "failed": {
                "type": "integer",
                "minimum": 0,
                "description": "The failed reserved renders, which do not consume successful-render quota."
              },
              "reserved": {
                "type": "integer",
                "minimum": 0,
                "description": "The render slots currently reserved for in-flight work."
              },
              "outputBytes": {
                "type": "integer",
                "minimum": 0,
                "description": "The total successful output bytes in the current month."
              },
              "renderMs": {
                "type": "integer",
                "minimum": 0,
                "description": "The aggregate successful render duration in the current month."
              },
              "updatedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "The last usage update time, or null before the first render.",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The last usage update time, or null before the first render."
              }
            },
            "additionalProperties": false,
            "required": [
              "period",
              "plan",
              "limit",
              "remaining",
              "resetAt",
              "successful",
              "failed",
              "reserved",
              "outputBytes",
              "renderMs",
              "updatedAt"
            ],
            "description": "Current successful-render usage for the UTC calendar month."
          },
          "upgradeRequest": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "The request identifier."
                  },
                  "keyId": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "The API key record identifier."
                  },
                  "requestedPlan": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The requested paid plan. Known values are launch, build, and scale; newer tiers are passed through unchanged."
                  },
                  "note": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "The optional request note."
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "The optional request note."
                  },
                  "status": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The request review status. Known values are new, contacted, fulfilled, and declined; newer statuses are passed through unchanged."
                  },
                  "createdAt": {
                    "type": "string",
                    "description": "When the request was created.",
                    "format": "date-time"
                  },
                  "updatedAt": {
                    "type": "string",
                    "description": "When the request was last updated.",
                    "format": "date-time"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "id",
                  "keyId",
                  "requestedPlan",
                  "note",
                  "status",
                  "createdAt",
                  "updatedAt"
                ],
                "description": "The latest paid-plan request attached to the key."
              },
              {
                "type": "null"
              }
            ],
            "description": "The latest paid-plan request attached to the key."
          },
          "links": {
            "type": "object",
            "properties": {
              "plans": {
                "type": "string",
                "description": "The public Latchshot plan comparison.",
                "format": "uri"
              },
              "requestPaidPlan": {
                "type": "string",
                "description": "The human paid-plan request form.",
                "format": "uri"
              },
              "requestPaidPlanDocs": {
                "type": "string",
                "description": "The authenticated paid-plan request API documentation.",
                "format": "uri"
              }
            },
            "additionalProperties": false,
            "required": [
              "plans",
              "requestPaidPlan",
              "requestPaidPlanDocs"
            ],
            "description": "Owner-managed paid-plan continuation links."
          }
        },
        "additionalProperties": false,
        "required": [
          "customer",
          "usage",
          "upgradeRequest",
          "links"
        ],
        "description": "The current Latchshot plan and quota snapshot."
      }
    }
  ]
}
