  "homepageUrl": "https://www.daily.co/",
  "actions": [
    {
      "id": "daily.create_meeting_token",
      "service": "daily",
      "name": "create_meeting_token",
      "description": "Create a Daily meeting token for room access control.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "properties": {
            "type": "object",
            "properties": {
              "room_name": {
                "type": "string",
                "minLength": 1,
                "description": "The Daily room name."
              },
              "exp": {
                "type": "integer",
                "description": "The UNIX timestamp after which the token cannot be used."
              },
              "nbf": {
                "type": "integer",
                "description": "The UNIX timestamp before which the token cannot be used."
              },
              "is_owner": {
                "type": "boolean",
                "description": "Whether the token grants meeting owner privileges."
              },
              "user_name": {
                "type": "string",
                "description": "The participant display name for the meeting."
              },
              "user_id": {
                "type": "string",
                "maxLength": 36,
                "description": "The participant ID for the meeting."
              },
              "start_video_off": {
                "type": "boolean",
                "description": "Whether this participant joins with camera off by default."
              },
              "start_audio_off": {
                "type": "boolean",
                "description": "Whether this participant joins with microphone off by default."
              },
              "eject_at_token_exp": {
                "type": "boolean",
                "description": "Whether to eject the participant when the meeting token expires."
              },
              "eject_after_elapsed": {
                "type": "integer",
                "description": "The number of seconds after join when the participant is ejected."
              }
            },
            "additionalProperties": true,
            "description": "Daily meeting token properties to send as-is."
          }
        },
        "additionalProperties": false,
        "required": [
          "properties"
        ],
        "description": "The input for creating a Daily meeting token."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "description": "The Daily meeting token."
          }
        },
        "additionalProperties": false,
        "required": [
          "token"
        ],
        "description": "The Daily meeting token response."
      }
    },
    {
      "id": "daily.create_room",
      "service": "daily",
      "name": "create_room",
      "description": "Create a Daily room with optional privacy and configuration properties.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The room name. Daily generates a name when omitted."
          },
          "privacy": {
            "type": "string",
            "enum": [
              "public",
              "private"
            ],
            "description": "The Daily room privacy setting."
          },
          "properties": {
            "type": "object",
            "properties": {
              "nbf": {
                "type": "integer",
                "description": "The UNIX timestamp before which users cannot join the room."
              },
              "exp": {
                "type": "integer",
                "description": "The UNIX timestamp after which users cannot join the room."
              },
              "max_participants": {
                "type": "integer",
                "description": "The maximum number of participants allowed in the room."
              },
              "enable_prejoin_ui": {
                "type": "boolean",
                "description": "Whether Daily Prebuilt shows the prejoin UI for this room."
              },
              "enable_people_ui": {
                "type": "boolean",
                "description": "Whether Daily Prebuilt shows the People UI."
              },
              "enable_pip_ui": {
                "type": "boolean",
                "description": "Whether Daily Prebuilt shows Picture in Picture controls."
              },
              "enable_chat": {
                "type": "boolean",
                "description": "Whether Daily Prebuilt chat is enabled."
              },
              "start_video_off": {
                "type": "boolean",
                "description": "Whether participants join with camera off by default."
              },
              "start_audio_off": {
                "type": "boolean",
                "description": "Whether participants join with microphone off by default."
              },
              "lang": {
                "type": "string",
                "description": "The default Daily Prebuilt language for this room."
              }
            },
            "additionalProperties": true,
            "description": "Daily room configuration properties to send as-is."
          }
        },
        "additionalProperties": false,
        "description": "The input for creating a Daily room."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "room": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The Daily room ID."
              },
              "name": {
                "type": "string",
                "description": "The Daily room name."
              },
              "api_created": {
                "type": "boolean",
                "description": "Whether the room was created through the API."
              },
              "privacy": {
                "type": "string",
                "description": "The Daily room privacy setting."
              },
              "url": {
                "type": "string",
                "description": "The Daily room URL."
              },
              "created_at": {
                "type": "string",
                "description": "The room creation timestamp."
              },
              "config": {
                "type": "object",
                "properties": {},
                "additionalProperties": true,
                "description": "The Daily room configuration object."
              }
            },
            "additionalProperties": true,
            "description": "A Daily room object."
          }
        },
        "additionalProperties": false,
        "required": [
          "room"
        ],
        "description": "The Daily room response."
      }
    },
