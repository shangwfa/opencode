      "id": "daily.list_rooms",
      "service": "daily",
      "name": "list_rooms",
      "description": "List Daily rooms with cursor pagination.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "The maximum number of rooms to return."
          },
          "starting_after": {
            "type": "string",
            "description": "Return rooms created after this room ID cursor."
          },
          "ending_before": {
            "type": "string",
            "description": "Return rooms created before this room ID cursor, or OLDEST for oldest rooms."
          }
        },
        "additionalProperties": false,
        "description": "The input for listing Daily rooms."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "total_count": {
            "type": "integer",
            "description": "The total number of rooms returned by Daily."
          },
          "rooms": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The Daily room ID."
                },
                "name": {
                  "type": "string",
                  "description": "The Daily room name."
                },
                "api_created": {
                  "type": "boolean",
                  "description": "Whether the room was created through the API."
                },
                "privacy": {
                  "type": "string",
                  "description": "The Daily room privacy setting."
                },
                "url": {
                  "type": "string",
                  "description": "The Daily room URL."
                },
                "created_at": {
                  "type": "string",
                  "description": "The room creation timestamp."
                },
                "config": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true,
                  "description": "The Daily room configuration object."
                }
              },
              "additionalProperties": true,
              "description": "A Daily room object."
            },
            "description": "The Daily rooms returned by the list endpoint."
          },
          "raw": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "A Daily object returned by the REST API."
          }
        },
        "additionalProperties": false,
        "required": [
          "rooms",
          "raw"
        ],
        "description": "The Daily rooms list response."
      }
