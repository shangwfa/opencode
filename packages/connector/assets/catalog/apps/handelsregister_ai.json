{
  "service": "handelsregister_ai",
  "displayName": "Handelsregister AI",
  "categories": [
    "Data",
    "Finance"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "YOUR_API_KEY",
      "description": "Handelsregister AI API key from the official dashboard: https://handelsregister.ai/en/dashboard."
    }
  ],
  "homepageUrl": "https://handelsregister.ai",
  "actions": [
    {
      "id": "handelsregister_ai.fetch_organization",
      "service": "handelsregister_ai",
      "name": "fetch_organization",
      "description": "Retrieve a German company profile by name, register number, search query, or exact entity identifier, with optional paid enrichment features.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1,
            "description": "A company name, register number, search query, or entity_id from search_organizations.",
            "pattern": "\\S"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "financial_kpi",
                "balance_sheet_accounts",
                "profit_and_loss_account",
                "related_persons",
                "publications",
                "news",
                "insolvency_publications",
                "annual_financial_statements",
                "annual_financial_statements__html",
                "shareholders",
                "ubos",
                "shareholdings",
                "mergers_and_acquisitions",
                "website_content"
              ],
              "description": "A documented organization enrichment feature."
            },
            "description": "Optional enrichment features to request; each feature may consume additional credits.",
            "minItems": 1
          },
          "ai_search": {
            "type": "string",
            "enum": [
              "on-default"
            ],
            "description": "Enable AI enrichment and fuzzy entity resolution at the provider's documented additional credit cost."
          },
          "realtime_mode": {
            "type": "string",
            "enum": [
              "handelsregister-default"
            ],
            "description": "Refresh live commercial-register data at the provider's documented additional credit cost."
          }
        },
        "additionalProperties": false,
        "required": [
          "q"
        ],
        "description": "Parameters for retrieving one German company profile and optional enrichment features."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "description": "The stable Handelsregister AI organization identifier."
          },
          "name": {
            "type": "string",
            "description": "The registered organization name."
          },
          "meta": {
            "type": "object",
            "properties": {
              "request_credit_cost": {
                "type": "number",
                "description": "The number of credits charged for the request."
              },
              "credits_remaining": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ],
                "description": "The remaining credit balance, returned as a number or numeric string."
              }
            },
            "additionalProperties": true,
            "description": "Request billing metadata returned by Handelsregister AI."
          }
        },
        "additionalProperties": true,
        "required": [
          "entity_id",
          "name",
          "meta"
        ],
        "description": "The company profile returned by Handelsregister AI, including requested enrichment fields when available."
      }
    },
    {
      "id": "handelsregister_ai.search_organizations",
      "service": "handelsregister_ai",
      "name": "search_organizations",
      "description": "Search German commercial-register organizations by free text or structured filters and return a paginated result set.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 2,
            "description": "A company name, register number, or free-text search query."
          },
          "filters": {
            "type": "object",
            "properties": {
              "registration_date_from": {
                "type": "string",
                "description": "The earliest registration date or timestamp in ISO 8601 format."
              },
              "registration_date_to": {
                "type": "string",
                "description": "The latest registration date or timestamp in ISO 8601 format."
              },
              "legal_form_code": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                ],
                "description": "One or more legal-form codes to match."
              },
              "industry_code": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                ],
                "description": "One or more WZ industry codes to match."
              },
              "industry_scheme": {
                "type": "string",
                "description": "The industry classification scheme, which defaults to WZ2025."
              },
              "active": {
                "type": "boolean",
                "description": "Whether to include only active or only inactive organizations."
              },
              "postal_code": {
                "type": "string",
                "description": "The postal code to match."
              },
              "city": {
                "type": "string",
                "description": "The city to match."
              },
              "state": {
                "type": "string",
                "description": "The German state to match."
              },
              "location_coordinates": {
                "type": "object",
                "properties": {
                  "latitude": {
                    "type": "number",
                    "description": "The latitude of the radius center."
                  },
                  "longitude": {
                    "type": "number",
                    "description": "The longitude of the radius center."
                  }
                },
                "additionalProperties": false,
                "description": "The center point for a geographic radius filter."
              },
              "location_max_distance_km": {
                "type": "number",
                "minimum": 1,
                "maximum": 100,
                "description": "The maximum radius in kilometers, from 1 to 100."
              },
              "registration_type": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  }
                ],
                "description": "One or more register types such as HRA, HRB, GnR, PR, or VR."
              },
              "registration_authority_name": {
                "type": "string",
                "description": "The registration court or authority name to match."
              },
              "registration_number": {
                "type": "string",
                "description": "The commercial-register number to match."
              },
              "company_size_category": {
                "type": "string",
                "enum": [
                  "micro",
                  "small",
                  "medium",
                  "large"
                ],
                "description": "The company size category to match."
              },
              "financial_filters": {
                "type": "object",
                "properties": {
                  "emp_count": {
                    "type": "object",
                    "properties": {
                      "gte": {
                        "type": "number",
                        "description": "The inclusive minimum value."
                      },
                      "lte": {
                        "type": "number",
                        "description": "The inclusive maximum value."
                      }
                    },
                    "additionalProperties": false,
                    "description": "An inclusive numeric range used to filter company financial values."
                  },
                  "bs_assets_total": {
                    "type": "object",
                    "properties": {
                      "gte": {
                        "type": "number",
                        "description": "The inclusive minimum value."
                      },
                      "lte": {
                        "type": "number",
                        "description": "The inclusive maximum value."
                      }
                    },
                    "additionalProperties": false,
                    "description": "An inclusive numeric range used to filter company financial values."
                  },
                  "bs_equity_total": {
                    "type": "object",
                    "properties": {
                      "gte": {
                        "type": "number",
                        "description": "The inclusive minimum value."
                      },
                      "lte": {
                        "type": "number",
                        "description": "The inclusive maximum value."
                      }
                    },
                    "additionalProperties": false,
                    "description": "An inclusive numeric range used to filter company financial values."
                  },
                  "bs_liabilities_total": {
                    "type": "object",
                    "properties": {
                      "gte": {
                        "type": "number",
                        "description": "The inclusive minimum value."
                      },
                      "lte": {
                        "type": "number",
                        "description": "The inclusive maximum value."
                      }
                    },
                    "additionalProperties": false,
                    "description": "An inclusive numeric range used to filter company financial values."
                  },
                  "bs_cash_and_equivalents": {
                    "type": "object",
                    "properties": {
                      "gte": {
                        "type": "number",
                        "description": "The inclusive minimum value."
                      },
                      "lte": {
                        "type": "number",
                        "description": "The inclusive maximum value."
                      }
                    },
                    "additionalProperties": false,
                    "description": "An inclusive numeric range used to filter company financial values."
                  },
                  "bs_cash_to_liabilities": {
                    "type": "object",
                    "properties": {
                      "gte": {
                        "type": "number",
                        "description": "The inclusive minimum value."
                      },
                      "lte": {
                        "type": "number",
                        "description": "The inclusive maximum value."
                      }
                    },
                    "additionalProperties": false,
                    "description": "An inclusive numeric range used to filter company financial values."
                  },
                  "bs_equity_ratio": {
                    "type": "object",
                    "properties": {
                      "gte": {
                        "type": "number",
                        "description": "The inclusive minimum value."
                      },
                      "lte": {
                        "type": "number",
                        "description": "The inclusive maximum value."
                      }
                    },
                    "additionalProperties": false,
                    "description": "An inclusive numeric range used to filter company financial values."
                  },
                  "bs_debt_to_assets": {
                    "type": "object",
                    "properties": {
                      "gte": {
                        "type": "number",
                        "description": "The inclusive minimum value."
                      },
                      "lte": {
                        "type": "number",
                        "description": "The inclusive maximum value."
                      }
                    },
                    "additionalProperties": false,
                    "description": "An inclusive numeric range used to filter company financial values."
                  },
                  "pl_revenue": {
                    "type": "object",
                    "properties": {
                      "gte": {
                        "type": "number",
                        "description": "The inclusive minimum value."
                      },
                      "lte": {
                        "type": "number",
                        "description": "The inclusive maximum value."
                      }
                    },
                    "additionalProperties": false,
                    "description": "An inclusive numeric range used to filter company financial values."
                  },
                  "pl_net_income": {
                    "type": "object",
                    "properties": {
                      "gte": {
                        "type": "number",
                        "description": "The inclusive minimum value."
                      },
                      "lte": {
                        "type": "number",
                        "description": "The inclusive maximum value."
                      }
                    },
                    "additionalProperties": false,
                    "description": "An inclusive numeric range used to filter company financial values."
                  },
                  "pl_ebit": {
                    "type": "object",
                    "properties": {
                      "gte": {
                        "type": "number",
                        "description": "The inclusive minimum value."
                      },
                      "lte": {
                        "type": "number",
                        "description": "The inclusive maximum value."
                      }
                    },
                    "additionalProperties": false,
                    "description": "An inclusive numeric range used to filter company financial values."
                  }
                },
                "additionalProperties": false,
                "description": "Financial ranges used to filter organizations by their latest available statements."
              }
            },
            "additionalProperties": false,
            "description": "Structured filters for German commercial-register organization search."
          },
          "skip": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of matching organizations to skip."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "description": "The maximum number of organizations to return, up to 30."
          },
          "ai_mode": {
            "type": "string",
            "enum": [
              "on-default"
            ],
            "description": "Enable AI-assisted search at the provider's documented additional credit cost."
          }
        },
        "additionalProperties": false,
        "description": "Search parameters for finding German commercial-register organizations.",
        "anyOf": [
          {
            "required": [
              "q"
            ]
          },
          {
            "required": [
              "filters"
            ]
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entity_id": {
                  "type": "string",
                  "description": "The stable Handelsregister AI organization identifier."
                },
                "name": {
                  "type": "string",
                  "description": "The registered organization name."
                },
                "registration": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true,
                  "description": "The organization's commercial-register details."
                },
                "address": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true,
                  "description": "The organization's registered address."
                },
                "registration_date": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "The organization registration date or timestamp in ISO 8601 format."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The organization registration date or timestamp in ISO 8601 format."
                },
                "purpose": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "The registered business purpose."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The registered business purpose."
                }
              },
              "additionalProperties": true,
              "description": "A German company search result with registry and address details when available."
            },
            "description": "The organizations matching the current query and filters."
          },
          "total": {
            "type": "integer",
            "description": "The total number of matching organizations."
          },
          "meta": {
            "type": "object",
            "properties": {
              "request_credit_cost": {
                "type": "number",
                "description": "The number of credits charged for the request."
              },
              "credits_remaining": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ],
                "description": "The remaining credit balance, returned as a number or numeric string."
              }
            },
            "additionalProperties": true,
            "description": "Request billing metadata returned by Handelsregister AI."
          }
        },
        "additionalProperties": false,
        "description": "A page of matching German commercial-register organizations."
      }
    }
  ]
}
