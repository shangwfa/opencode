    {
      "id": "lacuna.search",
      "service": "lacuna",
      "name": "search",
      "description": "Search Lacuna's machine-learning research map for papers, research directions, authors, venues, institutions, or generated hypotheses.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "The research query."
          },
          "searchType": {
            "type": "string",
            "enum": [
              "all",
              "paper",
              "papers",
              "cluster",
              "clusters",
              "direction",
              "directions",
              "author",
              "authors",
              "institution",
              "institutions",
              "venue",
              "venues",
              "hypothesis",
              "hypotheses",
              "proposal",
              "proposals"
            ],
            "description": "The entity type to search, including official aliases."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "The maximum number of results to return."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "The zero-based result offset."
          },
          "dateFrom": {
            "type": "string",
            "description": "An inclusive publication date bound in YYYY, YYYY-MM, or YYYY-MM-DD format.",
            "pattern": "^(?!0000)\\d{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12]\\d|3[01]))?)?$"
          },
          "dateTo": {
            "type": "string",
            "description": "An inclusive publication date bound in YYYY, YYYY-MM, or YYYY-MM-DD format.",
            "pattern": "^(?!0000)\\d{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12]\\d|3[01]))?)?$"
          },
          "venue": {
            "type": "string",
            "minLength": 1,
            "description": "A venue name or key used to filter paper results."
          },
          "sort": {
            "type": "string",
            "enum": [
              "relevance",
              "year_desc",
              "year_asc"
            ],
            "description": "The result ordering."
          },
          "rankingProfile": {
            "type": "string",
            "enum": [
              "default",
              "lexical",
              "semantic",
              "bm25",
              "bm25_title_abstract"
            ],
            "description": "The Lacuna ranking profile."
          },
          "fields": {
            "type": "string",
            "minLength": 1,
            "description": "Optional comma-separated lexical fields with optional weights, such as title^4,abstract. Each field must exist on the searched type: title (paper, cluster, venue, hypothesis), abstract/summary/concepts (paper), name (author, institution, venue), top_names (cluster, hypothesis), venue (paper, venue)."
          }
        },
        "additionalProperties": false,
        "required": [
          "query"
        ],
        "description": "Input parameters for searching Lacuna."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "The normalized search query."
          },
          "type_filter": {
            "type": "string",
            "enum": [
              "all",
              "paper",
              "cluster",
              "author",
              "institution",
              "venue",
              "hypothesis"
            ],
            "description": "The normalized entity type applied by Lacuna."
          },
          "total_results": {
            "type": "integer",
            "minimum": 0,
            "description": "The total number of matching Lacuna entities."
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "paper",
                    "cluster",
                    "direction",
                    "author",
                    "institution",
                    "venue",
                    "hypothesis"
                  ],
                  "description": "The Lacuna entity type."
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The Lacuna entity identifier."
                },
                "score": {
                  "type": "number",
                  "description": "The relevance score reported by Lacuna."
                },
                "url": {
                  "type": "string",
                  "description": "The canonical Lacuna page URL for the entity.",
                  "format": "uri"
                },
                "title": {
                  "type": "string",
                  "description": "The paper, direction, venue, or hypothesis title when present."
                },
                "name": {
                  "type": "string",
                  "description": "The author or institution name when present."
                },
                "year": {
                  "type": "integer",
                  "description": "The publication year when present."
                }
              },
              "additionalProperties": true,
              "required": [
                "type",
                "id",
                "score",
                "url"
              ],
              "description": "One Lacuna search result. Additional fields depend on the entity type."
            },
            "description": "The matching Lacuna entities."
          }
        },
        "additionalProperties": false,
        "required": [
          "query",
          "type_filter",
          "total_results",
          "results"
        ],
        "description": "A page of Lacuna search results."
      }
    }
  ]
