            "description": "The Hotjar site identifier."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "The maximum number of records to return, up to 100."
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "description": "The opaque cursor returned as nextCursor by a previous Hotjar list action."
          },
          "withQuestions": {
            "type": "boolean",
            "description": "Whether each survey should include its question definitions."
          }
        },
        "additionalProperties": false,
        "required": [
          "siteId"
