{
  "service": "hotjar",
  "displayName": "Hotjar",
  "categories": [
    "Data",
    "Marketing"
  ],
  "authTypes": [
    "custom_credential"
  ],
  "auth": [
    {
      "type": "custom_credential",
      "fields": [
        {
          "key": "clientId",
          "label": "Client ID",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "HOTJAR_CLIENT_ID",
          "description": "The client ID from an administrator-generated Hotjar API credential. Create or view credentials on the Hotjar API settings page: https://insights.hotjar.com/settings/api."
        },
        {
          "key": "clientSecret",
          "label": "Client Secret",
          "inputType": "password",
          "required": true,
          "secret": true,
          "placeholder": "HOTJAR_CLIENT_SECRET",
          "description": "The client secret paired with the Hotjar API credential. Generate it on the Hotjar API settings page and store it securely: https://insights.hotjar.com/settings/api."
        }
      ]
    }
  ],
  "homepageUrl": "https://www.hotjar.com/",
  "actions": [
    {
      "id": "hotjar.get_survey",
      "service": "hotjar",
      "name": "get_survey",
      "description": "Get one Hotjar survey with its question definitions.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "siteId": {
            "type": "string",
            "minLength": 1,
            "description": "The Hotjar site identifier."
          },
          "surveyId": {
            "type": "string",
            "minLength": 1,
            "description": "The Hotjar survey identifier."
          }
        },
        "additionalProperties": false,
        "required": [
          "siteId",
          "surveyId"
        ],
        "description": "The site and survey identifiers to retrieve."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "survey": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The unique Hotjar survey identifier."
              },
              "url": {
                "type": "string",
                "description": "The Hotjar API path for this survey."
              },
              "created_time": {
                "type": "string",
                "description": "The time the survey was created in RFC 3339 format.",
                "format": "date-time"
              },
              "updated_time": {
                "type": "string",
                "description": "The time the survey was last updated in RFC 3339 format.",
                "format": "date-time"
              },
              "is_enabled": {
                "type": "boolean",
                "description": "Whether the survey is enabled."
              },
              "name": {
                "type": "string",
                "description": "The survey name."
              },
              "responses_url": {
                "type": "string",
                "description": "The Hotjar API path for this survey's responses."
              },
              "type": {
                "type": "string",
                "enum": [
                  "link",
                  "full_screen",
                  "popover"
                ],
                "description": "The Hotjar survey presentation type."
              },
              "questions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "The unique Hotjar question identifier."
                    },
                    "is_required": {
                      "type": "boolean",
                      "description": "Whether the respondent must answer this question."
                    },
                    "text": {
                      "type": "string",
                      "description": "The survey question text."
                    },
                    "type": {
                      "type": "string",
                      "description": "The Hotjar question type, such as reaction, long-text, single-option, rating-1-5, nps, statement, or thank-you."
                    },
                    "image_url": {
                      "anyOf": [
                        {
                          "type": "string",
                          "description": "The image URL associated with the question, when present.",
                          "format": "uri"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "The image URL associated with the question, when present."
                    },
                    "choices": {
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "text": {
                                "type": "string",
                                "description": "The text shown for this choice."
                              },
                              "allow_comment": {
                                "type": "boolean",
                                "description": "Whether respondents can add a comment for this choice."
                              }
                            },
                            "additionalProperties": true,
                            "description": "A selectable choice for a Hotjar survey question."
                          },
                          "description": "The selectable choices for an option question."
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "The selectable choices for an option question."
                    },
                    "labels": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "low_label": {
                              "type": "string",
                              "description": "The label shown for the lowest score."
                            },
                            "high_label": {
                              "type": "string",
                              "description": "The label shown for the highest score."
                            }
                          },
                          "additionalProperties": true,
                          "description": "The endpoint labels for a scored Hotjar question."
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "description": "The endpoint labels for a scored Hotjar question."
                    }
                  },
                  "additionalProperties": true,
                  "description": "A question in a Hotjar survey."
                },
                "description": "The questions included in this survey response."
              },
              "sentiment_analysis_enabled": {
                "type": "boolean",
                "description": "Whether Hotjar sentiment analysis is enabled for this survey."
              }
            },
            "additionalProperties": true,
            "description": "A Hotjar survey returned by the API."
          }
        },
        "additionalProperties": false,
        "required": [
          "survey"
        ],
        "description": "One Hotjar survey."
      },
      "followUpActions": [
        "hotjar.list_survey_responses"
      ]
    },
    {
      "id": "hotjar.list_survey_responses",
      "service": "hotjar",
      "name": "list_survey_responses",
      "description": "List responses submitted to one Hotjar survey with cursor pagination.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "siteId": {
            "type": "string",
            "minLength": 1,
            "description": "The Hotjar site identifier."
          },
          "surveyId": {
            "type": "string",
            "minLength": 1,
            "description": "The Hotjar survey identifier."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "The maximum number of records to return, up to 100."
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "description": "The opaque cursor returned as nextCursor by a previous Hotjar list action."
          }
        },
        "additionalProperties": false,
        "required": [
          "siteId",
          "surveyId"
        ],
        "description": "The survey identifiers and pagination controls for listing responses."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "responses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The unique Hotjar survey response identifier."
                },
                "answers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "question_id": {
                        "type": "string",
                        "description": "The identifier of the answered survey question."
                      },
                      "answer": {
                        "type": "string",
                        "description": "The answer value recorded by Hotjar."
                      },
                      "comment": {
                        "anyOf": [
                          {
                            "type": "string",
                            "description": "The optional respondent comment."
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "The optional respondent comment."
                      },
                      "tags": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "description": "The tag name."
                            }
                          },
                          "additionalProperties": true,
                          "description": "A Hotjar survey response tag."
                        },
                        "description": "The tags attached to this answer."
                      },
                      "sentiment": {
                        "anyOf": [
                          {
                            "type": "string",
                            "enum": [
                              "positive",
                              "negative",
                              "neutral"
                            ],
                            "description": "The sentiment assigned to the answer text, when available."
                          },
                          {
                            "type": "null"
                          }
                        ],
                        "description": "The sentiment assigned to the answer text, when available."
                      }
                    },
                    "additionalProperties": true,
                    "description": "An answer in a Hotjar survey response."
                  },
                  "description": "The answers included in this survey response."
                },
                "browser": {
                  "type": "string",
                  "description": "The browser used to submit the survey response."
                },
                "country": {
                  "type": "string",
                  "description": "The two-letter country code associated with the respondent."
                },
                "created_time": {
                  "type": "string",
                  "description": "The response submission time in RFC 3339 format.",
                  "format": "date-time"
                },
                "device": {
                  "type": "string",
                  "enum": [
                    "tablet",
                    "mobile",
                    "desktop"
                  ],
                  "description": "The device type used to submit the response."
                },
                "hotjar_user_id": {
                  "type": "string",
                  "description": "The Hotjar identifier for the respondent."
                },
                "is_complete": {
                  "type": "boolean",
                  "description": "Whether the survey response is complete."
                },
                "os": {
                  "type": "string",
                  "description": "The respondent's operating system."
                },
                "recording_url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "The related Hotjar recording URL, or null when no recording is available.",
                      "format": "uri"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The related Hotjar recording URL, or null when no recording is available."
                },
                "response_origin_url": {
                  "type": "string",
                  "description": "The site URL where the survey response was submitted.",
                  "format": "uri"
                },
                "user_attributes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "description": "The user attribute name."
                      },
                      "value": {
                        "description": "The string, number, boolean, or datetime attribute value."
                      }
                    },
                    "additionalProperties": true,
                    "description": "A user attribute included through the Hotjar Identify API."
                  },
                  "description": "The respondent attributes supplied through the Hotjar Identify API."
                },
                "window_size": {
                  "type": "object",
                  "properties": {
                    "width": {
                      "type": "integer",
                      "description": "The browser window width in pixels."
                    },
                    "height": {
                      "type": "integer",
                      "description": "The browser window height in pixels."
                    }
                  },
                  "additionalProperties": true,
                  "description": "The browser window size for a survey response."
                }
              },
              "additionalProperties": true,
              "description": "A response submitted to a Hotjar survey."
            },
            "description": "The Hotjar survey responses returned for this page."
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string",
                "description": "The cursor for the next page, or null when there are no more responses."
              },
              {
                "type": "null"
              }
            ],
            "description": "The cursor for the next page, or null when there are no more responses."
          }
        },
        "additionalProperties": false,
        "required": [
          "responses",
          "nextCursor"
        ],
        "description": "A page of Hotjar survey responses."
      }
    },
    {
