    {
      "id": "hotjar.submit_user_lookup",
      "service": "hotjar",
      "name": "submit_user_lookup",
      "description": "Submit a Hotjar organization user lookup request, optionally deleting all matching data when deleteAllHits is true.",
      "operationType": "destructive",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "organizationId": {
            "type": "string",
            "minLength": 1,
            "description": "The Hotjar organization identifier."
          },
          "dataSubjectEmail": {
            "type": "string",
            "description": "The email address of the data subject.",
            "format": "email"
          },
          "dataSubjectSiteIdToUserIdMap": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "description": "The user's identifier on the mapped site."
            },
            "description": "A mapping from Hotjar site identifiers to the user's identifier on each site."
          },
          "deleteAllHits": {
            "type": "boolean",
            "description": "Whether Hotjar should immediately and silently delete all matching user data. Set false to request a lookup report instead."
          }
        },
        "additionalProperties": false,
        "required": [
          "organizationId",
          "deleteAllHits"
        ],
        "description": "The organization and data subject used for a Hotjar user lookup or deletion request."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "description": "Whether Hotjar accepted the lookup or deletion request."
          }
        },
        "additionalProperties": false,
        "required": [
          "accepted"
        ],
        "description": "The accepted Hotjar user lookup request."
      }
    }
  ]
}
