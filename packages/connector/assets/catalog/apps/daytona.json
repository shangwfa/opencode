    {
      "id": "daytona.list_sandboxes",
      "service": "daytona",
      "name": "list_sandboxes",
      "description": "List Daytona sandboxes with cursor pagination and common filters.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "description": "The cursor returned by the previous page."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "description": "The maximum number of sandboxes to return."
          },
          "id": {
            "type": "string",
            "description": "An ID prefix to filter by, matched case-insensitively."
          },
          "name": {
            "type": "string",
            "description": "A name prefix to filter by, matched case-insensitively."
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Sandbox states to include.",
            "minItems": 1
          },
          "includeErroredDeleted": {
            "type": "boolean",
            "description": "Whether to include errored sandboxes whose desired state is deleted."
          }
        },
        "additionalProperties": false,
        "description": "Filters and pagination for listing Daytona sandboxes."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "sandboxes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The sandbox ID."
                },
                "name": {
                  "type": "string",
                  "description": "The sandbox name."
                },
                "state": {
                  "type": "string",
                  "description": "The current sandbox state."
                },
                "desiredState": {
                  "type": "string",
                  "description": "The desired sandbox state."
                },
                "snapshot": {
                  "type": "string",
                  "description": "The snapshot used by the sandbox."
                },
                "target": {
                  "type": "string",
                  "description": "The Daytona target region for the sandbox."
                },
                "cpu": {
                  "type": "number",
                  "description": "The allocated CPU cores."
                },
                "memory": {
                  "type": "number",
                  "description": "The allocated memory in GiB."
                },
                "disk": {
                  "type": "number",
                  "description": "The allocated disk space in GiB."
                },
                "labels": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "description": "A label value."
                  },
                  "description": "Labels attached to the sandbox."
                },
                "createdAt": {
                  "type": "string",
                  "description": "The sandbox creation timestamp."
                },
                "updatedAt": {
                  "type": "string",
                  "description": "The sandbox update timestamp."
                }
              },
              "additionalProperties": true,
              "description": "A Daytona sandbox."
            },
            "description": "Sandboxes in the current page."
          },
          "nextCursor": {
            "anyOf": [
              {
                "type": "string",
                "description": "The cursor for the next page, or null when no page remains."
              },
              {
                "type": "null"
              }
            ],
            "description": "The cursor for the next page, or null when no page remains."
          }
        },
        "additionalProperties": false,
        "description": "A page of Daytona sandboxes."
      },
      "followUpActions": [
        "daytona.list_sandboxes"
      ]
    },
