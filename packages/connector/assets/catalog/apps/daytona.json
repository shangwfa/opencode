  "homepageUrl": "https://www.daytona.io/",
  "actions": [
    {
      "id": "daytona.create_sandbox",
      "service": "daytona",
      "name": "create_sandbox",
      "description": "Create a Daytona sandbox from a snapshot with optional resource and lifecycle settings.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The sandbox name. Daytona uses the generated ID when omitted."
          },
          "snapshot": {
            "type": "string",
            "description": "The ID or name of the snapshot to use."
          },
          "target": {
            "type": "string",
            "description": "The target region where Daytona should create the sandbox."
          },
          "cpu": {
            "type": "integer",
            "minimum": 1,
            "description": "The number of CPU cores to allocate."
          },
          "memory": {
            "type": "integer",
            "minimum": 1,
            "description": "The memory to allocate in GiB."
          },
          "disk": {
            "type": "integer",
            "minimum": 1,
            "description": "The disk space to allocate in GiB."
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "description": "An environment variable value."
            },
            "description": "Environment variables for the sandbox."
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "description": "A label value."
            },
            "description": "Labels for the sandbox."
          },
          "autoStopInterval": {
            "type": "integer",
            "minimum": 0,
            "description": "Minutes of inactivity before Daytona stops the sandbox; zero disables auto-stop."
          },
          "autoArchiveInterval": {
            "type": "integer",
            "minimum": 0,
            "description": "Minutes before Daytona archives a stopped sandbox."
          },
          "autoDeleteInterval": {
            "type": "integer",
            "minimum": 0,
            "description": "Minutes before Daytona deletes a stopped sandbox; zero deletes immediately."
          },
          "ttlMinutes": {
            "type": "integer",
            "minimum": 0,
            "description": "Maximum wall-clock lifetime in minutes; zero disables the TTL."
          }
        },
        "additionalProperties": false,
        "description": "Settings for creating a Daytona sandbox."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "sandbox": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The sandbox ID."
              },
              "name": {
                "type": "string",
                "description": "The sandbox name."
              },
              "state": {
                "type": "string",
                "description": "The current sandbox state."
              },
              "desiredState": {
                "type": "string",
                "description": "The desired sandbox state."
              },
              "snapshot": {
                "type": "string",
                "description": "The snapshot used by the sandbox."
              },
              "target": {
                "type": "string",
                "description": "The Daytona target region for the sandbox."
              },
              "cpu": {
                "type": "number",
                "description": "The allocated CPU cores."
              },
              "memory": {
                "type": "number",
                "description": "The allocated memory in GiB."
              },
              "disk": {
                "type": "number",
                "description": "The allocated disk space in GiB."
              },
              "labels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "description": "A label value."
                },
                "description": "Labels attached to the sandbox."
              },
              "createdAt": {
                "type": "string",
                "description": "The sandbox creation timestamp."
              },
              "updatedAt": {
                "type": "string",
                "description": "The sandbox update timestamp."
              }
            },
            "additionalProperties": true,
            "description": "A Daytona sandbox."
          }
        },
        "additionalProperties": false,
        "description": "A Daytona sandbox result."
      }
    },
