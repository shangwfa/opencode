    {
      "id": "cartes.create_map",
      "service": "cartes",
      "name": "create_map",
      "description": "Create a Cartes.io map.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 191,
            "description": "Map title."
          },
          "slug": {
            "type": "string",
            "maxLength": 255,
            "description": "Optional unique map slug."
          },
          "description": {
            "type": "string",
            "description": "Optional map description."
          },
          "privacy": {
            "type": "string",
            "enum": [
              "public",
              "unlisted",
              "private"
            ],
            "description": "The Cartes.io map privacy value."
          },
          "usersCanCreateMarkers": {
            "type": "string",
            "enum": [
              "yes",
              "only_logged_in",
              "no"
            ],
            "description": "Who can create markers on the map."
          }
        },
        "additionalProperties": false,
        "description": "Input parameters for creating a Cartes.io map."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "map": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The raw Cartes.io JSON object."
          }
        },
        "additionalProperties": false,
        "required": [
          "map"
        ],
        "description": "A Cartes.io map response."
      }
    },
    {
      "id": "cartes.create_marker",
      "service": "cartes",
      "name": "create_marker",
      "description": "Create a marker on one Cartes.io map.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "mapToken": {
            "type": "string",
            "minLength": 1,
            "description": "Optional map token for anonymous or token-protected map operations."
          },
          "description": {
            "type": "string",
            "maxLength": 191,
            "description": "Marker description."
          },
          "categoryId": {
            "type": "integer",
            "minimum": 1,
            "description": "The Cartes.io category id."
          },
          "categoryName": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32,
            "description": "Category name used when categoryId is not provided."
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "Latitude coordinate in decimal degrees."
          },
          "lng": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "Longitude coordinate in decimal degrees."
          },
          "link": {
            "type": "string",
            "description": "Optional marker link URL.",
            "format": "uri"
          },
          "zoom": {
            "type": "number",
            "minimum": 0,
            "maximum": 20,
            "description": "Map zoom level."
          },
          "elevation": {
            "type": "number",
            "minimum": -100000,
            "maximum": 100000,
            "description": "Elevation in meters."
          },
          "expiresAt": {
            "type": "string",
            "description": "Marker expiration timestamp.",
            "format": "date-time"
          },
          "meta": {
            "type": "array",
            "items": {
              "description": "A marker metadata value."
            },
            "description": "Optional marker metadata values.",
            "maxItems": 25
          },
          "heading": {
            "type": "number",
            "minimum": 0,
            "maximum": 360,
            "description": "Heading in degrees."
          },
          "pitch": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "Pitch in degrees."
          },
          "roll": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "Roll in degrees."
          },
          "speed": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000,
            "description": "Marker speed."
          },
          "mapUuid": {
            "type": "string",
            "description": "The Cartes.io map UUID.",
            "format": "uuid"
          }
        },
        "additionalProperties": false,
        "required": [
          "mapUuid",
          "lat",
          "lng"
        ],
        "description": "Input parameters for creating a marker on a Cartes.io map.",
        "oneOf": [
          {
            "required": [
              "categoryId"
            ],
            "not": {
              "required": [
                "categoryName"
              ]
            }
          },
          {
            "required": [
              "categoryName"
            ],
            "not": {
              "required": [
                "categoryId"
              ]
            }
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "marker": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The raw Cartes.io JSON object."
          }
        },
        "additionalProperties": false,
        "required": [
          "marker"
        ],
        "description": "A Cartes.io marker response."
      }
    },
