{
  "service": "govee",
  "displayName": "Govee",
  "categories": [
    "Developer Tools"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "Govee API Key",
      "placeholder": "GOVEE_API_KEY",
      "description": "Govee API key sent with the Govee-API-Key header. Apply for a key in the Govee Home app from Settings > Apply for API Key: https://developer.govee.com/reference/apply-you-govee-api-key."
    }
  ],
  "homepageUrl": "https://www.govee.com",
  "actions": [
    {
      "id": "govee.control_capability",
      "service": "govee",
      "name": "control_capability",
      "description": "Send one documented Govee capability value to a device, such as power, brightness, color, mode, or temperature.",
      "operationType": "destructive",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "description": "The Govee product model, such as `H605C`.",
            "pattern": "\\S"
          },
          "device": {
            "type": "string",
            "minLength": 1,
            "description": "The Govee device id returned by list_devices.",
            "pattern": "\\S"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "The Govee capability type, such as `devices.capabilities.on_off`.",
            "pattern": "\\S"
          },
          "instance": {
            "type": "string",
            "minLength": 1,
            "description": "The Govee capability instance, such as `powerSwitch`.",
            "pattern": "\\S"
          },
          "value": {
            "description": "The value to send for this capability, as documented in list_devices."
          },
          "requestId": {
            "type": "string",
            "description": "A caller-supplied request id. When omitted, the provider generates a UUID.",
            "format": "uuid"
          }
        },
        "additionalProperties": false,
        "required": [
          "sku",
          "device",
          "type",
          "instance",
          "value"
        ],
        "description": "Input parameters for controlling a Govee capability."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "requestId": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "The request id echoed by Govee, when returned."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The request id echoed by Govee, when returned."
              },
              "code": {
                "type": "integer",
                "description": "The numeric Govee response code."
              },
              "message": {
                "type": "string",
                "description": "The Govee response message."
              }
            },
            "additionalProperties": false,
            "required": [
              "requestId",
              "code",
              "message"
            ],
            "description": "The normalized Govee API response envelope."
          },
          "raw": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The raw Govee response envelope."
          }
        },
        "additionalProperties": false,
        "required": [
          "result",
          "raw"
        ],
        "description": "The Govee control response."
      }
    },
    {
      "id": "govee.get_device_state",
      "service": "govee",
      "name": "get_device_state",
      "description": "Get the current state for one Govee device by sku and device id.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
