        "additionalProperties": false,
        "required": [
          "sku",
          "device"
        ],
        "description": "Input parameters identifying one Govee device."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "state": {
            "type": "object",
            "properties": {
              "sku": {
                "type": "string",
                "description": "The Govee product model."
              },
              "device": {
                "type": "string",
                "description": "The Govee device id."
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "description": "The Govee capability type."
                    },
                    "instance": {
                      "type": "string",
                      "description": "The Govee capability instance."
                    },
                    "state": {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": true,
                      "description": "The current state for the capability."
                    }
                  },
                  "additionalProperties": true,
                  "description": "A Govee capability state returned for a device."
                },
                "description": "The capability states returned by Govee."
              }
            },
            "additionalProperties": true,
            "description": "The Govee device state payload."
          },
          "raw": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The raw Govee response envelope."
          }
        },
        "additionalProperties": false,
        "required": [
          "state",
          "raw"
        ],
        "description": "The current Govee device state."
      }
    },
