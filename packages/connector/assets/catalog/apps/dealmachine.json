    {
      "id": "dealmachine.count_properties",
      "service": "dealmachine",
      "name": "count_properties",
      "description": "Count properties and people matching DealMachine search criteria without consuming data credits.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "locations": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "state",
                        "county",
                        "city",
                        "zip_code"
                      ],
                      "description": "The named geographic area type."
                    },
                    "code": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The state, county, city, or ZIP identifier for the location."
                    }
                  },
                  "additionalProperties": false,
                  "description": "A state, county, city, or ZIP area included in the property search."
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "radius",
                      "type": "string",
                      "description": "The radius geographic area type."
                    },
                    "latitude": {
                      "type": "number",
                      "description": "The center latitude for a radius search."
                    },
                    "longitude": {
                      "type": "number",
                      "description": "The center longitude for a radius search."
                    },
                    "radius_miles": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "description": "The radius in miles for a radius search."
                    }
                  },
                  "additionalProperties": false,
                  "description": "A radius area included in the property search."
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "const": "polygon",
                      "type": "string",
                      "description": "The polygon geographic area type."
                    },
                    "coordinates": {
                      "type": "array",
                      "items": {
                        "type": "array",
                        "prefixItems": [
                          {
                            "type": "number",
                            "description": "The longitude coordinate."
                          },
                          {
                            "type": "number",
                            "description": "The latitude coordinate."
                          }
                        ],
                        "minItems": 2,
                        "maxItems": 2,
                        "description": "A longitude and latitude coordinate pair."
                      },
                      "description": "The boundary points for a polygon search as longitude and latitude pairs.",
                      "minItems": 3
                    }
                  },
                  "additionalProperties": false,
                  "description": "A polygon area included in the property search."
                }
              ],
              "description": "A geographic area included in the property search."
            },
            "description": "The geographic areas included in the search.",
            "minItems": 1,
            "maxItems": 15
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "filter_id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The filter slug returned by list_filters."
                },
                "operator": {
                  "type": "string",
                  "minLength": 1,
                  "description": "An operator allowed by the selected filter."
                },
                "value": {
                  "description": "The filter value in the shape required by the selected operator."
                }
              },
              "additionalProperties": false,
              "required": [
                "filter_id",
                "value"
              ],
              "description": "A DealMachine filter applied to the search."
            },
            "description": "The property or people filters combined with AND logic."
          },
          "include_lists": {
            "type": "object",
            "properties": {
              "property_list_ids": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "A DealMachine property list ID."
                },
                "description": "The DealMachine property list IDs.",
                "minItems": 1
              }
            },
            "additionalProperties": false,
            "description": "Property list IDs used to include or exclude records."
          },
          "exclude_lists": {
            "type": "object",
            "properties": {
              "property_list_ids": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "A DealMachine property list ID."
                },
                "description": "The DealMachine property list IDs.",
                "minItems": 1
              }
            },
            "additionalProperties": false,
            "description": "Property list IDs used to include or exclude records."
          },
          "exclude_previously_exported": {
            "description": "Whether or how to exclude records previously exported by the organization."
          },
          "anchor": {
            "type": "string",
            "enum": [
              "properties",
              "people"
            ],
            "description": "The primary entity represented by each result."
          },
          "contact_audience": {
            "type": "string",
            "enum": [
              "owners",
              "owners_and_family",
              "renters",
              "residents"
            ],
            "description": "The relationship group used to select contacts included in the count."
          }
        },
        "additionalProperties": false,
        "description": "The filters and geographic criteria used to count matching properties or people."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "total_properties": {
            "type": "integer",
            "description": "The number of matching properties."
          },
          "total_people": {
            "type": "integer",
            "description": "The number of matching people."
          },
          "total_results": {
            "type": "integer",
            "description": "The count for the selected anchor entity."
          }
        },
        "additionalProperties": false,
        "description": "The entity counts matching the property search criteria."
      }
    },
