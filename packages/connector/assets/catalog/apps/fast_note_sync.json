{
  "service": "fast_note_sync",
  "displayName": "Fast Note Sync",
  "categories": [
    "Productivity",
    "Storage"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Token",
      "placeholder": "FNS_API_TOKEN",
      "description": "FNS API token sent as a Bearer credential. Copy it from the API configuration in your FNS WebGUI.",
      "extraFields": [
        {
          "key": "baseUrl",
          "label": "Server Base URL",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "https://fns.example.com",
          "description": "The HTTP or HTTPS URL of your FNS server. Private targets require OOMOL_CONNECT_ALLOW_PRIVATE_NETWORK."
        }
      ]
    }
  ],
  "homepageUrl": "https://github.com/haierkeys/fast-note-sync-service",
  "actions": [
    {
      "id": "fast_note_sync.delete_attachment",
      "service": "fast_note_sync",
      "name": "delete_attachment",
      "description": "Permanently delete one FNS attachment by path and path hash.",
      "operationType": "destructive",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "vault": {
            "type": "string",
            "minLength": 1,
            "description": "The vault name."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "The attachment path."
          },
          "pathHash": {
            "type": "string",
            "minLength": 1,
            "description": "The attachment path hash returned by FNS."
          }
        },
        "additionalProperties": false,
        "required": [
          "vault",
          "path",
          "pathHash"
        ],
        "description": "Input parameters for deleting one attachment."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean",
            "description": "Whether FNS accepted the attachment deletion."
          },
          "attachment": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "description": "The attachment id."
              },
              "path": {
                "type": "string",
                "description": "The attachment path."
              },
              "pathHash": {
                "type": "string",
                "description": "The hash of the attachment path."
              },
              "contentHash": {
                "type": "string",
                "description": "The hash of the attachment content."
              },
              "rename": {
                "type": "integer",
                "description": "The attachment rename flag."
              },
              "ctime": {
                "type": "integer",
                "description": "The attachment creation timestamp."
              },
              "mtime": {
                "type": "integer",
                "description": "The attachment modification timestamp."
              },
              "size": {
                "type": "integer",
                "description": "The attachment size in bytes."
              },
              "lastTime": {
                "type": "integer",
                "description": "The attachment record update timestamp."
              },
              "createdAt": {
                "type": "string",
                "description": "The attachment record creation time."
              },
              "updatedAt": {
                "type": "string",
                "description": "The attachment record update time."
              }
            },
            "additionalProperties": true,
            "description": "FNS attachment metadata."
          }
        },
        "additionalProperties": false,
        "required": [
          "deleted",
          "attachment"
        ],
        "description": "The attachment deletion result."
      }
    },
