        "description": "Optional filtering for the Demio event list."
      },
      "outputSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer",
              "description": "The unique event identifier."
            },
            "name": {
              "type": "string",
              "description": "The event name."
            },
            "description": {
              "type": "string",
              "description": "The event description."
            },
            "date_id": {
              "type": "integer",
              "description": "The next scheduled event session identifier."
            },
            "status": {
              "type": "string",
              "description": "The next scheduled event session status."
            },
            "timestamp": {
              "type": "integer",
              "description": "The next scheduled event session time as a Unix timestamp."
            },
            "zone": {
              "type": "string",
              "description": "The timezone used for the next scheduled event session."
            },
            "registration_url": {
              "type": "string",
              "description": "The public registration page URL for the event."
            },
            "automated": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "duration": {
                      "type": "number",
                      "description": "The automated event video duration in seconds."
                    },
                    "ready": {
                      "type": "boolean",
                      "description": "Whether the automated event video is ready to play."
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "duration",
                    "ready"
                  ],
                  "description": "Demio automated-event playback details."
                },
                {
                  "type": "null"
                }
              ],
              "description": "Demio automated-event playback details."
            }
          },
          "additionalProperties": true,
          "required": [
            "id",
            "name",
            "date_id",
            "status",
            "timestamp",
            "zone",
            "registration_url",
            "automated"
          ],
          "description": "An active Demio event."
        },
        "description": "The active Demio events."
      }
    },
    {
      "id": "demio.register_attendee",
      "service": "demio",
      "name": "register_attendee",
      "description": "Register one attendee for a Demio event and return the attendee hash and unique join link.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "integer",
                "description": "The event ID, or null when ref_url identifies the event."
              },
              {
                "type": "null"
              }
            ],
            "description": "The event ID, or null when ref_url identifies the event."
          },
          "ref_url": {
            "anyOf": [
              {
                "type": "string",
                "description": "The event registration page URL, or null when id identifies the event.",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "description": "The event registration page URL, or null when id identifies the event."
          },
          "date_id": {
            "anyOf": [
              {
                "type": "integer",
                "description": "The event session ID, or null to let Demio choose the nearest active session."
              },
              {
                "type": "null"
              }
            ],
            "description": "The event session ID, or null to let Demio choose the nearest active session."
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "description": "The attendee's first name."
          },
          "email": {
            "type": "string",
            "description": "The attendee's email address.",
            "format": "email"
          },
          "last_name": {
            "type": "string",
            "description": "The attendee's last name."
          },
          "company": {
            "type": "string",
            "description": "The attendee's company."
          },
          "website": {
            "type": "string",
            "description": "The attendee's company website."
          },
          "phone_number": {
            "type": "string",
            "description": "The attendee's phone number."
          },
          "gdpr": {
            "type": "string",
            "description": "The attendee's value for the predefined GDPR field."
          }
        },
        "additionalProperties": {
          "type": "string",
          "description": "A custom registration field value keyed by its Demio field identifier."
        },
        "required": [
          "name",
          "email"
        ],
        "description": "Registration data for one Demio attendee. Extra string properties are sent as custom registration fields keyed by their Demio field identifiers."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "hash": {
            "type": "string",
            "minLength": 1,
            "description": "The attendee hash used to identify the registration."
          },
          "join_link": {
            "type": "string",
            "description": "The attendee's unique event join link.",
            "format": "uri"
          }
        },
        "additionalProperties": true,
        "required": [
          "hash",
          "join_link"
        ],
        "description": "The newly created Demio attendee registration."
      }
    }
  ]
}
