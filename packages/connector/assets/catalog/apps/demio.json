{
  "service": "demio",
  "displayName": "Demio",
  "categories": [
    "Marketing",
    "Communication"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "DEMIO_API_KEY",
      "description": "Demio API Key sent with the Api-Key header. Account owners can copy it from Settings > API: https://help.demio.com/en/articles/3527489-zapier-setup.",
      "extraFields": [
        {
          "key": "apiSecret",
          "label": "API Secret",
          "inputType": "password",
          "required": true,
          "secret": true,
          "placeholder": "DEMIO_API_SECRET",
          "description": "Demio API Secret sent with the Api-Secret header. Account owners can copy or regenerate it from Settings > API: https://help.demio.com/en/articles/3527489-zapier-setup."
        }
      ]
    }
  ],
  "homepageUrl": "https://www.demio.com",
  "actions": [
    {
      "id": "demio.get_event",
      "service": "demio",
      "name": "get_event",
      "description": "Get one Demio event with its public registration URL and complete scheduled session list.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The unique event identifier."
          },
          "active": {
            "type": "boolean",
            "description": "Whether to return only active sessions in the event series."
          }
        },
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "description": "Input identifying a Demio event."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The unique event identifier."
          },
          "name": {
            "type": "string",
            "description": "The event name."
          },
          "description": {
            "type": "string",
            "description": "The event description."
          },
          "registrants_stay_registered": {
            "type": "boolean",
            "description": "Whether registrants stay registered throughout an event series."
          },
          "registration_url": {
            "type": "string",
            "description": "The public registration page URL for the event."
          },
          "next_date_id": {
            "type": "integer",
            "description": "The next available running or scheduled event session identifier."
          },
          "automated": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "duration": {
                    "type": "number",
                    "description": "The automated event video duration in seconds."
                  },
                  "ready": {
                    "type": "boolean",
                    "description": "Whether the automated event video is ready to play."
                  }
                },
                "additionalProperties": false,
                "required": [
                  "duration",
                  "ready"
                ],
                "description": "Demio automated-event playback details."
              },
              {
                "type": "null"
              }
            ],
            "description": "Demio automated-event playback details."
          },
          "dates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date_id": {
                  "type": "integer",
                  "description": "The unique event session identifier."
                },
                "status": {
                  "type": "string",
                  "description": "The current event session status."
                },
                "timestamp": {
                  "type": "integer",
                  "description": "The scheduled event session time as a Unix timestamp."
                },
                "datetime": {
                  "type": "string",
                  "description": "The human-readable scheduled event session time."
                },
                "zone": {
                  "type": "string",
                  "description": "The timezone used for the event session."
                }
              },
              "additionalProperties": true,
              "required": [
                "date_id",
                "status",
                "timestamp",
                "datetime",
                "zone"
              ],
              "description": "A scheduled Demio event session."
            },
            "description": "All scheduled, running, and finished sessions for the event."
          }
        },
        "additionalProperties": true,
        "required": [
          "id",
          "name",
          "description",
          "registrants_stay_registered",
          "registration_url",
          "next_date_id",
          "automated",
          "dates"
        ],
        "description": "Detailed Demio event information."
      }
    },
    {
