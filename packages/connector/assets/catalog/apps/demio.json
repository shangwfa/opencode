    {
      "id": "demio.list_event_participants",
      "service": "demio",
      "name": "list_event_participants",
      "description": "List participants for one Demio event session, optionally filtered by participation status.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "date_id": {
            "type": "integer",
            "description": "The unique event session identifier."
          },
          "status": {
            "type": "string",
            "enum": [
              "attended",
              "did not attend",
              "completed",
              "left early",
              "banned"
            ],
            "description": "The participation status to return."
          }
        },
        "additionalProperties": false,
        "required": [
          "date_id"
        ],
        "description": "Input identifying a Demio event session participation report."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "participants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "description": "The participant's email address."
                },
                "name": {
                  "type": "string",
                  "description": "The participant's name."
                },
                "custom_fields": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "The custom registration field identifier."
                      },
                      "name": {
                        "type": "string",
                        "description": "The custom registration field name."
                      },
                      "value": {
                        "type": "string",
                        "description": "The participant's value for the custom registration field."
                      }
                    },
                    "additionalProperties": true,
                    "required": [
                      "id",
                      "name",
                      "value"
                    ],
                    "description": "A Demio participant custom field value."
                  },
                  "description": "The participant's custom registration field values."
                },
                "attended": {
                  "type": "boolean",
                  "description": "Whether the participant attended the event session."
                },
                "status": {
                  "type": "string",
                  "description": "The participant's event session status."
                }
              },
              "additionalProperties": true,
              "required": [
                "email",
                "name",
                "custom_fields",
                "attended",
                "status"
              ],
              "description": "A participant in a Demio event session."
            },
            "description": "The participants in the event session."
          }
        },
        "additionalProperties": true,
        "required": [
          "participants"
        ],
        "description": "The Demio event session participation report."
      }
    },
    {
