        "properties": {
          "typebotId": {
            "type": "string",
            "minLength": 1,
            "description": "The Typebot bot identifier.",
            "pattern": "\\S"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "description": "The maximum number of results to return, from 1 through 500."
          },
          "cursor": {
            "type": "number",
            "description": "The numeric cursor returned by a previous result page."
          },
          "timeFilter": {
            "type": "string",
            "enum": [
              "today",
              "last7Days",
              "last30Days",
              "monthToDate",
              "lastMonth",
              "yearToDate",
              "allTime"
