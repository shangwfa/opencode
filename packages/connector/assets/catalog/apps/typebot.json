                    "type": "string",
                    "description": "The Typebot bot identifier."
                  },
                  "name": {
                    "type": "string",
                    "description": "The Typebot bot name."
                  },
                  "version": {
                    "type": "string",
                    "description": "The Typebot schema version."
                  },
                  "workspaceId": {
                    "type": "string",
                    "description": "The workspace identifier that owns the bot."
                  },
                  "createdAt": {
                    "type": "string",
                    "description": "The bot creation timestamp."
                  },
                  "updatedAt": {
                    "type": "string",
                    "description": "The bot last update timestamp."
                  },
                  "groups": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": true,
                      "description": "One bot graph group returned by Typebot."
                    },
                    "description": "The bot graph groups returned by Typebot."
                  },
                  "edges": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": true,
                      "description": "One bot graph edge returned by Typebot."
                    },
                    "description": "The bot graph edges returned by Typebot."
                  },
                  "variables": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": true,
                      "description": "One bot variable returned by Typebot."
                    },
                    "description": "The bot variables returned by Typebot."
                  }
                },
                "additionalProperties": true,
                "required": [
                  "id",
                  "name",
                  "version",
                  "workspaceId",
                  "createdAt",
                  "updatedAt",
                  "groups",
                  "edges",
                  "variables"
                ],
                "description": "The Typebot definition, including its graph and configuration fields."
              },
              {
                "type": "null"
              }
            ],
            "description": "The Typebot definition, including its graph and configuration fields."
          },
          "currentUserMode": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "guest"
            ],
            "description": "The access right granted to the current Typebot user."
          }
        },
        "additionalProperties": true,
        "required": [
          "typebot",
          "currentUserMode"
        ],
        "description": "The Typebot definition result."
      }
    },
    {
      "id": "typebot.get_workspace",
      "service": "typebot",
      "name": "get_workspace",
      "description": "Retrieve detailed information for one Typebot workspace.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "description": "The Typebot workspace identifier.",
            "pattern": "\\S"
          }
        },
        "additionalProperties": false,
        "required": [
          "workspaceId"
        ],
        "description": "The Typebot workspace to retrieve."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "workspace": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The Typebot workspace identifier."
              },
              "name": {
                "type": "string",
                "description": "The Typebot workspace name."
              },
              "icon": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "The workspace icon URL when one is configured."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The workspace icon URL when one is configured."
              },
              "plan": {
                "type": "string",
                "enum": [
                  "FREE",
                  "STARTER",
                  "PRO",
                  "LIFETIME",
                  "OFFERED",
                  "CUSTOM",
                  "UNLIMITED",
                  "ENTERPRISE"
                ],
                "description": "The billing plan assigned to the Typebot workspace."
              },
              "createdAt": {
                "type": "string",
                "description": "The workspace creation timestamp."
              },
              "updatedAt": {
                "type": "string",
                "description": "The workspace last update timestamp."
              },
              "isSuspended": {
                "type": "boolean",
                "description": "Whether the workspace is suspended."
              },
              "isPastDue": {
                "type": "boolean",
                "description": "Whether the workspace has an overdue subscription payment."
              }
            },
            "additionalProperties": true,
            "required": [
              "id",
              "name",
              "icon",
              "plan",
              "createdAt",
              "updatedAt",
              "isSuspended",
              "isPastDue"
            ],
            "description": "Detailed Typebot workspace information."
          },
          "currentUserMode": {
            "type": "string",
            "enum": [
              "read",
              "write",
              "guest"
            ],
            "description": "The access right granted to the current Typebot user."
          }
        },
        "additionalProperties": true,
        "required": [
          "workspace",
          "currentUserMode"
        ],
        "description": "The Typebot workspace result."
      }
    },
    {
      "id": "typebot.list_results",
      "service": "typebot",
