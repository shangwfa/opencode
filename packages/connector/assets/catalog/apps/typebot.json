{
  "service": "typebot",
  "displayName": "Typebot",
  "categories": [
    "Communication",
    "Productivity"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Token",
      "placeholder": "Typebot API token",
      "description": "Typebot API token sent as a Bearer credential. Create one under Settings & Members > My account > API tokens: https://app.typebot.io/typebots."
    }
  ],
  "homepageUrl": "https://typebot.com",
  "actions": [
    {
      "id": "typebot.get_result",
      "service": "typebot",
      "name": "get_result",
      "description": "Retrieve one collected Typebot result by bot and result identifier.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "typebotId": {
            "type": "string",
            "minLength": 1,
            "description": "The Typebot bot identifier.",
            "pattern": "\\S"
          },
          "resultId": {
            "type": "string",
            "minLength": 1,
            "description": "The Typebot result identifier.",
            "pattern": "\\S"
          }
        },
        "additionalProperties": false,
        "required": [
          "typebotId",
          "resultId"
        ],
        "description": "The Typebot result to retrieve."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "The Typebot result identifier."
              },
              "createdAt": {
                "type": "string",
                "description": "The result creation timestamp."
              },
              "typebotId": {
                "type": "string",
                "description": "The bot identifier that produced the result."
              },
              "variables": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "The result variable identifier."
                    },
                    "name": {
                      "type": "string",
                      "description": "The result variable name."
                    },
                    "value": {
                      "description": "The string or string-array value captured for this variable."
                    },
                    "isSessionVariable": {
                      "type": "boolean",
                      "description": "Whether the variable belongs to the chat session rather than the saved result."
                    }
                  },
                  "additionalProperties": true,
                  "required": [
                    "id",
                    "name",
                    "value"
                  ],
                  "description": "One variable captured in a Typebot result."
                },
                "description": "The variables captured in the result."
              },
              "answers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "blockId": {
                      "type": "string",
                      "description": "The identifier of the input block that captured the answer."
                    },
                    "content": {
                      "type": "string",
                      "description": "The answer text content."
                    },
                    "attachedFileUrls": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "description": "One attached file URL."
                      },
                      "description": "The uploaded file URLs attached to the answer."
                    }
                  },
                  "additionalProperties": true,
                  "required": [
                    "blockId",
                    "content"
                  ],
                  "description": "One answer captured in a Typebot result."
                },
                "description": "The answers captured in the result."
              },
              "isCompleted": {
                "type": "boolean",
                "description": "Whether the conversation reached completion."
              },
              "hasStarted": {
                "anyOf": [
                  {
                    "type": "boolean",
                    "description": "Whether the conversation has started."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Whether the conversation has started."
              },
              "isArchived": {
                "anyOf": [
                  {
                    "type": "boolean",
                    "description": "Whether the result is archived."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Whether the result is archived."
              },
              "lastChatSessionId": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "The most recent chat session identifier when available."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The most recent chat session identifier when available."
              }
            },
            "additionalProperties": true,
            "required": [
              "id",
              "createdAt",
              "typebotId",
              "variables",
              "answers",
              "isCompleted",
              "hasStarted",
              "isArchived",
              "lastChatSessionId"
            ],
            "description": "One Typebot conversation result."
          }
        },
        "additionalProperties": true,
        "required": [
          "result"
        ],
        "description": "The Typebot result response."
      }
    },
    {
      "id": "typebot.get_typebot",
      "service": "typebot",
      "name": "get_typebot",
      "description": "Retrieve one Typebot definition and its graph configuration.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
