            "type": "string",
            "minLength": 1,
            "description": "The Typebot bot identifier.",
            "pattern": "\\S"
          },
          "migrateToLatestVersion": {
            "type": "boolean",
            "description": "Whether Typebot should migrate the returned definition to the latest schema."
