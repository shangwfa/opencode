    {
      "id": "moxie.search_clients",
      "service": "moxie",
      "name": "search_clients",
      "description": "Search Moxie clients by client name or contact information.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "The text to search for.",
            "pattern": "\\S"
          }
        },
        "additionalProperties": false,
        "description": "Search text for a Moxie lookup."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "clients": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The client business name."
                },
                "clientType": {
                  "type": "string",
                  "enum": [
                    "Client",
                    "Prospect"
                  ],
                  "description": "The client record type."
                },
                "archive": {
                  "type": "boolean",
                  "description": "Whether the client is archived."
                },
                "currency": {
                  "type": "string",
                  "description": "The client's ISO 4217 currency code."
                }
              },
              "additionalProperties": true,
              "description": "A client returned by Moxie."
            },
            "description": "Clients matching the search text."
          }
        },
        "additionalProperties": false,
        "description": "The matching Moxie clients."
      }
    },
    {
      "id": "moxie.search_contacts",
      "service": "moxie",
      "name": "search_contacts",
