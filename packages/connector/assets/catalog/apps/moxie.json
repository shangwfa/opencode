{
  "service": "moxie",
  "displayName": "Moxie",
  "description": "Read clients, contacts, projects, pipeline stages, and task stages from a Moxie workspace.",
  "categories": [
    "Productivity",
    "Marketing"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "MOXIE_API_KEY",
      "description": "Enable Custom API on a Pro or Teams plan and copy the key from Apps & integrations: https://help.withmoxie.com/en/articles/16189299-use-custom-api-and-event-webhooks",
      "extraFields": [
        {
          "key": "baseUrl",
          "label": "API Base URL",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "https://pod00.withmoxie.dev/api/public/",
          "description": "The workspace-specific HTTPS API base URL displayed beside the Custom API key."
        }
      ]
    }
  ],
  "homepageUrl": "https://www.withmoxie.com/",
  "actions": [
    {
      "id": "moxie.list_clients",
      "service": "moxie",
      "name": "list_clients",
      "description": "List all clients in the connected Moxie workspace.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "description": "Input for a Moxie list request."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "clients": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The client business name."
                },
                "clientType": {
                  "type": "string",
                  "enum": [
                    "Client",
                    "Prospect"
                  ],
                  "description": "The client record type."
                },
                "archive": {
                  "type": "boolean",
                  "description": "Whether the client is archived."
                },
                "currency": {
                  "type": "string",
                  "description": "The client's ISO 4217 currency code."
                }
              },
              "additionalProperties": true,
              "description": "A client returned by Moxie."
            },
            "description": "Clients returned by Moxie."
          }
        },
        "additionalProperties": false,
        "description": "The Moxie client list."
      }
    },
    {
      "id": "moxie.list_pipeline_stages",
