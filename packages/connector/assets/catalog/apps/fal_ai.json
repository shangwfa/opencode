{
  "service": "fal_ai",
  "displayName": "fal.ai",
  "categories": [
    "AI",
    "Developer Tools"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "FAL_KEY",
      "description": "fal.ai API key sent with the Authorization: Key header. Create or view keys in the fal dashboard: https://fal.ai/dashboard/keys."
    }
