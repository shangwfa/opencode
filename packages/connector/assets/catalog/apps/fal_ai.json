    {
      "id": "fal_ai.get_queue_request_result",
      "service": "fal_ai",
      "name": "get_queue_request_result",
      "description": "Retrieve the stored final result payload for a completed fal queued request.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "responseUrl": {
            "type": "string",
