    {
      "id": "easy8.create_issue",
      "service": "easy8",
      "name": "create_issue",
      "description": "Create an Easy8 task.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1,
            "description": "The task subject."
          },
          "projectId": {
            "type": "integer",
            "minimum": 1,
            "description": "The numeric Easy8 resource ID."
          },
          "trackerId": {
            "type": "integer",
            "minimum": 1,
            "description": "The numeric Easy8 resource ID."
          },
          "statusId": {
            "type": "integer",
            "minimum": 1,
            "description": "The numeric Easy8 resource ID."
          },
          "priorityId": {
            "type": "integer",
            "minimum": 1,
            "description": "The numeric Easy8 resource ID."
          },
          "authorId": {
            "type": "integer",
            "minimum": 1,
            "description": "The numeric Easy8 resource ID."
          },
          "assigneeId": {
            "type": "integer",
            "minimum": 1,
            "description": "The numeric Easy8 resource ID."
          },
          "description": {
            "type": "string",
            "description": "The task description."
          },
          "estimatedHours": {
            "type": "string",
            "description": "The estimated hours value accepted by Easy8."
          },
          "doneRatio": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "The task completion percentage in ten-point steps."
          },
          "startDate": {
            "type": "string",
            "description": "The task start date in YYYY-MM-DD format.",
            "format": "date"
          },
          "dueDate": {
            "type": "string",
            "description": "The task due date in YYYY-MM-DD format.",
            "format": "date"
          },
          "private": {
            "type": "boolean",
            "description": "Whether the task is private."
          },
          "parentIssueId": {
            "type": "integer",
            "minimum": 1,
            "description": "The numeric Easy8 resource ID."
          },
          "notes": {
            "type": "string",
            "description": "A comment to add while updating the task."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "A task tag."
            },
            "description": "Tags assigned to the task."
          }
        },
        "additionalProperties": false,
        "required": [
          "subject",
          "projectId",
          "trackerId",
          "statusId",
          "priorityId",
          "authorId",
          "assigneeId"
        ],
        "description": "The input for creating an Easy8 task."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "issue": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "description": "The numeric Easy8 resource ID."
              },
              "subject": {
                "type": "string",
                "description": "The task subject."
              },
              "description": {
                "type": "string",
                "description": "The task description."
              }
            },
            "additionalProperties": true,
            "description": "An Easy8 task object."
          }
        },
        "additionalProperties": false,
        "description": "The created Easy8 task response."
      }
    },
