          "marketplace": {
            "type": "string",
            "minLength": 1,
            "description": "The marketplace code returned by list_stores."
          },
          "merchantId": {
            "type": "string",
            "description": "The optional Amazon merchant ID."
          },
          "shipmentId": {
            "type": "string",
            "description": "An exact FBA shipment ID."
          },
          "shipmentStatus": {
            "type": "string",
