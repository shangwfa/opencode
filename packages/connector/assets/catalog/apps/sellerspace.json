                "format": "date"
              }
            },
            "additionalProperties": false,
            "description": "The reporting period for the query."
          },
          "name": {
            "type": "string",
            "description": "A name or text search applied to the selected advertising entity."
          },
          "status": {
            "type": "string",
            "enum": [
              "archived",
              "enabled",
              "paused",
              "notArchived"
            ],
            "description": "The SellerSpace advertising entity status."
          },
          "campaignStatus": {
            "type": "string",
            "enum": [
              "archived",
              "enabled",
              "paused",
              "notArchived"
            ],
            "description": "The SellerSpace advertising entity status."
          },
          "adGroupStatus": {
            "type": "string",
            "enum": [
              "archived",
              "enabled",
              "paused",
              "notArchived"
            ],
            "description": "The SellerSpace advertising entity status."
          },
          "criteria": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "Entity-specific SellerSpace advertising criteria."
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The SellerSpace metric field to filter."
                },
                "op": {
                  "type": "string",
                  "enum": [
                    "gt",
                    "gte",
                    "eq",
                    "lt",
                    "lte"
                  ],
                  "description": "The comparison operator."
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "A string comparison value."
                    },
                    {
                      "type": "number",
                      "description": "A numeric comparison value."
                    },
                    {
                      "type": "boolean",
                      "description": "A boolean comparison value."
                    }
                  ],
                  "description": "The value to compare against the selected field."
                }
              },
              "additionalProperties": false,
              "description": "One metric filter applied by SellerSpace."
            },
            "description": "Metric filters applied to the advertising query."
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Additional SellerSpace result fields to include."
