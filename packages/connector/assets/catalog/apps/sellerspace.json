          },
          "fromDateStr": {
            "type": "string",
            "description": "The shipment creation date range start.",
            "format": "date"
          },
          "toDateStr": {
            "type": "string",
            "description": "The shipment creation date range end.",
            "format": "date"
          },
          "page": {
            "type": "integer",
            "description": "The one-based page number.",
            "default": 1
          },
          "pageSize": {
            "type": "integer",
            "description": "The number of shipments requested per page.",
            "default": 30
          },
          "includeFields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Additional shipment fields to include."
