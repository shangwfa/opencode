          "selectFields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "The exact shipment fields to return."
          }
        },
        "additionalProperties": false,
        "required": [
          "sellerId",
          "marketplace"
        ],
        "description": "Filters and pagination for SellerSpace FBA inbound shipments."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "description": "The SellerSpace result payload. Its nested fields vary with the selected entity, dataset, and field selection."
          }
        },
        "additionalProperties": false,
        "description": "The result returned by the SellerSpace MCP tool."
      }
    },
