              "minLength": 1
            },
            "description": "The exact SellerSpace result fields to return."
          },
          "includeSummary": {
            "type": "boolean",
            "description": "Whether to retain summary data when selectFields requests a narrow field set."
          },
          "includeFieldMeta": {
