    {
      "id": "sellerspace.query_ads",
      "service": "sellerspace",
      "name": "query_ads",
      "description": "Query SellerSpace Amazon advertising campaigns, ad groups, promoted products, keywords, targets, search terms, or negative targeting with filters and pagination.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "entity": {
            "type": "string",
            "enum": [
              "campaign",
              "adGroup",
              "productAds",
              "keywords",
              "targets",
              "searchQuery",
              "searchTermFrequency",
              "negativeKeywords",
              "negativeTargets"
            ],
            "description": "The advertising entity to query."
          },
          "scope": {
            "type": "object",
            "properties": {
              "sellerId": {
                "type": "integer",
                "description": "The SellerSpace seller ID returned by list_stores."
              },
              "marketplace": {
                "type": "string",
                "minLength": 1,
                "description": "The marketplace code returned by list_stores, such as US."
              }
            },
            "additionalProperties": false,
            "description": "One SellerSpace store and Amazon marketplace to query."
          },
          "period": {
            "type": "object",
            "properties": {
              "preset": {
                "type": "string",
                "enum": [
                  "TD",
                  "YD",
                  "WD",
                  "LW",
                  "MO",
                  "LM",
                  "SD",
                  "HD",
                  "NM",
                  "CU"
                ],
                "description": "The SellerSpace date preset: TD today, YD yesterday, WD this week, LW last week, MO this month, LM last month, SD trailing 7 days, HD trailing 15 days, NM trailing 30 days, or CU custom dates.",
                "default": "SD"
              },
              "text": {
                "type": "string",
