{
  "service": "sellerspace",
  "displayName": "SellerSpace",
  "categories": [
    "Productivity",
    "Data",
    "Marketing"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "MCP Key",
      "placeholder": "sk-ss-...",
      "description": "SellerSpace MCP key sent in the x-api-key header. Create it by following https://www.sellerspace.com/help/doc/how-to-get-your-sellerspace-mcp-key ."
    }
  ],
  "homepageUrl": "https://www.sellerspace.com/",
  "actions": [
    {
      "id": "sellerspace.call_tool",
      "service": "sellerspace",
      "name": "call_tool",
      "description": "Call an explicitly approved SellerSpace MCP read tool with JSON arguments after discovering its live schema. Write, export, and browser-task tools are unavailable through this action.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "toolName": {
            "type": "string",
            "minLength": 1,
            "description": "The exact tool name returned by list_tools."
          },
          "arguments": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "JSON arguments matching the inputSchema returned for the selected tool."
          }
        },
        "additionalProperties": false,
        "required": [
          "toolName"
        ],
        "description": "Input for invoking one current SellerSpace MCP tool."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "description": "The SellerSpace result payload. Its nested fields vary with the selected entity, dataset, and field selection."
          }
        },
        "additionalProperties": false,
        "description": "The result returned by the SellerSpace MCP tool."
      },
      "followUpActions": [
        "sellerspace.list_tools"
      ]
    },
    {
      "id": "sellerspace.discover_fields",
      "service": "sellerspace",
      "name": "discover_fields",
      "description": "Discover current SellerSpace fields for advanced selection, filtering, sorting, or output interpretation in a supported data domain.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "enum": [
              "ads",
              "product",
              "website",
              "stores"
            ],
            "description": "The SellerSpace field domain."
          },
          "entity": {
            "type": "string",
            "description": "An optional entity context such as campaign, product, market, or store."
          },
          "query": {
            "type": "string",
            "description": "A field name, keyword, or business meaning to search for."
          },
          "usage": {
            "type": "string",
            "enum": [
              "select",
              "include",
              "sort",
              "filter",
              "output"
            ],
            "description": "The intended field usage."
          }
        },
        "additionalProperties": false,
        "description": "A SellerSpace field catalog search."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "description": "The SellerSpace result payload. Its nested fields vary with the selected entity, dataset, and field selection."
          }
        },
        "additionalProperties": false,
        "description": "The result returned by the SellerSpace MCP tool."
      },
      "followUpActions": [
        "sellerspace.query_ads",
        "sellerspace.query_products",
        "sellerspace.query_store_performance"
      ]
    },
    {
      "id": "sellerspace.get_ad_metric_history",
      "service": "sellerspace",
      "name": "get_ad_metric_history",
      "description": "Get time-series or placement-level metrics for one SellerSpace advertising campaign, ad group, promoted product, keyword, target, or search term.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "sellerId": {
            "type": "integer",
            "description": "The SellerSpace seller ID returned by list_stores."
          },
          "marketplace": {
            "type": "string",
            "minLength": 1,
            "description": "The marketplace code returned by list_stores."
          },
          "adDataType": {
            "type": "string",
            "enum": [
              "campaign",
              "adGroup",
              "productAd",
              "keyword",
              "target",
              "searchTerm"
            ],
            "description": "The advertising entity type."
          },
          "id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "description": "The advertising entity or composite search-term ID."
              },
              {
                "type": "number",
                "description": "The numeric advertising entity ID."
              }
            ],
            "description": "The entity ID returned by query_ads; use a string for large IDs."
          },
          "fromDateStr": {
            "type": "string",
            "description": "The query start date.",
            "format": "date"
          },
          "toDateStr": {
            "type": "string",
            "description": "The query end date.",
            "format": "date"
          },
          "dimension": {
            "type": "string",
            "enum": [
              "time",
              "placement"
            ],
            "description": "Whether to split metrics by time or advertising placement.",
            "default": "time"
          },
          "timeType": {
            "type": "string",
            "enum": [
              "DAILY",
              "WEEKLY",
              "WEEK",
              "MONTHLY",
              "HOURLY"
            ],
            "description": "The time aggregation used when dimension is time.",
            "default": "DAILY"
          },
          "placementBusiness": {
            "type": "string",
            "enum": [
              "Y",
              "N"
            ],
            "description": "Whether placement results should use Amazon Business placements.",
            "default": "N"
          },
          "dateType": {
            "type": "string",
            "enum": [
              "TD",
              "YD",
              "WD",
              "LW",
              "MO",
              "LM",
              "SD",
              "HD",
              "NM",
              "CU"
            ],
            "description": "The SellerSpace date preset: TD today, YD yesterday, WD this week, LW last week, MO this month, LM last month, SD trailing 7 days, HD trailing 15 days, NM trailing 30 days, or CU custom dates."
          },
          "includeFields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Additional history fields to include."
          },
          "selectFields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "The exact history fields to return."
          },
          "includeSummary": {
            "type": "boolean",
            "description": "Whether to retain the summary when selectFields requests a narrow field set."
          }
        },
        "additionalProperties": false,
        "required": [
          "sellerId",
          "marketplace",
          "adDataType",
          "id",
          "fromDateStr",
          "toDateStr"
        ],
        "description": "A metric history query for one SellerSpace advertising entity."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "result": {
            "description": "The SellerSpace result payload. Its nested fields vary with the selected entity, dataset, and field selection."
          }
        },
        "additionalProperties": false,
        "description": "The result returned by the SellerSpace MCP tool."
      },
      "followUpActions": [
        "sellerspace.query_ads"
      ]
    },
    {
      "id": "sellerspace.list_fba_shipments",
