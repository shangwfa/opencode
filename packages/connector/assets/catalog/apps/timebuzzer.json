  "homepageUrl": "https://timebuzzer.com",
  "actions": [
    {
      "id": "timebuzzer.create_activity",
      "service": "timebuzzer",
      "name": "create_activity",
      "description": "Create a timeBuzzer activity for a user and an ordered set of tiles.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "tiles": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "description": "A tile ID."
            },
            "description": "The tile IDs to assign in layer order, with at most one tile per layer.",
            "minItems": 1,
            "maxItems": 3
          },
          "startDate": {
            "type": "string",
            "description": "The activity start time in UTC.",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "description": "The activity end time in UTC.",
            "format": "date-time"
          },
          "startUtcOffset": {
            "type": "string",
            "description": "The UTC offset at the activity start, such as +02:00.",
            "pattern": "^[+-][0-9]{2}:[0-9]{2}$"
          },
          "endUtcOffset": {
            "type": "string",
            "description": "The UTC offset at the activity end, such as +02:00.",
            "pattern": "^[+-][0-9]{2}:[0-9]{2}$"
          },
          "note": {
            "type": "string",
            "description": "The activity note."
          },
          "userId": {
            "type": "integer",
            "minimum": 1,
            "description": "The ID of the user who owns the activity."
          },
          "billed": {
            "type": "boolean",
            "description": "Whether the activity is billed."
          },
          "customData": {
            "anyOf": [
              {
                "type": "string",
                "description": "Optional provider-defined custom data for the activity."
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional provider-defined custom data for the activity."
          }
        },
        "additionalProperties": false,
        "required": [
          "tiles",
          "startDate",
          "endDate",
          "startUtcOffset",
          "endUtcOffset",
          "note",
          "userId"
        ],
        "description": "The timeBuzzer activity to create."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "The activity ID."
          },
          "tiles": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "description": "A tile ID."
            },
            "description": "The tile IDs assigned in layer order.",
            "maxItems": 3
          },
          "startDate": {
            "type": "string",
            "description": "The activity start time in UTC.",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "description": "The activity end time in UTC.",
            "format": "date-time"
          },
          "startUtcOffset": {
            "type": "string",
            "description": "The UTC offset at the activity start.",
            "pattern": "^[+-][0-9]{2}:[0-9]{2}$"
          },
          "endUtcOffset": {
            "type": "string",
            "description": "The UTC offset at the activity end.",
            "pattern": "^[+-][0-9]{2}:[0-9]{2}$"
          },
          "note": {
            "type": "string",
            "description": "The activity note."
          },
          "userId": {
            "type": "integer",
            "minimum": 1,
            "description": "The ID of the user who owns the activity."
          },
          "billed": {
            "type": "boolean",
            "description": "Whether the activity is billed."
          },
          "customData": {
            "anyOf": [
              {
                "type": "string",
                "description": "Provider-defined custom data attached to the activity."
              },
              {
                "type": "null"
              }
            ],
            "description": "Provider-defined custom data attached to the activity."
          }
        },
        "additionalProperties": true,
        "required": [
          "id",
          "tiles",
          "startDate",
          "endDate",
          "startUtcOffset",
          "endUtcOffset",
          "note",
          "userId"
        ],
        "description": "A timeBuzzer time activity."
      }
    },
