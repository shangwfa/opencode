    {
      "id": "boldsign.send_document_from_template",
      "service": "boldsign",
      "name": "send_document_from_template",
      "description": "Send a BoldSign signature request from an existing template and return the new document ID.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "templateId": {
            "type": "string",
            "minLength": 1,
            "description": "The existing BoldSign template identifier."
          },
          "title": {
            "type": "string",
            "maxLength": 256,
            "description": "The title shown in BoldSign and signature request emails."
          },
          "message": {
            "type": "string",
            "maxLength": 5000,
            "description": "A message sent to all recipients."
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "roleIndex": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50,
                  "description": "The one-based role position from the template, from 1 through 50."
                },
                "signerName": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The signer's display name."
                },
                "signerEmail": {
                  "type": "string",
                  "description": "The signer's email address.",
                  "format": "email"
                },
                "signerOrder": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "The signer's order when ordered signing is enabled."
                },
                "privateMessage": {
                  "type": "string",
                  "maxLength": 5000,
                  "description": "A private message displayed only to this signer."
                },
                "signerType": {
                  "type": "string",
                  "enum": [
                    "Signer",
                    "Reviewer",
                    "InPersonSigner"
                  ],
                  "description": "The signer's role in the signing workflow."
                },
                "locale": {
                  "type": "string",
                  "enum": [
                    "EN",
                    "NO",
                    "FR",
                    "DE",
                    "ES",
                    "BG",
                    "CS",
                    "DA",
                    "IT",
                    "NL",
                    "PL",
                    "PT",
                    "RO",
                    "RU",
                    "SV",
                    "JA",
                    "TH",
                    "ZH_CN",
                    "ZH_TW",
                    "KO"
                  ],
                  "description": "The locale used for signer pages and emails."
                }
              },
              "additionalProperties": false,
              "required": [
                "roleIndex"
              ],
              "description": "A template role mapped to a real signer."
            },
            "description": "Template roles mapped to real signers.",
            "minItems": 1,
            "maxItems": 50
          },
          "fileUrls": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "A publicly accessible document URL.",
              "format": "uri"
            },
            "description": "Public file URLs added when the template permits new files. BoldSign fetches these URLs.",
            "minItems": 1,
            "maxItems": 25
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 255,
              "description": "A document label without whitespace."
            },
            "description": "Labels attached to the created document."
          },
          "cc": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "A CC email.",
              "format": "email"
            },
            "description": "Email addresses copied on the signature request."
