          "disableSms": {
            "type": "boolean",
            "description": "Whether to disable document-related SMS notifications."
          },
          "enableSigningOrder": {
            "type": "boolean",
            "description": "Whether signers must complete the document in order."
          },
          "enableReassign": {
            "type": "boolean",
            "description": "Whether signers may reassign the signature request."
          },
          "enablePrintAndSign": {
            "type": "boolean",
            "description": "Whether signers may print, sign, and upload the document."
