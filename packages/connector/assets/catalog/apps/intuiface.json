{
  "service": "intuiface",
  "displayName": "Intuiface",
  "categories": [
    "Communication",
    "Design & Media"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "Credential Key",
      "placeholder": "INTUIFACE_CREDENTIAL_KEY",
      "description": "Intuiface Credential Key with the Web Triggers scope, sent in the x-api-key header. Create or manage keys on the official Credential Keys page: https://my.intuiface.com/credentialkeys?scope=API_WebTriggers."
    }
  ],
  "homepageUrl": "https://www.intuiface.com/",
  "actions": [
    {
      "id": "intuiface.list_available_experiences",
      "service": "intuiface",
      "name": "list_available_experiences",
      "description": "List running Intuiface experiences that can receive Web Trigger messages.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "experienceNames": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "An exact Intuiface experience name."
            },
            "description": "Experience names that must exactly match running Intuiface experiences."
          },
          "experienceIDs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "An exact Intuiface experience ID."
            },
            "description": "Experience IDs that must exactly match running Intuiface experiences."
          },
          "playerDeviceNames": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "An exact Intuiface Player device name."
            },
            "description": "Player device names that must exactly match Players running the experiences."
          },
          "playerIDs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "An exact Intuiface Player ID."
            },
            "description": "Player IDs that must exactly match Players running the experiences."
          },
          "playerTags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "An exact Intuiface Player tag."
            },
            "description": "Player tags used to select Players with one or more matching tags."
          }
        },
        "additionalProperties": false,
        "description": "Filters for listing available Intuiface experiences. All provided filters use AND semantics."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "connectedExperiences",
              "noConnectedExperience",
              "noMatchingExperience"
            ],
            "description": "The Intuiface experience search status."
          },
          "experienceCount": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of experiences in the result."
          },
          "experiences": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The experience ID."
                },
                "name": {
                  "type": "string",
                  "description": "The experience name."
                },
                "runningOnPlayer": {
                  "type": "object",
                  "properties": {
                    "playerId": {
                      "type": "string",
                      "description": "The Player device ID."
                    },
                    "name": {
                      "type": "string",
                      "description": "The Player device name."
                    },
                    "nickName": {
                      "type": "string",
                      "description": "The Player device nickname."
                    },
                    "platform": {
                      "type": "string",
                      "description": "The Player platform."
                    },
                    "version": {
                      "type": "string",
                      "description": "The Intuiface Player version."
                    },
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "description": "An Intuiface Player tag."
                      },
                      "description": "The tags assigned to the Player."
                    }
                  },
                  "additionalProperties": true,
                  "description": "The Intuiface Player running an experience."
                }
              },
              "additionalProperties": true,
              "description": "A running Intuiface experience."
            },
            "description": "The matching running experiences."
          },
          "timestamp": {
            "type": "string",
            "description": "The UTC timestamp reported by Intuiface."
          }
        },
        "additionalProperties": true,
        "description": "The available Intuiface experiences response."
      }
    },
    {
      "id": "intuiface.send_message",
      "service": "intuiface",
      "name": "send_message",
      "description": "Send a Web Trigger message to selected running Intuiface experiences.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "The message value sent to every selected experience."
          },
          "parameter1": {
            "type": "string",
            "description": "The first optional value sent with the message."
          },
          "parameter2": {
            "type": "string",
            "description": "The second optional value sent with the message."
          },
          "parameter3": {
            "type": "string",
            "description": "The third optional value sent with the message."
          },
          "experienceNames": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "An exact Intuiface experience name."
            },
            "description": "Experience names that must exactly match running Intuiface experiences."
          },
          "experienceIDs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "An exact Intuiface experience ID."
            },
            "description": "Experience IDs that must exactly match running Intuiface experiences."
          },
          "playerDeviceNames": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "An exact Intuiface Player device name."
            },
            "description": "Player device names that must exactly match Players running the experiences."
          },
          "playerIDs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "An exact Intuiface Player ID."
            },
            "description": "Player IDs that must exactly match Players running the experiences."
          },
          "playerTags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "An exact Intuiface Player tag."
            },
            "description": "Player tags used to select Players with one or more matching tags."
          }
        },
        "additionalProperties": false,
        "required": [
          "message"
        ],
        "description": "The message and optional filters for selecting target Intuiface experiences."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "sent",
              "noConnectedExperience",
              "noMatchingExperience"
            ],
            "description": "The Intuiface message delivery status."
          },
          "experienceCount": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of experiences in the result."
          },
          "experiences": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The experience ID."
                },
                "name": {
                  "type": "string",
                  "description": "The experience name."
                },
                "runningOnPlayer": {
                  "type": "object",
                  "properties": {
                    "playerId": {
                      "type": "string",
                      "description": "The Player device ID."
                    },
                    "name": {
                      "type": "string",
                      "description": "The Player device name."
                    },
                    "nickName": {
                      "type": "string",
                      "description": "The Player device nickname."
                    },
                    "platform": {
                      "type": "string",
                      "description": "The Player platform."
                    },
                    "version": {
                      "type": "string",
                      "description": "The Intuiface Player version."
                    },
                    "tags": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "description": "An Intuiface Player tag."
                      },
                      "description": "The tags assigned to the Player."
                    }
                  },
                  "additionalProperties": true,
                  "description": "The Intuiface Player running an experience."
                }
              },
              "additionalProperties": true,
              "description": "A running Intuiface experience."
            },
            "description": "The matching running experiences."
          },
          "timestamp": {
            "type": "string",
            "description": "The UTC timestamp reported by Intuiface."
          }
        },
        "additionalProperties": true,
        "description": "The Intuiface Web Trigger message delivery response."
      }
    }
  ]
}
