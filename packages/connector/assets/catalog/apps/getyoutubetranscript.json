    {
      "id": "getyoutubetranscript.search_youtube",
      "service": "getyoutubetranscript",
      "name": "search_youtube",
      "description": "Search YouTube for videos or channels, one page at a time.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "The YouTube search query.",
            "pattern": "\\S"
          },
          "type": {
            "type": "string",
            "enum": [
              "video",
              "channel"
            ],
            "description": "The kind of results to return."
          },
          "pageToken": {
            "type": "string",
            "minLength": 1,
            "description": "The continuationToken from a previous response, to fetch the next page.",
            "pattern": "\\S"
          }
        },
        "additionalProperties": false,
        "description": "The input payload for searching YouTube. Give query for a first page or pageToken for later pages.",
        "anyOf": [
          {
            "required": [
              "query"
            ]
          },
          {
            "required": [
              "pageToken"
            ]
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "The search query."
          },
          "video_results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "One video result."
            },
            "description": "Video results when type is video."
          },
          "channel_results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "One channel result."
            },
            "description": "Channel results when type is channel."
          },
          "continuation_token": {
            "anyOf": [
              {
                "type": "string",
                "description": "Opaque token for the next page, or null when there are no more pages. Pass it back unchanged."
              },
              {
                "type": "null"
              }
            ],
            "description": "Opaque token for the next page, or null when there are no more pages. Pass it back unchanged."
          }
