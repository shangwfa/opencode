    {
      "id": "vonage.send_sms",
      "service": "vonage",
      "name": "send_sms",
      "description": "Send a text or Unicode SMS through the Vonage SMS API.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "description": "The sender name or number. Number senders use E.164 format; sender ID rules vary by country."
          },
          "to": {
            "type": "string",
            "minLength": 7,
            "maxLength": 15,
            "description": "The destination number in E.164 format without a leading plus sign.",
            "pattern": "^[0-9]{7,15}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "The text body of the outbound SMS."
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "unicode"
            ],
            "description": "The SMS text encoding."
          },
          "ttl": {
            "type": "integer",
            "minimum": 20000,
            "maximum": 604800000,
            "description": "How long Vonage should attempt delivery, in milliseconds."
          },
          "statusReportRequired": {
            "type": "boolean",
            "description": "Whether Vonage should request a delivery receipt."
          },
          "callback": {
            "type": "string",
            "maxLength": 100,
            "description": "The delivery receipt callback URL for this message.",
            "format": "uri"
          },
          "clientRef": {
            "type": "string",
            "maxLength": 100,
            "description": "A caller-defined reference included in the submission result."
          }
        },
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "text"
        ],
        "description": "The outbound Vonage SMS payload."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "messageCount": {
            "type": "integer",
            "description": "The number of SMS submission results returned by Vonage."
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "string",
                  "description": "The destination number in E.164 format."
                },
                "messageId": {
                  "type": "string",
                  "description": "The Vonage message identifier."
                },
                "status": {
                  "type": "string",
                  "description": "The Vonage SMS status code."
                },
                "remainingBalance": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "The estimated remaining account balance."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The estimated remaining account balance."
                },
                "messagePrice": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "The estimated price of the message."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The estimated price of the message."
                },
                "network": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "The destination network identifier."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The destination network identifier."
                },
                "clientRef": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "The caller-supplied client reference."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The caller-supplied client reference."
                }
              },
