{
  "service": "simplelocalize",
  "displayName": "SimpleLocalize",
  "categories": [
    "Developer Tools",
    "Productivity"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "Project API Key",
      "placeholder": "YOUR_PROJECT_API_KEY",
      "description": "SimpleLocalize project API key. Copy it from Settings > Credentials > API Key: https://simplelocalize.io/docs/api/get-started/"
    }
  ],
  "homepageUrl": "https://simplelocalize.io",
  "actions": [
    {
      "id": "simplelocalize.create_language",
      "service": "simplelocalize",
      "name": "create_language",
      "description": "Create a language in the authenticated SimpleLocalize project.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "description": "The case-sensitive language key."
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "description": "The display name for the language."
          }
        },
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "description": "The SimpleLocalize language to create."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "language": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The created language."
          }
        },
        "additionalProperties": false,
        "description": "The language created by SimpleLocalize."
      }
    },
    {
      "id": "simplelocalize.create_translation_key",
      "service": "simplelocalize",
      "name": "create_translation_key",
      "description": "Create a translation key in the authenticated SimpleLocalize project.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "The translation key to create."
          },
          "namespace": {
            "type": "string",
            "maxLength": 128,
            "description": "The namespace for the translation key."
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "description": "A translator-facing description for the key."
          },
          "codeDescription": {
            "type": "string",
            "maxLength": 500,
            "description": "A code-facing description for the key."
          },
          "charactersLimit": {
            "type": "integer",
            "description": "The maximum translated-text length, or -1 for no limit."
          },
          "lock": {
            "type": "boolean",
            "description": "Whether to prevent the translation key from being modified."
          },
          "deprecated": {
            "type": "boolean",
            "description": "Whether to mark the translation key as deprecated."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "A tag name."
            },
            "description": "Up to five tags assigned to the key.",
            "maxItems": 5
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "description": "An attribute value."
            },
            "description": "Provider-defined attributes assigned to the translation key."
          }
        },
        "additionalProperties": false,
        "required": [
          "key"
        ],
        "description": "The SimpleLocalize translation key to create."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether SimpleLocalize completed the requested operation."
          }
        },
        "additionalProperties": false,
        "description": "The acknowledgement returned after the operation succeeds."
      }
    },
    {
      "id": "simplelocalize.delete_language",
      "service": "simplelocalize",
      "name": "delete_language",
      "description": "Delete a language from the authenticated SimpleLocalize project.",
      "operationType": "destructive",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "languageKey": {
            "type": "string",
            "minLength": 1,
            "description": "The case-sensitive language key to delete."
          }
        },
        "additionalProperties": false,
        "description": "The SimpleLocalize language to delete."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether SimpleLocalize completed the requested operation."
          }
        },
        "additionalProperties": false,
        "description": "The acknowledgement returned after the operation succeeds."
      }
    },
    {
      "id": "simplelocalize.get_project",
      "service": "simplelocalize",
      "name": "get_project",
      "description": "Get details and localization statistics for the authenticated SimpleLocalize project.",
