          }
        },
        "additionalProperties": false,
        "description": "The authenticated SimpleLocalize project details."
      }
    },
    {
      "id": "simplelocalize.list_languages",
      "service": "simplelocalize",
      "name": "list_languages",
      "description": "List languages configured in the authenticated SimpleLocalize project.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "description": "The input payload for this SimpleLocalize action."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "languages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A language returned by SimpleLocalize."
            },
            "description": "The languages configured in the project."
          }
        },
        "additionalProperties": false,
        "description": "The project languages returned by SimpleLocalize."
      }
    },
    {
      "id": "simplelocalize.list_translation_keys",
      "service": "simplelocalize",
      "name": "list_translation_keys",
      "description": "List translation keys and their metadata in the authenticated project.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "The exact translation key to filter by."
          },
          "namespace": {
            "type": "string",
            "description": "The exact namespace to filter by."
          },
          "sort": {
            "type": "string",
            "enum": [
              "last_seen_at",
              "modified_at",
              "created_at",
              "deprecated_at"
            ],
            "description": "The field used to sort translation keys."
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "description": "The zero-based result page."
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2500,
            "description": "The number of translation keys per page."
          }
        },
        "additionalProperties": false,
        "description": "The filters and pagination used to list SimpleLocalize translation keys."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "translationKeys": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A translation key and its metadata returned by SimpleLocalize."
            },
            "description": "The translation keys on the requested page."
          },
          "pageDetails": {
            "anyOf": [
              {
                "type": "object",
                "properties": {},
                "additionalProperties": true,
                "description": "The pagination details returned by SimpleLocalize."
              },
              {
                "type": "null"
              }
            ],
            "description": "The pagination details returned by SimpleLocalize."
          }
        },
        "additionalProperties": false,
        "description": "A page of translation keys returned by SimpleLocalize."
      }
    },
    {
      "id": "simplelocalize.list_translations",
      "service": "simplelocalize",
      "name": "list_translations",
      "description": "List and filter translations in the authenticated SimpleLocalize project.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "The exact translation key to filter by."
          },
          "namespace": {
            "type": "string",
            "description": "The exact namespace to filter by."
          },
          "language": {
            "type": "string",
            "description": "The language key to filter by."
          },
          "text": {
            "type": "string",
            "minLength": 3,
            "description": "Text to search for, using a case-insensitive contains match."
          },
          "customerId": {
            "type": "string",
            "description": "The customer identifier to filter by."
          },
          "baseOnly": {
            "type": "boolean",
            "description": "Whether to exclude customer-specific translations."
          },
          "reviewStatus": {
            "type": "string",
            "enum": [
              "REVIEWED",
              "NOT_REVIEWED"
            ],
            "description": "The review status to filter by."
          },
          "page": {
            "type": "integer",
            "minimum": 0,
            "description": "The zero-based result page."
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2500,
            "description": "The number of translations per page."
          },
          "sortBy": {
            "type": "string",
            "enum": [
              "lastModifiedAt"
            ],
            "description": "The field used to sort translations."
          },
          "sortOrder": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "description": "The translation sort direction."
          },
          "version": {
            "type": "string",
            "enum": [
              "REVIEWED"
            ],
            "description": "The translation version to return."
          }
        },
        "additionalProperties": false,
        "description": "The filters and pagination used to list SimpleLocalize translations."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "translations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A translation returned by SimpleLocalize."
            },
            "description": "The translations on the requested page."
          },
          "pageDetails": {
            "anyOf": [
              {
                "type": "object",
                "properties": {},
                "additionalProperties": true,
                "description": "The pagination details returned by SimpleLocalize."
              },
              {
                "type": "null"
              }
            ],
            "description": "The pagination details returned by SimpleLocalize."
          }
        },
        "additionalProperties": false,
        "description": "A page of translations returned by SimpleLocalize."
      }
    },
    {
      "id": "simplelocalize.update_language",
      "service": "simplelocalize",
      "name": "update_language",
      "description": "Update a language in the authenticated SimpleLocalize project.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "languageKey": {
            "type": "string",
            "minLength": 1,
            "description": "The current case-sensitive language key."
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "description": "The replacement language key."
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "description": "The replacement display name."
          }
        },
        "additionalProperties": false,
        "required": [
          "languageKey"
        ],
        "description": "The SimpleLocalize language update."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether SimpleLocalize completed the requested operation."
          }
        },
        "additionalProperties": false,
        "description": "The acknowledgement returned after the operation succeeds."
      }
    },
    {
      "id": "simplelocalize.update_translation",
      "service": "simplelocalize",
      "name": "update_translation",
      "description": "Update the text or review state of one SimpleLocalize translation.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "description": "The translation key to update."
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "description": "The language key of the translation to update."
          },
          "text": {
            "type": "string",
            "maxLength": 16382,
            "description": "The new translation text."
          },
          "namespace": {
            "type": "string",
            "description": "The namespace containing the translation key."
          },
          "customerId": {
            "type": "string",
            "description": "The customer identifier for a customer-specific translation."
          },
          "reviewStatus": {
            "type": "string",
            "enum": [
              "REVIEWED",
              "NOT_REVIEWED"
            ],
            "description": "The new review status."
          }
        },
        "additionalProperties": false,
        "required": [
          "key",
          "language",
          "text"
        ],
        "description": "The SimpleLocalize translation to update."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether SimpleLocalize completed the requested operation."
          }
        },
        "additionalProperties": false,
        "description": "The acknowledgement returned after the operation succeeds."
      }
    }
  ]
}
