{
  "service": "pingbell",
  "displayName": "PingBell",
  "description": "List PingBell sources and send counter notifications.",
  "categories": [
    "Communication",
    "Productivity"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "PINGBELL_API_KEY",
      "description": "PingBell API key sent in the x-api-key header. Copy it from PingBell Settings: https://pingbell.io/knowledge-base/account-billing/getting-your-api-key/"
    }
  ],
  "homepageUrl": "https://pingbell.io",
  "actions": [
    {
      "id": "pingbell.list_sources",
      "service": "pingbell",
      "name": "list_sources",
      "description": "List the sources available to the connected PingBell account.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "description": "Input for listing PingBell sources."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The source ID normalized as a string."
                },
                "name": {
                  "type": "string",
                  "description": "The source name."
                }
              },
              "additionalProperties": false,
              "description": "One PingBell source."
            },
            "description": "The available sources."
          }
        },
        "additionalProperties": false,
        "description": "The available PingBell sources."
      }
    },
    {
      "id": "pingbell.ring_source",
      "service": "pingbell",
      "name": "ring_source",
      "description": "Ring a PingBell source so its counter and subscribed devices update.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "sourceId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "description": "A source ID represented as a string."
              },
              {
                "type": "integer",
                "description": "A source ID represented as an integer."
              }
            ],
            "description": "The source ID returned by PingBell."
          },
          "amount": {
            "type": "number",
            "description": "Optional revenue amount."
          },
          "currency": {
            "type": "string",
            "minLength": 1,
            "description": "Optional currency code."
          },
          "transactionId": {
            "type": "string",
            "minLength": 1,
            "description": "Optional transaction ID for deduplication."
          }
        },
        "additionalProperties": false,
        "required": [
          "sourceId"
        ],
        "description": "Input for sending a PingBell notification."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "The status text returned by PingBell."
          }
        },
        "additionalProperties": false,
        "description": "The PingBell notification result."
      }
    }
  ]
}
