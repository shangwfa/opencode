            "maxLength": 512,
            "description": "The opaque Kling AI task handle returned by the selected connection.",
            "pattern": "\\S"
          }
        },
        "additionalProperties": false,
        "required": [
          "taskId"
        ],
        "description": "A Kling AI task lookup."
      },
      "outputSchema": {
