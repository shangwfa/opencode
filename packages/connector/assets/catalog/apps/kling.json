      "asyncLifecycle": {
        "startActionId": "kling.submit_video_generation",
        "statusActionId": "kling.get_video_generation"
      }
    },
    {
      "id": "kling.submit_video_generation",
      "service": "kling",
      "name": "submit_video_generation",
      "description": "Submit an asynchronous Kling AI V3 video generation task.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "kling-3.0-turbo",
              "kling-3.0",
              "kling-3.0-omni"
            ],
            "description": "The Kling AI V3 video model.",
            "default": "kling-3.0"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500,
            "description": "The video prompt, including any @referenceId media references.",
            "pattern": "\\S"
          },
          "media": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "first_frame",
                    "last_frame",
                    "reference_image",
                    "reference_video",
                    "source_video"
                  ],
                  "description": "How Kling AI uses this media input."
                },
                "url": {
                  "type": "string",
                  "maxLength": 8192,
                  "description": "A public HTTP or HTTPS media URL passed to Kling AI.",
                  "format": "uri",
                  "pattern": "^[hH][tT][tT][pP][sS]?:\\/\\/"
                },
                "referenceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "description": "A request-unique identifier that can be referenced as @referenceId in prompts.",
                  "pattern": "\\S"
                }
              },
              "additionalProperties": false,
              "required": [
                "role",
                "url"
              ],
              "description": "A URL-based image or video input for Kling AI."
            },
            "description": "URL-based media inputs for Kling AI.",
            "maxItems": 9
          },
          "resolution": {
            "type": "string",
            "enum": [
              "720p",
              "1080p",
              "4k"
            ],
            "description": "The generated video resolution.",
            "default": "720p"
          },
          "aspectRatio": {
            "type": "string",
            "enum": [
              "16:9",
              "9:16",
              "1:1"
            ],
            "description": "The generated aspect ratio when it is not inherited from input media.",
            "default": "16:9"
          },
          "duration": {
            "type": "integer",
            "minimum": 3,
            "maximum": 15,
            "description": "The requested video duration in seconds.",
            "default": 5
          },
          "audioMode": {
            "type": "string",
            "enum": [
              "off",
              "native",
              "original"
            ],
            "description": "How the generated video uses audio."
          },
          "multiShot": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "intelligent",
                  "custom"
                ],
                "description": "Whether Kling AI plans shots or uses the supplied custom shots."
              },
              "shots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "prompt": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512,
                      "description": "The prompt for this shot.",
                      "pattern": "\\S"
                    },
                    "duration": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 15,
                      "description": "The shot duration in seconds."
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "prompt",
                    "duration"
                  ],
                  "description": "One custom multi-shot segment."
                },
                "description": "The ordered shots used by custom mode.",
                "minItems": 1,
                "maxItems": 6
              }
            },
            "additionalProperties": false,
            "required": [
              "mode"
            ],
            "description": "A Kling AI multi-shot generation mode."
          },
          "watermark": {
            "type": "boolean",
            "description": "Whether Kling AI should also generate a watermarked video.",
            "default": false
          }
        },
        "additionalProperties": false,
        "description": "A unified Kling AI V3 video generation request.",
        "anyOf": [
          {
            "required": [
              "prompt"
            ]
          },
          {
            "required": [
              "multiShot"
            ]
          }
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "model": {
                  "const": "kling-3.0-turbo"
                }
              },
              "required": [
                "model"
              ]
            },
            "then": {
              "properties": {
                "resolution": {
                  "type": "string",
                  "enum": [
                    "720p",
                    "1080p"
                  ]
                },
                "audioMode": {
                  "type": "string",
                  "enum": [
                    "native"
                  ]
                },
                "media": {
                  "type": "array",
                  "maxItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "const": "first_frame"
                      }
                    },
                    "required": [
                      "role"
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "anyOf": [
                {
                  "properties": {
                    "model": {
                      "const": "kling-3.0"
                    }
                  },
                  "required": [
                    "model"
                  ]
                },
                {
                  "not": {
                    "required": [
                      "model"
                    ]
                  }
                }
              ]
            },
            "then": {
              "properties": {
                "audioMode": {
                  "type": "string",
                  "enum": [
                    "off",
                    "native"
                  ]
                },
                "media": {
                  "type": "array",
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "enum": [
                          "first_frame",
                          "last_frame"
                        ]
                      }
                    },
                    "required": [
                      "role"
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "multiShot": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "const": "custom"
                    }
                  },
                  "required": [
                    "mode"
                  ]
                }
              },
              "required": [
                "multiShot"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "prompt"
                ]
              },
              "properties": {
                "multiShot": {
                  "required": [
                    "mode",
                    "shots"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "multiShot": {
                  "type": "object",
                  "properties": {
                    "mode": {
                      "const": "intelligent"
                    }
                  },
                  "required": [
                    "mode"
                  ]
                }
              },
              "required": [
                "multiShot"
              ]
            },
            "then": {
              "required": [
                "prompt"
              ],
              "properties": {
                "multiShot": {
                  "not": {
                    "required": [
                      "shots"
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "audioMode": {
                  "const": "original"
                }
              },
              "required": [
                "audioMode"
              ]
            },
            "then": {
              "required": [
                "model",
                "media"
              ],
              "properties": {
                "model": {
                  "const": "kling-3.0-omni"
                },
                "media": {
                  "type": "array",
                  "contains": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "enum": [
                          "reference_video",
                          "source_video"
                        ]
                      }
                    },
                    "required": [
                      "role"
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "media"
              ],
              "properties": {
                "media": {
                  "type": "array",
                  "contains": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "const": "last_frame"
                      }
                    },
                    "required": [
                      "role"
                    ]
                  }
                }
              }
            },
            "then": {
              "properties": {
                "media": {
                  "type": "array",
                  "contains": {
                    "type": "object",
                    "properties": {
                      "role": {
                        "const": "first_frame"
                      }
                    },
                    "required": [
                      "role"
                    ]
                  }
                }
              }
            }
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "The opaque Kling AI task handle returned by the selected connection.",
            "pattern": "\\S"
          }
        },
        "additionalProperties": false,
        "required": [
          "taskId"
        ],
        "description": "The submitted Kling AI task handle."
      },
      "followUpActions": [
        "kling.get_video_generation"
      ],
      "asyncLifecycle": {
        "startActionId": "kling.submit_video_generation",
        "statusActionId": "kling.get_video_generation"
      }
    }
  ]
}
