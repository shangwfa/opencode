              },
              "resolution": {
                "type": "string",
                "description": "The generated video resolution when reported."
              },
              "framesPerSecond": {
                "type": "integer",
                "description": "The generated video frame rate when reported."
              },
              "audioMode": {
                "type": "string",
                "enum": [
                  "off",
                  "native",
                  "original"
                ],
                "description": "How the generated video uses audio."
              }
            },
            "additionalProperties": false,
            "required": [
              "taskId",
              "state",
              "videoUrl"
            ],
            "description": "A succeeded Kling AI video generation task."
          },
          {
            "type": "object",
            "properties": {
              "taskId": {
                "type": "string",
                "minLength": 1,
