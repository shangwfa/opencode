              }
            },
            "additionalProperties": false,
            "required": [
              "taskId",
              "state"
            ],
            "description": "A submitted or processing Kling AI task."
          },
          {
            "type": "object",
            "properties": {
              "taskId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "description": "The opaque Kling AI task handle returned by the selected connection.",
