{
  "service": "airfocus",
  "displayName": "airfocus",
  "categories": [
    "Productivity"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "Personal Access Token",
      "placeholder": "AIRFOCUS_PERSONAL_ACCESS_TOKEN",
      "description": "airfocus personal access token sent as a Bearer token. Include profile:read for connection validation and workspace:read or workspace for the selected actions. Create one under Account settings > API keys: https://help.lucid.co/hc/en-us/articles/43062348823572-Use-an-API-with-airfocus",
      "extraFields": []
    }
  ],
  "homepageUrl": "https://airfocus.com/",
  "actions": [
    {
      "id": "airfocus.create_item",
      "service": "airfocus",
      "name": "create_item",
      "description": "Create an item in an airfocus workspace.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "description": "The airfocus workspace ID.",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The item name or title."
          },
          "description": {
            "type": "object",
            "additionalProperties": true,
            "description": "Structured airfocus rich-text content using the provider's documented block format."
          },
          "statusId": {
            "type": "string",
            "description": "The status ID to assign to the item.",
            "format": "uuid"
          },
          "archived": {
            "type": "boolean",
            "description": "Whether the item is archived."
          },
          "assigneeUserIds": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "An assigned airfocus user ID.",
              "format": "uuid"
            },
            "description": "User IDs assigned to the item."
          },
          "assigneeUserGroupIds": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "An assigned airfocus user group ID.",
              "format": "uuid"
            },
            "description": "User group IDs assigned to the item."
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "description": "A provider-defined custom field value."
            },
            "description": "Custom field values keyed by airfocus field ID."
          },
          "order": {
            "type": "integer",
            "description": "The item order number used for sorting."
          }
        },
        "additionalProperties": false,
        "required": [
          "workspaceId",
          "name"
        ],
        "description": "Parameters for creating an airfocus item."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "item": {
            "type": "object",
            "additionalProperties": true,
            "description": "The airfocus item returned by the API."
          }
        },
        "additionalProperties": false,
        "required": [
          "item"
        ],
        "description": "Action output."
      }
    },
