                "endTime": {
                  "type": "string",
                  "description": "The original event end time in UTC.",
                  "format": "date-time"
                },
                "recurring": {
                  "type": "boolean",
                  "description": "Whether the event recurs."
                },
                "createdAt": {
                  "type": "string",
                  "description": "The time when the event was created.",
                  "format": "date-time"
                },
                "createdBy": {
                  "type": "string",
                  "description": "The user identifier of the event creator."
                },
                "invitedUsers": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "An invited user identifier."
                  },
                  "description": "The identifiers of users invited to the event."
                },
                "invitedGroups": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "An invited group identifier."
                  },
                  "description": "The identifiers of groups invited to the event."
                },
                "coverImage": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "The URL of the event cover image, or null when no cover image is set."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The URL of the event cover image, or null when no cover image is set."
                }
              },
              "additionalProperties": true,
              "description": "A Heartbeat community event with documented fields and any additional upstream data."
            },
            "description": "The community events."
          }
        },
        "additionalProperties": false,
        "required": [
          "events"
        ],
        "description": "Action output."
      }
