                },
                "name": {
                  "type": "string",
                  "description": "The display name of the event."
                },
                "description": {
                  "type": "string",
                  "description": "The description of the event."
                },
                "startTime": {
                  "type": "string",
                  "description": "The original event start time in UTC.",
