    {
      "id": "heartbeat.find_users_by_email",
      "service": "heartbeat",
      "name": "find_users_by_email",
      "description": "Find Heartbeat community users whose email matches exactly.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "The exact user email address to find.",
            "format": "email"
          }
        },
        "additionalProperties": false,
        "required": [
          "email"
        ],
        "description": "The email address to find in the Heartbeat community."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The unique identifier of the user."
                },
                "email": {
                  "type": "string",
                  "description": "The user's email address.",
                  "format": "email"
                },
                "name": {
                  "type": "string",
                  "description": "The user's full name."
                },
                "firstName": {
                  "type": "string",
                  "description": "The user's first name."
                },
                "lastName": {
                  "type": "string",
                  "description": "The user's last name."
                },
                "role": {
                  "type": "string",
                  "description": "The user's current role."
                },
                "isAdmin": {
                  "type": "boolean",
                  "description": "Whether the user is a community administrator."
                },
                "groups": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "The unique identifier of the group."
                      },
                      "name": {
                        "type": "string",
                        "description": "The display name of the group."
                      }
                    },
                    "additionalProperties": true,
                    "description": "A Heartbeat group associated with a user."
                  },
                  "description": "The groups associated with the user."
                },
                "onboardingResponses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "question": {
                        "type": "string",
                        "description": "The onboarding question shown to the user."
                      },
                      "answer": {
                        "type": "string",
                        "description": "The user's answer to the onboarding question."
                      },
                      "isPrivate": {
                        "type": "boolean",
                        "description": "Whether the onboarding response is private."
                      }
                    },
                    "additionalProperties": true,
                    "description": "One response to a Heartbeat onboarding question."
                  },
                  "description": "The user's onboarding question responses."
                },
                "bio": {
                  "type": "string",
                  "description": "The user's Heartbeat biography."
                },
                "avatar": {
                  "type": "string",
                  "description": "The URL of the user's Heartbeat avatar."
                },
                "linkedInSummary": {
                  "type": "string",
                  "description": "The formatted LinkedIn summary available for the user."
                },
                "linkedInData": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": true,
                      "description": "The LinkedIn profile data available for the user."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The LinkedIn profile data available for the user."
                }
              },
              "additionalProperties": true,
              "description": "A Heartbeat community user with documented profile fields and any additional upstream data."
            },
            "description": "The matching community users."
          }
        },
        "additionalProperties": false,
        "required": [
          "users"
        ],
        "description": "Action output."
      }
    },
