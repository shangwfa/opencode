{
  "service": "quriiri",
  "displayName": "Quriiri",
  "categories": [
    "Communication",
    "Marketing"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "QURIIRI_API_KEY",
      "description": "Quriiri API key used with the Authorization Bearer header. Create or manage API keys in Quriiri under Management > API keys: https://docs.quriiri.fi/docs/quriiri/send-sms.",
      "extraFields": [
        {
          "key": "apiBaseUrl",
          "label": "API Base URL",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "https://example.com",
          "description": "The HTTP common API URL copied from Quriiri under Message Router > Resources."
        }
      ]
    }
  ],
  "homepageUrl": "https://quriiri.fi/",
  "actions": [
    {
      "id": "quriiri.get_sms_status",
      "service": "quriiri",
      "name": "get_sms_status",
      "description": "Get one Quriiri SMS delivery status by delivery report ID.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "deliveryReportId": {
            "type": "string",
            "minLength": 1,
            "description": "The Quriiri delivery report ID."
          }
        },
        "additionalProperties": false,
        "required": [
          "deliveryReportId"
        ],
        "description": "The input payload for getting one Quriiri SMS status."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "object",
            "properties": {
              "drid": {
                "type": "string",
                "minLength": 1,
                "description": "The Quriiri delivery report ID."
              },
              "bodyparts": {
                "type": "integer",
                "minimum": 0,
                "description": "The number of SMS body parts."
              },
              "direction": {
                "type": "string",
                "enum": [
                  "MT",
                  "MO"
                ],
                "description": "The message direction."
              },
              "batchid": {
                "type": "string",
                "description": "The optional batch ID."
              },
              "billingref": {
                "type": "string",
                "description": "The optional billing reference."
              },
              "created": {
                "type": "string",
                "description": "The message creation timestamp.",
                "format": "date-time"
              },
              "statustime": {
                "type": "string",
                "description": "The status timestamp.",
                "format": "date-time"
              },
              "reason": {
                "type": "string",
                "description": "The failure reason, if any."
              },
              "status": {
                "type": "string",
                "description": "The current message status."
              },
              "countrycode": {
                "type": "string",
                "description": "The destination country code."
              }
            },
            "additionalProperties": true,
            "description": "A Quriiri SMS status record."
          }
        },
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "description": "The Quriiri SMS status response."
      }
    },
    {
      "id": "quriiri.list_sender_ids",
      "service": "quriiri",
      "name": "list_sender_ids",
      "description": "List authorized and registered sender IDs for the Quriiri customer.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false,
        "description": "The input payload for listing Quriiri sender IDs."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "authorized_sender_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "An authorized sender ID."
            },
            "description": "The sender IDs authorized in the Quriiri service."
          },
          "registered_sender_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "A registered sender ID."
            },
            "description": "The sender IDs registered with Traficom."
          }
        },
        "additionalProperties": false,
        "required": [
          "authorized_sender_ids",
          "registered_sender_ids"
        ],
        "description": "The authorized and registered Quriiri sender IDs."
      }
    },
    {
      "id": "quriiri.list_sms_statuses",
      "service": "quriiri",
      "name": "list_sms_statuses",
      "description": "List Quriiri SMS delivery statuses within an optional time range.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "start": {
            "type": "string",
            "description": "The inclusive start timestamp for the status search.",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "description": "The exclusive end timestamp for the status search.",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "CREATED",
              "SENT",
              "ACKED",
              "FAILED",
              "DELIVERED",
              "READ",
              "UNKNOWN",
              "RETRY"
            ],
            "description": "The optional message status filter."
          }
        },
        "additionalProperties": false,
        "description": "The input payload for listing Quriiri SMS statuses."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of matching status records."
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "drid": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The Quriiri delivery report ID."
                },
                "bodyparts": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "The number of SMS body parts."
                },
                "direction": {
                  "type": "string",
                  "enum": [
                    "MT",
                    "MO"
                  ],
                  "description": "The message direction."
                },
                "batchid": {
                  "type": "string",
                  "description": "The optional batch ID."
                },
                "billingref": {
                  "type": "string",
                  "description": "The optional billing reference."
                },
                "created": {
                  "type": "string",
                  "description": "The message creation timestamp.",
                  "format": "date-time"
                },
                "statustime": {
                  "type": "string",
                  "description": "The status timestamp.",
                  "format": "date-time"
                },
                "reason": {
                  "type": "string",
                  "description": "The failure reason, if any."
                },
                "status": {
                  "type": "string",
                  "description": "The current message status."
                },
                "countrycode": {
                  "type": "string",
                  "description": "The destination country code."
                }
              },
              "additionalProperties": true,
              "description": "A Quriiri SMS status record."
            },
            "description": "The matching SMS status records."
          },
          "start": {
            "type": "string",
            "description": "The response start timestamp.",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "description": "The response end timestamp.",
            "format": "date-time"
          }
        },
        "additionalProperties": false,
        "required": [
          "count",
          "messages",
          "start",
          "end"
        ],
        "description": "The Quriiri SMS status list response."
      }
    },
    {
      "id": "quriiri.send_sms",
      "service": "quriiri",
      "name": "send_sms",
      "description": "Send an SMS message with Quriiri using the HTTP JSON API.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "sender": {
            "type": "string",
            "minLength": 1,
            "description": "The SMS sender ID or phone number."
          },
          "destination": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "A recipient phone number."
            },
            "description": "The recipient phone numbers in international, national, or shortcode format.",
            "minItems": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "The SMS message text."
          },
          "senderType": {
            "type": "string",
            "enum": [
              "MSISDN",
              "NATIONAL",
              "ALNUM"
            ],
            "description": "The sender type. Quriiri can also infer this when omitted."
          },
          "batchId": {
            "type": "string",
            "maxLength": 255,
            "description": "The optional batch ID used to group related messages."
          },
          "billingRef": {
            "type": "string",
            "maxLength": 255,
            "description": "The optional billing reference stored for reporting."
          },
          "deliveryReportUrl": {
            "type": "string",
            "description": "The optional URL where Quriiri sends delivery reports.",
            "format": "uri"
          },
          "deliveryReportType": {
            "type": "string",
            "enum": [
              "JSON",
              "POST",
              "GET"
            ],
            "description": "The delivery report format."
          },
          "flash": {
            "type": "boolean",
            "description": "Whether to send the message as a flash SMS."
          },
          "validityMinutes": {
            "type": "integer",
            "minimum": 1,
            "description": "The message validity period in minutes."
          },
          "scheduleTime": {
            "type": "string",
            "description": "The optional scheduled send time in ISO 8601 format.",
            "format": "date-time"
          }
        },
        "additionalProperties": false,
        "required": [
          "sender",
          "destination",
          "text"
        ],
        "description": "The input payload for sending a Quriiri SMS message."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "converted": {
                  "type": "string",
                  "description": "The normalized destination phone number."
                },
                "status": {
                  "type": "string",
                  "description": "The message creation status."
                },
                "reason": {
                  "type": "string",
                  "description": "The failure reason, if the recipient failed."
                },
                "messageid": {
                  "type": "string",
                  "description": "The Quriiri message ID."
                }
              },
              "additionalProperties": true,
              "description": "A per-recipient send result."
            },
            "description": "The per-recipient send results keyed by recipient phone number."
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "description": "The error or warning message."
                }
              },
              "additionalProperties": true,
              "description": "A Quriiri error or warning message."
            },
            "description": "The warnings returned by Quriiri."
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "description": "The error or warning message."
                }
              },
              "additionalProperties": true,
              "description": "A Quriiri error or warning message."
            },
            "description": "The errors returned by Quriiri."
          }
        },
        "additionalProperties": false,
        "required": [
          "messages",
          "warnings",
          "errors"
        ],
        "description": "The response returned after Quriiri processes the SMS send request."
      }
    }
  ]
}
