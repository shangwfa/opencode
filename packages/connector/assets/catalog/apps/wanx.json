{
  "service": "wanx",
  "displayName": "Wanx",
  "categories": [
    "AI",
    "Design & Media"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "Model Studio API Key",
      "placeholder": "Your Beijing Model Studio API key",
      "description": "Beijing Model Studio API key sent as a Bearer token. Create one at https://bailian.console.aliyun.com/?apiKey=1#/api-key."
    }
  ],
  "homepageUrl": "https://tongyi.aliyun.com/wanxiang/",
  "actions": [
    {
      "id": "wanx.generate_image",
      "service": "wanx",
      "name": "generate_image",
      "description": "Generate or edit images with the Wan Image 2.7 family.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "wan2.7-image",
              "wan2.7-image-pro"
            ],
            "description": "The Wan Image 2.7 model.",
            "default": "wan2.7-image"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "description": "The image generation or editing prompt."
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "A reference image URL or data URL."
            },
            "description": "Reference image URLs or data URLs. Omit for text-to-image generation.",
            "maxItems": 9
          },
          "size": {
            "type": "string",
            "minLength": 1,
            "description": "The output size preset or WIDTH*HEIGHT value.",
            "default": "2K"
          },
          "imageCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "description": "The number of images to generate.",
            "default": 1
          },
          "negativePrompt": {
            "type": "string",
            "maxLength": 500,
            "description": "Content that should not appear in the generated images."
          },
          "promptExtend": {
            "type": "boolean",
            "description": "Whether Wanx should enhance the prompt.",
            "default": true
          },
          "watermark": {
            "type": "boolean",
            "description": "Whether generated images include a watermark.",
            "default": false
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647,
            "description": "The random seed."
          }
        },
        "additionalProperties": false,
        "required": [
          "prompt"
        ],
        "description": "A unified Wan Image 2.7 generation or editing request."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "images": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "A generated image URL."
            },
            "description": "The generated temporary image URLs."
          },
          "imageCount": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of generated images."
          },
          "size": {
            "type": "string",
            "description": "The generated image dimensions."
          }
        },
        "additionalProperties": false,
        "required": [
          "images",
          "imageCount",
          "size"
        ],
        "description": "The generated Wanx images and usage."
      }
    },
    {
      "id": "wanx.get_video_generation",
      "service": "wanx",
      "name": "get_video_generation",
      "description": "Retrieve a Wan 3.0 video task state and output.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1,
            "description": "The opaque Wanx task identifier returned by the selected connection."
          }
        },
        "additionalProperties": false,
        "required": [
          "taskId"
        ],
        "description": "A Wan 3.0 task lookup."
      },
      "outputSchema": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "taskId": {
                "type": "string",
                "minLength": 1,
                "description": "The opaque Wanx task identifier returned by the selected connection."
              },
              "state": {
                "const": "processing",
                "type": "string",
                "description": "The task is queued or running."
              },
              "progress": {
                "type": "number",
                "minimum": 0,
                "maximum": 100,
                "description": "The task progress percentage when available."
              }
            },
            "additionalProperties": false,
            "required": [
              "taskId",
              "state"
            ],
            "description": "A queued or running Wan 3.0 task."
          },
          {
            "type": "object",
            "properties": {
              "taskId": {
                "type": "string",
                "minLength": 1,
                "description": "The opaque Wanx task identifier returned by the selected connection."
              },
              "state": {
                "const": "succeeded",
                "type": "string",
                "description": "The task succeeded."
              },
              "videoUrl": {
                "type": "string",
                "minLength": 1,
                "description": "The temporary generated video URL."
              },
              "duration": {
                "type": "number",
                "description": "The billed generated video duration in seconds."
              },
              "resolution": {
                "type": "string",
                "description": "The generated video resolution."
              },
              "ratio": {
                "type": "string",
                "description": "The generated video aspect ratio."
              }
            },
            "additionalProperties": false,
            "required": [
              "taskId",
              "state",
              "videoUrl"
            ],
            "description": "A succeeded Wan 3.0 task."
          },
          {
            "type": "object",
            "properties": {
              "taskId": {
                "type": "string",
                "minLength": 1,
                "description": "The opaque Wanx task identifier returned by the selected connection."
              },
              "state": {
                "type": "string",
                "enum": [
                  "failed",
                  "cancelled",
                  "expired"
                ],
                "description": "The terminal task state."
              },
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "description": "The upstream error code."
                  },
                  "message": {
                    "type": "string",
                    "description": "The upstream error message."
                  }
                },
                "additionalProperties": false,
                "description": "The upstream terminal error."
              }
            },
            "additionalProperties": false,
            "required": [
              "taskId",
              "state"
            ],
            "description": "A terminal Wan 3.0 task that did not succeed."
          }
        ],
        "description": "The normalized Wan 3.0 video task state."
      },
      "asyncLifecycle": {
        "startActionId": "wanx.submit_video_generation",
        "statusActionId": "wanx.get_video_generation"
      }
    },
    {
      "id": "wanx.submit_video_generation",
      "service": "wanx",
      "name": "submit_video_generation",
      "description": "Submit a unified asynchronous Wan 3.0 video generation task.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "wan3.0-video",
              "wan3.0-video-prime"
            ],
            "description": "The Wan 3.0 video model.",
            "default": "wan3.0-video"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000,
            "description": "The video generation or editing prompt."
          },
          "media": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "first_frame",
                    "last_frame",
                    "reference_image",
                    "reference_video",
                    "reference_audio",
                    "file",
                    "link"
                  ],
                  "description": "How Wan 3.0 uses this media."
                },
                "url": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A public URL, OSS temporary URL, or supported image data URL."
                }
              },
              "additionalProperties": false,
              "required": [
                "type",
                "url"
              ],
              "description": "A media input for Wan 3.0 video generation."
            },
            "description": "Media inputs for Wan 3.0.",
            "maxItems": 20
          },
          "resolution": {
            "type": "string",
            "enum": [
              "480P",
              "720P",
              "1080P"
            ],
            "description": "The generated video resolution.",
            "default": "1080P"
          },
          "ratio": {
            "type": "string",
            "enum": [
              "adaptive",
              "16:9",
              "4:3",
              "1:1",
              "3:4",
              "9:16"
            ],
            "description": "The generated video aspect ratio.",
            "default": "adaptive"
          },
          "duration": {
            "type": "integer",
            "description": "The video duration in seconds, or -1 for automatic selection.",
            "default": 5
          },
          "audio": {
            "type": "boolean",
            "description": "Whether the generated video contains audio.",
            "default": true
          },
          "promptExtend": {
            "type": "boolean",
            "description": "Whether Wanx should enhance the prompt.",
            "default": true
          },
          "watermark": {
            "type": "boolean",
            "description": "Whether the generated video includes a watermark.",
            "default": false
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2147483647,
            "description": "The random seed."
          }
        },
        "additionalProperties": false,
        "description": "A unified Wan 3.0 video generation request. Provide a prompt or media.",
        "anyOf": [
          {
            "required": [
              "prompt"
            ]
          },
          {
            "required": [
              "media"
            ]
          }
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1,
            "description": "The opaque Wanx task identifier returned by the selected connection."
          }
        },
        "additionalProperties": false,
        "required": [
          "taskId"
        ],
        "description": "The submitted Wan 3.0 task handle."
      },
      "followUpActions": [
        "wanx.get_video_generation"
      ],
      "asyncLifecycle": {
        "startActionId": "wanx.submit_video_generation",
        "statusActionId": "wanx.get_video_generation"
      }
    }
  ]
}
