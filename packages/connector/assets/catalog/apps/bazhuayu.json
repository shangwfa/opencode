              "type": "object",
              "properties": {
                "taskId": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The Bazhuayu task ID."
                },
                "actions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "actionType": {
                        "type": "string",
                        "description": "The task step type."
                      },
                      "name": {
                        "type": "string",
                        "description": "The task step name."
                      },
                      "actionId": {
                        "type": "string",
                        "description": "The task step ID used by update actions."
                      }
                    },
                    "additionalProperties": true,
                    "description": "One API-addressable step in a Bazhuayu task."
                  },
                  "description": "The matching task steps."
                }
              },
              "additionalProperties": true,
              "description": "The API-addressable steps for one Bazhuayu task."
            },
            "description": "The task step groups."
          },
          "requestId": {
            "type": "string",
            "description": "The Bazhuayu request ID used for support and troubleshooting."
          }
