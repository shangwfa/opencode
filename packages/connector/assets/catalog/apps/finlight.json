                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Article summary when available."
                },
                "publishDate": {
                  "type": "string",
                  "description": "Publication date as an ISO date string."
                },
                "createdAt": {
                  "type": "string",
                  "description": "Indexing date, returned when ordering by createdAt."
                },
                "revisedDate": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "Last revision date, returned when ordering by revisedDate."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Last revision date, returned when ordering by revisedDate."
                },
                "language": {
                  "type": "string",
                  "description": "Article language as an ISO 639-1 code."
                },
                "sentiment": {
                  "type": "string",
                  "description": "Sentiment: positive, neutral, or negative."
                },
                "confidence": {
                  "type": "string",
                  "description": "Sentiment confidence from 0 to 1 as a stringified number."
                },
                "content": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "Full article content when available under the subscription."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Full article content when available under the subscription."
                },
                "images": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "description": "An article image URL."
                  },
                  "description": "Article image URLs."
                },
                "countries": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "description": "An ISO 3166-1 alpha-2 country code."
                  },
                  "description": "Countries related to the article."
                },
                "categories": {
                  "type": "array",
                  "items": {
