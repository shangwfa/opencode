  "actions": [
    {
      "id": "finlight.get_article_by_link",
      "service": "finlight",
      "name": "get_article_by_link",
      "description": "Get a Finlight article by its original URL, optionally including company entities and full content.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "link": {
            "type": "string",
            "description": "Original article URL to look up in Finlight.",
            "format": "uri"
          },
          "includeEntities": {
            "type": "boolean",
            "description": "Include company entities; requires a suitable subscription. Defaults to false."
          },
          "includeContent": {
            "type": "boolean",
            "description": "Deprecated upstream option to include full article content. Defaults to false."
          }
        },
        "additionalProperties": false,
        "required": [
          "link"
        ],
        "description": "Article lookup options."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Upstream response status."
          },
          "article": {
            "type": "object",
            "properties": {
              "link": {
                "type": "string",
                "description": "URL of the original article."
              },
              "source": {
                "type": "string",
                "description": "Publisher domain."
              },
              "title": {
                "type": "string",
                "description": "Article title."
              },
              "summary": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Article summary when available."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Article summary when available."
              },
              "publishDate": {
                "type": "string",
                "description": "Publication date as an ISO date string."
              },
              "createdAt": {
                "type": "string",
                "description": "Indexing date, returned when ordering by createdAt."
              },
              "revisedDate": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Last revision date, returned when ordering by revisedDate."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Last revision date, returned when ordering by revisedDate."
              },
              "language": {
                "type": "string",
                "description": "Article language as an ISO 639-1 code."
              },
              "sentiment": {
                "type": "string",
                "description": "Sentiment: positive, neutral, or negative."
              },
              "confidence": {
                "type": "string",
                "description": "Sentiment confidence from 0 to 1 as a stringified number."
              },
              "content": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "Full article content when available under the subscription."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Full article content when available under the subscription."
              },
              "images": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "An article image URL."
                },
                "description": "Article image URLs."
              },
              "countries": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "An ISO 3166-1 alpha-2 country code."
                },
                "description": "Countries related to the article."
              },
              "categories": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "An article category."
                },
                "description": "Article categories."
              },
              "companies": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {},
                      "additionalProperties": true,
                      "description": "Company identity, confidence, tickers, ISINs, and exchange listings."
                    },
                    "description": "Company entities, subject to subscription access."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Company entities, subject to subscription access."
              }
            },
            "additionalProperties": true,
            "required": [
              "link",
              "title"
            ],
            "description": "A financial news article returned by Finlight."
          }
        },
        "additionalProperties": true,
        "required": [
          "status",
          "article"
        ],
        "description": "Finlight single article response."
      }
    },
    {
