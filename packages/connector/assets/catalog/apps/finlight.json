    {
      "id": "finlight.search_articles",
      "service": "finlight",
      "name": "search_articles",
      "description": "Search financial news with sentiment, source, ticker, country, category, date, and pagination filters.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query, including Finlight advanced query syntax."
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "A source domain or *."
            },
            "description": "Restrict sources; use * to include all sources."
          },
          "optInSources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "An additional source domain."
            },
            "description": "Additional sources to include beyond the default set."
          },
          "excludeSources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "A source domain to exclude."
            },
            "description": "Sources to exclude."
          },
          "tickers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "A stock ticker or *."
            },
            "description": "Stock tickers to match; supports *."
          },
          "countries": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "An ISO 3166-1 alpha-2 country code."
            },
            "description": "Filter countries the article is about, not publisher or company domicile."
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "markets",
                "economy",
                "business",
                "politics",
                "geopolitics",
                "regulation",
                "technology",
                "energy",
                "commodities",
                "crypto",
                "health",
                "climate",
                "security"
              ],
              "description": "An article category."
            },
            "description": "Filter by article categories."
          },
          "includeEntities": {
            "type": "boolean",
            "description": "Include company entities; requires a suitable subscription. Defaults to false."
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "description": "Start date in YYYY-MM-DD or ISO date format."
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "description": "End date in YYYY-MM-DD or ISO date format."
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "description": "ISO 639-1 language filter. Defaults to en, excluding other languages."
          },
          "orderBy": {
            "type": "string",
            "enum": [
              "publishDate",
              "createdAt",
              "revisedDate"
            ],
            "description": "Sort field. Defaults to publishDate."
          },
          "order": {
            "type": "string",
            "enum": [
              "ASC",
              "DESC"
            ],
            "description": "Sort direction. Defaults to DESC."
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Results per page. Defaults to 20."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "Page number, starting at 1. Defaults to 1."
          }
        },
        "additionalProperties": false,
        "description": "Financial news search options."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Upstream response status."
