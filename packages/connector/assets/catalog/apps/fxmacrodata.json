  "homepageUrl": "https://fxmacrodata.com",
  "actions": [
    {
      "id": "fxmacrodata.get_announcements",
      "service": "fxmacrodata",
      "name": "get_announcements",
      "description": "Get the official release history of one macroeconomic indicator for a currency, such as US CPI or the ECB deposit rate. Each row carries the reference period, the value and the time the publisher released it. USD works without an API key with limited recent history.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "description": "Three-letter currency code, such as usd, eur, gbp or jpy. Case-insensitive.",
            "pattern": "^[A-Za-z]{3}$"
          },
          "indicator": {
            "type": "string",
            "description": "Indicator slug, such as inflation, policy_rate, unemployment or gdp. get_data_catalogue lists every slug served for a currency.",
            "pattern": "^[a-z0-9_]+$"
          },
          "startDate": {
            "type": "string",
            "description": "Earliest date to return, as YYYY-MM-DD.",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "description": "Latest date to return, as YYYY-MM-DD.",
            "format": "date"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Maximum number of rows to return. Defaults to 20; at most 100.",
            "default": 20
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of rows to skip. Use pagination.next_offset to read the next page.",
            "default": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "currency",
          "indicator"
        ],
        "description": "The currency, indicator, optional date window and pagination."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "description": "The currency code."
          },
          "indicator": {
            "type": "string",
            "description": "The indicator slug."
          },
          "name": {
            "type": "string",
            "description": "The indicator name."
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "description": "The reference period the value describes, as YYYY-MM-DD."
                },
                "val": {
                  "anyOf": [
                    {
                      "type": "number",
                      "description": "The released value."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "The released value."
                },
                "announcement_datetime": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "description": "When the publisher released the value, as Unix seconds."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "When the publisher released the value, as Unix seconds."
                },
                "source": {
                  "type": "string",
                  "description": "The publisher of the value."
                },
                "source_url": {
                  "type": "string",
                  "description": "The publisher page the value was read from."
                }
              },
              "additionalProperties": true,
              "description": "One official release."
            },
            "description": "Releases, newest first."
          },
          "pagination": {
            "type": "object",
            "properties": {
              "limit": {
                "anyOf": [
                  {
                    "type": "integer",
                    "description": "The requested page size."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The requested page size."
              },
              "offset": {
                "anyOf": [
                  {
                    "type": "integer",
                    "description": "Number of rows skipped."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Number of rows skipped."
              },
              "returned_count": {
                "anyOf": [
                  {
                    "type": "integer",
                    "description": "Number of rows in this page."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Number of rows in this page."
              },
              "total_count": {
                "anyOf": [
                  {
                    "type": "integer",
                    "description": "Total rows in the requested date window."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Total rows in the requested date window."
              },
              "has_more": {
                "anyOf": [
                  {
                    "type": "boolean",
                    "description": "Whether another page is available."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Whether another page is available."
              },
              "next_offset": {
                "anyOf": [
                  {
                    "type": "integer",
                    "description": "Offset for the next page, or null when there are no more rows."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Offset for the next page, or null when there are no more rows."
              }
            },
            "additionalProperties": true,
            "description": "Page information. Continue with next_offset while has_more is true."
          }
        },
        "additionalProperties": true,
        "description": "The release history of the indicator."
      }
    },
