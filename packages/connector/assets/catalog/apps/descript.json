    {
      "id": "descript.prompt_agent",
      "service": "descript",
      "name": "prompt_agent",
      "description": "Submit an asynchronous Underlord request to create or edit a Descript project.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "description": "The existing project UUID to edit.",
            "format": "uuid"
          },
          "projectName": {
            "type": "string",
            "description": "The name of a new project to create."
          },
          "compositionId": {
            "type": "string",
            "description": "A composition UUID, short ID, or Descript project URL to target."
          },
          "model": {
            "type": "string",
            "description": "A model ID or stable alias returned by list_agent_models."
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "description": "The complete natural-language editing instruction."
          },
          "teamAccess": {
            "type": "string",
            "enum": [
              "edit",
              "comment",
              "view",
              "none"
            ],
            "description": "The Drive member access for a newly created project."
          },
          "callbackUrl": {
            "type": "string",
            "description": "A webhook URL that Descript should call when the job stops.",
            "format": "uri"
          }
        },
        "additionalProperties": false,
        "required": [
          "prompt"
        ],
        "description": "An Underlord instruction targeting an existing project or a new project name."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "description": "The job identifier used to monitor completion.",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "description": "The project created or modified by the job.",
            "format": "uuid"
          },
          "projectUrl": {
            "type": "string",
            "description": "The URL for opening the project in Descript.",
            "format": "uri"
          },
          "raw": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The complete response payload returned by Descript."
          }
        },
        "additionalProperties": true,
        "description": "A newly submitted Descript job."
      },
      "followUpActions": [
        "descript.get_job"
      ]
