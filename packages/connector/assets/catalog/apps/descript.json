          "createdAfter": {
            "type": "string",
            "description": "Only include projects created after this ISO 8601 timestamp.",
            "format": "date-time"
          },
          "createdBefore": {
            "type": "string",
            "description": "Only include projects created before this ISO 8601 timestamp.",
