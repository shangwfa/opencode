{
  "service": "descript",
  "displayName": "Descript",
  "categories": [
    "AI",
    "Design & Media"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Token",
      "placeholder": "DESCRIPT_API_TOKEN",
      "description": "Personal API token sent as a Bearer credential. Create a Drive-scoped token in Descript Settings under API tokens: https://docs.descriptapi.com/#section/Getting-started/Create-an-API-token"
    }
  ],
  "homepageUrl": "https://www.descript.com/",
  "actions": [
    {
      "id": "descript.cancel_job",
      "service": "descript",
      "name": "cancel_job",
      "description": "Cancel a running Descript job.",
      "operationType": "destructive",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "description": "The running job UUID.",
            "format": "uuid"
          }
        },
        "additionalProperties": false,
        "required": [
          "jobId"
        ],
        "description": "The job to cancel."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "cancelled": {
            "type": "boolean",
            "description": "Whether the cancellation request succeeded."
          }
        },
        "additionalProperties": false,
        "required": [
          "cancelled"
        ],
        "description": "Confirmation that Descript accepted the cancellation."
      }
    },
    {
      "id": "descript.get_job",
      "service": "descript",
      "name": "get_job",
      "description": "Get the current state and type-specific result of a Descript job.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "description": "The job UUID.",
            "format": "uuid"
          }
        },
        "additionalProperties": false,
        "required": [
          "jobId"
        ],
        "description": "The job to retrieve."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ],
            "description": "The normalized job status."
          },
          "job": {
            "type": "object",
            "properties": {
              "job_id": {
                "type": "string",
                "description": "The job identifier.",
                "format": "uuid"
              },
              "job_type": {
                "type": "string",
                "description": "The Descript job type."
              },
              "job_state": {
                "type": "string",
                "description": "The upstream job state."
              },
              "result": {
                "type": "object",
                "properties": {},
                "additionalProperties": true,
                "description": "The type-specific job result."
              }
            },
            "additionalProperties": true,
            "description": "A Descript asynchronous job."
          }
        },
        "additionalProperties": false,
        "required": [
          "status",
          "job"
        ],
        "description": "The normalized state and raw Descript job."
      }
    },
    {
      "id": "descript.get_project",
      "service": "descript",
      "name": "get_project",
      "description": "Get a Descript project with its media, compositions, and published links.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "description": "The project UUID.",
            "format": "uuid"
          }
        },
        "additionalProperties": false,
        "required": [
          "projectId"
        ],
        "description": "The project to retrieve."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The project and its contents."
          }
        },
        "additionalProperties": false,
        "required": [
          "project"
        ],
        "description": "A Descript project response."
      }
    },
    {
      "id": "descript.import_media",
      "service": "descript",
      "name": "import_media",
      "description": "Import URL-hosted media into a new or existing Descript project asynchronously.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "description": "The existing project UUID to receive the media.",
            "format": "uuid"
          },
          "projectName": {
            "type": "string",
            "description": "The name of a new project to create."
          },
          "teamAccess": {
            "type": "string",
            "enum": [
              "edit",
              "comment",
              "view",
              "none"
            ],
            "description": "The Drive member access for a newly created project."
          },
          "folderName": {
            "type": "string",
            "description": "The nested folder path for a newly created project."
          },
          "media": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The display name or folder path used inside the project."
                },
                "url": {
                  "type": "string",
                  "description": "A public or pre-signed URL that supports HTTP Range requests.",
                  "format": "uri"
                }
              },
              "additionalProperties": false,
              "required": [
                "name",
                "url"
              ],
              "description": "One media file exposed to Descript by URL."
            },
            "description": "The URL-hosted media files to import.",
            "minItems": 1
          },
          "compositions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A Descript composition definition."
            },
            "description": "Optional Descript composition definitions referencing media names."
          },
          "callbackUrl": {
            "type": "string",
            "description": "A webhook URL that Descript should call when the job stops.",
            "format": "uri"
          }
        },
        "additionalProperties": false,
        "required": [
          "media"
        ],
        "description": "A URL-based Descript media import request."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "description": "The job identifier used to monitor completion.",
            "format": "uuid"
          },
          "projectId": {
            "type": "string",
            "description": "The project created or modified by the job.",
            "format": "uuid"
          },
          "projectUrl": {
            "type": "string",
            "description": "The URL for opening the project in Descript.",
            "format": "uri"
          },
          "raw": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The complete response payload returned by Descript."
          }
        },
        "additionalProperties": true,
        "description": "A newly submitted Descript job."
      },
      "followUpActions": [
        "descript.get_job"
      ]
    },
    {
