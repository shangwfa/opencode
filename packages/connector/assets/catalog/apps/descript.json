    {
      "id": "descript.list_jobs",
      "service": "descript",
      "name": "list_jobs",
      "description": "List recent Descript jobs with optional project, type, time, and pagination filters.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "description": "Only include jobs for this project UUID.",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "import/project_media",
              "agent"
            ],
            "description": "Only include this job type."
          },
          "cursor": {
            "type": "string",
            "description": "A pagination cursor from a previous response."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "The maximum number of jobs to return."
          },
          "createdAfter": {
            "type": "string",
            "description": "Only include jobs created after this ISO 8601 timestamp.",
            "format": "date-time"
          },
          "createdBefore": {
            "type": "string",
            "description": "Only include jobs created before this ISO 8601 timestamp.",
            "format": "date-time"
          }
        },
        "additionalProperties": false,
        "description": "Filters and pagination for listing Descript jobs."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "jobs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "job_id": {
                  "type": "string",
                  "description": "The job identifier.",
                  "format": "uuid"
                },
                "job_type": {
                  "type": "string",
                  "description": "The Descript job type."
                },
                "job_state": {
                  "type": "string",
                  "description": "The upstream job state."
                },
                "result": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": true,
                  "description": "The type-specific job result."
                }
              },
              "additionalProperties": true,
              "description": "A Descript asynchronous job."
            },
            "description": "The jobs in this page."
          },
          "pagination": {
            "type": "object",
            "properties": {
              "next_cursor": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "The cursor for the next page, or null at the end."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The cursor for the next page, or null at the end."
              }
            },
            "additionalProperties": true,
            "description": "Pagination metadata returned by Descript."
          },
          "raw": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The complete response payload returned by Descript."
          }
        },
        "additionalProperties": false,
        "required": [
          "jobs",
          "pagination",
          "raw"
        ],
        "description": "A page of Descript jobs."
      }
    },
    {
      "id": "descript.list_projects",
      "service": "descript",
      "name": "list_projects",
