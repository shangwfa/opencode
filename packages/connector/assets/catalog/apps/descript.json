            "description": "The projects in this page."
          },
          "pagination": {
            "type": "object",
            "properties": {
              "next_cursor": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "The cursor for the next page, or null at the end."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The cursor for the next page, or null at the end."
              }
            },
            "additionalProperties": true,
            "description": "Pagination metadata returned by Descript."
          },
          "raw": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The complete response payload returned by Descript."
          }
        },
        "additionalProperties": false,
        "required": [
          "projects",
          "pagination",
          "raw"
        ],
        "description": "A page of Descript projects."
      }
