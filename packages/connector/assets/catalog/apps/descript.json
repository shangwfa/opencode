          "cursor": {
            "type": "string",
            "description": "A pagination cursor from a previous response."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "The maximum number of projects to return."
          }
        },
        "additionalProperties": false,
        "description": "Filters and pagination for listing Descript projects."
      },
      "outputSchema": {
        "type": "object",
