          "owner": {
            "type": "string",
            "description": "The login of the case owner."
          },
          "flag": {
            "type": "boolean",
            "description": "Whether the case is flagged."
          },
          "severity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "description": "The severity level from 1 through 3."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "A tag."
