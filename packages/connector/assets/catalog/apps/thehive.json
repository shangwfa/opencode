{
  "service": "thehive",
  "displayName": "TheHive",
  "description": "Create and inspect alerts and cases in a TheHive 4 instance.",
  "categories": [
    "Security"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "Your TheHive API key",
      "description": "The API key sent as a Bearer token. In TheHive 4, an organization administrator can create it from Organization > Create API Key. See https://docs.thehive-project.org/thehive/legacy/thehive4/.",
      "extraFields": [
        {
          "key": "baseUrl",
          "label": "Instance URL",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "https://thehive.example.com",
          "description": "The root HTTP or HTTPS URL of your TheHive 4 instance. Private-network instances require OOMOL_CONNECT_ALLOW_PRIVATE_NETWORK in the self-hosted runtime; reserved, local, and cloud-metadata targets remain blocked."
        }
      ]
    }
  ],
  "homepageUrl": "https://thehive-project.org",
  "actions": [
    {
      "id": "thehive.create_alert",
      "service": "thehive",
      "name": "create_alert",
      "description": "Create a JSON alert in a TheHive 4 instance.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "The alert type."
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "description": "The alert source."
          },
          "sourceRef": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "The unique reference within the alert source."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "The alert title."
          },
          "description": {
            "type": "string",
            "description": "The alert description."
          },
          "date": {
            "type": "integer",
            "description": "The alert timestamp in Unix milliseconds."
          },
          "follow": {
            "type": "boolean",
            "description": "Whether the connected user follows the alert."
          },
          "severity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3,
            "description": "The severity level from 1 through 3."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "A tag."
            },
            "description": "Tags assigned to the entity."
          },
          "tlp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "The Traffic Light Protocol level from 0 through 3."
          }
        },
        "additionalProperties": false,
        "required": [
          "type",
          "source",
          "sourceRef",
          "title",
          "description"
        ],
        "description": "The input for creating a TheHive 4 alert."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "alert": {
            "type": "object",
            "properties": {
              "_id": {
                "type": "string",
                "description": "The alert ID."
              },
              "title": {
                "type": "string",
                "description": "The alert title."
              },
              "source": {
                "type": "string",
                "description": "The alert source."
              },
              "sourceRef": {
                "type": "string",
                "description": "The source-specific alert reference."
              }
            },
            "additionalProperties": true,
            "description": "A TheHive 4 alert."
          }
        },
        "additionalProperties": false,
        "description": "The created TheHive 4 alert response."
      }
    },
    {
      "id": "thehive.create_case",
