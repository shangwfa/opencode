    {
      "id": "thehive.list_alerts",
      "service": "thehive",
      "name": "list_alerts",
      "description": "List alerts visible to the connected TheHive 4 user.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "The maximum number of records to return, up to 100."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "The zero-based result offset."
          }
        },
        "additionalProperties": false,
        "description": "The input for listing TheHive 4 alerts."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "alerts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "_id": {
                  "type": "string",
                  "description": "The alert ID."
                },
                "title": {
                  "type": "string",
                  "description": "The alert title."
                },
                "source": {
                  "type": "string",
                  "description": "The alert source."
                },
                "sourceRef": {
                  "type": "string",
                  "description": "The source-specific alert reference."
                }
              },
              "additionalProperties": true,
              "description": "A TheHive 4 alert."
            },
            "description": "Alerts returned by TheHive 4."
          },
          "offset": {
            "type": "integer",
            "description": "The zero-based offset used for this result page."
          },
          "limit": {
            "type": "integer",
            "description": "The requested page size."
          },
          "nextOffset": {
            "anyOf": [
              {
                "type": "integer",
                "description": "The offset to request for the next page, or null when this page is incomplete."
              },
              {
                "type": "null"
              }
            ],
            "description": "The offset to request for the next page, or null when this page is incomplete."
          }
        },
        "additionalProperties": false,
        "description": "The TheHive 4 alert list response."
      }
    },
