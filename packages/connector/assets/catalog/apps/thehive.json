              "title": {
                "type": "string",
                "description": "The case title."
              },
              "description": {
                "type": "string",
                "description": "The case description."
              }
            },
            "additionalProperties": true,
            "description": "A TheHive 4 case."
          }
        },
        "additionalProperties": false,
        "description": "The created TheHive 4 case response."
      }
    },
