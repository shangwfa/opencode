    {
      "id": "megaventory.upsert_purchase_order",
      "service": "megaventory",
      "name": "upsert_purchase_order",
      "description": "Insert or update a Megaventory purchase order with one or more order lines.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "integer",
            "minimum": 0,
            "description": "The existing order ID; omit for a new order."
          },
          "orderTypeId": {
            "type": "integer",
            "minimum": 1,
            "description": "The order document type ID."
          },
          "supplierId": {
            "type": "integer",
            "minimum": 1,
            "description": "The supplier ID."
          },
          "inventoryLocationId": {
            "type": "integer",
            "minimum": 1,
            "description": "The inventory location ID."
          },
          "status": {
            "type": "string",
            "enum": [
              "ValidStatus",
              "Pending",
              "Verified",
              "PartiallyReceived",
              "PartiallyReceivedAndPartiallyInvoiced",
              "FullyReceived",
              "PartiallyInvoiced",
              "FullyInvoiced",
              "Closed",
              "Cancelled"
            ],
            "description": "The documented order status."
          },
          "orderNumber": {
            "type": "string",
            "description": "The order number."
          },
          "referenceNumber": {
            "type": "string",
            "description": "The caller's reference number."
          },
          "comments": {
            "type": "string",
            "description": "Order comments."
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "productSku": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The product SKU."
                },
                "quantity": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "description": "The ordered quantity."
                },
                "unitPrice": {
                  "type": "number",
                  "description": "The unit price before tax and discount."
                },
                "taxId": {
                  "type": "integer",
                  "description": "The tax identifier."
                },
                "discountId": {
                  "type": "integer",
                  "description": "The discount identifier."
                },
                "remarks": {
                  "type": "string",
                  "description": "Line remarks."
                }
              },
              "additionalProperties": false,
              "required": [
                "productSku",
                "quantity"
              ],
              "description": "One purchase order line."
            },
            "description": "The order lines.",
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "orderTypeId",
          "supplierId",
          "inventoryLocationId",
          "status",
          "details"
        ],
        "description": "The purchase order fields to insert or update."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "order": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "The inserted or updated purchase order."
          },
          "responseStatus": {
            "type": "object",
            "properties": {
              "ErrorCode": {
                "type": "string",
                "description": "The error code; zero indicates success."
              },
              "Message": {
                "type": "string",
                "description": "The human-readable status message."
              }
            },
            "additionalProperties": true,
            "required": [
              "ErrorCode"
            ],
            "description": "The status returned by Megaventory."
          },
          "entityId": {
            "type": "integer",
            "description": "The entity identifier."
          },
          "relatedDocumentId": {
            "type": "integer",
            "description": "The related document identifier."
          }
        },
        "additionalProperties": false,
        "required": [
          "order",
          "responseStatus"
        ],
        "description": "The purchase order returned after the update."
