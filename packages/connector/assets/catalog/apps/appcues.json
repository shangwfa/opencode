{
  "service": "appcues",
  "displayName": "Appcues",
  "categories": [
    "Marketing",
    "Data"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "placeholder": "APPCUES_API_KEY",
      "description": "Appcues Public API key. Create it at https://studio.appcues.com/settings/keys",
      "extraFields": [
        {
          "key": "apiSecret",
          "label": "API Secret",
          "inputType": "password",
          "required": true,
          "secret": true
        },
        {
          "key": "accountId",
          "label": "Account ID",
          "inputType": "text",
          "required": true,
          "secret": false
        },
        {
          "key": "region",
          "label": "Region",
          "inputType": "text",
          "required": false,
          "secret": false,
          "placeholder": "us",
          "description": "Use us or eu."
        }
      ]
    }
  ],
  "homepageUrl": "https://www.appcues.com",
  "actions": [
    {
      "id": "appcues.get_flow",
      "service": "appcues",
      "name": "get_flow",
      "description": "Get one Appcues Flow 2.0 experience by identifier.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "flow_id": {
            "type": "string",
            "minLength": 1,
            "description": "The Appcues Flow 2.0 identifier."
          }
        },
        "additionalProperties": false,
        "description": "Input for one Appcues Flow 2.0 experience."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The flow identifier."
          },
          "name": {
            "type": "string",
            "description": "The flow name."
          },
          "published": {
            "type": "boolean",
            "description": "Whether the flow is currently published."
          },
          "state": {
            "type": "string",
            "description": "The current flow state."
          },
          "platform": {
            "type": "string",
            "description": "The platform targeted by the flow."
          },
          "frequency": {
            "type": "string",
            "description": "The configured display frequency."
          },
          "created_at": {
            "type": "integer",
            "description": "The flow creation time as a Unix timestamp in milliseconds."
          },
          "updated_at": {
            "type": "integer",
            "description": "The last flow update time as a Unix timestamp in milliseconds."
          },
          "published_at": {
            "anyOf": [
              {
                "type": "integer",
                "description": "The last publish time as a Unix timestamp in milliseconds."
              },
              {
                "type": "null"
              }
            ],
            "description": "The last publish time as a Unix timestamp in milliseconds."
          },
          "tag_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "One tag ID."
            },
            "description": "The identifiers of tags assigned to the flow."
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The step identifier."
                },
                "type": {
                  "type": "string",
                  "description": "The step type."
                }
              },
              "additionalProperties": true,
              "description": "One provider-defined flow step."
            },
            "description": "The provider-defined steps in the flow."
          }
        },
        "additionalProperties": true,
        "required": [
          "id",
          "name",
          "published"
        ],
        "description": "One Appcues Flow 2.0 experience."
      }
    },
