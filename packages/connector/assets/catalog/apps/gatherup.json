{
  "service": "gatherup",
  "displayName": "GatherUp",
  "categories": [
    "Marketing",
    "Data"
  ],
  "authTypes": [
    "custom_credential"
  ],
  "auth": [
    {
      "type": "custom_credential",
      "fields": [
        {
          "key": "apiKey",
          "label": "Bearer Token",
          "inputType": "password",
          "required": true,
          "secret": true,
          "placeholder": "GATHERUP_BEARER_TOKEN",
          "description": "GatherUp Bearer token. Obtain it from the account owner details: https://help.gatherup.com/s/article/GatherUp-API-Client-ID-Private-Key-and-Bearer-Token."
        },
        {
          "key": "clientId",
          "label": "Client ID",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "GATHERUP_CLIENT_ID",
          "description": "GatherUp client ID paired with the Bearer token: https://help.gatherup.com/s/article/GatherUp-API-Client-ID-Private-Key-and-Bearer-Token."
        }
      ]
    }
  ],
  "homepageUrl": "https://gatherup.com/",
  "actions": [
    {
      "id": "gatherup.get_business",
      "service": "gatherup",
      "name": "get_business",
      "description": "Get one GatherUp business location by ID.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "integer",
            "minimum": 1,
            "description": "The optional GatherUp agency client number to target when using account-owner credentials."
          },
          "businessId": {
            "type": "integer",
            "minimum": 1,
            "description": "The GatherUp business ID to retrieve."
          }
        },
        "additionalProperties": false,
        "required": [
          "businessId"
        ],
        "description": "The GatherUp business lookup input."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "The GatherUp business ID."
          },
          "name": {
            "type": "string",
            "description": "The business name."
          },
          "errorCode": {
            "type": "integer",
            "description": "The GatherUp result code. A successful response returns 0."
          },
          "errorMessage": {
            "type": "string",
            "description": "The GatherUp result message."
          }
        },
        "additionalProperties": true,
        "required": [
          "id",
          "name",
          "errorCode",
          "errorMessage"
        ],
        "description": "A GatherUp business location with provider-defined fields preserved."
      }
    },
    {
      "id": "gatherup.get_customer",
      "service": "gatherup",
      "name": "get_customer",
