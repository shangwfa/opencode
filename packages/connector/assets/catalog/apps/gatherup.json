    {
      "id": "gatherup.list_businesses",
      "service": "gatherup",
      "name": "list_businesses",
      "description": "List one page of business locations available to the connected GatherUp account.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "agent": {
            "type": "integer",
            "minimum": 1,
            "description": "The optional GatherUp agency client number to target when using account-owner credentials."
          },
          "includeDeletedBusinesses": {
            "type": "boolean",
            "description": "Whether GatherUp should include deleted business locations."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "The one-based page number to request."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "description": "The number of business locations to request per page."
          }
        },
        "additionalProperties": false,
        "description": "Filters for listing GatherUp business locations."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "The current page number."
          },
          "perPage": {
            "type": "integer",
            "minimum": 1,
            "description": "The number of business locations requested per page."
          },
          "pages": {
            "type": "integer",
            "minimum": 0,
            "description": "The total number of pages."
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "description": "The total number of business locations."
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "businessId": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "The GatherUp business ID."
                },
                "businessName": {
                  "type": "string",
                  "description": "The business name."
                },
                "businessDeleted": {
                  "type": "integer",
                  "description": "Whether GatherUp marks the business as deleted."
                }
              },
              "additionalProperties": true,
              "required": [
                "businessId",
                "businessName",
                "businessDeleted"
              ],
              "description": "A business location returned by GatherUp."
            },
            "description": "The business locations returned on this page."
          },
          "errorCode": {
            "type": "integer",
            "description": "The GatherUp result code. A successful response returns 0."
          },
          "errorMessage": {
            "type": "string",
            "description": "The GatherUp result message."
          }
        },
        "additionalProperties": true,
        "required": [
          "page",
          "perPage",
          "pages",
          "count",
          "data",
          "errorCode",
          "errorMessage"
        ],
        "description": "A page of GatherUp business locations."
      }
    },
