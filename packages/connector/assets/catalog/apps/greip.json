{
  "service": "greip",
  "displayName": "Greip",
  "homepageUrl": "https://greip.io",
  "categories": [
    "Security & Identity",
    "Maps & Location"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key",
      "description": "Get your API key from https://dashboard.greip.io/home. Requests use Authorization: Bearer <API key>."
    }
  ],
  "actions": [
    {
      "id": "greip.lookup_asn",
      "service": "greip",
      "name": "lookup_asn",
      "description": "Look up an autonomous system number, its organization and network prefixes.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "asn": {
            "type": "string",
            "minLength": 1,
            "description": "Autonomous system number, with or without the AS prefix, such as AS6167 or 6167."
          },
          "mode": {
            "type": "string",
            "enum": [
              "live",
              "test"
            ],
            "description": "Environment; test returns simulated data, live is the default."
          }
        },
        "additionalProperties": false,
        "required": [
          "asn"
        ],
        "description": "ASN lookup parameters."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "asn": {
                "type": "string",
                "description": "Autonomous system number."
              },
              "name": {
                "type": "string",
                "description": "Autonomous system name."
              },
              "country": {
                "type": "string",
                "description": "Country code."
              },
              "org": {
                "type": "string",
                "description": "Organization name."
              },
              "prefixes": {
                "type": "object",
                "properties": {
                  "ipv4": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "IPv4 network prefix."
                    },
                    "description": "IPv4 network prefixes."
                  },
                  "ipv6": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "IPv6 network prefix."
                    },
                    "description": "IPv6 network prefixes."
                  },
                  "total": {
                    "type": "integer",
                    "description": "Total number of prefixes."
                  }
                },
                "additionalProperties": true,
                "description": "Network prefixes advertised by the autonomous system."
              }
            },
            "additionalProperties": true,
            "required": [
              "asn"
            ],
            "description": "Autonomous system information."
          },
          "status": {
            "type": "string",
            "description": "Response status."
          },
          "executionTime": {
            "type": "number",
            "description": "Processing time in milliseconds."
          }
        },
        "additionalProperties": true,
        "required": [
          "data",
          "status"
        ],
        "description": "Greip response with the original data and response metadata."
      }
    },
    {
      "id": "greip.lookup_country",
