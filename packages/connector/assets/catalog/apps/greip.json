      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "CountryCode": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2,
            "description": "Two-letter country code, such as GB."
          },
          "params": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "language",
                "flag",
                "currency",
                "timezone"
              ],
              "description": "Country detail module."
            },
            "description": "Optional country detail modules.",
            "minItems": 1,
            "uniqueItems": true
          },
          "mode": {
            "type": "string",
            "enum": [
              "live",
              "test"
            ],
            "description": "Environment; test returns simulated data, live is the default."
          }
