    {
      "id": "riddle_quiz_maker.list_riddles",
      "service": "riddle_quiz_maker",
      "name": "list_riddles",
      "description": "List and search Riddles with documented filters and pagination.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "project": {
            "type": "integer",
            "minimum": 1,
            "description": "The numeric Riddle project ID."
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "Only return Riddles of this type, such as Quiz or Poll."
          },
          "notType": {
            "type": "string",
            "minLength": 1,
            "description": "Exclude Riddles of this type."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "description": "A Riddle tag ID."
            },
            "description": "Tag IDs that every returned Riddle must have."
          },
          "status": {
            "type": "string",
            "enum": [
              "published",
              "modified",
              "draft"
            ],
            "description": "Only return Riddles with this publication status."
          },
          "search": {
            "type": "string",
            "minLength": 1,
            "description": "A search term for Riddle titles or UUIDs."
          },
          "origin": {
            "type": "string",
            "enum": [
              "api",
              "manual"
            ],
            "description": "Only return Riddles created through this origin."
          },
          "sortBy": {
            "type": "string",
            "enum": [
              "created",
              "published",
              "modified"
            ],
            "description": "The Riddle field used for sorting."
          },
          "sortOrder": {
            "type": "string",
            "enum": [
              "ASC",
              "DESC"
            ],
            "description": "The result sort direction."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "The one-based page number."
          },
          "pageSize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300,
            "description": "The number of Riddles per page, up to 300."
          }
        },
        "additionalProperties": false,
        "description": "Filters and pagination for listing Riddles."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "riddles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": true,
              "description": "A Riddle object returned by the Riddle API."
            },
            "description": "The Riddles on this page."
          },
          "pagination": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "page": {
                    "type": "integer",
                    "description": "The current page number."
                  },
                  "pageSize": {
                    "type": "integer",
                    "description": "The number of items requested per page."
                  },
                  "total": {
                    "type": "integer",
                    "description": "The total number of matching items."
                  },
                  "hasMore": {
                    "type": "boolean",
                    "description": "Whether another page is available."
                  }
                },
                "additionalProperties": true,
                "description": "Pagination metadata returned by the Riddle API."
              },
              {
                "type": "null"
              }
            ],
            "description": "Pagination metadata returned by the Riddle API."
          }
        },
        "additionalProperties": false,
        "description": "A page of Riddles and its pagination metadata."
      }
