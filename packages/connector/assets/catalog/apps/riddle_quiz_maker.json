      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "riddleUuid": {
            "type": "string",
            "minLength": 1,
            "description": "The UUID of the Riddle to operate on."
          },
          "id": {
            "type": "integer",
            "minimum": 1,
            "description": "The ID of an existing tag to attach."
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The name of a tag to create and attach."
          }
        },
        "additionalProperties": false,
        "required": [
          "riddleUuid"
        ],
        "description": "The Riddle and either an existing tag ID or a new tag name.",
