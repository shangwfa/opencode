    {
      "id": "chargeblast.update_alert",
      "service": "chargeblast",
      "name": "update_alert",
      "description": "Action one Chargeblast alert with an official reason code and optional expiration-time handling.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The Chargeblast resource identifier."
          },
          "result": {
            "type": "string",
            "enum": [
              "Resolved",
              "ResolvedPartial",
              "ResolvedCancelled",
              "AccountCancelled",
              "CancellationProcessed",
              "UnmatchedGeneral",
              "UnmatchedCannotFindTransaction",
              "Duplicate",
              "MIDLost",
              "AlreadyRefunded",
              "AlreadyChargeback",
              "Ineligible",
              "TDS",
              "CannotCancel",
              "MatchedWillShip",
              "EscalateChargeback",
              "ContactedShipper",
              "WIP",
              "Error",
              "None",
              "NotMyDescriptor",
              "Unactioned",
              ""
            ],
            "description": "The Chargeblast reason code used to action an alert."
          },
          "actionAtExpiration": {
            "type": "boolean",
            "description": "Whether Chargeblast should action the alert at expiration instead of immediately. Chargeblast ignores this when result is Resolved."
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "result"
        ],
