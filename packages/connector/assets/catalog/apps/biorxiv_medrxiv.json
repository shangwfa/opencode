    {
      "id": "biorxiv_medrxiv.get_preprint",
      "service": "biorxiv_medrxiv",
      "name": "get_preprint",
      "description": "Get all versions of one bioRxiv or medRxiv preprint by DOI.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string",
            "enum": [
              "biorxiv",
              "medrxiv"
            ],
            "description": "The preprint server to query."
          },
          "doi": {
            "type": "string",
            "minLength": 1,
            "description": "The preprint DOI, such as 10.1101/339747."
          }
        },
        "additionalProperties": false,
        "description": "Input parameters for getting a preprint."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "found": {
            "type": "boolean",
            "description": "Whether the API returned at least one version."
          },
          "preprints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "doi": {
                  "type": "string",
                  "description": "The preprint DOI."
                },
                "title": {
                  "type": "string",
                  "description": "The preprint title."
                },
                "authors": {
                  "type": "string",
                  "description": "The semicolon-separated author list."
                },
                "author_corresponding": {
                  "type": "string",
                  "description": "The corresponding author name."
                },
                "author_corresponding_institution": {
                  "type": "string",
                  "description": "The corresponding author institution."
                },
                "date": {
                  "type": "string",
                  "description": "A date in YYYY-MM-DD format.",
                  "format": "date"
                },
                "version": {
                  "type": "string",
                  "description": "The preprint version number."
                },
                "type": {
                  "type": "string",
                  "description": "The submission type reported by the server."
                },
                "license": {
                  "type": "string",
                  "description": "The license code reported by the server."
                },
                "category": {
                  "type": "string",
                  "description": "The subject category."
                },
                "jatsxml": {
                  "type": "string",
                  "description": "The URL of the JATS XML source."
                },
                "abstract": {
                  "type": "string",
                  "description": "The preprint abstract."
                },
                "funder": {
                  "description": "The funding metadata returned by the server."
                },
                "published": {
                  "type": "string",
                  "description": "The published DOI, or NA when none is reported."
                },
                "server": {
                  "type": "string",
                  "description": "The display name of the source preprint server."
                }
              },
              "additionalProperties": true,
              "required": [
                "doi",
                "title",
                "date",
                "version"
              ],
              "description": "A preprint version returned by the bioRxiv API."
            },
            "description": "All returned versions of the preprint."
          }
        },
        "additionalProperties": false,
        "description": "The versions returned for one preprint DOI."
      }
