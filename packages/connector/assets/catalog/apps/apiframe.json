    {
      "id": "apiframe.get_job",
      "service": "apiframe",
      "name": "get_job",
      "description": "Get the current status and model-specific result for one Apiframe job.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The Apiframe job UUID.",
            "format": "uuid"
          }
        },
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "description": "The Apiframe job to retrieve."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "The Apiframe job UUID.",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "QUEUED",
              "PROCESSING",
              "COMPLETED",
              "FAILED",
              "CANCELLED"
            ],
            "description": "The current job status."
          },
          "model": {
            "type": "string",
            "description": "The model used by the job."
          },
          "progress": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 100,
                "description": "The completion percentage when reported."
              },
              {
                "type": "null"
              }
            ],
            "description": "The completion percentage when reported."
          },
          "input": {
            "anyOf": [
              {
                "type": "object",
                "properties": {},
                "additionalProperties": true,
                "description": "The original generation input when returned."
              },
              {
                "type": "null"
              }
            ],
            "description": "The original generation input when returned."
          },
          "result": {
            "description": "The model-specific result, normally containing provider-hosted media URLs."
          },
          "error": {
            "anyOf": [
              {
                "type": "string",
                "description": "The failure message when the job failed."
              },
              {
                "type": "null"
              }
            ],
            "description": "The failure message when the job failed."
          },
          "creditCost": {
            "anyOf": [
              {
                "type": "integer",
                "description": "The number of credits charged for the job."
              },
              {
                "type": "null"
              }
            ],
            "description": "The number of credits charged for the job."
          },
          "webhookStatus": {
            "anyOf": [
              {
                "type": "string",
                "description": "The current webhook delivery status."
              },
              {
                "type": "null"
              }
            ],
            "description": "The current webhook delivery status."
          },
          "createdAt": {
            "type": "string",
            "description": "The time the job was created.",
            "format": "date-time"
          },
          "completedAt": {
            "anyOf": [
              {
                "type": "string",
                "description": "The time the job completed.",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "description": "The time the job completed."
          },
          "expired": {
            "type": "boolean",
            "description": "Whether the job's hosted media assets have expired."
          }
        },
        "additionalProperties": true,
        "required": [
          "id",
          "status",
          "model",
          "progress",
          "error",
          "creditCost",
          "webhookStatus",
          "createdAt",
          "completedAt"
        ],
        "description": "The current Apiframe job state and result."
      }
    },
