  "actions": [
    {
      "id": "apiframe.generate_image",
      "service": "apiframe",
      "name": "generate_image",
      "description": "Submit an Apiframe image generation job and return its job ID.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1,
                "description": "The Apiframe model identifier from the model catalog."
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "description": "The generation prompt when required by the selected model."
              },
              "webhookUrl": {
                "type": "string",
                "description": "The endpoint URL that receives job events.",
                "format": "uri"
              },
              "webhookEvents": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "progress",
                    "completed",
                    "failed"
                  ],
                  "description": "An Apiframe job event delivered to the webhook."
                },
                "description": "The job events delivered to the webhook.",
                "minItems": 1
              }
            },
            "additionalProperties": true,
            "required": [
              "model"
            ],
            "description": "The Apiframe generation request, including the model-specific parameter object documented for the selected model."
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "description": "A unique key used to deduplicate generation retries."
          }
        },
        "additionalProperties": false,
        "required": [
          "body"
        ],
        "description": "The request for an Apiframe image generation job."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "jobId": {
            "type": "string",
            "description": "The job UUID used to retrieve the result.",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "QUEUED",
              "PROCESSING",
              "COMPLETED",
              "FAILED"
            ],
            "description": "The job status when the request was accepted."
          }
        },
        "additionalProperties": false,
        "required": [
          "jobId",
          "status"
        ],
        "description": "The accepted Apiframe generation job."
      },
      "followUpActions": [
        "apiframe.get_job"
      ]
    },
