    {
      "id": "instabot.create_user",
      "service": "instabot",
      "name": "create_user",
      "description": "Create a registered user in Instabot.",
      "operationType": "write",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "userName": {
            "type": "string",
            "minLength": 1,
            "description": "The unique user name."
          },
          "userPassword": {
            "type": "string",
            "minLength": 1,
            "description": "The initial user password."
          },
          "name": {
            "type": "string",
            "description": "The user's display name."
          },
          "description": {
            "type": "string",
            "description": "The user description."
          },
          "email": {
            "type": "string",
            "description": "The user's email address.",
            "format": "email"
          },
          "phone": {
            "type": "string",
            "description": "The user's phone number."
          },
          "photoFile": {
            "type": "object",
            "properties": {
              "objectId": {
                "type": "integer",
                "minimum": 1,
                "description": "The Instabot File Object ID used as the user's photo."
              }
            },
            "additionalProperties": false,
            "required": [
              "objectId"
            ],
            "description": "A reference to an existing Instabot File Object."
          },
          "customProperties": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "Custom Instabot user properties keyed by property name."
          }
        },
        "additionalProperties": false,
        "required": [
          "userName",
          "userPassword"
        ],
        "description": "The Instabot user fields used for creation."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "object",
            "properties": {
              "apiStatusCode": {
                "type": "string",
                "description": "The Instabot API status code."
              },
              "apiStatusMessage": {
                "anyOf": [
                  {
                    "type": "string",
                    "description": "The Instabot API status message when the service supplies one."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The Instabot API status message when the service supplies one."
              }
            },
            "additionalProperties": false,
            "required": [
              "apiStatusCode",
              "apiStatusMessage"
            ],
            "description": "The status envelope returned by Instabot."
          },
          "userId": {
            "type": "integer",
            "minimum": 1,
            "description": "The Instabot user object ID."
          }
        },
        "additionalProperties": false,
        "required": [
          "status",
          "userId"
        ],
        "description": "The result returned after Instabot creates a user."
      }
    },
