{
  "service": "luno",
  "displayName": "Luno",
  "categories": [
    "Finance",
    "Data"
  ],
  "authTypes": [
    "api_key"
  ],
  "auth": [
    {
      "type": "api_key",
      "label": "API Key Secret",
      "placeholder": "LUNO_API_KEY_SECRET",
      "description": "Luno API Key Secret from Profile > Security > API keys: https://www.luno.com/wallet/settings/api_keys",
      "extraFields": [
        {
          "key": "keyId",
          "label": "API Key ID",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "LUNO_API_KEY_ID",
          "description": "Luno API Key ID used as the HTTP Basic username."
        }
      ]
    }
  ],
  "homepageUrl": "https://www.luno.com",
  "actions": [
    {
      "id": "luno.get_balances",
      "service": "luno",
      "name": "get_balances",
      "description": "List Luno account balances, optionally filtered by asset code.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "assets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "One Luno asset code."
            },
            "description": "The asset codes to include, such as XBT or ETH.",
            "minItems": 1
          }
        },
        "additionalProperties": false,
        "description": "Input for listing Luno account balances."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "balance": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "account_id": {
                  "type": "string",
                  "description": "The account identifier."
                },
                "asset": {
                  "type": "string",
                  "description": "The account asset code."
                },
                "balance": {
                  "type": "string",
                  "description": "The total balance as a decimal string."
                },
                "name": {
                  "type": "string",
                  "description": "The account label."
                },
                "reserved": {
                  "type": "string",
                  "description": "The reserved balance as a decimal string."
                },
                "unconfirmed": {
                  "type": "string",
                  "description": "The unconfirmed balance as a decimal string."
                }
              },
              "additionalProperties": true,
              "description": "One Luno account balance."
            },
            "description": "The returned account balances."
          }
        },
        "additionalProperties": false,
        "description": "The Luno account balance list."
      }
    },
    {
      "id": "luno.get_order",
      "service": "luno",
      "name": "get_order",
      "description": "Get one Luno order by its order identifier.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "The Luno order identifier."
          }
        },
        "additionalProperties": false,
        "description": "Input for retrieving one Luno order."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "description": "The order identifier."
          },
          "pair": {
            "type": "string",
            "description": "The order market pair."
          },
          "state": {
            "type": "string",
            "description": "The current order state."
          },
          "type": {
            "type": "string",
            "description": "The order side or type."
          },
          "creation_timestamp": {
            "type": "integer",
            "description": "A Unix timestamp in milliseconds."
          },
          "completed_timestamp": {
            "type": "integer",
            "description": "A Unix timestamp in milliseconds."
          },
          "expiration_timestamp": {
            "type": "integer",
            "description": "A Unix timestamp in milliseconds."
          },
          "base": {
            "type": "string",
            "description": "The base amount as a decimal string."
          },
          "counter": {
            "type": "string",
            "description": "The counter amount as a decimal string."
          },
          "fee_base": {
            "type": "string",
            "description": "The base-currency fee as a decimal string."
          },
          "fee_counter": {
            "type": "string",
            "description": "The counter-currency fee as a decimal string."
          },
          "limit_price": {
            "type": "string",
            "description": "The limit price as a decimal string."
          },
          "limit_volume": {
            "type": "string",
            "description": "The limit volume as a decimal string."
          },
          "time_in_force": {
            "type": "string",
            "description": "The order time-in-force policy."
          }
        },
        "additionalProperties": true,
        "description": "One Luno order."
      }
    },
    {
      "id": "luno.get_ticker",
      "service": "luno",
      "name": "get_ticker",
      "description": "Get the latest Luno ticker indicators for one currency pair.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "pair": {
            "type": "string",
            "minLength": 1,
            "description": "The Luno market pair, such as XBTZAR or ETHXBT."
          }
        },
        "additionalProperties": false,
        "description": "Input for retrieving one Luno ticker."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "ask": {
            "type": "string",
            "description": "The lowest current ask price as a decimal string."
          },
          "bid": {
            "type": "string",
            "description": "The highest current bid price as a decimal string."
          },
          "last_trade": {
            "type": "string",
            "description": "The latest trade price as a decimal string."
          },
          "pair": {
            "type": "string",
            "description": "The market currency pair."
          },
          "rolling_24_hour_volume": {
            "type": "string",
            "description": "The rolling 24-hour traded volume as a decimal string."
          },
          "status": {
            "type": "string",
            "description": "The current market status."
          },
          "timestamp": {
            "type": "integer",
            "description": "A Unix timestamp in milliseconds."
          }
        },
        "additionalProperties": true,
        "description": "One Luno market ticker."
      }
    },
    {
      "id": "luno.get_top_order_book",
      "service": "luno",
      "name": "get_top_order_book",
      "description": "Get the best 100 aggregated Luno bid and ask levels for one currency pair.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "pair": {
            "type": "string",
            "minLength": 1,
            "description": "The Luno market pair, such as XBTZAR or ETHXBT."
          }
        },
        "additionalProperties": false,
        "description": "Input for retrieving the top Luno order book."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "asks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "price": {
                  "type": "string",
                  "description": "A decimal value represented as a string to preserve precision."
                },
                "volume": {
                  "type": "string",
                  "description": "A decimal value represented as a string to preserve precision."
                }
              },
              "additionalProperties": false,
              "description": "One aggregated order-book price level."
            },
            "description": "Ask levels sorted by ascending price."
          },
          "bids": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "price": {
                  "type": "string",
                  "description": "A decimal value represented as a string to preserve precision."
                },
                "volume": {
                  "type": "string",
                  "description": "A decimal value represented as a string to preserve precision."
                }
              },
              "additionalProperties": false,
              "description": "One aggregated order-book price level."
            },
            "description": "Bid levels sorted by descending price."
          },
          "timestamp": {
            "type": "integer",
            "description": "A Unix timestamp in milliseconds."
          }
        },
        "additionalProperties": false,
        "description": "The aggregated top Luno order book."
      }
    },
    {
      "id": "luno.list_orders",
      "service": "luno",
      "name": "list_orders",
      "description": "List recently placed Luno orders with optional state, pair, and time filters.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "PENDING",
              "COMPLETE"
            ],
            "description": "The Luno order state."
          },
          "pair": {
            "type": "string",
            "minLength": 1,
            "description": "The Luno market pair, such as XBTZAR or ETHXBT."
          },
          "created_before": {
            "type": "integer",
            "description": "A Unix timestamp in milliseconds."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000,
            "description": "The maximum number of orders to return."
          }
        },
        "additionalProperties": false,
        "description": "Input for listing Luno orders."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "orders": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "order_id": {
                  "type": "string",
                  "description": "The order identifier."
                },
                "pair": {
                  "type": "string",
                  "description": "The order market pair."
                },
                "state": {
                  "type": "string",
                  "description": "The current order state."
                },
                "type": {
                  "type": "string",
                  "description": "The order side or type."
                },
                "creation_timestamp": {
                  "type": "integer",
                  "description": "A Unix timestamp in milliseconds."
                },
                "completed_timestamp": {
                  "type": "integer",
                  "description": "A Unix timestamp in milliseconds."
                },
                "expiration_timestamp": {
                  "type": "integer",
                  "description": "A Unix timestamp in milliseconds."
                },
                "base": {
                  "type": "string",
                  "description": "The base amount as a decimal string."
                },
                "counter": {
                  "type": "string",
                  "description": "The counter amount as a decimal string."
                },
                "fee_base": {
                  "type": "string",
                  "description": "The base-currency fee as a decimal string."
                },
                "fee_counter": {
                  "type": "string",
                  "description": "The counter-currency fee as a decimal string."
                },
                "limit_price": {
                  "type": "string",
                  "description": "The limit price as a decimal string."
                },
                "limit_volume": {
                  "type": "string",
                  "description": "The limit volume as a decimal string."
                },
                "time_in_force": {
                  "type": "string",
                  "description": "The order time-in-force policy."
                }
              },
              "additionalProperties": true,
              "description": "One Luno order."
            },
            "description": "The returned Luno orders."
          }
        },
        "additionalProperties": false,
        "description": "The Luno order list."
      }
    },
    {
      "id": "luno.list_recent_trades",
      "service": "luno",
      "name": "list_recent_trades",
      "description": "List up to 100 recent public Luno trades for one currency pair.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "pair": {
            "type": "string",
            "minLength": 1,
            "description": "The Luno market pair, such as XBTZAR or ETHXBT."
          },
          "since": {
            "type": "integer",
            "description": "Only return trades after this Unix timestamp in milliseconds, which cannot be more than 24 hours ago."
          }
        },
        "additionalProperties": false,
        "required": [
          "pair"
        ],
        "description": "Input for listing recent Luno market trades."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "trades": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "price": {
                  "type": "string",
                  "description": "The trade price as a decimal string."
                },
                "sequence": {
                  "type": "integer",
                  "description": "The market trade sequence number."
                },
                "timestamp": {
                  "type": "integer",
                  "description": "A Unix timestamp in milliseconds."
                },
                "volume": {
                  "type": "string",
                  "description": "The trade volume as a decimal string."
                },
                "is_buy": {
                  "type": "boolean",
                  "description": "Whether the market taker was buying."
                }
              },
              "additionalProperties": true,
              "description": "One recent public Luno market trade."
            },
            "description": "The returned market trades."
          }
        },
        "additionalProperties": false,
        "description": "The recent Luno market trades."
      }
    },
