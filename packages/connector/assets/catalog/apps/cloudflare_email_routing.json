    {
      "id": "cloudflare_email_routing.list_destination_addresses",
      "service": "cloudflare_email_routing",
      "name": "list_destination_addresses",
      "description": "List Cloudflare Email Routing destination addresses. Use addresses with a non-null verified timestamp for forward actions.",
      "operationType": "read",
      "requiredScopes": [
        "Email Routing Addresses Read"
      ],
      "providerPermissions": [
        "Email Routing Addresses Read"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "minLength": 1,
            "description": "The Cloudflare account ID."
          },
          "direction": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ],
            "description": "The result sort direction."
          },
          "verified": {
            "type": "boolean",
            "description": "Filter by destination address verification status."
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "description": "The result page number."
          },
          "perPage": {
            "type": "integer",
            "minimum": 5,
            "maximum": 50,
            "description": "The page size."
          }
        },
        "additionalProperties": false,
        "description": "The input payload for this action."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "addresses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The destination address ID."
                },
                "email": {
                  "type": "string",
                  "description": "The destination email address.",
                  "format": "email"
                },
                "created": {
                  "type": "string",
                  "description": "When the address was created.",
                  "format": "date-time"
                },
                "modified": {
                  "type": "string",
                  "description": "When the address was last modified.",
                  "format": "date-time"
                },
                "verified": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "When the address was verified; null means not verified."
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "When the address was verified; null means not verified."
                }
              },
              "additionalProperties": false,
              "required": [
                "id",
                "email"
              ],
              "description": "A Cloudflare Email Routing destination address. Verified addresses may be used by forward actions."
            },
            "description": "Destination addresses, including verification status."
          },
          "resultInfo": {
            "type": "object",
            "properties": {},
            "additionalProperties": true,
            "description": "Cloudflare pagination metadata."
          }
        },
        "additionalProperties": false,
        "required": [
          "addresses"
        ],
        "description": "The output payload for this action."
      }
