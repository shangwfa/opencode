{
  "service": "cloudflare_email_routing",
  "displayName": "Cloudflare Email Routing",
  "categories": [
    "Communication",
    "Developer Tools"
  ],
  "authTypes": [
    "custom_credential"
  ],
  "auth": [
    {
      "type": "custom_credential",
      "fields": [
        {
          "key": "email",
          "label": "Cloudflare Account Email",
          "inputType": "text",
          "required": false,
          "secret": false,
          "placeholder": "you@example.com",
          "description": "Email address for legacy Global API Key authentication. Leave blank when using a cfut_ User API Token with Email Routing permissions."
        },
        {
          "key": "apiKey",
          "label": "Cloudflare API Credential",
          "inputType": "password",
          "required": true,
          "secret": true,
          "placeholder": "cloudflare_global_api_key",
          "description": "Use a cfut_ User API Token with Email Routing Rules/Addresses permissions, or a Global API Key (cfk_ or legacy format) with the account email. Cloudflare cfat_ Account API Tokens are not accepted by the Email Routing API: https://developers.cloudflare.com/fundamentals/api/reference/permissions/."
        },
        {
          "key": "accountId",
          "label": "Cloudflare Account ID",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "32-character Cloudflare account ID",
          "description": "Default account ID for destination addresses and account rule listings. Action inputs may override it."
        },
        {
          "key": "zoneId",
          "label": "Cloudflare Zone ID",
          "inputType": "text",
          "required": true,
          "secret": false,
          "placeholder": "32-character Cloudflare zone ID",
          "description": "Default zone ID for routing rule actions. Action inputs may override it."
        }
      ]
    }
  ],
  "homepageUrl": "https://www.cloudflare.com",
  "actions": [
    {
      "id": "cloudflare_email_routing.create_routing_rule",
      "service": "cloudflare_email_routing",
      "name": "create_routing_rule",
      "description": "Create a Cloudflare Email Routing rule in a zone. Forward actions require verified destination addresses.",
      "operationType": "write",
      "requiredScopes": [
        "Email Routing Rules Write"
      ],
      "providerPermissions": [
        "Email Routing Rules Write"
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "zoneId": {
            "type": "string",
            "minLength": 1,
            "description": "The Cloudflare zone ID."
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "drop",
                    "forward",
                    "worker"
                  ],
                  "description": "The action type."
                },
                "value": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Destination email addresses or Worker names.",
                  "minItems": 1
                }
              },
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "description": "An action applied to a matching email."
            },
            "description": "Actions applied to matching email.",
            "minItems": 1
          },
          "matchers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "all",
                    "literal"
                  ],
                  "description": "The matcher type."
                },
                "field": {
                  "type": "string",
                  "enum": [
                    "to"
                  ],
                  "description": "The email field to match."
                },
                "value": {
                  "type": "string",
                  "maxLength": 90,
                  "description": "The literal email address to match."
                }
              },
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "description": "A condition matching an incoming email."
            },
            "description": "Conditions matching incoming email.",
            "minItems": 1
          },
          "enabled": {
            "type": "boolean",
            "description": "Whether the rule is enabled."
          },
          "name": {
            "type": "string",
            "maxLength": 256,
            "description": "The rule name."
          },
          "priority": {
            "type": "number",
            "minimum": 0,
            "description": "The rule priority."
          },
          "source": {
            "type": "string",
            "enum": [
              "api",
              "wrangler"
            ],
            "description": "Who manages the rule."
          },
          "ownerWorkerTag": {
            "type": "string",
            "maxLength": 32,
            "description": "The public script tag required when source is wrangler."
          }
        },
        "additionalProperties": false,
        "required": [
          "actions",
          "matchers"
        ],
        "description": "The input payload for this action."
      },
