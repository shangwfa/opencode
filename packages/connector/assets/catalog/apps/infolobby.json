    {
      "id": "infolobby.count_records",
      "service": "infolobby",
      "name": "count_records",
      "description": "Count InfoLobby records matching filters, search, or a saved view.",
      "operationType": "read",
      "requiredScopes": [],
      "providerPermissions": [],
      "inputSchema": {
        "type": "object",
        "properties": {
          "tableId": {
            "type": "integer",
            "minimum": 1,
            "description": "The InfoLobby table id."
          },
          "where": {
            "type": "object",
            "additionalProperties": {
              "description": "A JSON-encodable InfoLobby field or filter value."
            },
            "description": "Simple equality or comparison filters keyed by field id."
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "column": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The field id to filter."
                },
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "description": "An alternative field id to filter."
                },
                "compare": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The documented comparison operator or alias."
                },
                "value": {
                  "description": "A JSON-encodable InfoLobby field or filter value."
                },
                "connector": {
                  "type": "string",
                  "enum": [
                    "AND",
                    "OR"
                  ],
                  "description": "How this filter joins the preceding filter."
                }
              },
              "additionalProperties": false,
              "required": [
                "compare"
              ],
              "description": "One InfoLobby record query filter."
            },
            "description": "The explicit filters applied to records.",
            "minItems": 1
          },
          "search": {
            "type": "string",
            "minLength": 1,
            "description": "A case-insensitive search term applied across selected fields."
          },
          "viewId": {
            "type": "integer",
            "minimum": 0,
            "description": "The saved view id, or 0 for the synthesized default view."
          }
        },
        "additionalProperties": false,
        "required": [
          "tableId"
        ],
        "description": "The input for counting InfoLobby records."
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "description": "The number of records matching the query."
          },
          "total": {
            "type": "integer",
            "description": "The total number of records in the table."
          },
          "totalApprox": {
            "type": "boolean",
            "description": "Whether the total is an approximate estimate."
          },
          "restricted": {
            "type": "boolean",
            "description": "Whether the query narrows the table."
          }
        },
        "additionalProperties": false,
        "required": [
          "count",
          "total",
          "totalApprox",
          "restricted"
        ],
        "description": "The InfoLobby record count result."
      }
    },
