{
  "id": "boss-micro",
  "label": "Boss 微前端工作流",
  "description": "需求讨论 → 布局设计 → 方案规划 → 代码生成 → 代码审查",
  "workspaceRoot": "{workspaceRoot}",
  "projectDir": "{workspaceRoot}/project",
  "defaultTemplateSkillId": "boss-create",
  "sessionAgentNames": [
    "specer-boss",
    "layout-designer",
    "layout-template-judge",
    "layout-wireframe-designer",
    "api-detail-specer",
    "planner-boss",
    "builder",
    "reviewer"
  ],
  "suggestStepPath": "analysis/{reqId}/suggest-step.json",
  "stages": [
    {
      "id": "requirement-discussion",
      "label": "需求讨论",
      "agent": "specer-boss",
      "artifactPath": "analysis/{reqId}/spec/spec.md",
      "description": "与 AI 讨论需求细节，产出需求文档",
      "permission": { "edit": "deny", "bash": "deny" },
      "emptyPrompt": "请直接在下方输入你想做的功能或改动",
      "artifactPanelView": "boss-requirement-discussion"
    },
    {
      "id": "layout-design",
      "label": "布局设计",
      "agent": "layout-designer",
      "artifactPath": "analysis/{reqId}/template/layout-designer.json",
      "description": "统一完成模版判定、模版确认与线框方案选择",
      "permission": { "edit": "deny", "bash": "deny" },
      "enterPrompt": "开始「{stageLabel}」",
      "emptyPrompt": "等待 AI 生成布局设计方案…",
      "skippable": true,
      "artifactPanelView": "layout-designer-confirm"
    },
    {
      "id": "plan",
      "label": "方案规划",
      "agent": "planner-boss",
      "artifactPath": "analysis/{reqId}/plan/plan.md",
      "description": "基于需求文档规划技术方案和任务拆分",
      "permission": { "edit": "deny", "bash": "ask" },
      "enterPrompt": "开始「{stageLabel}」",
      "artifactPanelView": "plan-confirm"
    },
    {
      "id": "code-modification",
      "label": "代码生成",
      "agent": "builder",
      "artifactPath": "analysis/{reqId}/build/build.md",
      "description": "根据方案执行代码修改",
      "permission": { "edit": "allow", "bash": "allow" },
      "enterPrompt": "开始「{stageLabel}」",
      "backwardEnterPrompt": "代码审查发现以下问题，请修复：{suggestStepReason}"
    },
    {
      "id": "code-review",
      "label": "代码审查",
      "agent": "reviewer",
      "artifactPath": "analysis/{reqId}/review/review.md",
      "description": "对代码变更进行全面审查",
      "permission": { "edit": "deny", "bash": "deny" },
      "enterPrompt": "请对当前代码变更进行全面审查",
      "commitButton": true,
      "completion": {
        "vcsDiff": true,
        "completionPrompt": "代码已提交，可在部署发布面板继续部署或创建 MR",
        "autoDetectSuggestStep": true
      }
    }
  ]
}
